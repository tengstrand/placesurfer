(ns placesurfer.edit.interface.handlers.poi
  (:require [placesurfer.edit.handlers.poi :as poi]))

(defn init-poi! [] (poi/init-poi!))
(defn sync-poi-circles! [] (poi/sync-poi-circles!))
(defn set-poi-unit! [unit] (poi/set-poi-unit! unit))
(defn set-poi-pin-id! [id] (poi/set-poi-pin-id! id))
(defn select-poi-circle! [id] (poi/select-poi-circle! id))
(defn set-poi-draft-radius! [s] (poi/set-poi-draft-radius! s))
(defn add-poi-circle! [] (poi/add-poi-circle!))
(defn start-poi-circle-edit! [id] (poi/start-poi-circle-edit! id))
(defn confirm-poi-circle-edit! [] (poi/confirm-poi-circle-edit!))
(defn delete-poi-circle! [id] (poi/delete-poi-circle! id))
(defn reorder-poi-circle! [drag-id to-index] (poi/reorder-poi-circle! drag-id to-index))
(defn submit-poi-draft! [] (poi/submit-poi-draft!))
(defn poi-submit-enabled? [state] (poi/poi-submit-enabled? state))
