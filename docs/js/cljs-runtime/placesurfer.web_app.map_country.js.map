(ns placesurfer.web-app.map-country
  (:require [placesurfer.app-ui.interface.load :as app-load]
            [placesurfer.app-ui.interface.pages :as app-ui.pages]
            [placesurfer.country.interface :as country]
            [placesurfer.map-ui.interface :as map-ui]
            [placesurfer.web-app.effects :as effects]
            [placesurfer.web-app.state :as state]))

(defn disable-country-pick! []
  (swap! state/!state assoc :map-country-pick? false)
  (map-ui/sync-country-pick-state! {:active? false}))

(defn- select-country-at-point! [{:keys [longitude latitude]}]
  (app-load/ensure-countries-loaded!)
  (when-let [slug (country/slug-for-point longitude latitude (:countries @state/!state))]
    (disable-country-pick!)
    (when-let [view (map-ui/map-view-state)]
      (swap! state/!state assoc :map-restore-view view))
    (effects/select-country! slug)))

(defn sync-map-country-pick! []
  (let [active? (and (:map-country-pick? @state/!state)
                     (app-ui.pages/map-page? (:page @state/!state)))]
    (map-ui/sync-country-pick-state!
     {:active? active?
      :on-click (when active? select-country-at-point!)})))

(defn enable-country-pick! []
  (when (app-ui.pages/map-page? (:page @state/!state))
    (when-let [view (:map-restore-view @state/!state)]
      (swap! state/!state dissoc :map-restore-view)
      (map-ui/fly-to-view! view))
    (swap! state/!state assoc :map-country-pick? true)
    (app-load/ensure-countries-loaded!)
    (effects/render!)))
