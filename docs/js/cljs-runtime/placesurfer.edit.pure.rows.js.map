(ns placesurfer.edit.pure.rows
  (:require [clojure.string :as str]
            [placesurfer.edit.pure.coords :as coords]
            [placesurfer.edit.pure.forms :as forms]
            [placesurfer.edit.pure.sources :as sources]
            [placesurfer.html.interface.description :as html-description]))

(defn- description-for-disk-compare
  "Canonical description for row/disk diffing (same round-trip as the rich editor)."
  [description]
  (let [s (str/trim (str (or description "")))]
    (if (seq s)
      (html-description/description-from-text-editor
       (html-description/description-for-text-display s))
      "")))

(defn ensure-position-description
  "Every loaded or new position carries :description (empty string when unset)."
  [position]
  (assoc position :description (description-for-disk-compare (:description position))))

(defn ensure-position-image
  "Every loaded or new position carries :image (empty string when unset)."
  [position]
  (assoc position :image (str/trim (str (or (:image position) "")))))

(defn row-source-set?
  [row-or-place]
  (some? (:source row-or-place)))

(defn pending-place->row
  [place]
  (cond-> {:row-id (:pending-id place)
           :name (:name place)
           :locality (:locality place)
           :homepage (:homepage place)
           :description (:description place "")
           :longitude (:longitude place)
           :latitude (:latitude place)
           :source (:source place)
           :url-form (:url-form place)
           :pending? true}
    (:url-form place) (assoc :marker-topic :url-pin)
    (:action place) (assoc :action (:action place))))

(defn coerce-action-keyword
  "Return keyword action or nil. Blank strings from disk JSON must not reach `keyword`."
  [action]
  (when (seq (str/trim (str action)))
    (if (keyword? action) action (keyword (str/trim (str action))))))

(defn- delete-action-keyword
  [action]
  (coerce-action-keyword action))

(defn row-marked-deleted?
  "Client-side delete marker before save; saved rows use :deleted on disk."
  [row]
  (and (= :deleted (delete-action-keyword (:action row)))
       (not (str/blank? (str (:name row))))))

(defn saved-delete-row?
  "Row persisted on disk (or staged) as deleted."
  [row]
  (contains? #{:delete :deleted} (delete-action-keyword (:action row))))

(defn row-marked-edited?
  [row]
  (= :edited (:action row)))

(defn row-marked-added?
  [row]
  (= :added (:action row)))

(defn disk-tombstone-row?
  "Legacy disk tombstones without a name."
  [row]
  (and (saved-delete-row? row)
       (str/blank? (str (:name row)))))

(defn row-save-as-tombstone?
  [row]
  (or (row-marked-deleted? row) (disk-tombstone-row? row)))

(defn- row-country-code-blank?
  [row]
  (str/blank? (str (:country-code row ""))))

(defn enrich-row-country-code
  "Rows loaded from disk often omit per-row :country-code; keep it in client state."
  [row country-code]
  (if (and country-code (row-country-code-blank? row))
    (assoc row :country-code country-code)
    row))

(defn mark-row-as-deleted
  [row country-code]
  (-> row
      (assoc :action :deleted)
      (enrich-row-country-code country-code)))

(defn pending-row?
  [row]
  (or (:pending? row)
      (neg? (or (:row-id row) (:pending-id row) 0))))

(defn saved-update-row-id?
  [id]
  (and (number? id) (>= id 0)))

(defn- vec-rows [rows]
  (if (sequential? rows) (vec rows) []))

(defn normalize-disk-baseline-row
  [row]
  (when-let [{:keys [longitude latitude]} (coords/row-lon-lat row)]
    (let [{:keys [name locality homepage description source holes layout-name]} row
          src (when (seq (str/trim (str source)))
                (sources/normalize-update-source source))]
      (cond-> {:name (str/trim (str (or name "")))
               :longitude (double longitude)
               :latitude (double latitude)
               :description (description-for-disk-compare description)}
        (seq (str/trim (str locality))) (assoc :locality (str/trim (str locality)))
        (seq (str/trim (str homepage))) (assoc :homepage (str/trim (str homepage)))
        src (assoc :source src)
        (some? holes) (assoc :holes holes)
        (seq (str/trim (str layout-name))) (assoc :layout-name (str/trim (str layout-name)))))))

(defn- baseline-entry-for-compare
  "Disk baseline entries are already normalized; only fill optional keys for legacy shapes."
  [baseline]
  (if (contains? baseline :description)
    baseline
    (assoc baseline :description "")))

(defn disk-baseline-from-rows
  [rows]
  (into {}
        (keep (fn [row]
                (when (saved-update-row-id? (:row-id row))
                  (when-let [baseline (normalize-disk-baseline-row row)]
                    [(:row-id row) baseline])))
              (vec-rows rows))))

(defn row-save-fields-valid?
  [row]
  (and (seq (str/trim (str (:name row ""))))
       (some? (coords/row-lon-lat row))))

(def ^:private empty-manual-draft-content-snapshot
  {:name "" :locality ""})

(defn manual-draft-content-snapshot
  [row-or-place]
  (let [lon (cond
              (number? (:longitude row-or-place)) (:longitude row-or-place)
              :else (coords/parse-decimal (:longitude row-or-place)))
        lat (cond
              (number? (:latitude row-or-place)) (:latitude row-or-place)
              :else (coords/parse-decimal (:latitude row-or-place)))
        homepage (let [h (:homepage row-or-place)]
                   (when (some? h)
                     (let [s (str/trim (str h))]
                       (when (seq s) s))))]
    (cond-> {:name (str/trim (str (:name row-or-place "")))
             :locality (str/trim (str (:locality row-or-place "")))}
      homepage (assoc :homepage homepage)
      (number? lon) (assoc :longitude (double lon))
      (number? lat) (assoc :latitude (double lat)))))

(defn manual-draft-differs-from-empty-baseline?
  [row-or-place]
  (not= (manual-draft-content-snapshot row-or-place)
        empty-manual-draft-content-snapshot))

(defn manual-draft-pending-row?
  [row-or-place]
  (and (nil? (:url-form row-or-place))
       (= :manual (sources/normalize-update-source (:source row-or-place)))
       (or (:pending? row-or-place)
           (neg? (or (:row-id row-or-place) (:pending-id row-or-place) 0)))))

(defn removable-pending-row-without-url?
  "Client-only pending row (incl. URL draft) that trash removes entirely."
  [row-or-place]
  (boolean (and row-or-place (pending-row? row-or-place))))

(defn incomplete-manual-draft?
  [row-or-place]
  (and (or (:pending? row-or-place)
           (neg? (or (:row-id row-or-place) (:pending-id row-or-place) 0)))
       (nil? (:url-form row-or-place))
       (= :manual (sources/normalize-update-source (:source row-or-place)))
       (not (row-save-fields-valid? row-or-place))))

(defn saved-row-unchanged-without-coords?
  "Saved disk row with no coordinates that the client has not modified."
  [row]
  (and (saved-update-row-id? (:row-id row))
       (nil? (coords/row-lon-lat row))
       (not (or (row-marked-edited? row)
                (row-marked-added? row)
                (row-marked-deleted? row)))))

(defn blank-manual-draft-pending-place?
  [place]
  (and (incomplete-manual-draft? place)
       (not (manual-draft-differs-from-empty-baseline? place))))

(defn empty-draft-pending-place?
  [place]
  (incomplete-manual-draft? place))

(defn blank-empty-draft-pending-place
  [place]
  (assoc place
         :name ""
         :locality ""
         :homepage nil
         :description ""
         :longitude nil
         :latitude nil
         :source :manual
         :url-form nil
         :action :added))

(defn row-differs-from-disk-baseline?
  [row disk-baseline]
  (when-let [baseline (get disk-baseline (:row-id row))]
    (let [baseline* (baseline-entry-for-compare baseline)]
      (if-let [normalized (normalize-disk-baseline-row row)]
        (not= normalized baseline*)
        (not= nil baseline*)))))

(defn recompute-row-action
  [row disk-baseline]
  (cond
    (row-marked-deleted? row) row
    (pending-row? row)
    (cond
      (:url-form row)
      (if (row-save-fields-valid? row)
        (assoc row :action :added)
        (dissoc row :action))

      (manual-draft-pending-row? row)
      (assoc row :action :added)

      (row-save-fields-valid? row)
      (assoc row :action :added)

      :else (dissoc row :action))
    (and (saved-update-row-id? (:row-id row))
         (row-save-fields-valid? row)
         (row-differs-from-disk-baseline? row disk-baseline))
    (assoc row :action :edited)
    :else (dissoc row :action)))

(defn pending-place-from-form-baseline
  [place baseline]
  (let [lon-str (str/trim (str (:longitude baseline "")))
        lat-str (str/trim (str (:latitude baseline "")))
        homepage-str (str/trim (str (:homepage baseline "")))
        description-str (str/trim (str (:description baseline "")))]
    (assoc place
           :name (str/trim (str (:name baseline "")))
           :locality (str/trim (str (:locality baseline "")))
           :homepage (when (seq homepage-str) homepage-str)
           :description description-str
           :longitude (when (seq lon-str) (coords/parse-decimal lon-str))
           :latitude (when (seq lat-str) (coords/parse-decimal lat-str))
           :source (sources/normalize-update-source (:source baseline))
           :url-form nil
           :action :added)))

(defn display-rows
  [saved-rows pending-places]
  (into (remove disk-tombstone-row? (vec-rows saved-rows))
        (map pending-place->row
             (if (sequential? pending-places) (vec pending-places) []))))

(defn row-field-patch-from-form
  [form field-errors & {:keys [draft-validation? preserve-row]}]
  (let [errors (or field-errors {})
        description (:description (ensure-position-description {:description (:description form "")}))]
    (cond-> {:locality (:locality form)
             :description description}
      (or (not (row-source-set? preserve-row))
          (:url-form preserve-row))
      (assoc :source (sources/normalize-update-source (:source form)))
      (or draft-validation?
          (and (not (:name errors))
               (forms/valid-update-name? (:name form))))
      (assoc :name (str/trim (coords/form-field-value-str (:name form))))
      (and (not (:longitude errors))
           (coords/valid-longitude? (:longitude form)))
      (assoc :longitude (coords/parse-decimal (:longitude form)))
      (and (not (:latitude errors))
           (coords/valid-latitude? (:latitude form)))
      (assoc :latitude (coords/parse-decimal (:latitude form)))
      (and (not (:homepage errors))
           (forms/valid-homepage? (:homepage form)))
      (assoc :homepage (str/trim (str (:homepage form "")))))))
