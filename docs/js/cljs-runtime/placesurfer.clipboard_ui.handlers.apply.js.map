(ns placesurfer.clipboard-ui.handlers.apply
  (:require [placesurfer.clipboard-ui.handlers.google-maps :as google-maps]
            [placesurfer.clipboard-ui.handlers.hemnet :as hemnet]
            [placesurfer.clipboard-ui.pure.browser :as browser]
            [placesurfer.clipboard-ui.pure.payload :as payload]
            [placesurfer.pin-ui.interface.handlers.editor :as editor]
            [placesurfer.pin-ui.interface.handlers.rows :as pin-rows]))

(defn apply-hemnet-payload!
  [& args]
  (apply hemnet/apply-payload! args))

(defn apply-google-place-payload!
  [& args]
  (apply google-maps/apply-payload! args))

(defn- plain-pin? [item]
  (and (map? item)
       (nil? (:type item))
       (number? (:latitude item))
       (number? (:longitude item))))

(defn- apply-pin-list-payload!
  "Process a placesurfer/pin-list payload."
  [payload]
  (let [all-pins (:pins payload [])
        groups   (:groups payload [])
        pins     (filterv plain-pin? all-pins)
        bookmarklet-items (filterv #(and (map? %) (some? (:type %))) all-pins)]
    (when (or (seq pins) (seq groups))
      (when-let [first-id (pin-rows/import-pin-items! {:pins pins :groups groups})]
        (editor/load-pin-into-inline-editor! first-id))
      (browser/clear-clipboard!))
    (doseq [pin bookmarklet-items]
      (cond
        (payload/hemnet-bookmarklet-payload? pin) (apply-hemnet-payload! pin)
        (payload/place-bookmarklet-payload? pin)  (apply-google-place-payload! pin)))
    (boolean (or (seq all-pins) (seq groups)))))

(defn apply-place-payload!
  "Apply supported bookmarklet payload to the pin editor."
  [payload]
  (cond
    (payload/pin-list-payload? payload)
    (apply-pin-list-payload! payload)

    (payload/hemnet-bookmarklet-payload? payload)
    (apply-hemnet-payload! payload)

    (payload/place-bookmarklet-payload? payload)
    (apply-google-place-payload! payload)

    :else false))
