(ns placesurfer.clipboard-ui.handlers.apply
  (:require [placesurfer.app-ui.interface.state :as app-state]
            [placesurfer.clipboard-ui.handlers.google-maps :as google-maps]
            [placesurfer.clipboard-ui.handlers.hemnet :as hemnet]
            [placesurfer.clipboard-ui.hemnet.search-results :as hemnet-search-results]
            [placesurfer.clipboard-ui.pure.browser :as browser]
            [placesurfer.clipboard-ui.pure.payload :as payload]
            [placesurfer.i18n.interface :as i18n]
            [placesurfer.nav-ui.interface.toast :as nav-ui.toast]
            [placesurfer.pin-ui.interface.handlers.editor :as editor]
            [placesurfer.pin-ui.interface.handlers.hemnet-search :as pin-hemnet-search]
            [placesurfer.pin-ui.interface.handlers.rows :as pin-rows]))

(defn apply-hemnet-payload!
  [& args]
  (apply hemnet/apply-payload! args))

(defn- apply-hemnet-search-results-payload!
  "Process a placesurfer/hemnet-search-results payload: normalize each item
   and merge them into the ephemeral, non-persisted search-results list shown
   on the pin page - never touches :pin-items."
  [payload]
  (let [locale (:locale @app-state/!state :en)
        results (hemnet-search-results/payload->results payload locale)]
    (when (seq results)
      (let [{:keys [total visible]} (pin-hemnet-search/upsert-results! results)]
        (browser/clear-clipboard!)
        (nav-ui.toast/show!
         (if (< visible total)
           (i18n/t locale :pin/search-results-imported-partial {:count visible :total total})
           (i18n/t locale :pin/search-results-imported-count {:count visible}))
         {:kind :success})))
    (boolean (seq results))))

(defn apply-google-place-payload!
  [& args]
  (apply google-maps/apply-payload! args))

(defn- plain-pin? [item]
  (and (map? item)
       (nil? (:type item))
       (number? (:latitude item))
       (number? (:longitude item))))

(defn- apply-pin-list-payload!
  "Process a placesurfer/pin-list payload."
  [payload]
  (let [all-pins (:pins payload [])
        pins     (filterv plain-pin? all-pins)
        bookmarklet-items (filterv #(and (map? %) (some? (:type %))) all-pins)]
    (when (seq pins)
      (when-let [first-id (pin-rows/import-pin-items! {:pins pins})]
        (editor/load-pin-into-inline-editor! first-id))
      (browser/clear-clipboard!))
    (doseq [pin bookmarklet-items]
      (cond
        (payload/hemnet-bookmarklet-payload? pin) (apply-hemnet-payload! pin)
        (payload/place-bookmarklet-payload? pin)  (apply-google-place-payload! pin)))
    (boolean (seq all-pins))))

(defn apply-place-payload!
  "Apply supported bookmarklet payload to the pin editor."
  [payload]
  (cond
    (payload/hemnet-search-results-payload? payload)
    (apply-hemnet-search-results-payload! payload)

    (payload/pin-list-payload? payload)
    (apply-pin-list-payload! payload)

    (payload/hemnet-bookmarklet-payload? payload)
    (apply-hemnet-payload! payload)

    (payload/place-bookmarklet-payload? payload)
    (apply-google-place-payload! payload)

    :else false))
