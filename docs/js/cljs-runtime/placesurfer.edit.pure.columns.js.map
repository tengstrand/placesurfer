(ns placesurfer.edit.pure.columns
  (:require [clojure.string :as str]))

(defn- data-column-label
  [k t]
  (case k
    :name (t :common/name)
    :address (t :common/location)
    :location (t :common/location)
    :homepage (t :common/homepage)
    :longitude (t :common/longitude)
    :latitude (t :common/latitude)
    :description (t :common/description)
    (str/capitalize (name k))))

(defn column-label
  ([k] (column-label k nil))
  ([k t]
   (case k
     :action-icon ""
     :source-icon (if t (t :update/column-source) "Source")
     :meters (if t (t :update/column-meters) "Meters")
     (if t
       (data-column-label k t)
       (str/capitalize (name k))))))
