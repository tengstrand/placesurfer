(ns placesurfer.edit.pure.poi-panel
  (:require [placesurfer.pin-ui.interface.drag :as drag]
            [placesurfer.pin-ui.interface.search :as search]))

(defn- unit-options [t]
  [{:value :kilometer :label (t :poi/unit-kilometer)}
   {:value :yard      :label (t :poi/unit-yard)}])

(defn- unit-select [{:keys [poi-unit set-poi-unit! t]}]
  [:div.poi-control-row
   [:label.poi-control-label {:for "poi-unit"} (t :poi/unit)]
   [:select.poi-control-select
    {:id "poi-unit"
     :value (name (or poi-unit :kilometer))
     :on {:change (fn [e] (set-poi-unit! (keyword (.. e -target -value))))}}
    (for [{:keys [value label]} (unit-options t)]
      ^{:key (name value)}
      [:option {:value (name value)} label])]])

(defn- pin-select [{:keys [poi-pin-items poi-pin-id set-poi-pin-id! t]}]
  [:div.poi-control-row
   [:label.poi-control-label {:for "poi-pin"} (t :poi/interest-point)]
   (if (seq poi-pin-items)
     [:select.poi-control-select
      {:id "poi-pin"
       :value (or poi-pin-id "")
       :on {:change (fn [e] (set-poi-pin-id! (.. e -target -value)))}}
      [:option {:value ""} "—"]
      (for [{:keys [id name]} poi-pin-items]
        ^{:key id}
        [:option {:value id} name])]
     [:span.poi-control-empty (t :poi/no-pin)])])

(defn- circle-row [{:keys [id radius selected? t
                            select-poi-circle! start-poi-circle-edit! delete-poi-circle!]}]
  [:div
   {:data-pin-row-id id
    :class (str "group-row update-row update-row--draggable"
                (when selected? " update-row--selected"))
    :on {:click (fn [_] (select-poi-circle! id))}}
   [:button.group-row-edit-btn
    {:type "button"
     :title (t :pin/edit-title)
     :aria-label (t :pin/edit-title)
     :on {:click (fn [e]
                   (.stopPropagation e)
                   (start-poi-circle-edit! id))}}
    [:img {:src "/images/edit.png" :alt (t :pin/edit-alt)}]]
   [:span.group-row-label radius]
   [:button.group-row-delete
    {:type "button"
     :title (t :pin/separator-delete)
     :aria-label (t :pin/separator-delete)
     :on {:click (fn [e]
                   (.stopPropagation e)
                   (delete-poi-circle! id))}}
    [:img {:src "/images/trash.png" :alt ""}]]])

(defn panel
  [{:keys [poi-unit poi-pin-id poi-circles poi-selected-id poi-draft-radius poi-editing?
           poi-submit-enabled?
           poi-pin-items
           set-poi-unit! set-poi-pin-id! select-poi-circle!
           set-poi-draft-radius! submit-poi-draft!
           start-poi-circle-edit! delete-poi-circle! reorder-poi-circle!
           t]
    :or {t (fn [k] (name k))}}]
  [:div.poi-panel
   [:div.poi-controls
    (unit-select {:poi-unit poi-unit :set-poi-unit! set-poi-unit! :t t})
    (pin-select {:poi-pin-items poi-pin-items :poi-pin-id poi-pin-id
                 :set-poi-pin-id! set-poi-pin-id! :t t})]
   [:div.update-table-wrap
    [:div.group-list
     {:replicant/on-render (fn [{:keys [replicant/node]}]
                             (when (and node reorder-poi-circle!)
                               (drag/ensure-pin-row-drag! node reorder-poi-circle!
                                                          {:drag-from-whole-row? true})))}
     (if (seq poi-circles)
       (for [{:keys [id radius]} poi-circles]
         ^{:key id}
         (circle-row {:id id
                      :radius radius
                      :selected? (= id poi-selected-id)
                      :t t
                      :select-poi-circle! select-poi-circle!
                      :start-poi-circle-edit! start-poi-circle-edit!
                      :delete-poi-circle! delete-poi-circle!}))
       [:p.group-list-empty (t :poi/empty)])]
    [:div.group-draft-row
     [:input.group-draft-input
      {:id "poi-draft-input"
       :type "number"
       :min "0"
       :step "any"
       :placeholder (t :poi/radius-placeholder)
       :value (or poi-draft-radius "")
       :on {:input (fn [e] (set-poi-draft-radius! (.. e -target -value)))
            :keydown (fn [e]
                       (when (and poi-submit-enabled? (search/enter-key? e))
                         (.preventDefault e)
                         (submit-poi-draft!)))}}]
     [:button.group-draft-submit-btn
      {:type "button"
       :disabled (not poi-submit-enabled?)
       :on {:click (fn [_] (submit-poi-draft!))}}
      (if poi-editing?
        (t :pin/separator-ok)
        (t :poi/add))]]]])
