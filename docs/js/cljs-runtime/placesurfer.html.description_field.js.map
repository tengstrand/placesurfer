(ns placesurfer.html.description-field
  (:require [clojure.string :as str]
            [placesurfer.html.description :as description]))

(defonce !synced-tokens (atom {}))

(def ^:private listener-data-prop "__placesurferDescriptionListeners")
(def ^:private set-description-prop "__placesurferSetDescription")

(defn- refresh-set-description! [node set-description!]
  (when node
    (aset node set-description-prop set-description!)))

(defn- current-set-description! [node]
  (when node (aget node set-description-prop)))

(defn- editor-root-node [field-id]
  (.getElementById js/document field-id))

(defn- coerce-text [v]
  (cond
    (string? v) v
    (nil? v) ""
    :else (str v)))

(defn- html-mode? [mode]
  (= mode :html))

(defn- display-html [canonical]
  (description/description-for-text-display (coerce-text canonical)))

(defn editor-contains-focus?
  "True when browser focus is on the contenteditable root or a descendant."
  [node]
  (when node
    (let [active (.-activeElement js/document)]
      (or (= active node)
          (and active (.contains node active))))))

(defn- sync-rich-editor! [node field-id description sync-token trace-description!]
  (when (and node (not (editor-contains-focus? node)))
    (let [prev (get @!synced-tokens field-id)]
      (when (not= prev sync-token)
        (when trace-description!
          (trace-description! :sync-rich-reset nil))
        (set! (.-innerHTML node) (display-html description))
        (swap! !synced-tokens assoc field-id sync-token)))))

(defn- apply-display-to-node! [node canonical]
  (when node
    (set! (.-innerHTML node) (display-html canonical))))

(defn- sync-from-node!
  [node set-description! & {:keys [refresh-display?] :or {refresh-display? false}}]
  (when node
    (let [canonical (description/description-from-text-editor (.-innerHTML node))]
      (set-description! canonical)
      (when refresh-display?
        (apply-display-to-node! node canonical)))))

(defn- insert-plain-text! [node text]
  (when (and node (not (str/blank? text)))
    (if (and js/document (.queryCommandSupported js/document "insertText"))
      (.execCommand js/document "insertText" false text)
      (set! (.-textContent node) (str (.-textContent node) text)))))

(defn- paste-input! [root set-description! e]
  (.preventDefault e)
  (let [target (.-target e)
        text (.. e -clipboardData (getData "text/plain"))]
    (insert-plain-text! target text)
    (sync-from-node! root set-description! :refresh-display? true)))

(defn- blur-sync! [node set-description!]
  (when node
    (sync-from-node! node set-description! :refresh-display? true)))

(defn- focusout-sync! [root set-description! e]
  (when root
    (let [related (.-relatedTarget e)]
      (when-not (and related (.contains root related))
        (blur-sync! root set-description!)))))

(defn- sync-root!
  [field-id set-description! & {:keys [refresh-display?] :or {refresh-display? false}}]
  (when-let [node (editor-root-node field-id)]
    (sync-from-node! node set-description! :refresh-display? refresh-display?)))

(defn read-editor-canonical
  "Read canonical description from a textarea or contenteditable editor node."
  [node]
  (if (= (.-tagName node) "TEXTAREA")
    (-> (.-value node)
        description/strip-place-external-links-suffix
        description/plain-text->description)
    (description/description-from-text-editor (.-innerHTML node))))

(defn flush-editor!
  "Sync description from a DOM editor node into app state via set-description!."
  [field-id set-description!]
  (when-let [node (.getElementById js/document field-id)]
    (set-description! (read-editor-canonical node))))

(defn- unmount-rich-editor-listeners! [node]
  (when-let [handlers (aget node listener-data-prop)]
    (.removeEventListener node "input" (aget handlers "input") true)
    (.removeEventListener node "focusout" (aget handlers "focusout"))
    (.removeEventListener node "compositionend" (aget handlers "compositionend"))
    (.removeEventListener node "paste" (aget handlers "paste"))
    (js-delete node listener-data-prop)))

(defn- mount-rich-editor-listeners! [node field-id set-description! flush-description! trace-description!]
  (refresh-set-description! node set-description!)
  (when-not (aget node listener-data-prop)
    (let [dom-sync! (fn [event & {:keys [refresh-display?] :or {refresh-display? false}}]
                      (when trace-description!
                        (trace-description! event nil))
                      (if flush-description!
                        (flush-description!)
                        (when-let [root (editor-root-node field-id)]
                          (sync-from-node! root set-description!
                                           :refresh-display? refresh-display?))))
          input-handler (fn [_] (dom-sync! :native-input))
          focusout-handler (fn [e]
                             (when-let [root (editor-root-node field-id)]
                               (when-let [set-description!* (current-set-description! root)]
                                 (when trace-description!
                                   (trace-description! :focusout nil))
                                 (if flush-description!
                                   (flush-description!)
                                   (focusout-sync! root set-description!* e)))))
          composition-handler (fn [_] (dom-sync! :compositionend))
          paste-handler (fn [e]
                          (when-let [root (editor-root-node field-id)]
                            (when-let [set-description!* (current-set-description! root)]
                              (when trace-description!
                                (trace-description! :paste nil))
                              (paste-input! root set-description!* e)
                              (when flush-description!
                                (flush-description!)))))]
      (.addEventListener node "input" input-handler true)
      (.addEventListener node "focusout" focusout-handler)
      (.addEventListener node "compositionend" composition-handler)
      (.addEventListener node "paste" paste-handler)
      (aset node listener-data-prop
            #js {:input input-handler
                 :focusout focusout-handler
                 :compositionend composition-handler
                 :paste paste-handler}))))

(defn- rich-editor-dom-handlers [field-id set-description! flush-description! trace-description!]
  (when-not flush-description!
    (let [dom-sync! (fn [event]
                      (when trace-description!
                        (trace-description! event nil))
                      (sync-root! field-id set-description!))]
      {:input (fn [_] (dom-sync! :replicant-input))
       :focusout (fn [e]
                   (when trace-description!
                     (trace-description! :replicant-focusout nil))
                   (when-let [root (editor-root-node field-id)]
                     (focusout-sync! root set-description! e)))})))

(defn- handle-toggle! [field-id mode set-description! toggle-mode!]
  (when-not (html-mode? mode)
    (when-let [el (.getElementById js/document field-id)]
      (sync-from-node! el set-description!)))
  (toggle-mode!))

(defn- mode-toggle-btn [html-mode? t handle-toggle!]
  [:button.update-description-mode-btn
   {:type "button"
    :class (when html-mode? "update-description-mode-btn--active")
    :aria-pressed (str html-mode?)
    :aria-label (t :description/toggle-aria)
    :title (if html-mode? (t :description/to-text) (t :description/to-html))
    :on {:mousedown (fn [e]
                      (.preventDefault e)
                      (handle-toggle!))}}
   [:img {:src "/images/html.png" :alt "" :draggable false}]])

(defn- grammarly-disabled-attrs []
  {:spellCheck false
   :data-gramm "false"
   :data-gramm_editor "false"
   :data-enable-grammarly "false"})

(defn description-field
  [{:keys [id description mode set-description! toggle-mode! sync-token
           flush-description! trace-description!
           label-for aria-label-for t]
    :or {sync-token 0
         t (fn [k] (name k))}}]
  (let [description* (coerce-text description)
        html-mode? (html-mode? mode)
        label-for* (or label-for (t :common/description))
        toggle! #(handle-toggle! id mode set-description! toggle-mode!)
        sync-rich! (fn [{:keys [replicant/node]}]
                     (when (and node (not html-mode?))
                       (sync-rich-editor! node id description* sync-token trace-description!)))
        mount-rich! (fn [{:keys [replicant/node]}]
                      (when node
                        (mount-rich-editor-listeners! node id set-description!
                                                      flush-description! trace-description!)))
        unmount-rich! (fn [{:keys [replicant/node]}]
                        (when node
                          (unmount-rich-editor-listeners! node)))
        update-rich! (fn [{:keys [replicant/node]}]
                       (when (and node (not html-mode?))
                         (refresh-set-description! node set-description!)
                         (sync-rich-editor! node id description* sync-token trace-description!)))
        rich-dom-handlers (rich-editor-dom-handlers id set-description!
                                                    flush-description! trace-description!)
        rich-on (or rich-dom-handlers {})]
    [:div.update-field-row.update-description-row
     [:label.update-label {:for id} label-for*]
     [:div.update-field-control.update-description-control
      (if html-mode?
        [:textarea.update-input
         (merge {:id id
                 :rows 3
                 :value description*
                 :autoComplete "off"
                 :on {:input (fn [e] (set-description! (.. e -target -value)))}}
                (grammarly-disabled-attrs))]
        [:div.update-input.update-description-rich
         (merge {:id id
                 :contentEditable true
                 :role "textbox"
                 :aria-multiline true
                 :tabIndex 0
                 :autoComplete "off"
                 :on rich-on
                 :replicant/on-mount mount-rich!
                 :replicant/on-unmount unmount-rich!
                 :replicant/on-update update-rich!
                 :replicant/on-render sync-rich!}
                (grammarly-disabled-attrs))])
      (mode-toggle-btn html-mode? t toggle!)]]))
