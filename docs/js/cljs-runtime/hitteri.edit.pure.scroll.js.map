(ns hitteri.edit.pure.scroll)

(defonce ^:private last-scroll-token (atom nil))
(defonce ^:private preserved-scroll-pos (atom nil))

(defn- scroll-pos [^js node]
  #js {:top (.-scrollTop node)
       :left (.-scrollLeft node)})

(defn mount-table-scroll-preservation! [^js node]
  (when node
    (.addEventListener
     node "scroll"
     (fn [_]
       (reset! preserved-scroll-pos (scroll-pos node)))
     #js {:passive true})
    (reset! preserved-scroll-pos (scroll-pos node))))

(defn sync-table-wrap-scroll!
  "Scroll to top when the scroll token changes; otherwise restore last position."
  [^js node token]
  (when node
    (if (and (some? token) (not= token @last-scroll-token))
      (do (reset! last-scroll-token token)
          (reset! preserved-scroll-pos nil)
          (set! (.-scrollTop node) 0)
          (set! (.-scrollLeft node) 0))
      (when-let [pos @preserved-scroll-pos]
        (set! (.-scrollTop node) (.-top pos))
        (set! (.-scrollLeft node) (.-left pos))))))
