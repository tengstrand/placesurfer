(ns hitteri.edit.handlers.description-trace
  (:require [clojure.string :as str]
            [hitteri.app-ui.interface.state :as state]
            [hitteri.edit.interface.model :as edit-ui.model]
            [hitteri.edit.interface.rows :as edit-ui.rows]
            [hitteri.html.interface.description-field :as description-field]))

(def ^:private trace-storage-key "hitteri.trace-description")
(def ^:private listener-data-prop "__hitteriDescriptionListeners")
(def ^:private max-trace-entries 30)

(defonce !trace-buffer (atom []))

(defn enabled? []
  (try
    (= "1" (.getItem js/localStorage trace-storage-key))
    (catch :default _ false)))

(defn- main-js-version []
  (try
    (some-> (.querySelector js/document "script[src*=\"js/main.js\"]")
            (.-src)
            (str/split #"v=")
            second)
    (catch :default _ nil)))

(defn- selected-row [s]
  (when-let [row-id (:update-selected-row-id s)]
    (some #(when (= (:row-id %) row-id) %) (:update-rows s))))

(defn- snapshot [event & [{:keys [form-description-before extra]}]]
  (let [s @state/!state
        el (when js/document (.getElementById js/document "update-description"))
        row (selected-row s)
        disk-baseline (:update-disk-baseline s)]
    (cond-> {:event (if (keyword? event) (name event) (str event))
             :ts (.now js/Date)
             :domCanonical (when el (description-field/read-editor-canonical el))
             :formDescription (:description (:update-form s))
             :formDescriptionBefore form-description-before
             :baselineDescription (get-in s [:update-row-baseline :description])
             :rowDescription (:description row)
             :rowDiffers (boolean (and row
                                       (edit-ui.rows/row-differs-from-disk-baseline?
                                        row disk-baseline)))
             :editedCount (:edited (edit-ui.model/dataset-change-counts s))
             :listenersMounted (boolean (and el (aget el listener-data-prop)))
             :editorFocused (boolean (and el (description-field/editor-contains-focus? el)))
             :mainJsVersion (main-js-version)
             :selectedRowId (:update-selected-row-id s)}
      extra (merge extra))))

(defn trace!
  [event & [opts]]
  (when (enabled?)
    (swap! !trace-buffer
           (fn [buf]
             (let [entry (apply snapshot event opts)
                   next (conj (vec buf) entry)]
               (if (<= (count next) max-trace-entries)
                 next
                 (subvec next (- max-trace-entries))))))))

(defn trace-buffer []
  @!trace-buffer)

(defn clear-trace! []
  (reset! !trace-buffer []))

(defn diagnostics [s]
  (let [el (when js/document (.getElementById js/document "update-description"))
        row (selected-row s)
        disk-baseline (:update-disk-baseline s)]
    {:descriptionTrace (vec @!trace-buffer)
     :updateEditedCount (:edited (edit-ui.model/dataset-change-counts s))
     :updateRowDescription (:description row)
     :updateDescriptionDiffersFromDisk
     (boolean (and row
                   (edit-ui.rows/row-differs-from-disk-baseline? row disk-baseline)))
     :descriptionListenersMounted (boolean (and el (aget el listener-data-prop)))
     :descriptionDomCanonical (when el (description-field/read-editor-canonical el))
     :descriptionTraceEnabled (enabled?)}))
