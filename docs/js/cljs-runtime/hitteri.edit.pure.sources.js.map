(ns hitteri.edit.pure.sources
  (:require [clojure.string :as str]))

(defn normalize-update-source
  [source]
  (cond
    (keyword? source) source
    (symbol? source) (keyword source)
    (string? source) (let [trimmed (str/trim source)]
                       (if (seq trimmed)
                         (keyword trimmed)
                         :manual))
    (number? source) :manual
    :else :manual))

(defn source-name-for-save
  "Serialize :source for API payloads; never throws on empty/invalid values."
  [source]
  (name (normalize-update-source source)))

(defn keyword-name-safe
  "Like clojure.core/name but accepts keywords, symbols, and strings."
  [x]
  (cond
    (keyword? x) (name x)
    (symbol? x) (name x)
    (string? x) x
    (some? x) (str x)
    :else nil))

(defn coerce-form-text
  [v]
  (cond
    (string? v) v
    (nil? v) ""
    :else (str v)))
