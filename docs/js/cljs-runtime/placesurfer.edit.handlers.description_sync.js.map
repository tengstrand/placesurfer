(ns placesurfer.edit.handlers.description-sync
  (:require [clojure.string :as str]
            [placesurfer.app-ui.interface.effects :as effects]
            [placesurfer.app-ui.interface.state :as state]
            [placesurfer.edit.handlers.description-trace :as description-trace]
            [placesurfer.edit.handlers.rows :as update-rows]
            [placesurfer.html.interface.description :as html-description]
            [placesurfer.html.interface.description-field :as description-field]))

(defn- dom-available? []
  (try
    (boolean (and js/document (.-getElementById js/document)))
    (catch :default _ false)))

(defn- description-baseline-canonical [s]
  (html-description/description-for-text-display
   (str/trim (str (get-in s [:update-row-baseline :description] "")))))

(defn description-editor-differs-from-baseline? [s]
  (when (and (dom-available?)
             (= :update (:page s))
             (some? (:update-selected-row-id s)))
    (when-let [el (.getElementById js/document "update-description")]
      (not= (description-field/read-editor-canonical el)
            (description-baseline-canonical s)))))

(defn flush-update-description-from-dom! []
  "Read the live description editor DOM node into app state (contenteditable may lag blur)."
  (when (and (dom-available?)
             (= :update (:page @state/!state))
             (some? (:update-selected-row-id @state/!state)))
    (when-let [el (.getElementById js/document "update-description")]
      (description-trace/trace! :flush)
      (state/clear-update-status!)
      (let [canonical (description-field/read-editor-canonical el)]
        (swap! state/!state
               (fn [s]
                 (let [form (assoc-in (:update-form s) [:description] canonical)
                       s (-> s
                             (assoc :update-form form)
                             (update-rows/select-or-create-empty-draft-state))
                       errors (update-rows/compute-update-form-field-errors-for-state s)
                       s (assoc s :update-form-field-errors errors)]
                   (update-rows/sync-form-into-selected-row s))))
        (effects/render!)))))
