(ns placesurfer.web-app.dropbox
  (:require [placesurfer.app-ui.interface.state :as state]
            [placesurfer.browser-storage.interface :as storage]
            [placesurfer.dropbox.interface :as dropbox]
            [placesurfer.i18n.interface :as i18n]
            [placesurfer.nav-ui.interface.toast :as nav-ui.toast]
            [placesurfer.pin-ui.interface.storage :as pin-storage]
            [placesurfer.web-app.effects :as effects]))

(defn sync-state!
  "Reflects the dropbox component's own truth (localStorage) onto the UI state atom."
  []
  (swap! state/!state assoc
         :dropbox-configured? (dropbox/configured?)
         :dropbox-connected? (dropbox/connected?)
         :dropbox-account-email (dropbox/account-email))
  (effects/render!))

(defn- show-sync-error! [err]
  (js/console.error "Dropbox sync error" err)
  (nav-ui.toast/show! (i18n/t (:locale @state/!state :en) :settings/dropbox-error))
  (swap! state/!state assoc :dropbox-sync-error true)
  (effects/render!))

(defn init!
  "Wires the dropbox component's background-push-failure hook to a user-facing toast,
   and registers what actually gets synced - one Dropbox file per data type - since the
   dropbox component itself stays fully agnostic of prefs/pins (see register-sync-doc!)."
  []
  (dropbox/set-on-push-error! show-sync-error!)
  (dropbox/register-sync-doc!
   :prefs
   {:remote-path "/prefs.edn"
    :read (fn []
            {:active-topics (vec (storage/read-active-topics (constantly #{})))
             :country-slug (storage/read-country-slug)
             :page (storage/read-saved-page)
             :transit-destination (:transit-destination (i18n/read-settings!) "")})
    :write (fn [data]
             ;; EDN round-trips keywords natively, unlike JSON - no name/keyword conversion needed.
             (when (seq (:active-topics data))
               (storage/save-active-topics! (set (:active-topics data))))
             (when (seq (:country-slug data))
               (storage/save-country-slug! (:country-slug data)))
             (when (:page data)
               (storage/save-page! (:page data)))
             (when (:transit-destination data)
               (i18n/save-settings!
                (assoc (i18n/read-settings!) :transit-destination (:transit-destination data)))
               (swap! state/!state assoc :transit-destination (:transit-destination data))))})
  (dropbox/register-sync-doc!
   :pins
   {:remote-path "/pins.edn"
    :read pin-storage/read-pins!
    :write (fn [pins] (when (seq pins) (pin-storage/save-pins! pins)))})
  (dropbox/register-sync-doc!
   :search
   {:remote-path "/search.edn"
    :read pin-storage/read-search-results!
    ;; Unlike :pins above, this has no (when (seq ...)) guard: an empty list
    ;; is a legitimate synced value (the user clicked "Rensa"), and a pulling
    ;; client must apply that empty list rather than ignore it.
    :write pin-storage/save-search-results!}))

(defn connect! []
  (swap! state/!state assoc :dropbox-sync-error nil)
  (-> (dropbox/begin-connect!)
      (.catch (fn [err]
                (js/console.error "Dropbox connect error" err)
                (swap! state/!state assoc :dropbox-sync-error true)
                (effects/render!)))))

(defn disconnect! []
  (-> (dropbox/disconnect!)
      (.then (fn [_] (sync-state!)))))
