(ns hitteri.pin-ui.pure.separator-row)

(defn content [label]
  [:div.pin-separator-content
   [:span.pin-separator-label label]])

(defn table-row
  [{:keys [id values column-count show-drag-handle? drag-from-whole-row?]
    :or {show-drag-handle? true drag-from-whole-row? false}}]
  [:tr.pin-separator-row.update-row
   {:data-pin-row-id id
    :class (when drag-from-whole-row? "update-row--draggable")}
   [:td.pin-separator-cell {:colSpan (if show-drag-handle? (inc column-count) column-count)}
    (content (:label values ""))]])

(defn preview-row
  [{:keys [id values drag-from-whole-row?]}]
  [:div.pin-separator-row.pin-preview-row.update-row
   {:data-pin-row-id id
    :class (when drag-from-whole-row? "update-row--draggable")}
   (content (:label values ""))])
