(ns hitteri.edit.pure.cells
  (:require [clojure.string :as str]))

(defn display-cell-value
  [v]
  (cond
    (nil? v) ""
    (keyword? v) (name v)
    :else (str v)))

(defn source-label
  [source]
  (cond
    (keyword? source) (name source)
    (symbol? source) (name source)
    (string? source) source
    :else nil))

(defn source-icon-src
  [source]
  (when-let [source-name (some-> (source-label source) str/lower-case not-empty)]
    (str "/images/source/" source-name ".png")))

(defn row-marker-icon-src
  [values]
  (when (= :url-pin (:marker-topic values))
    "/images/edit.png"))

(defn source-cell-icon-src
  "Prefer persisted source icon; fall back to URL-draft pin icon when source is unset."
  [values]
  (or (source-icon-src (:source values))
      (row-marker-icon-src values)))

(defn source-display-name
  [source]
  (source-label source))

(defn sort-indicator
  [sort-field sort-dir column-key]
  (when (= sort-field column-key)
    (if (= sort-dir :asc) " ↑" " ↓")))

(defn table-column-header
  [key label sort-field sort-dir]
  (if (= key :action-icon)
    [:span.update-action-header-label
     [:img.update-action-header-icon
      {:src "/images/flash.png"
       :alt "Action"}]
     (sort-indicator sort-field sort-dir key)]
    (str label (or (sort-indicator sort-field sort-dir key) ""))))

(defn table-cell
  [row-id values key]
  (cond
    (= key :action-icon)
    [:td.update-action-cell
     (cond
       (= :deleted (:action values))
       [:img.update-row-action-icon
        {:src "/images/removed.png"
         :alt "deleted"}]

       (= :added (:action values))
       [:img.update-row-action-icon
        {:src "/images/added.png"
         :alt "added"}]

       (= :edited (:action values))
       [:img.update-row-action-icon
        {:src "/images/edited.png"
         :alt "edited"}]

       (:form-validation-warning? values)
       [:img.update-row-action-icon
        {:src "/images/warning.png"
         :alt "validation warning"}])]

    (= key :source-icon)
    [:td.update-source-cell
     (when-let [src (source-cell-icon-src values)]
       [:img.update-source-icon
        {:src src
         :alt (display-cell-value (or (:source values) "place"))
         :title (display-cell-value (or (:source values) "place"))}])]

    (= key :meters)
    [:td.update-meters-cell (display-cell-value (get values key))]

    :else
    [:td (display-cell-value (get values key))]))
