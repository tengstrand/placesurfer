(ns placesurfer.edit.handlers.save
  (:require [clojure.string :as str]
            [placesurfer.edit.interface.coords :as edit-ui.coords]
            [placesurfer.edit.interface.forms :as edit-ui.forms]
            [placesurfer.edit.interface.model :as edit-ui.model]
            [placesurfer.edit.interface.rows :as edit-ui.rows]
            [placesurfer.edit.interface.save :as edit-ui.save]
            [placesurfer.edit.interface.table :as edit-ui.table]
            [placesurfer.edit.interface.sources :as edit-ui.sources]
            [placesurfer.i18n.interface :as i18n]
            [placesurfer.api-client.interface :as api-client]
            [placesurfer.app-ui.interface.effects :as effects]
            [placesurfer.app-ui.interface.state :as state]
            [placesurfer.edit.handlers.map :as update-map]
            [placesurfer.edit.handlers.description-sync :as description-sync]
            [placesurfer.edit.handlers.rows :as update-rows]
            [placesurfer.edit.pure.dataset-cache :as dataset-cache]
            [placesurfer.edit.pure.topics :as edit-topics]))

(defn- topic-name-for-api [topic]
  (edit-ui.sources/keyword-name-safe topic))

(defn update-display-rows [s]
  (edit-ui.model/display-rows s))

(defn update-table-model [s]
  (edit-ui.model/table-model s
                             {:t (fn ([key] (i18n/t (:locale s :en) key))
                                   ([key params] (i18n/t (:locale s :en) key params)))}))

(defn update-dataset-preconditions-met? [s]
  (edit-ui.model/dataset-preconditions-met? s))

(defn dataset-positions-for-save [s]
  (let [country (:update-country-code s)
        rows (update-rows/merge-selected-form-into-rows s (update-rows/save-source-rows s))
        tombstones (vec (filter edit-ui.rows/row-save-as-tombstone? rows))
        unchanged-stubs (vec (filter edit-ui.rows/saved-row-unchanged-without-coords? rows))
        active (->> rows
                    (remove edit-ui.rows/row-save-as-tombstone?)
                    (remove edit-ui.rows/incomplete-manual-draft?)
                    (remove edit-ui.rows/saved-row-unchanged-without-coords?)
                    vec)]
    (->> (into (into (mapv #(edit-ui.save/row->save-position country %) active)
                     (mapv #(edit-ui.save/row->save-position country %) tombstones))
               (mapv #(edit-ui.save/row->save-position country %) unchanged-stubs))
         (keep identity)
         vec)))

(defn- disk-save-snapshot-from-state [s]
  (try
    (edit-ui.save/canonical-save-positions (dataset-positions-for-save s))
    (catch :default _
      nil)))

(defn disk-save-snapshot-from-disk-rows [country-code rows]
  (try
    (let [active (remove edit-ui.rows/row-save-as-tombstone? (update-rows/as-update-rows rows))
          deleted (filter edit-ui.rows/row-save-as-tombstone? (update-rows/as-update-rows rows))]
      (edit-ui.save/canonical-save-positions
       (into (mapv #(edit-ui.save/row->save-position country-code %) active)
             (mapv #(edit-ui.save/row->save-position country-code %) deleted))))
    (catch :default _
      nil)))

(defn update-dataset-dirty? [s]
  (let [current (disk-save-snapshot-from-state s)]
    (if-let [saved (:update-disk-save-snapshot s)]
      (not= current saved)
      (edit-ui.model/dataset-dirty? s))))

(def ^:private client-deleted-preserve-keys
  #{:name :locality :homepage :description :image :source :country-code :longitude :latitude
    :holes :layout-name :layout-holes :layout-par :layout-length-meters :region-code
    :action})

(defn- normalize-loaded-server-row [row]
  (let [row (-> row
                edit-ui.rows/ensure-position-image
                edit-ui.rows/ensure-position-description)
        action (edit-ui.rows/coerce-action-keyword (:action row))]
    (if (#{:delete :deleted} action)
      (assoc row :action :deleted)
      row)))

(defn- coords-for-post-load-row-selection [s]
  (if (:update-url-form s)
    (update-map/coords-from-update-url-form s)
    (update-map/coords-from-update-form s)))

(defn save-current-update-dataset-to-cache-if-clean!
  "Remember a clean loaded dataset for the current topic and country."
  []
  (let [s @state/!state
        topic (:update-topic s)
        country (:update-country-code s)]
    (when (and topic country (not (update-dataset-dirty? s)))
      (swap! state/!state update :update-dataset-cache
             assoc (dataset-cache/cache-key topic country)
             (dataset-cache/entry-from-state s)))))

(defn- restore-update-dataset-from-cache!
  [{:keys [clear-selection? recenter?]
    :or {clear-selection? false recenter? true}}]
  (let [s @state/!state
        topic (:update-topic s)
        country (:update-country-code s)
        entry (dataset-cache/cached-entry (:update-dataset-cache s) topic country)]
    (when entry
      (swap! state/!state
             (fn [st]
               (cond-> (assoc st
                              :update-loading? false
                              :update-error nil
                              :update-message nil
                              :update-rows (:rows entry)
                              :update-columns (:columns entry)
                              :update-disk-baseline (:disk-baseline entry)
                              :update-disk-save-snapshot (:disk-save-snapshot entry))
                 clear-selection? state/clear-update-selection-state)))
      (update-map/schedule-update-map-pin-sync! {:recenter? recenter?})
      (effects/render!)
      true)))

(defn- save-loaded-dataset-to-cache!
  []
  (let [s @state/!state
        topic (:update-topic s)
        country (:update-country-code s)]
    (when (and topic country)
      (swap! state/!state update :update-dataset-cache
             assoc (dataset-cache/cache-key topic country)
             (dataset-cache/entry-from-state s)))))

(defn commit-update-dataset-save! []
  (let [s @state/!state
        country-code (:update-country-code s)
        rows (->> (update-rows/merge-selected-form-into-rows s (update-rows/save-source-rows s))
                  (mapv #(edit-ui.rows/enrich-row-country-code % country-code)))
        snapshot (disk-save-snapshot-from-state s)
        selected-id (:update-selected-row-id s)]
    (swap! state/!state
           (fn [st]
             (let [st (assoc st
                             :update-rows rows
                             :update-pending-places []
                             :update-url-form nil
                             :update-disk-save-snapshot snapshot
                             :update-disk-baseline (edit-ui.rows/disk-baseline-from-rows
                                                     (remove edit-ui.rows/saved-delete-row? rows)))
                   row (when selected-id (update-rows/find-update-display-row st selected-id))]
               (if row
                 (assoc st :update-selected-row row)
                 st))))
    (save-current-update-dataset-to-cache-if-clean!)
    (update-map/schedule-update-map-pin-sync! {:recenter? false})))

(defn apply-update-dataset-rows!
  ([rows] (apply-update-dataset-rows! rows {}))
  ([rows {:keys [reset-client-actions? recenter?]
          :or {reset-client-actions? false recenter? true}}]
   (let [server-rows (mapv normalize-loaded-server-row rows)
         selected-id (:update-selected-row-id @state/!state)
         old-rows (update-rows/as-update-rows (:update-rows @state/!state))
         baseline-rows (remove edit-ui.rows/saved-delete-row? server-rows)
         disk-baseline (edit-ui.rows/disk-baseline-from-rows baseline-rows)
         disk-snapshot-country (:update-country-code @state/!state)
         client-actions (when-not reset-client-actions?
                          (into {}
                                (keep (fn [row]
                                        (when (#{:deleted :edited :added} (:action row))
                                          [(:row-id row) (:action row)]))
                                      old-rows)))
         client-edited-data (when-not reset-client-actions?
                              (into {}
                                    (keep (fn [row]
                                            (when (or (edit-ui.rows/row-marked-edited? row)
                                                      (edit-ui.rows/row-marked-added? row))
                                              [(:row-id row)
                                               (select-keys row [:name :locality :homepage
                                                                 :description :image :longitude
                                                                 :latitude :source :action])]))
                                          old-rows)))
         client-deleted-data (when-not reset-client-actions?
                               (into {}
                                     (keep (fn [row]
                                             (when (edit-ui.rows/row-marked-deleted? row)
                                               [(:row-id row) (select-keys row client-deleted-preserve-keys)]))
                                           old-rows)))
         enrich-country (fn [row]
                          (edit-ui.rows/enrich-row-country-code row disk-snapshot-country))
         rows (if reset-client-actions?
                (mapv enrich-country (vec server-rows))
                (mapv (fn [row]
                        (let [row-id (:row-id row)
                              file-action (edit-ui.rows/coerce-action-keyword (:action row))
                              client-action (get client-actions row-id)
                              edited-data (get client-edited-data row-id)
                              deleted-data (get client-deleted-data row-id)]
                          (let [row (-> row
                                        enrich-country
                                        (cond-> (and file-action (not (#{:delete :deleted} file-action)))
                                          (assoc :action file-action))
                                        (cond-> (and (nil? file-action) client-action)
                                          (assoc :action client-action))
                                        (cond-> edited-data (merge edited-data)))]
                            (if deleted-data
                              (merge deleted-data row)
                              row))))
                      server-rows))]
     (swap! state/!state
            (fn [s]
              (let [s (assoc s
                             :update-loading? false
                             :update-rows rows
                             :update-columns (edit-ui.table/as-update-columns
                                              (edit-ui.table/update-columns-for-rows rows))
                             :update-error nil)
                    s (if-let [row (when selected-id (update-rows/find-update-display-row s selected-id))]
                        (update-rows/select-update-row-in-state s row)
                        (if (and selected-id (nil? (update-rows/find-update-display-row s selected-id)))
                          (assoc s :update-selected-row-id nil
                                 :update-selected-row nil)
                          s))
                    s (if-let [{:keys [longitude latitude]} (coords-for-post-load-row-selection s)]
                        (let [matched (update-rows/find-display-row-in-state s longitude latitude)]
                          (cond
                            (and matched (edit-ui.rows/saved-update-row-id? (:row-id matched)))
                            (-> (update-rows/select-update-row-in-state s matched)
                                (assoc :update-pending-places []))

                            (and selected-id (some? (update-rows/find-update-display-row s selected-id)))
                            s

                            :else
                            (update-rows/select-row-for-url-coords s longitude latitude)))
                        s)]
                s)))
     (swap! state/!state
            (fn [s]
              (let [from-disk (disk-save-snapshot-from-disk-rows
                               disk-snapshot-country server-rows)
                    from-state (disk-save-snapshot-from-state s)]
                (assoc s
                       :update-disk-save-snapshot (if reset-client-actions?
                                                    (or from-state from-disk)
                                                    from-disk)
                       :update-disk-baseline disk-baseline))))
     (save-loaded-dataset-to-cache!)
     (update-map/schedule-update-map-pin-sync! {:recenter? recenter?}))))

(defn reload-update-dataset!
  ([] (reload-update-dataset! {}))
  ([opts]
   (if (edit-topics/pins-topic? (:update-topic @state/!state))
     (when-let [on-complete (:on-complete opts)]
       (on-complete))
     (let [{:keys [clear-selection? recenter? force-reload? on-complete reset-client-actions?]
            :or {clear-selection? false recenter? true force-reload? false reset-client-actions? false}}
           (if (map? opts) opts {})
           {:keys [update-topic update-country-code backend-online?]} @state/!state
           invoke-complete! (fn [] (when on-complete (on-complete)))
           can-load? (and backend-online?
                          (some? update-topic)
                          (edit-ui.model/valid-country-code? update-country-code))
           load-error (cond
                        (not backend-online?) nil
                        (not (some? update-topic)) nil
                        (not (edit-ui.model/valid-country-code? update-country-code))
                        "Select a valid country"
                        :else nil)]
       (if-not can-load?
         (do
           (swap! state/!state
                  (fn [s]
                    (assoc s
                           :update-rows []
                           :update-columns []
                           :update-loading? false
                           :update-selected-row-id nil
                           :update-selected-row nil
                           :update-disk-save-snapshot nil
                           :update-disk-baseline nil
                           :update-error load-error)))
           (effects/render!)
           (invoke-complete!))
         (if (and (not force-reload?)
                  (restore-update-dataset-from-cache!
                   {:clear-selection? clear-selection?
                    :recenter? recenter?}))
           (invoke-complete!)
           (let [request-id (swap! state/!update-load-request-id inc)]
             (swap! state/!state
                    (fn [s]
                      (cond-> (assoc s
                                     :update-loading? true
                                     :update-error nil
                                     :update-message nil)
                        clear-selection? state/clear-update-selection-state)))
             (effects/render!)
             (let [finish-load! (fn [thunk]
                                  (when (= request-id @state/!update-load-request-id)
                                    (try
                                      (thunk)
                                      (catch :default e
                                        (swap! state/!state assoc
                                               :update-loading? false
                                               :update-error (or (when (some? e) (.-message e))
                                                                   "Failed to load dataset"))))
                                    (effects/render!)
                                    (invoke-complete!)))
                   on-body (fn [resp body]
                             (finish-load!
                              (fn []
                                (if (.-ok resp)
                                  (apply-update-dataset-rows!
                                   (js->clj (aget body "rows") :keywordize-keys true)
                                   {:reset-client-actions? reset-client-actions?
                                    :recenter? recenter?})
                                  (swap! state/!state assoc
                                         :update-loading? false
                                         :update-error (or (state/update-error-text (aget body "error"))
                                                           "Failed to load dataset"))))))
                   on-error (fn [error]
                              (finish-load!
                               (fn []
                                 (swap! state/!state assoc
                                        :update-loading? false
                                        :update-error (or (.-message error) "Failed to load dataset")))))
                   p (js/fetch (api-client/dataset-url)
                               (clj->js {:method "POST"
                                         :headers {"Content-Type" "application/json"}
                                         :body (.stringify js/JSON
                                                           (clj->js {:topic (topic-name-for-api update-topic)
                                                                     :country-code update-country-code}))}))
                   p (.then p (fn [resp]
                                (.then (.json resp) (fn [body] (on-body resp body)))))]
               (.catch p on-error)))))))))

(defn discard-unsaved-dataset-changes!
  "Reload the current dataset topic from cache or server, discarding client edits."
  [on-complete]
  (reload-update-dataset!
   {:clear-selection? true
    :reset-client-actions? true
    :recenter? false
    :on-complete on-complete}))

(defn save-update-dataset!
  ([] (save-update-dataset! {}))
  ([{:keys [on-success on-failure]}]
   (description-sync/flush-update-description-from-dom!)
   (state/clear-update-status!)
   (let [s @state/!state]
     (if-not (update-dataset-preconditions-met? s)
       (do (swap! state/!state assoc :update-error
                  (cond
                    (not (:backend-online? s)) "Backend service is not running"
                    :else "Select a topic and a valid country"))
           (effects/render!)
           (when on-failure (on-failure)))
       (try
         (let [positions (dataset-positions-for-save s)
               topic (:update-topic s)
               complete-success (fn [body]
                                  (let [count (aget body "count")]
                                    (swap! state/!state
                                           (fn [st]
                                             (assoc st
                                                    :update-message (str "Saved "
                                                                           (or count (count positions))
                                                                           " places")
                                                    :update-error nil)))
                                    (commit-update-dataset-save!)
                                    (effects/load-topic-positions! topic)
                                    (effects/render!)
                                    (when on-success (on-success body))))
               complete-failure (fn [message]
                                  (swap! state/!state assoc :update-error message)
                                  (effects/render!)
                                  (when on-failure (on-failure message)))]
           (-> (js/fetch (api-client/save-dataset-url)
                         (clj->js {:method "POST"
                                   :headers {"Content-Type" "application/json"}
                                   :body (.stringify js/JSON
                                                     (clj->js {:topic (topic-name-for-api topic)
                                                               :country-code (:update-country-code s)
                                                               :positions (clj->js positions)}))}))
               (.then (fn [resp]
                        (.then (.json resp)
                               (fn [body]
                                 (if (.-ok resp)
                                   (complete-success body)
                                   (complete-failure (or (state/update-error-text (aget body "error"))
                                                           "Failed to save dataset")))))))
               (.catch (fn [error]
                         (complete-failure (or (.-message error) "Failed to save dataset"))))))
         (catch :default e
           (swap! state/!state assoc :update-error
                  (or (when (some? e) (.-message e))
                      "Cannot save dataset"))
           (effects/render!)
           (when on-failure (on-failure))))))))

(defn save-update! []
  (state/clear-update-status!)
  (let [{:keys [backend-online? update-topic update-country-code update-selected-row-id
                update-columns update-form]} @state/!state
        {:keys [name locality homepage description longitude latitude source]} update-form
        lon (edit-ui.coords/parse-decimal longitude)
        lat (edit-ui.coords/parse-decimal latitude)
        backend-row-id (when (and (some? update-selected-row-id)
                                  (edit-ui.rows/saved-update-row-id? update-selected-row-id))
                         update-selected-row-id)
        update? (some? backend-row-id)
        payload {:topic (when update-topic (topic-name-for-api update-topic))
                 :country-code update-country-code
                 :row-id backend-row-id
                 :known-columns (mapv edit-ui.sources/keyword-name-safe update-columns)
                 :entry (cond-> {:name name
                                 :locality locality
                                 :longitude lon
                                 :latitude lat
                                 :country-code update-country-code
                                 :source (or (edit-ui.sources/source-name-for-save source)
                                             (when-not update? "manual")
                                             "manual")}
                        (seq (str/trim (str homepage))) (assoc :homepage (str/trim homepage))
                        (seq (str/trim (str description))) (assoc :description (str/trim description)))}]
    (cond
      (not backend-online?)
      (do (swap! state/!state assoc :update-error "Backend service is not running")
          (effects/render!))

      (or (nil? update-topic)
          (not (edit-ui.model/valid-country-code? update-country-code))
          (not (edit-ui.forms/valid-update-form? update-form)))
      (do (swap! state/!state assoc :update-error "Topic, country, name, longitude and latitude are required")
          (effects/render!))

      :else
      (-> (js/fetch (api-client/upsert-row-url)
                    (clj->js {:method "POST"
                              :headers {"Content-Type" "application/json"}
                              :body (.stringify js/JSON (clj->js payload))}))
          (.then (fn [resp]
                   (-> (.json resp)
                       (.then (fn [body]
                                (if (.-ok resp)
                                  (do
                                    (swap! state/!state assoc
                                           :update-message (if (= (aget body "action") "updated")
                                                             "Information updated"
                                                             "Information added")
                                           :update-error nil)
                                    (reload-update-dataset! {:recenter? false
                                                             :force-reload? true}))
                                  (swap! state/!state assoc
                                         :update-error (or (state/update-error-text (aget body "error"))
                                                           "Failed to save")))
                                (effects/render!))))))
          (.catch (fn [error]
                    (swap! state/!state assoc :update-error (or (.-message error) "Failed to save"))
                    (effects/render!)))))))

