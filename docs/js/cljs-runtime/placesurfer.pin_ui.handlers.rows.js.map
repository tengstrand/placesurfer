(ns placesurfer.pin-ui.handlers.rows
  "Pin list CRUD and table state."
  (:require [placesurfer.app-ui.interface.state :as app-state]
            [placesurfer.map-ui.interface :as map-ui]
            [placesurfer.pin-ui.handlers.map :as pin-map]
            [placesurfer.pin-ui.handlers.state :as pin-state]
            [placesurfer.pin-ui.pure.forms :as forms]
            [placesurfer.pin-ui.pure.rows :as rows]
            [placesurfer.pin-ui.pure.storage :as storage]))

(defn- persist-items! [items]
  (storage/save-pins! items))

(defn- list-items-for-page [s]
  (if (= :pin (:page s))
    (rows/pin-page-list-items (:pin-items s))
    (rows/visible-list-items (or (:pin-items s) [])
                             (:countries s)
                             (rows/country-slug-for-view s))))

(defn table-rows-for-state [s]
  (rows/table-rows (vec (list-items-for-page s)) (:pin-selected-id s)))

(defn find-display-item [s id]
  (rows/find-by-id (list-items-for-page s) id))

(defn refresh-table-rows
  ([s] (refresh-table-rows s nil))
  ([s include-id]
   (let [filtered (list-items-for-page s)
         filtered (if include-id
                    (let [items (:pin-items s)]
                      (if-let [item (rows/find-by-id items include-id)]
                        (if (some #(= include-id (:id %)) filtered)
                          filtered
                          (conj (vec filtered) item))
                        filtered))
                    filtered)]
     (assoc s :pin-table-rows
            (rows/table-rows (vec filtered) (:pin-selected-id s))))))

(defn add-raw-pin-item!
  "Insert `item` directly into pin-items and select it. Used for map-position pick."
  [item]
  (let [saved (atom nil)]
    (pin-state/swap-state!
     (fn [s]
       (let [next-items (rows/upsert-item (:pin-items s) item)]
         (reset! saved next-items)
         (refresh-table-rows
          (assoc s
                 :pin-items next-items
                 :pin-selected-id (:id item))))))
    (when @saved
      (persist-items! @saved)
      (pin-state/render!))))

(defn- selectable-pin-items [s]
  (if (= :pin (:page s))
    (rows/pin-page-list-items (:pin-items s))
    (rows/visible-list-items (or (:pin-items s) [])
                             (:countries s)
                             (rows/country-slug-for-view s))))

(defn select-pin-row! [id]
  (let [s @app-state/!state
        item (rows/find-by-id (selectable-pin-items s) id)]
    (when (and item (not (rows/separator-item? item)))
      (pin-state/swap-render!
       (fn [state]
         (refresh-table-rows
          (-> state
              (assoc :pin-selected-id (:id item)
                     :pin-message nil)
              pin-state/clear-search-ui))))
      (pin-map/focus-pin-on-map! item))))

(defn select-display-row! [id]
  (let [s @app-state/!state
        item (rows/find-by-id (list-items-for-page s) id)]
    (when (and item (not (rows/separator-item? item)))
      (pin-state/swap-render!
       (fn [state]
         (refresh-table-rows
          (-> state
              (assoc :pin-selected-id id
                     :pin-message nil)
              pin-state/clear-search-ui))))
      (pin-map/focus-pin-on-map! item))))

(defn- focus-pin-search! []
  (when (js* "typeof document !== 'undefined' && document.getElementById")
    (doseq [delay-ms [0 60 140 260]]
      (js/setTimeout
       #(when-let [el (.getElementById js/document "pin-search")]
          (.focus el))
       delay-ms))))

(defn- reset-form-after-add! [state items saved-id existing?]
  (let [saved-item (rows/find-by-id items saved-id)
        next-form (if existing?
                    (forms/item->form saved-item)
                    (forms/default-form))]
    (-> state
        (assoc :pin-items items
               :pin-selected-id saved-id
               :pin-form next-form
               :pin-form-baseline next-form
               :pin-message nil)
        (pin-state/clear-search-ui)
        (refresh-table-rows saved-id))))

(defn- save-target-item [items selected-id form]
  (or (when selected-id (rows/find-by-id items selected-id))
      (when-let [probe (forms/form->item form "probe")]
        (rows/find-by-coords items (:longitude probe) (:latitude probe)))))

(defn save-enabled? [state]
  (let [form (:pin-form state)
        baseline (:pin-form-baseline state (forms/default-form))]
    (and (forms/form-valid? form)
         (forms/form-edited-from-baseline? form baseline))))

(defn- apply-save! [s form next-items item-id]
  (refresh-table-rows
   (-> s
       (assoc :pin-items next-items
              :pin-form form
              :pin-form-baseline form
              :pin-selected-id item-id
              :pin-message nil)
       (pin-state/clear-search-ui))
   item-id))

(defn save-pin!
  "Persist form edits: update matching list item or add a new one."
  []
  (let [saved (atom nil)
        saved-id (atom nil)]
    (pin-state/swap-state!
     (fn [s]
       (if-not (save-enabled? s)
         s
         (let [form (:pin-form s)
               items (:pin-items s)]
           (if-let [target (save-target-item items (:pin-selected-id s) form)]
             (if-let [updated (forms/form->item form (:id target))]
               (let [next-items (rows/upsert-item items updated)]
                 (reset! saved next-items)
                 (reset! saved-id (:id target))
                 (apply-save! s form next-items (:id target)))
               s)
             (if-let [created (forms/form->item form (storage/new-pin-id))]
               (let [next-items (rows/upsert-item items created)]
                 (reset! saved next-items)
                 (reset! saved-id (:id created))
                 (apply-save! s form next-items (:id created)))
               s))))))
    (when @saved
      (persist-items! @saved)
      (pin-state/render!)
      (when-let [item (rows/find-by-id @saved @saved-id)]
        (pin-map/focus-pin-on-map! item)))))

(defn add-pin!
  "Add the current form as a pin, or update the existing pin that
   shares the same longitude/latitude. With `:force-new? true`, always
   inserts a new pin even when coordinates match an existing one."
  ([] (add-pin! {}))
  ([{:keys [force-new?]}]
   (let [saved (atom nil)
         saved-id (atom nil)
         focus-search? (atom false)]
     (pin-state/swap-state!
      (fn [s]
        (let [form (:pin-form s)]
          (if-not (forms/form-valid? form)
            s
            (if-let [base (forms/form->item form (storage/new-pin-id))]
              (let [items (:pin-items s)
                    existing (when-not force-new?
                               (rows/find-by-coords items (:longitude base) (:latitude base)))
                    item (cond-> base existing (assoc :id (:id existing)))
                    next-items (rows/upsert-item items item)]
                (reset! saved next-items)
                (reset! saved-id (:id item))
                (reset! focus-search? (and (nil? existing) (not force-new?)))
                (reset-form-after-add! s next-items (:id item) (some? existing)))
              s)))))
     (when @saved
       (persist-items! @saved)
       (pin-state/render!)
       (when-let [item (rows/find-by-id @saved @saved-id)]
         (pin-map/focus-pin-on-map! item))
       (when (and @focus-search? (:pin-editor-open? @app-state/!state))
         (focus-pin-search!))))))

(defn import-pin-items!
  "Add groups and pins that don't already exist. Groups deduped by label,
   pins deduped by longitude/latitude. Order preserved: ungrouped pins first,
   then each group (in groups order) with its pins. Returns id of first imported pin, or nil."
  [{:keys [pins groups]}]
  (let [saved (atom nil)
        first-new-id (atom nil)]
    (pin-state/swap-state!
     (fn [s]
       (let [current (:pin-items s [])
             sep? #(= :separator (:kind %))
             existing-labels (into #{}
                                   (comp (filter sep?)
                                         (map #(.toLowerCase (str (:label % "")))))
                                   current)
             existing-coords (into #{}
                                   (comp (remove sep?)
                                         (keep #(when (and (number? (:longitude %))
                                                           (number? (:latitude %)))
                                                  [(:longitude %) (:latitude %)])))
                                   current)
             pins-by-group (group-by :group (or pins []))
             ungrouped (get pins-by-group nil [])
             ordered-items (concat
                            ungrouped
                            (mapcat (fn [{:keys [label]}]
                                      (cons {:kind "separator" :label label}
                                            (get pins-by-group label [])))
                                    (or groups [])))
             [next-items _ _]
             (reduce (fn [[acc seen-labels seen-coords] item]
                       (let [kind (:kind item)]
                         (cond
                           (or (= kind :separator) (= kind "separator"))
                           (let [label (.trim (str (:label item "")))
                                 lc (.toLowerCase label)]
                             (if (or (= "" label) (seen-labels lc))
                               [acc seen-labels seen-coords]
                               [(conj acc {:id (storage/new-pin-id) :kind :separator :label label})
                                (conj seen-labels lc)
                                seen-coords]))

                           (and (number? (:latitude item)) (number? (:longitude item)))
                           (let [coord [(:longitude item) (:latitude item)]]
                             (if (seen-coords coord)
                               [acc seen-labels seen-coords]
                               (let [new-pin (forms/form->item (forms/item->form item) (storage/new-pin-id))]
                                 (when (and (nil? @first-new-id) new-pin)
                                   (reset! first-new-id (:id new-pin)))
                                 [(if new-pin (conj acc new-pin) acc)
                                  seen-labels
                                  (conj seen-coords coord)])))

                           :else [acc seen-labels seen-coords])))
                     [current existing-labels existing-coords]
                     ordered-items)]
         (reset! saved next-items)
         (-> s
             (assoc :pin-items next-items)
             (cond-> @first-new-id
               (assoc :pin-selected-id @first-new-id :pin-message nil))
             pin-state/clear-search-ui
             (refresh-table-rows @first-new-id)))))
    (when @saved
      (persist-items! @saved)
      (pin-state/render!)
      (when-let [fid @first-new-id]
        (when-let [item (rows/find-by-id @saved fid)]
          (pin-map/focus-pin-on-map! item))))
    @first-new-id))

(defn delete-enabled? [state]
  (boolean
   (when-let [id (:pin-selected-id state)]
     (some #(= id (:id %)) (:pin-items state [])))))

(defn delete-selected-pin! []
  (let [s @app-state/!state
        id (:pin-selected-id s)]
    (when (delete-enabled? s)
      (let [table-rows (:pin-table-rows s)
            next-id (rows/selection-id-after-delete table-rows id)
            items (atom nil)]
        (pin-state/swap-state!
         (fn [state]
           (let [next-items (rows/remove-item (:pin-items state) id)]
             (reset! items next-items)
             (refresh-table-rows
              (-> state
                  (assoc :pin-items next-items
                         :pin-selected-id next-id
                         :pin-form (forms/default-form)
                         :pin-form-baseline (forms/default-form)
                         :pin-message nil
                         :pin-editor-open? false
                         :pin-editor-mode nil
                         :pin-editor-snapshot nil
                         :pin-separator-overlay-open? false
                         :pin-separator-overlay-rows []
                         :pin-separator-overlay-selected-id nil
                         :pin-separator-overlay-snapshot nil
                         :pin-table-keyboard-focus? true)
                  (pin-state/clear-search-ui))))))
        (when @items
          (persist-items! @items)
          (pin-state/render!)
          (when (= :pin (:page @app-state/!state))
            (map-ui/close-all-popups!))
          (pin-map/schedule-pin-map-sync! {:recenter? false})
          (when next-id
            (when-let [item (rows/find-by-id (list-items-for-page @app-state/!state) next-id)]
              (pin-map/focus-pin-on-map! item))))))))

(defn refresh-pin-table! []
  (pin-state/swap-render! refresh-table-rows))

(defn pin-page-table-rows [s]
  (table-rows-for-state (assoc s :page :pin)))

(defn reorder-pin-row!
  "Move a visible pin row to `to-index` and select it."
  [drag-id to-index]
  (let [s @app-state/!state
        drag-item (rows/find-by-id (:pin-items s) drag-id)]
    (when (and drag-item (not (rows/separator-item? drag-item)))
      (let [next-items (if (= :pin (:page s))
                         (rows/reorder-pin-page-items (:pin-items s) drag-id to-index)
                         (rows/reorder-visible-pin (:pin-items s)
                                                   (:countries s)
                                                   (rows/country-slug-for-view s)
                                                   drag-id
                                                   to-index))]
        (when (and next-items (not= next-items (:pin-items s)))
          (pin-state/swap-render!
           (fn [state]
             (refresh-table-rows
              (-> state
                  (assoc :pin-selected-id drag-id
                         :pin-items next-items
                         :pin-message nil)
                  pin-state/clear-search-ui))))
          (persist-items! next-items)
          (when-let [item (rows/find-by-id next-items drag-id)]
            (pin-map/focus-pin-on-map! item)))))))
