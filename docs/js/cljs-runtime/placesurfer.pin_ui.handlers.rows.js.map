(ns placesurfer.pin-ui.handlers.rows
  "Pin list CRUD and table state."
  (:require [clojure.set :as set]
            [clojure.string :as str]
            [placesurfer.app-ui.interface.state :as app-state]
            [placesurfer.dropbox.interface :as dropbox]
            [placesurfer.map-ui.interface :as map-ui]
            [placesurfer.pin-ui.handlers.map :as pin-map]
            [placesurfer.pin-ui.handlers.state :as pin-state]
            [placesurfer.pin-ui.pure.coords :as coords]
            [placesurfer.pin-ui.pure.forms :as forms]
            [placesurfer.pin-ui.pure.rows :as rows]
            [placesurfer.pin-ui.pure.storage :as storage]))

(defn- persist-items! [items]
  (storage/save-pins! items)
  (when (dropbox/connected?) (dropbox/push!)))

(defn- list-items-for-page [s]
  (if (= :pin (:page s))
    (rows/pin-page-list-items (:pin-items s))
    (rows/visible-list-items (or (:pin-items s) [])
                             (:countries s)
                             (rows/country-slug-for-view s))))

(defn table-rows-for-state [s]
  (rows/table-rows (vec (list-items-for-page s)) (:pin-selected-id s)))

(defn find-display-item [s id]
  (rows/find-by-id (list-items-for-page s) id))

(defn refresh-table-rows
  ([s] (refresh-table-rows s nil))
  ([s include-id]
   (let [include-id* (or include-id (:pin-new-draft-id s))
         filtered (list-items-for-page s)
         filtered (if include-id*
                    (let [items (:pin-items s)]
                      (if-let [item (rows/find-by-id items include-id*)]
                        (if (some #(= include-id* (:id %)) filtered)
                          filtered
                          (conj (vec filtered) item))
                        filtered))
                    filtered)]
     (assoc s :pin-table-rows
            (rows/table-rows (vec filtered) (:pin-selected-id s))))))

(defn- selectable-pin-items [s]
  (if (= :pin (:page s))
    (rows/pin-page-list-items (:pin-items s))
    (rows/visible-list-items (or (:pin-items s) [])
                             (:countries s)
                             (rows/country-slug-for-view s))))

(defn select-pin-row! [id]
  (let [s @app-state/!state
        ;; Fall back to the unfiltered list: a pin can be visible in the table via
        ;; refresh-table-rows's force-include (e.g. just added/imported) while still
        ;; being outside the current country view's bounds, so selectable-pin-items
        ;; alone can miss it. Without this fallback, selection silently no-ops here
        ;; while load-pin-into-inline-editor! (unfiltered) still loads its data into
        ;; the form - so a subsequent save writes onto whatever pin *was* selected.
        item (or (rows/find-by-id (selectable-pin-items s) id)
                 (rows/find-by-id (:pin-items s) id))]
    (when (and item (not (rows/separator-item? item)))
      (pin-state/swap-render!
       (fn [state]
         (refresh-table-rows
          (-> state
              (assoc :pin-selected-id (:id item)
                     :pin-message nil)
              pin-state/clear-search-ui))))
      (pin-map/focus-pin-on-map! item))))

(defn select-display-row! [id]
  (let [s @app-state/!state
        ;; Same unfiltered fallback as select-pin-row! - see its comment.
        item (or (rows/find-by-id (list-items-for-page s) id)
                 (rows/find-by-id (:pin-items s) id))]
    (when (and item (not (rows/separator-item? item)))
      (pin-state/swap-render!
       (fn [state]
         (refresh-table-rows
          (-> state
              (assoc :pin-selected-id id
                     :pin-message nil)
              pin-state/clear-search-ui))))
      (pin-map/focus-pin-on-map! item))))

(defn- focus-pin-search! []
  (when (js* "typeof document !== 'undefined' && document.getElementById")
    (doseq [delay-ms [0 60 140 260]]
      (js/setTimeout
       #(when-let [el (.getElementById js/document "pin-search")]
          (.focus el))
       delay-ms))))

(defn- reset-form-after-add! [state items saved-id existing?]
  (let [saved-item (rows/find-by-id items saved-id)
        next-form (if existing?
                    (forms/item->form saved-item)
                    (forms/default-form))]
    (-> state
        (assoc :pin-items items
               :pin-selected-id saved-id
               :pin-form next-form
               :pin-form-baseline next-form
               :pin-message nil)
        (pin-state/clear-search-ui)
        (refresh-table-rows saved-id))))

(defn- save-target-item [items selected-id form]
  (or (when selected-id (rows/find-by-id items selected-id))
      (when-let [probe (forms/form->item form "probe")]
        (rows/find-by-coords items (:longitude probe) (:latitude probe)))))

(defn save-enabled? [state]
  (let [form (:pin-form state)
        baseline (:pin-form-baseline state (forms/default-form))]
    (and (forms/form-valid? form)
         (forms/form-edited-from-baseline? form baseline))))

(defn- apply-save! [s form next-items item-id]
  (refresh-table-rows
   (-> s
       (assoc :pin-items next-items
              :pin-form form
              :pin-form-baseline form
              :pin-selected-id item-id
              :pin-message nil)
       (cond-> (= (:pin-new-draft-id s) item-id)
         (assoc :pin-new-draft-id nil))
       (pin-state/clear-search-ui))
   item-id))

(defn save-pin!
  "Persist form edits: update matching list item or add a new one."
  ([] (save-pin! {}))
  ([{:keys [focus-map?] :or {focus-map? true}}]
   (let [saved (atom nil)
         saved-id (atom nil)]
     (pin-state/swap-state!
      (fn [s]
        (if-not (save-enabled? s)
          s
          (let [form (:pin-form s)
                items (:pin-items s)]
            (if-let [target (save-target-item items (:pin-selected-id s) form)]
              (if-let [updated (forms/form->item form (:id target))]
                (let [next-items (rows/upsert-item items updated)]
                  (reset! saved next-items)
                  (reset! saved-id (:id target))
                  (apply-save! s form next-items (:id target)))
                s)
              (if-let [created (forms/form->item form (storage/new-pin-id))]
                (let [next-items (rows/upsert-item items created)]
                  (reset! saved next-items)
                  (reset! saved-id (:id created))
                  (apply-save! s form next-items (:id created)))
                s))))))
     (when @saved
       (persist-items! @saved)
       (pin-state/render!)
       (when focus-map?
         (when-let [item (rows/find-by-id @saved @saved-id)]
           (pin-map/focus-pin-on-map! item)))))))

(defn add-pin!
  "Add the current form as a pin, or update the existing pin that
   shares the same longitude/latitude. With `:force-new? true`, always
   inserts a new pin even when coordinates match an existing one."
  ([] (add-pin! {}))
  ([{:keys [force-new?]}]
   (let [saved (atom nil)
         saved-id (atom nil)
         focus-search? (atom false)]
     (pin-state/swap-state!
      (fn [s]
        (let [form (:pin-form s)]
          (if-not (forms/form-valid? form)
            s
            (if-let [base (forms/form->item form (storage/new-pin-id))]
              (let [items (:pin-items s)
                    existing (when-not force-new?
                               (rows/find-by-coords items (:longitude base) (:latitude base)))
                    item (cond-> base existing (assoc :id (:id existing)))
                    next-items (rows/upsert-item items item)]
                (reset! saved next-items)
                (reset! saved-id (:id item))
                (reset! focus-search? (and (nil? existing) (not force-new?)))
                (reset-form-after-add! s next-items (:id item) (some? existing)))
              s)))))
     (when @saved
       (persist-items! @saved)
       (pin-state/render!)
       (when-let [item (rows/find-by-id @saved @saved-id)]
         (pin-map/focus-pin-on-map! item))
       (when (and @focus-search? (:pin-editor-open? @app-state/!state))
         (focus-pin-search!))))))

(defn update-draft-pin-field!
  "When a draft (newly created empty) pin is being edited, sync field k=v
   into pin-items so the list row updates immediately without waiting for
   auto-save to fire (which requires valid coordinates)."
  [k v]
  (when-let [draft-id (:pin-new-draft-id @app-state/!state)]
    (pin-state/swap-render!
     (fn [s]
       (if (= draft-id (:pin-selected-id s))
         (if-let [item (rows/find-by-id (:pin-items s) draft-id)]
           (let [next-items (rows/upsert-item (:pin-items s) (assoc item k v))]
             (-> s
                 (assoc :pin-items next-items)
                 (refresh-table-rows draft-id)))
           s)
         s)))))

(defn add-pin-item-at-coords!
  "Insert a new blank pin with the given coordinates, select it, and return its id."
  ([longitude latitude] (add-pin-item-at-coords! longitude latitude {}))
  ([longitude latitude extra-fields]
  (let [new-id (storage/new-pin-id)
        item (merge {:id new-id :name "" :address "" :icon forms/default-icon
                     :longitude longitude :latitude latitude}
                    extra-fields)
        saved (atom nil)]
    (pin-state/swap-state!
     (fn [s]
       (let [next-items (rows/upsert-item (:pin-items s []) item)]
         (reset! saved next-items)
         (-> s
             (assoc :pin-items next-items
                    :pin-new-draft-id new-id
                    :pin-selected-id new-id
                    :pin-message nil)
             pin-state/clear-search-ui
             (refresh-table-rows new-id)))))
    (when @saved
      (persist-items! @saved)
      (pin-state/render!))
    new-id)))

(defn update-pin-name-address!
  "Update name and address on the pin item with the given id,
   and refresh the form if that item is currently selected."
  [id name address]
  (when id
    (let [saved (atom nil)]
      (pin-state/swap-state!
       (fn [s]
         (let [item (rows/find-by-id (:pin-items s []) id)
               updated (when item (assoc item :name name :address address))
               next-items (if updated
                            (rows/upsert-item (:pin-items s []) updated)
                            (:pin-items s []))]
           (reset! saved next-items)
           (cond-> s
             true (assoc :pin-items next-items)
             (= id (:pin-selected-id s))
             (update :pin-form assoc :name name :location address)
             true (refresh-table-rows id)))))
      (when @saved
        (persist-items! @saved)
        (pin-state/render!)))))

(defn add-empty-pin-item!
  "Insert a new blank pin at the end of the list, select it, and return its id."
  []
  (let [new-id (storage/new-pin-id)
        item {:id new-id :name "" :address "" :icon forms/default-icon}
        saved (atom nil)]
    (pin-state/swap-state!
     (fn [s]
       (let [next-items (rows/upsert-item (:pin-items s []) item)]
         (reset! saved next-items)
         (-> s
             (assoc :pin-items next-items
                    :pin-new-draft-id new-id
                    :pin-selected-id new-id
                    :pin-message nil)
             pin-state/clear-search-ui
             (refresh-table-rows new-id)))))
    (when @saved
      (persist-items! @saved)
      (pin-state/render!))
    new-id))

(defn- import-skip-message [no-coords no-name]
  (let [total (+ no-coords no-name)]
    (when (pos? total)
      (let [parts (cond-> []
                    (pos? no-coords) (conj (str no-coords
                                               (if (= 1 no-coords) " entry" " entries")
                                               " without coordinates"))
                    (pos? no-name)   (conj (str no-name
                                               (if (= 1 no-name) " entry" " entries")
                                               " without name")))]
        (str "Skipped " (str/join ", " parts))))))

(defn import-pin-items!
  "Append pins that don't already exist (deduped by longitude/latitude) to
   the end of the list. Any legacy `:group` tag on an imported pin (from an
   older export) is ignored - groups are no longer a concept here, so
   imported pins always land ungrouped. Returns id of first imported pin,
   or nil."
  [{:keys [pins]}]
  (let [pins (mapv #(set/rename-keys % {:location :address}) (or pins []))
        saved (atom nil)
        first-new-id (atom nil)
        skipped-no-coords (atom 0)
        skipped-no-name (atom 0)]
    (pin-state/swap-state!
     (fn [s]
       (let [current (:pin-items s [])

             existing-coords (into #{}
                                   (keep #(when (and (number? (:longitude %))
                                                     (number? (:latitude %)))
                                            [(:longitude %) (:latitude %)])
                                         current))

             ;; Mutable coord tracker shared across all new pins
             seen-coords (atom existing-coords)

             make-new-pin (fn [item]
                            (let [lon (:longitude item)
                                  lat (:latitude item)]
                              (cond
                                (not (and (coords/valid-longitude? lon)
                                          (coords/valid-latitude? lat)))
                                (do (swap! skipped-no-coords inc) nil)

                                (str/blank? (str/trim (str (:name item ""))))
                                (do (swap! skipped-no-name inc) nil)

                                (@seen-coords [lon lat])
                                nil

                                :else
                                (do (swap! seen-coords conj [lon lat])
                                    (let [new-pin (forms/form->item (forms/item->form item) (storage/new-pin-id))]
                                      (when (and (nil? @first-new-id) new-pin)
                                        (reset! first-new-id (:id new-pin)))
                                      new-pin)))))

             new-pins (keep make-new-pin pins)
             next-items (into (vec current) new-pins)]
         (reset! saved next-items)
         (let [msg (import-skip-message @skipped-no-coords @skipped-no-name)]
           (-> s
               (assoc :pin-items next-items)
               (cond-> @first-new-id
                 (assoc :pin-selected-id @first-new-id))
               (cond-> (or @first-new-id msg)
                 (assoc :pin-message msg))
               pin-state/clear-search-ui
               (refresh-table-rows @first-new-id))))))
    (when @saved
      (persist-items! @saved)
      (pin-state/render!)
      (when-let [fid @first-new-id]
        (when-let [item (rows/find-by-id @saved fid)]
          (pin-map/focus-pin-on-map! item))))
    @first-new-id))

(defn delete-enabled? [state]
  (boolean
   (when-let [id (:pin-selected-id state)]
     (some #(= id (:id %)) (:pin-items state [])))))

(defn- pin-item-exists? [state id]
  (boolean (some #(= id (:id %)) (:pin-items state []))))

(defn delete-pin!
  "Remove the pin `id` from the list, regardless of whether it's currently
   selected - the trash-icon-per-row counterpart to `delete-selected-pin!`.
   Only touches :pin-selected-id/the open editor/form when the deleted row
   WAS the selected one; deleting an unrelated row via its own trash icon
   must not disturb whatever's currently open. Stashes the removed item and
   its index in :pin-delete-undo so `undo-pin-delete!` can splice it back
   into exactly the same spot, not just re-appended at the end."
  [id]
  (let [s @app-state/!state]
    (when (pin-item-exists? s id)
      (let [table-rows (:pin-table-rows s)
            was-selected? (= id (:pin-selected-id s))
            next-id (when was-selected? (rows/selection-id-after-delete table-rows id))
            items (atom nil)]
        (pin-state/swap-state!
         (fn [state]
           (let [current-items (vec (:pin-items state))
                 deleted-index (first (keep-indexed (fn [i v] (when (= id (:id v)) i)) current-items))
                 deleted-item (rows/find-by-id current-items id)
                 next-items (rows/remove-item current-items id)
                 next-item (when next-id (rows/find-by-id next-items next-id))
                 next-form (if next-item (forms/item->form next-item) (forms/default-form))]
             (reset! items next-items)
             (refresh-table-rows
              (cond-> (-> state
                          (assoc :pin-items next-items
                                 :pin-delete-undo (when deleted-item
                                                     {:kind :pin :item deleted-item :index deleted-index}))
                          (pin-state/clear-search-ui))
                was-selected?
                (assoc :pin-selected-id next-id
                       :pin-form next-form
                       :pin-form-baseline next-form
                       :pin-message nil
                       :pin-editor-open? false
                       :pin-editor-mode nil
                       :pin-editor-snapshot nil
                       :pin-table-keyboard-focus? true))))))
        (when @items
          (persist-items! @items)
          (pin-state/render!)
          (when (= :pin (:page @app-state/!state))
            (map-ui/close-all-popups!))
          (pin-map/schedule-pin-map-sync! {:recenter? false})
          (when (and was-selected? next-id)
            (when-let [item (rows/find-by-id (list-items-for-page @app-state/!state) next-id)]
              (pin-map/focus-pin-on-map! item))))))))

(defn delete-selected-pin! []
  (when-let [id (:pin-selected-id @app-state/!state)]
    (delete-pin! id)))

(defn undo-pin-delete-enabled? [state]
  (boolean (:pin-delete-undo state)))

(defn- undo-pin-item-delete!
  "Re-insert the most recently deleted pin at the index `delete-pin!` removed
   it from (see delete-pin!'s docstring)."
  [{:keys [item index]}]
  (let [items (atom nil)]
    (pin-state/swap-state!
     (fn [state]
       (let [current (vec (:pin-items state []))
             idx (min (max 0 (or index (count current))) (count current))
             next-items (into (conj (subvec current 0 idx) item) (subvec current idx))]
         (reset! items next-items)
         (refresh-table-rows
          (-> state
              (assoc :pin-items next-items
                     :pin-selected-id (:id item)
                     :pin-delete-undo nil)
              (pin-state/clear-search-ui))))))
    (when @items
      (persist-items! @items)
      (pin-state/render!)
      (pin-map/schedule-pin-map-sync! {:recenter? false})
      (when-let [restored (rows/find-by-id (list-items-for-page @app-state/!state) (:id item))]
        (pin-map/focus-pin-on-map! restored)))))

(defn- undo-search-result-discard!
  "Counterpart to `pin-ui.handlers.hemnet-search/discard-result!`'s soft
   delete - that handler never actually removes the row (just flags it
   :deleted), so undo here is just clearing that flag again, re-selecting
   the row so it's visible where it lands back in the list."
  [id]
  (let [results (atom nil)]
    (pin-state/swap-state!
     (fn [state]
       (let [updated (mapv (fn [r] (if (= id (:id r)) (dissoc r :deleted) r))
                           (:search-results state []))]
         (reset! results updated)
         (assoc state
                :search-results updated
                :hemnet-selected-id id
                :pin-delete-undo nil))))
    (when @results
      (storage/save-search-results! @results)
      (when (dropbox/connected?) (dropbox/push!))
      (pin-state/render!)
      (pin-map/schedule-pin-map-sync! {:recenter? false}))))

(defn undo-pin-delete!
  "Undo whichever row (a saved pin, or a soft-deleted Hemnet/Booli/Notar
   search result) was most recently removed from the pin-page list - a
   single shared undo slot behind the toolbar's one undo button, not a full
   history: using it, or deleting something else afterwards, clears it."
  []
  (when-let [undo (:pin-delete-undo @app-state/!state)]
    (case (:kind undo)
      :pin (undo-pin-item-delete! undo)
      :search-result (undo-search-result-discard! (:id undo))
      nil)))

(defn refresh-pin-table! []
  (pin-state/swap-render! refresh-table-rows))

(defn pin-page-table-rows [s]
  (table-rows-for-state (assoc s :page :pin)))

(defn reorder-stars-row!
  "Reorder a pin within its star group; updates :stars-order in state and persists it."
  [stars-val drag-id to-index]
  (let [s @app-state/!state
        all-in-group (->> (:pin-items s)
                          (filter #(and (not (rows/separator-item? %))
                                       (= (or (:ranking %) (:stars %) "0-stars.png") stars-val)))
                          (mapv :id))
        current-order (get (:stars-order s) stars-val [])
        order-set (set current-order)
        ordered (vec (concat (filter order-set all-in-group)
                             (remove order-set all-in-group)))
        from-index (first (keep-indexed (fn [i id] (when (= id drag-id) i)) ordered))]
    (when (and (some? from-index) (not= from-index to-index))
      (let [without (vec (concat (subvec ordered 0 from-index)
                                 (subvec ordered (inc from-index))))
            [before after] (split-at to-index without)
            new-order (vec (concat before [drag-id] after))]
        (pin-state/swap-render!
         (fn [state]
           (let [next-stars-order (assoc (or (:stars-order state) {}) stars-val new-order)]
             (storage/save-stars-order! next-stars-order)
             (assoc state :stars-order next-stars-order))))))))

(defn reorder-stars-pin!
  "Move a pin to a (possibly different) star group at local-to-index within that group.
   Updates :stars on the pin if the group changed, updates :stars-order, persists both."
  [drag-id to-stars-val local-to-index]
  (let [s @app-state/!state
        drag-item (rows/find-by-id (:pin-items s) drag-id)
        from-stars-val (forms/normalize-stars (or (:ranking drag-item) (:stars drag-item) "0-stars.png"))
        stars-order (:stars-order s {})]
    (when drag-item
      (let [dest-ids (->> (:pin-items s)
                          (filter #(and (not (rows/separator-item? %))
                                       (= (forms/normalize-stars (or (:ranking %) (:stars %) "0-stars.png"))
                                          to-stars-val)))
                          (mapv :id))
            cur-dest-order (get stars-order to-stars-val [])
            dest-set (set cur-dest-order)
            ordered-dest (vec (concat (filter dest-set dest-ids)
                                      (remove dest-set dest-ids)))
            ordered-dest-without (vec (remove #{drag-id} ordered-dest))
            [before after] (split-at local-to-index ordered-dest-without)
            new-dest-order (vec (concat before [drag-id] after))
            new-src-order (vec (remove #{drag-id} (get stars-order from-stars-val [])))
            cross-group? (not= from-stars-val to-stars-val)
            next-stars-order (cond-> (assoc stars-order to-stars-val new-dest-order)
                               cross-group? (assoc from-stars-val new-src-order))
            next-items (when cross-group?
                         (mapv #(if (= (:id %) drag-id) (assoc % :ranking to-stars-val) %)
                               (:pin-items s)))]
        (pin-state/swap-render!
         (fn [state]
           (storage/save-stars-order! next-stars-order)
           (cond-> (assoc state :stars-order next-stars-order)
             cross-group? (assoc :pin-items next-items)
             (and cross-group? (= drag-id (:pin-selected-id state)))
             (update :pin-form assoc :ranking to-stars-val))))
        (when cross-group?
          (persist-items! next-items))))))

(defn set-pin-list-sort!
  "Toggle or set the column sort for the pin list.
   Same column: toggles direction. New column: desc for :stars, asc otherwise."
  [col]
  (pin-state/swap-render!
   (fn [state]
     (let [{:keys [col dir] :as current} (:pin-list-sort state {:col :ranking :dir :desc})
           same-col? (= col (:col current))
           new-dir   (if same-col?
                       (if (= :desc dir) :asc :desc)
                       (if (= :ranking col) :desc :asc))]
       (assoc state :pin-list-sort {:col col :dir new-dir})))))

(defn reorder-pin-row!
  "Move a visible pin row to just before `target-id` (the id of the row it
   was dropped on, from pure.drag's finish-row-drag!), falling back to the
   raw `to-index` DOM position when that can't be resolved - needed because
   `to-index` alone isn't reliable here: it's a count of rendered rows, which
   (sorted/grouped for display, separators rendered as headers rather than
   rows - see pin-ui.pure.list-panel/pin-sorted-table's pin-only filter) don't line up 1:1 with
   :pin-items' own storage order that the reorder itself operates on."
  ([drag-id to-index] (reorder-pin-row! drag-id to-index nil))
  ([drag-id to-index target-id]
   (let [s @app-state/!state
         drag-item (rows/find-by-id (:pin-items s) drag-id)]
     (when (and drag-item (not (rows/separator-item? drag-item)))
       (let [next-items (if (= :pin (:page s))
                          (rows/reorder-pin-page-items (:pin-items s) drag-id to-index target-id)
                          (rows/reorder-visible-pin (:pin-items s)
                                                    (:countries s)
                                                    (rows/country-slug-for-view s)
                                                    drag-id
                                                    to-index
                                                    target-id))]
         (when (and next-items (not= next-items (:pin-items s)))
           (pin-state/swap-render!
            (fn [state]
              (refresh-table-rows
               (-> state
                   (assoc :pin-selected-id drag-id
                          :pin-items next-items
                          :pin-message nil)
                   pin-state/clear-search-ui))))
           (persist-items! next-items)
           (when-let [item (rows/find-by-id next-items drag-id)]
             (pin-map/focus-pin-on-map! item))))))))
