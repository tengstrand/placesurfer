(ns placesurfer.pin-ui.handlers.rows
  "Pin list CRUD and table state."
  (:require [clojure.set :as set]
            [clojure.string :as str]
            [placesurfer.app-ui.interface.state :as app-state]
            [placesurfer.map-ui.interface :as map-ui]
            [placesurfer.pin-ui.handlers.map :as pin-map]
            [placesurfer.pin-ui.handlers.state :as pin-state]
            [placesurfer.pin-ui.pure.coords :as coords]
            [placesurfer.pin-ui.pure.forms :as forms]
            [placesurfer.pin-ui.pure.rows :as rows]
            [placesurfer.pin-ui.pure.storage :as storage]))

(defn- persist-items! [items]
  (storage/save-pins! items))

(defn- list-items-for-page [s]
  (if (= :pin (:page s))
    (rows/pin-page-list-items (:pin-items s))
    (rows/visible-list-items (or (:pin-items s) [])
                             (:countries s)
                             (rows/country-slug-for-view s))))

(defn table-rows-for-state [s]
  (rows/table-rows (vec (list-items-for-page s)) (:pin-selected-id s)))

(defn find-display-item [s id]
  (rows/find-by-id (list-items-for-page s) id))

(defn refresh-table-rows
  ([s] (refresh-table-rows s nil))
  ([s include-id]
   (let [include-id* (or include-id (:pin-new-draft-id s))
         filtered (list-items-for-page s)
         filtered (if include-id*
                    (let [items (:pin-items s)]
                      (if-let [item (rows/find-by-id items include-id*)]
                        (if (some #(= include-id* (:id %)) filtered)
                          filtered
                          (conj (vec filtered) item))
                        filtered))
                    filtered)]
     (assoc s :pin-table-rows
            (rows/table-rows (vec filtered) (:pin-selected-id s))))))

(defn- selectable-pin-items [s]
  (if (= :pin (:page s))
    (rows/pin-page-list-items (:pin-items s))
    (rows/visible-list-items (or (:pin-items s) [])
                             (:countries s)
                             (rows/country-slug-for-view s))))

(defn select-pin-row! [id]
  (let [s @app-state/!state
        item (rows/find-by-id (selectable-pin-items s) id)]
    (when (and item (not (rows/separator-item? item)))
      (pin-state/swap-render!
       (fn [state]
         (refresh-table-rows
          (-> state
              (assoc :pin-selected-id (:id item)
                     :pin-message nil)
              pin-state/clear-search-ui))))
      (pin-map/focus-pin-on-map! item))))

(defn select-display-row! [id]
  (let [s @app-state/!state
        item (rows/find-by-id (list-items-for-page s) id)]
    (when (and item (not (rows/separator-item? item)))
      (pin-state/swap-render!
       (fn [state]
         (refresh-table-rows
          (-> state
              (assoc :pin-selected-id id
                     :pin-message nil)
              pin-state/clear-search-ui))))
      (pin-map/focus-pin-on-map! item))))

(defn- focus-pin-search! []
  (when (js* "typeof document !== 'undefined' && document.getElementById")
    (doseq [delay-ms [0 60 140 260]]
      (js/setTimeout
       #(when-let [el (.getElementById js/document "pin-search")]
          (.focus el))
       delay-ms))))

(defn- reset-form-after-add! [state items saved-id existing?]
  (let [saved-item (rows/find-by-id items saved-id)
        next-form (if existing?
                    (forms/item->form saved-item)
                    (forms/default-form))]
    (-> state
        (assoc :pin-items items
               :pin-selected-id saved-id
               :pin-form next-form
               :pin-form-baseline next-form
               :pin-message nil)
        (pin-state/clear-search-ui)
        (refresh-table-rows saved-id))))

(defn- save-target-item [items selected-id form]
  (or (when selected-id (rows/find-by-id items selected-id))
      (when-let [probe (forms/form->item form "probe")]
        (rows/find-by-coords items (:longitude probe) (:latitude probe)))))

(defn save-enabled? [state]
  (let [form (:pin-form state)
        baseline (:pin-form-baseline state (forms/default-form))]
    (and (forms/form-valid? form)
         (forms/form-edited-from-baseline? form baseline))))

(defn- apply-save! [s form next-items item-id]
  (refresh-table-rows
   (-> s
       (assoc :pin-items next-items
              :pin-form form
              :pin-form-baseline form
              :pin-selected-id item-id
              :pin-message nil)
       (cond-> (= (:pin-new-draft-id s) item-id)
         (assoc :pin-new-draft-id nil))
       (pin-state/clear-search-ui))
   item-id))

(defn save-pin!
  "Persist form edits: update matching list item or add a new one."
  ([] (save-pin! {}))
  ([{:keys [focus-map?] :or {focus-map? true}}]
   (let [saved (atom nil)
         saved-id (atom nil)]
     (pin-state/swap-state!
      (fn [s]
        (if-not (save-enabled? s)
          s
          (let [form (:pin-form s)
                items (:pin-items s)]
            (if-let [target (save-target-item items (:pin-selected-id s) form)]
              (if-let [updated (forms/form->item form (:id target))]
                (let [next-items (rows/upsert-item items updated)]
                  (reset! saved next-items)
                  (reset! saved-id (:id target))
                  (apply-save! s form next-items (:id target)))
                s)
              (if-let [created (forms/form->item form (storage/new-pin-id))]
                (let [next-items (rows/upsert-item items created)]
                  (reset! saved next-items)
                  (reset! saved-id (:id created))
                  (apply-save! s form next-items (:id created)))
                s))))))
     (when @saved
       (persist-items! @saved)
       (pin-state/render!)
       (when focus-map?
         (when-let [item (rows/find-by-id @saved @saved-id)]
           (pin-map/focus-pin-on-map! item)))))))

(defn add-pin!
  "Add the current form as a pin, or update the existing pin that
   shares the same longitude/latitude. With `:force-new? true`, always
   inserts a new pin even when coordinates match an existing one."
  ([] (add-pin! {}))
  ([{:keys [force-new?]}]
   (let [saved (atom nil)
         saved-id (atom nil)
         focus-search? (atom false)]
     (pin-state/swap-state!
      (fn [s]
        (let [form (:pin-form s)]
          (if-not (forms/form-valid? form)
            s
            (if-let [base (forms/form->item form (storage/new-pin-id))]
              (let [items (:pin-items s)
                    existing (when-not force-new?
                               (rows/find-by-coords items (:longitude base) (:latitude base)))
                    item (cond-> base existing (assoc :id (:id existing)))
                    next-items (rows/upsert-item items item)]
                (reset! saved next-items)
                (reset! saved-id (:id item))
                (reset! focus-search? (and (nil? existing) (not force-new?)))
                (reset-form-after-add! s next-items (:id item) (some? existing)))
              s)))))
     (when @saved
       (persist-items! @saved)
       (pin-state/render!)
       (when-let [item (rows/find-by-id @saved @saved-id)]
         (pin-map/focus-pin-on-map! item))
       (when (and @focus-search? (:pin-editor-open? @app-state/!state))
         (focus-pin-search!))))))

(defn update-draft-pin-field!
  "When a draft (newly created empty) pin is being edited, sync field k=v
   into pin-items so the list row updates immediately without waiting for
   auto-save to fire (which requires valid coordinates)."
  [k v]
  (when-let [draft-id (:pin-new-draft-id @app-state/!state)]
    (pin-state/swap-render!
     (fn [s]
       (if (= draft-id (:pin-selected-id s))
         (if-let [item (rows/find-by-id (:pin-items s) draft-id)]
           (let [next-items (rows/upsert-item (:pin-items s) (assoc item k v))]
             (-> s
                 (assoc :pin-items next-items)
                 (refresh-table-rows draft-id)))
           s)
         s)))))

(defn add-pin-item-at-coords!
  "Insert a new blank pin with the given coordinates, select it, and return its id."
  ([longitude latitude] (add-pin-item-at-coords! longitude latitude {}))
  ([longitude latitude extra-fields]
  (let [new-id (storage/new-pin-id)
        item (merge {:id new-id :name "" :address "" :icon forms/default-icon
                     :longitude longitude :latitude latitude}
                    extra-fields)
        saved (atom nil)]
    (pin-state/swap-state!
     (fn [s]
       (let [next-items (rows/upsert-item (:pin-items s []) item)]
         (reset! saved next-items)
         (-> s
             (assoc :pin-items next-items
                    :pin-new-draft-id new-id
                    :pin-selected-id new-id
                    :pin-message nil)
             pin-state/clear-search-ui
             (refresh-table-rows new-id)))))
    (when @saved
      (persist-items! @saved)
      (pin-state/render!))
    new-id)))

(defn update-pin-name-address!
  "Update name and address on the pin item with the given id,
   and refresh the form if that item is currently selected."
  [id name address]
  (when id
    (let [saved (atom nil)]
      (pin-state/swap-state!
       (fn [s]
         (let [item (rows/find-by-id (:pin-items s []) id)
               updated (when item (assoc item :name name :address address))
               next-items (if updated
                            (rows/upsert-item (:pin-items s []) updated)
                            (:pin-items s []))]
           (reset! saved next-items)
           (cond-> s
             true (assoc :pin-items next-items)
             (= id (:pin-selected-id s))
             (update :pin-form assoc :name name :location address)
             true (refresh-table-rows id)))))
      (when @saved
        (persist-items! @saved)
        (pin-state/render!)))))

(defn add-empty-pin-item!
  "Insert a new blank pin at the end of the list, select it, and return its id."
  []
  (let [new-id (storage/new-pin-id)
        item {:id new-id :name "" :address "" :icon forms/default-icon}
        saved (atom nil)]
    (pin-state/swap-state!
     (fn [s]
       (let [next-items (rows/upsert-item (:pin-items s []) item)]
         (reset! saved next-items)
         (-> s
             (assoc :pin-items next-items
                    :pin-new-draft-id new-id
                    :pin-selected-id new-id
                    :pin-message nil)
             pin-state/clear-search-ui
             (refresh-table-rows new-id)))))
    (when @saved
      (persist-items! @saved)
      (pin-state/render!))
    new-id))

(defn- import-skip-message [no-coords no-name]
  (let [total (+ no-coords no-name)]
    (when (pos? total)
      (let [parts (cond-> []
                    (pos? no-coords) (conj (str no-coords
                                               (if (= 1 no-coords) " entry" " entries")
                                               " without coordinates"))
                    (pos? no-name)   (conj (str no-name
                                               (if (= 1 no-name) " entry" " entries")
                                               " without name")))]
        (str "Skipped " (str/join ", " parts))))))

(defn import-pin-items!
  "Add groups and pins that don't already exist. Groups deduped by label,
   pins deduped by longitude/latitude. New pins are inserted into their
   matching existing section; new groups are appended at the end.
   Returns id of first imported pin, or nil."
  [{:keys [pins groups]}]
  (let [pins (mapv #(set/rename-keys % {:location :address}) (or pins []))
        saved (atom nil)
        first-new-id (atom nil)
        skipped-no-coords (atom 0)
        skipped-no-name (atom 0)]
    (pin-state/swap-state!
     (fn [s]
       (let [current (:pin-items s [])

             ;; Parse current into ungrouped pins + sections [{:separator :pins}]
             {:keys [ungrouped sections]}
             (loop [rem (seq current) ung [] secs [] cur-sep nil cur-pins []]
               (if (empty? rem)
                 {:ungrouped ung
                  :sections (cond-> secs cur-sep (conj {:separator cur-sep :pins cur-pins}))}
                 (let [item (first rem)]
                   (if (rows/separator-item? item)
                     (recur (rest rem) ung
                            (cond-> secs cur-sep (conj {:separator cur-sep :pins cur-pins}))
                            item [])
                     (if cur-sep
                       (recur (rest rem) ung secs cur-sep (conj cur-pins item))
                       (recur (rest rem) (conj ung item) secs nil []))))))

             ;; Build dedup sets from current
             existing-sep-labels (into #{} (map #(.toLowerCase (str (:label (:separator %) "")))) sections)
             existing-coords (into #{}
                                   (keep #(when (and (number? (:longitude %))
                                                     (number? (:latitude %)))
                                            [(:longitude %) (:latitude %)])
                                         (concat ungrouped (mapcat :pins sections))))

             ;; Pins from import keyed by :group (case-sensitive; nil = ungrouped)
             import-pins-by-group (group-by :group (or pins []))

             ;; Mutable coord tracker shared across all new pins
             seen-coords (atom existing-coords)

             make-new-pin (fn [item]
                            (let [lon (:longitude item)
                                  lat (:latitude item)]
                              (cond
                                (not (and (coords/valid-longitude? lon)
                                          (coords/valid-latitude? lat)))
                                (do (swap! skipped-no-coords inc) nil)

                                (str/blank? (str/trim (str (:name item ""))))
                                (do (swap! skipped-no-name inc) nil)

                                (@seen-coords [lon lat])
                                nil

                                :else
                                (do (swap! seen-coords conj [lon lat])
                                    (let [new-pin (forms/form->item (forms/item->form item) (storage/new-pin-id))]
                                      (when (and (nil? @first-new-id) new-pin)
                                        (reset! first-new-id (:id new-pin)))
                                      new-pin)))))

             ;; New ungrouped pins inserted after existing ungrouped pins
             new-ungrouped (keep make-new-pin (get import-pins-by-group nil []))

             ;; Existing sections with new pins appended to each section's pins
             updated-sections (mapv (fn [{:keys [separator pins]}]
                                      {:separator separator
                                       :pins (into (vec pins)
                                                   (keep make-new-pin
                                                         (get import-pins-by-group (:label separator) [])))})
                                    sections)

             ;; New sections for groups not yet in current; appended at end
             new-sections (keep (fn [{:keys [label]}]
                                  (let [trimmed (.trim (str label))
                                        lc (.toLowerCase trimmed)]
                                    (when (and (seq trimmed) (not (existing-sep-labels lc)))
                                      (let [sep {:id (storage/new-pin-id) :kind :separator :label trimmed}
                                            new-pins (vec (keep make-new-pin
                                                                (get import-pins-by-group label [])))]
                                        {:separator sep :pins new-pins}))))
                                (or groups []))

             ;; Reconstruct flat item list
             next-items (into (vec ungrouped)
                              (concat new-ungrouped
                                      (mapcat (fn [{:keys [separator pins]}]
                                                (cons separator pins))
                                              (concat updated-sections new-sections))))]
         (reset! saved next-items)
         (let [msg (import-skip-message @skipped-no-coords @skipped-no-name)]
           (-> s
               (assoc :pin-items next-items)
               (cond-> @first-new-id
                 (assoc :pin-selected-id @first-new-id))
               (cond-> (or @first-new-id msg)
                 (assoc :pin-message msg))
               pin-state/clear-search-ui
               (refresh-table-rows @first-new-id))))))
    (when @saved
      (persist-items! @saved)
      (pin-state/render!)
      (when-let [fid @first-new-id]
        (when-let [item (rows/find-by-id @saved fid)]
          (pin-map/focus-pin-on-map! item))))
    @first-new-id))

(defn delete-enabled? [state]
  (boolean
   (when-let [id (:pin-selected-id state)]
     (some #(= id (:id %)) (:pin-items state [])))))

(defn delete-selected-pin! []
  (let [s @app-state/!state
        id (:pin-selected-id s)]
    (when (delete-enabled? s)
      (let [table-rows (:pin-table-rows s)
            next-id (rows/selection-id-after-delete table-rows id)
            items (atom nil)]
        (pin-state/swap-state!
         (fn [state]
           (let [next-items (rows/remove-item (:pin-items state) id)]
             (reset! items next-items)
             (refresh-table-rows
              (-> state
                  (assoc :pin-items next-items
                         :pin-selected-id next-id
                         :pin-form (forms/default-form)
                         :pin-form-baseline (forms/default-form)
                         :pin-message nil
                         :pin-editor-open? false
                         :pin-editor-mode nil
                         :pin-editor-snapshot nil
                         :pin-separator-overlay-open? false
                         :pin-separator-overlay-rows []
                         :pin-separator-overlay-selected-id nil
                         :pin-separator-overlay-snapshot nil
                         :pin-table-keyboard-focus? true)
                  (pin-state/clear-search-ui))))))
        (when @items
          (persist-items! @items)
          (pin-state/render!)
          (when (= :pin (:page @app-state/!state))
            (map-ui/close-all-popups!))
          (pin-map/schedule-pin-map-sync! {:recenter? false})
          (when next-id
            (when-let [item (rows/find-by-id (list-items-for-page @app-state/!state) next-id)]
              (pin-map/focus-pin-on-map! item))))))))

(defn refresh-pin-table! []
  (pin-state/swap-render! refresh-table-rows))

(defn pin-page-table-rows [s]
  (table-rows-for-state (assoc s :page :pin)))

(defn reorder-pin-row!
  "Move a visible pin row to `to-index` and select it."
  [drag-id to-index]
  (let [s @app-state/!state
        drag-item (rows/find-by-id (:pin-items s) drag-id)]
    (when (and drag-item (not (rows/separator-item? drag-item)))
      (let [next-items (if (= :pin (:page s))
                         (rows/reorder-pin-page-items (:pin-items s) drag-id to-index)
                         (rows/reorder-visible-pin (:pin-items s)
                                                   (:countries s)
                                                   (rows/country-slug-for-view s)
                                                   drag-id
                                                   to-index))]
        (when (and next-items (not= next-items (:pin-items s)))
          (pin-state/swap-render!
           (fn [state]
             (refresh-table-rows
              (-> state
                  (assoc :pin-selected-id drag-id
                         :pin-items next-items
                         :pin-message nil)
                  pin-state/clear-search-ui))))
          (persist-items! next-items)
          (when-let [item (rows/find-by-id next-items drag-id)]
            (pin-map/focus-pin-on-map! item)))))))
