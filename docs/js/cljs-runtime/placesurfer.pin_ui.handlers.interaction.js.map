(ns placesurfer.pin-ui.handlers.interaction
  "Pin list row click and keyboard navigation."
  (:require [placesurfer.app-ui.interface.state :as app-state]
            [placesurfer.map-ui.interface :as map-ui]
            [placesurfer.pin-ui.handlers.editor :as editor]
            [placesurfer.pin-ui.handlers.map :as pin-map]
            [placesurfer.pin-ui.handlers.rows :as rows]
            [placesurfer.pin-ui.handlers.separator :as separator]
            [placesurfer.pin-ui.handlers.state :as pin-state]
            [placesurfer.pin-ui.pure.coords :as coords]
            [placesurfer.pin-ui.pure.rows :as pure-rows]
            [placesurfer.pin-ui.pure.update-context :as update-context]))

(defn- update-pins-mode? [s]
  (update-context/update-pins-mode? s))

(defn- pin-browse-mode? [s]
  (= :pin (:page s)))

(defn- selected-row-index [table-rows selected-id]
  (first (keep-indexed (fn [idx {:keys [id]}]
                          (when (= id selected-id) idx))
                        table-rows)))

(defn- navigate-pin-row! [target-id editor-open? separator-open?]
  (when (and target-id (not= target-id (:pin-selected-id @app-state/!state)))
    (when (update-pins-mode? @app-state/!state)
      (editor/maybe-save-inline-pin-before-switch!))
    (when editor-open?
      (editor/cancel-pin-editor!))
    (when separator-open?
      (separator/cancel-pin-separator-overlay!))
    (if (pin-browse-mode? @app-state/!state)
      (rows/select-display-row! target-id)
      (do
        (rows/select-pin-row! target-id)
        (when (update-pins-mode? @app-state/!state)
          (editor/load-pin-into-inline-editor! target-id))
        (when (and editor-open? (not (update-pins-mode? @app-state/!state)))
          (editor/open-pin-editor-edit!))))))

(defn- set-pin-table-keyboard-focus! []
  (pin-state/swap-render! #(assoc % :pin-table-keyboard-focus? true)))

(defn clear-pin-table-keyboard-focus! []
  (when (:pin-table-keyboard-focus? @app-state/!state)
    (pin-state/swap-render! #(assoc % :pin-table-keyboard-focus? false))))

(defn- focus-selected-pin-on-map! [item]
  (when item
    (pin-map/focus-pin-on-map! item)))

(defn- numeric-coord [v]
  (cond
    (number? v) v
    (string? v) (coords/parse-decimal v)
    :else nil))

(defn- explicit-marker-topic [position]
  (some position [:marker-topic :markerTopic :marker_topic]))

(defn normalize-map-click-position
  "Normalize map marker click data for pin detection."
  [raw-position]
  (let [position (if (map? raw-position)
                     raw-position
                     (js->clj raw-position :keywordize-keys true))
        lon (numeric-coord (:longitude position))
        lat (numeric-coord (:latitude position))]
    (cond-> position
      lon (assoc :longitude lon)
      lat (assoc :latitude lat))))

(defn- find-pin-by-id [items id]
  (first (filter #(= (str id) (str (:id %))) items)))

(defn- pin-item-for-map-position [position items]
  (or (when-let [id (:id position)]
        (find-pin-by-id items id))
      (when-let [lon (:longitude position)]
        (when-let [lat (:latitude position)]
          (pure-rows/find-by-coords items lon lat)))))

(defn pin-marker-position? [position]
  (let [topic (explicit-marker-topic position)]
    (= :pin (if (keyword? topic) topic (some-> topic str not-empty keyword)))))

(defn pick-pin-from-map!
  "Select a saved pin from a map marker click without leaving the current page."
  [raw-position]
  (let [position (normalize-map-click-position raw-position)
        s @app-state/!state
        items (:pin-items s)
        item (or (when-let [match (pin-item-for-map-position position items)]
                   (when-not (pure-rows/separator-item? match) match))
                 (pin-map/main-map-pin-for-click s raw-position))]
    (when (or item (pin-marker-position? position) (pin-map/saved-pin-on-main-map? s raw-position))
      (map-ui/close-all-popups!)
      (when item
        (let [id (:id item)
              already-selected? (= id (:pin-selected-id s))]
          (when-not already-selected?
            (rows/select-pin-row! id)
            (when (update-pins-mode? s)
              (editor/load-pin-into-inline-editor! id)))
          (focus-selected-pin-on-map! item)))
      (when (and (not item)
                 (or (pin-marker-position? position) (pin-map/saved-pin-on-main-map? s raw-position)))
        (pin-map/focus-pin-on-map! position)))))

(defn pin-map-position?
  "True when `position` refers to a saved pin (marker topic, id, or coordinates)."
  [raw-position]
  (let [position (normalize-map-click-position raw-position)
        s @app-state/!state]
    (or (pin-marker-position? position)
        (pin-map/saved-pin-on-main-map? s raw-position)
        (when-let [item (pin-item-for-map-position position (:pin-items s))]
          (not (pure-rows/separator-item? item))))))

(defn toggle-pin-preview! []
  (pin-state/swap-render! #(update % :pin-show-preview? not)))

(defn toggle-pin-topics-on-map! []
  (pin-state/swap-render! #(update % :pin-show-topics-on-map? not))
  (when (pin-browse-mode? @app-state/!state)
    (pin-map/schedule-pin-map-sync! {:recenter? false})))

(defn open-selected-pin-row! []
  (when (and (:pin-selected-id @app-state/!state)
             (not (:pin-editor-open? @app-state/!state)))
    (editor/open-pin-editor-edit!)))

(defn pin-row-click! [id]
  (clear-pin-table-keyboard-focus!)
  (let [s @app-state/!state
        item (pure-rows/find-by-id (:pin-items s) id)
        separator? (and item (pure-rows/separator-item? item))
        already-selected? (= id (:pin-selected-id s))
        editor-open? (:pin-editor-open? s)
        separator-open? (:pin-separator-overlay-open? s)]
    (cond
      separator?
      (do
        (when editor-open?
          (editor/cancel-pin-editor!))
        (when separator-open?
          (separator/cancel-pin-separator-overlay!)))

      (pin-browse-mode? s)
      (when-let [display-item (rows/find-display-item s id)]
        (when-not (pure-rows/separator-item? display-item)
          (if already-selected?
            (focus-selected-pin-on-map! display-item)
            (rows/select-display-row! id))))

      (update-pins-mode? s)
      (when-not separator?
        (do
          (when separator-open?
            (separator/cancel-pin-separator-overlay!))
          (when-not already-selected?
            (editor/maybe-save-inline-pin-before-switch!)
            (rows/select-pin-row! id)
            (editor/load-pin-into-inline-editor! id))
          (when-let [item (pure-rows/find-by-id (:pin-items s) id)]
            (focus-selected-pin-on-map! item))))

      already-selected?
      (if editor-open?
        (editor/cancel-pin-editor!)
        (editor/open-pin-editor-edit!))

      :else
      (do
        (when editor-open?
          (editor/cancel-pin-editor!))
        (when separator-open?
          (separator/cancel-pin-separator-overlay!))
        (rows/select-pin-row! id)))))

(defn select-adjacent-pin-row! [delta]
  (when (number? delta)
    (let [s @app-state/!state
          table-rows (if (= :pin (:page s))
                       (rows/table-rows-for-state s)
                       (:pin-table-rows s))
          n (count table-rows)]
      (when (pos? n)
        (let [selected-id (:pin-selected-id s)
              editor-open? (:pin-editor-open? s)
              separator-open? (:pin-separator-overlay-open? s)
              current-idx (or (selected-row-index table-rows selected-id)
                              (if (pos? delta) -1 n))
              next-idx (-> (+ current-idx delta)
                           (max 0)
                           (min (dec n)))
              next-id (:id (nth table-rows next-idx))]
          (navigate-pin-row! next-id editor-open? separator-open?)
          (set-pin-table-keyboard-focus!))))))
