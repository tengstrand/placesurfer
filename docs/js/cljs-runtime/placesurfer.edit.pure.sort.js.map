(ns placesurfer.edit.pure.sort
  (:require [clojure.string :as str]))

(defn table-sort-data-field
  "Maps UI sort keys to row data keys."
  [sort-key]
  (case sort-key
    :action-icon :action
    :source-icon :source
    :distance :meters
    sort-key))

(defn compare-field-values
  "Sort helper: numbers asc, nils last, strings case-insensitive."
  [a b]
  (cond
    (and (number? a) (number? b))
    (compare a b)

    (nil? a) 1
    (nil? b) -1

    :else
    (compare (str/lower-case (str a)) (str/lower-case (str b)))))
