(ns hitteri.country-ui.filter)

(defn label-starts-with?
  [label query]
  (let [q (.trim (or query ""))
        label-str (str (or label ""))]
    (or (empty? q)
        (.startsWith (.toLowerCase label-str) (.toLowerCase q)))))

(defn filter-countries
  [countries query]
  (vec (filter #(label-starts-with? (:label %) query) (or countries []))))

(defn order-selected-first
  [countries selected-slug]
  (let [selected (vec (filter #(= selected-slug (:slug %)) countries))
        rest (vec (remove #(= selected-slug (:slug %)) countries))]
    (into selected rest)))

(defn visible-countries
  [countries query selected-slug]
  (order-selected-first (filter-countries countries query) selected-slug))
