(ns placesurfer.topic-ui.rows
  "View-model for topic sidebar and nav: one row map per topic definition.")

(defn for-topics
  [active-topics loading-topics topic-definitions]
  (mapv (fn [{:keys [topic label marker-url]}]
          {:topic topic
           :active? (contains? active-topics topic)
           :loading? (contains? loading-topics topic)
           :label label
           :marker-url marker-url})
        topic-definitions))
