(ns hitteri.app-ui.core
  (:require [clojure.string :as str]
            [hitteri.country.interface :as country]))

(defn- coerce-form-field [v]
  (cond
    (string? v) v
    (nil? v) ""
    :else (str v)))

(defn- map-page? [page]
  (contains? #{:home :topic :country} page))

(defn- iso->flag [iso]
  (when (and iso (= 2 (count iso)))
    (let [upper (.toUpperCase iso)
          base (- 0x1F1E6 65)]
      (str (js/String.fromCodePoint (+ base (.charCodeAt upper 0)))
           (js/String.fromCodePoint (+ base (.charCodeAt upper 1)))))))

(defn- nav-tab [label tab-page active-page]
  (let [panel-name (name tab-page)
        active? (= tab-page active-page)]
    [:sl-tab {:slot "nav"
              :panel panel-name
              :active active?}
     label]))

(defn- nav-country-tab [country-code active-page]
  [:sl-tab.nav-country-tab
   {:slot "nav"
    :panel "country"
    :active (= :country active-page)}
   [:span.nav-country-tab-icon (iso->flag (or country-code "SE"))]])

(defn- nav-update-tab
  [{:keys [active-page navigate!]}]
  [:sl-tab.nav-update-tab
   {:slot "nav"
    :panel "update"
    :active (= :update active-page)
    :on {:click (fn [_]
                  (when navigate!
                    (navigate! :update)))}}
   [:span.nav-update-tab-content
    [:img.nav-update-icon
     {:src "/images/edit.png"
      :alt "update"}]]])

(defn- nav-topic-tab [topic-rows active-page]
  (let [active-topics (vec (filter :active? topic-rows))
        fallback-discgolf (some #(when (= :discgolf (:topic %)) %) topic-rows)
        selected-topic (if (= 1 (count active-topics))
                         (first active-topics)
                         (or fallback-discgolf
                             {:topic :discgolf
                              :marker-url "data/discgolf/marker.png"}))]
    [:sl-tab.nav-topic-tab
     {:slot "nav"
      :panel "topic"
      :active (= :topic active-page)}
     [:span.nav-topic-tab-icons
      [:span.nav-topic-icon-wrap
       [:img
        {:class (str "nav-topic-icon nav-topic-icon--" (name (:topic selected-topic)))
         :src (:marker-url selected-topic)
         :alt (name (:topic selected-topic))}]]]]))

(defonce !synced-nav-page (atom nil))

(defn- sync-tab-group-on-page! [^js group page]
  (when (and group (not= page @!synced-nav-page))
    (let [name (name page)
          run (fn []
                (when (and group (.-show group))
                  (let [active-tab (.-activeTab group)
                        active-panel (when active-tab (.-panel active-tab))]
                    (when (not= active-panel name)
                      (.show group name))
                    (reset! !synced-nav-page page))))]
      (if (.-show group) (run) (js/setTimeout run 0)))))

(defn- nav-tabs
  [page navigate! backend-online? country-code topic-rows]
  [:sl-tab-group.nav-tab-group
   {:replicant/on-render (fn [{:keys [replicant/node]}]
                           (sync-tab-group-on-page! node page))
    :on {:sl-tab-show (fn [^js e]
                        (let [name (.-name (.-detail e))]
                          (when (seq name)
                            (reset! !synced-nav-page (keyword name))
                            (when (not= page (keyword name))
                              (navigate! (keyword name))))))}}
   (nav-tab "home" :home page)
   (nav-tab "about" :about page)
   (nav-country-tab country-code page)
   (nav-topic-tab topic-rows page)
   (nav-update-tab {:active-page page
                    :navigate! navigate!})
   [:sl-tab-panel {:name "home"}]
   [:sl-tab-panel {:name "topic"}]
   [:sl-tab-panel {:name "country"}]
   [:sl-tab-panel {:name "update"}]
   [:sl-tab-panel {:name "about"}]])

(def ^:private github-sponsors-url "https://github.com/sponsors/tengstrand")

(defn- external-link [href label]
  [:a.about-link
   {:href href :target "_blank" :rel "noopener noreferrer"}
   label])

(defn- about-panel []
  [:motion.about-section
   [:h2.about-heading "Sponsor me"]
   [:div.about-author
    [:img.about-avatar
     {:src "https://github.com/tengstrand.png"
      :alt "Joakim Tengstrand"
      :width "48"
      :height "48"}]
    [:p.about-bio
     "My name is Joakim Tengstrand, and I'm the author of this site. If you would like to sponsor me, please visit my "
     (external-link github-sponsors-url "GitHub Sponsors page")
     "."]]])

(defn- country-row-class [selected? keyboard-highlight?]
  (str/join " "
            (remove nil? [(when selected? "country-row--selected")
                            (when keyboard-highlight? "country-row--keyboard-focus")])))

(defn- country-row [{:keys [iso label slug]} selected? keyboard-highlight? select-country!]
  [:button.country-row
   {:type "button"
    :class (country-row-class selected? keyboard-highlight?)
    :replicant/on-render (fn [{:keys [replicant/node]}]
                           (when (and keyboard-highlight? node)
                             (.scrollIntoView node #js {:block "nearest"})))
    :on {:click (fn [_] (select-country! slug))}}
   [:span.country-flag (iso->flag iso)]
   [:span.country-label label]])

(defn- label-starts-with? [label query]
  (let [q (.trim (or query ""))
        label-str (str (or label ""))]
    (or (empty? q)
        (.startsWith (.toLowerCase label-str) (.toLowerCase q)))))

(defn- filter-countries [countries query]
  (vec (filter #(label-starts-with? (:label %) query) (or countries []))))

(defn- order-selected-first [countries selected-slug]
  (let [selected (vec (filter #(= selected-slug (:slug %)) countries))
        rest (vec (remove #(= selected-slug (:slug %)) countries))]
    (into selected rest)))

(defn- sync-country-search! [^js node value]
  (when node
    (let [v (or value "")]
      (when (and (not= (.-value node) v)
                 (or (empty? v)
                     (not= node (.-activeElement js/document))))
        (set! (.-value node) v)))))

(defn- handle-country-search-keydown!
  [e country-highlight-index visible n select-country! set-country-highlight-index! navigate!]
  (let [key (.-key e)
        trimmed (.trim (.-value (.-target e)))]
    (case key
      "ArrowDown"
      (do (.preventDefault e)
          (set-country-highlight-index!
           (country/step-highlight-index country-highlight-index n 1)))

      "ArrowUp"
      (do (.preventDefault e)
          (set-country-highlight-index!
           (country/step-highlight-index country-highlight-index n -1)))

      "Enter"
      (do (.preventDefault e)
          (if (empty? trimmed)
            (navigate! :home)
            (when (pos? n)
              (let [idx (or country-highlight-index 0)
                    slug (get-in visible [idx :slug])]
                (when slug (select-country! slug))))))

      nil)))

(defn- country-search [value country-slug countries country-highlight-index
                      set-country-filter! set-country-highlight-index!
                      select-country! navigate!]
  (let [visible-for-keys (fn [query]
                           (order-selected-first
                            (filter-countries countries query)
                            country-slug))]
    [:input.country-search
     {:type "search"
      :placeholder "Search country…"
      :aria-label "Search country"
      :replicant/on-render (fn [{:keys [replicant/node]}]
                             (sync-country-search! node value))
      :on {:input (fn [e]
                    (let [query (.-value (.-target e))
                          visible (visible-for-keys query)]
                      (set-country-filter! query (count visible))))
           :keydown (fn [e]
                      (let [trimmed (.trim (.-value (.-target e)))
                            visible (visible-for-keys trimmed)]
                        (handle-country-search-keydown!
                         e country-highlight-index visible (count visible)
                         select-country! set-country-highlight-index! navigate!)))}}]))

(defn- sync-checkbox! [^js node active?]
  (when (and node (not= (.-checked node) active?))
    (set! (.-hitteriSyncing node) true)
    (set! (.-checked node) active?)
    (js/setTimeout #(set! (.-hitteriSyncing node) false) 0)))

(defn- topic-row [{:keys [topic active? loading? label marker-url set-topic-active!]}]
  [:motion.topic-row
   [:sl-checkbox {:size "small"
                  :checked active?
                  :replicant/on-render (fn [{:keys [replicant/node]}]
                                         (sync-checkbox! node active?))
                  :on {:sl-change (fn [^js e]
                                    (let [^js target (.-target e)]
                                      (when (and (not (.-hitteriSyncing target))
                                                 (not (.-hitteriTopicBatchSync js/window)))
                                        (set-topic-active! topic (.-checked target)))))}}
    [:span.topic-row-content
     [:span.topic-icon-wrap
      [:img
       {:class (str "topic-icon topic-icon--" (name topic))
        :src marker-url
        :alt ""}]]
     [:span.topic-label label]
     (when loading?
       [:span.country-loading-spinner.topic-loading-spinner {:aria-hidden "true"}])]]])

(defn- map-container [{:keys [element-id mount-map! unmount-map!]}]
  [:div.map-root {:key (str "map-container-" element-id)
                  :id element-id
                  :style {:border "1px solid #ddd"}
                  :replicant/on-mount (fn [{:keys [replicant/node]}]
                                        (js/setTimeout #(when mount-map! (mount-map! node)) 0))
                  :replicant/on-unmount (fn [_]
                                          (when unmount-map! (unmount-map!)))}])

(defn- topic-panel [{:keys [rows set-topic-active! show-map! mobile?]}]
  (let [has-topics? (some :active? rows)]
    [:motion.topic-section
     [:motion.topic-list
      (for [{:keys [topic active? loading? label marker-url]} rows]
        ^{:key (name topic)}
        (topic-row {:topic topic
                    :active? active?
                    :loading? loading?
                    :label label
                    :marker-url marker-url
                    :set-topic-active! set-topic-active!}))]
     (when-not has-topics?
       [:p.topic-empty-message "Select at least one topic"])
     (when mobile?
       [:div.topic-actions
        [:button.topic-show
         {:type "button"
          :disabled (not has-topics?)
          :on {:click (fn [_] (show-map!))}}
         "Show"]])]))

(defn- country-panel [{:keys [countries country-slug country-filter country-highlight-index
                              status countries-loading?
                              select-country! set-country-filter! set-country-highlight-index!
                              navigate! ensure-countries-loaded!]}]
  (let [countries (or countries [])
        filter-q (or country-filter "")
        status-str (str (or status ""))
        load-error? (str/starts-with? status-str "Error")
        visible (order-selected-first
                 (filter-countries countries filter-q)
                 country-slug)]
    [:div.country-section
     {:replicant/on-mount (fn [_]
                            (when ensure-countries-loaded!
                              (ensure-countries-loaded!)))}
     (country-search filter-q country-slug countries country-highlight-index
                      set-country-filter! set-country-highlight-index!
                      select-country! navigate!)
     [:div.country-list {:key (str "country-list-" (count countries))}
      (cond
        load-error?
        [:p.country-list-message.country-list-message--error status-str]

        (empty? countries)
        [:p.country-list-message "Loading countries…"]

        (empty? visible)
        [:p.country-list-message "No matching countries"]

        :else
        (map-indexed
         (fn [idx {:keys [slug] :as country}]
           ^{:key slug}
           (country-row country
                        (= slug country-slug)
                        (= idx country-highlight-index)
                        select-country!))
         visible))]]))

(defn- display-cell-value [v]
  (cond
    (nil? v) ""
    (keyword? v) (name v)
    :else (str v)))

(defn- display-status-text [v]
  (when (some? v)
    (let [s (str/trim (str v))]
      (when (seq s) s))))

(defn- source-label [source]
  (cond
    (keyword? source) (name source)
    (symbol? source) (name source)
    (string? source) source
    :else nil))

(defn- source-icon-src [source]
  (when-let [source-name (some-> (source-label source) str/lower-case not-empty)]
    (str "/images/source/" source-name ".png")))

(defn- update-row-marker-icon-src [values]
  (when (= :url-pin (:marker-topic values))
    "/images/edit.png"))

(defn- source-display-name [source]
  (source-label source))

(defn- sort-indicator [sort-field sort-dir column-key]
  (when (= sort-field column-key)
    (if (= sort-dir :asc) " ↑" " ↓")))

(defn- update-table-cell
  [row-id values key]
  (cond
    (= key :action-icon)
    [:td.update-action-cell
     (cond
       (= :added (:action values))
       [:img.update-row-action-icon
        {:src "/images/added.png"
         :alt "added"}]

       (= :deleted (:action values))
       [:img.update-row-action-icon
        {:src "/images/removed.png"
         :alt "deleted"}]

       (= :edited (:action values))
       [:img.update-row-action-icon
        {:src "/images/edited.png"
         :alt "edited"}])]

    (= key :source-icon)
    [:td.update-source-cell
     (when-let [src (or (update-row-marker-icon-src values)
                        (source-icon-src (:source values)))]
       [:img.update-source-icon
        {:src src
         :alt (display-cell-value (or (:source values) "place"))
         :title (display-cell-value (or (:source values) "place"))}])]

    (= key :meters)
    [:td.update-meters-cell (display-cell-value (get values key))]

    :else
    [:td (display-cell-value (get values key))]))

(defn- update-panel
  [{:keys [update-topic-invalid?
           update-form
           update-table-columns update-table-rows
           update-sort-field update-sort-dir
           update-loading? update-error update-message
           update-delete-enabled? update-save-dataset-disabled?
           update-clipboard-valid-url?
           set-update-name! set-update-locality! set-update-homepage!
           set-update-longitude! set-update-latitude!
           create-new-update-row!
           toggle-update-row! set-update-sort!
           toggle-selected-update-row-delete!
           save-update-dataset!
           unmount-map!]
    :as panel-props}]
  (let [mount-update-map-fn (:mount-update-map! panel-props)]
  (let [{:keys [locality homepage longitude latitude]} update-form
        place-name (:name update-form)]
    [:section.update-section
     [:div.update-layout
      [:aside.update-editor
       (when update-topic-invalid?
         [:p.update-error "Select exactly one topic to continue"])
       [:div.update-field-row
        [:label.update-label {:for "update-name"} "Name"]
        [:input#update-name.update-input
         {:type "text"
          :value (coerce-form-field place-name)
          :on {:input (fn [e] (set-update-name! (.. e -target -value)))}}]]
       [:div.update-field-row
        [:label.update-label {:for "update-locality"} "Locality"]
        [:input#update-locality.update-input
         {:type "text"
          :value (coerce-form-field locality)
          :on {:input (fn [e] (set-update-locality! (.. e -target -value)))}}]]
       [:div.update-field-row
        [:label.update-label {:for "update-longitude"} "Longitude"]
        [:input#update-longitude.update-input
         {:type "text"
          :inputmode "decimal"
          :value (coerce-form-field longitude)
          :on {:input (fn [e] (set-update-longitude! (.. e -target -value)))}}]]
       [:div.update-field-row
        [:label.update-label {:for "update-latitude"} "Latitude"]
        [:input#update-latitude.update-input
         {:type "text"
          :inputmode "decimal"
          :value (coerce-form-field latitude)
          :on {:input (fn [e] (set-update-latitude! (.. e -target -value)))}}]]
       [:div.update-field-row
        [:label.update-label {:for "update-homepage"} "Homepage"]
        [:input#update-homepage.update-input
         {:type "text"
          :value (coerce-form-field homepage)
          :on {:input (fn [e] (set-update-homepage! (.. e -target -value)))}}]]

       (when-let [err (display-status-text update-error)]
         [:p.update-error err])
       (when-let [msg (display-status-text update-message)]
         [:p.update-message msg])
       [:div.update-map-panel
        (map-container {:element-id "update-map"
                        :mount-map! mount-update-map-fn
                        :unmount-map! unmount-map!})]]

      [:div.update-table-wrap
       (when-not update-loading?
         [:div.update-table-toolbar
          [:button.update-new-btn
           {:type "button"
            :title (if update-clipboard-valid-url?
                     "Paste Google Maps URL from clipboard"
                     "Paste Google Maps URL from clipboard, or clear")
            :on {:click (fn [_] (create-new-update-row!))}}
           (when update-clipboard-valid-url?
             [:img.update-new-btn-icon
              {:src "/images/link.png" :alt ""}])
           "New"]
          [:button.update-delete-btn
           {:type "button"
            :disabled (not update-delete-enabled?)
            :title "Toggle delete on selected row"
            :on {:click (fn [_] (toggle-selected-update-row-delete!))}}
           [:img {:src "/images/trash.png" :alt "Delete selected row"}]]
          [:button.update-dataset-save
           {:type "button"
            :disabled (boolean update-save-dataset-disabled?)
            :on {:click (fn [e]
                          (.stopPropagation e)
                          (save-update-dataset!))}}
           "Save"]])
       (if update-loading?
         [:p.update-loading "Loading dataset..."]
         [:table.update-table
          [:thead
           [:tr.update-table-header-row
            (for [{:keys [key label sortable?]} update-table-columns]
              ^{:key (name key)}
              [:th
               {:class (cond
                         (= key :action-icon) "update-action-header"
                         (= key :source-icon) "update-source-header"
                         (= key :meters) "update-meters-header"
                         sortable? "update-th-sortable")
                :on (when sortable?
                      {:click (fn [_] (set-update-sort! key))})}
               (cond
                 (= key :action-icon)
                 [:img.update-action-header-icon
                  {:src "/images/floppy.png" :alt "save status"}]
                 :else
                 (str label (or (sort-indicator update-sort-field update-sort-dir key) "")))])]]
          [:tbody
           (for [{:keys [row-id selected? values]} update-table-rows]
             ^{:key row-id}
             [:tr.update-row
              {:class (when selected? "update-row--selected")
               :on {:click (fn [_] (toggle-update-row! row-id))}}
              (for [{:keys [key]} update-table-columns]
                ^{:key (str row-id "-" (name key))}
                (update-table-cell row-id values key))])]])]]])))

(defn view
  [{:keys [page countries country-slug country-iso country-filter country-highlight-index
           status countries-loading? map-status
           active-topics topic-rows navigate! select-country! set-country-filter!
           set-country-highlight-index! set-topic-active! ensure-countries-loaded!
           mobile?
           show-map!
           mount-map! unmount-map!
           backend-online?
           update-country-code
           update-topic-invalid?
           update-form
           update-table-columns update-table-rows
           update-sort-field update-sort-dir
           update-loading? update-error update-message
           update-delete-enabled? update-save-dataset-disabled?
           update-clipboard-valid-url?
           set-update-name! set-update-locality! set-update-homepage!
           set-update-longitude! set-update-latitude!
           create-new-update-row!
           toggle-update-row! set-update-sort!
           toggle-selected-update-row-delete!
           save-update-dataset!]
    :as props
    :or {page :home countries [] country-filter "" topic-rows [] active-topics #{}
         mobile? false
         backend-online? false}}]
  (let [mount-update-map-fn (:mount-update-map! props)]
  [:main.app {:data-page (name page)}
   [:nav.nav-tabs
    (nav-tabs page navigate! backend-online?
              (or country-iso "SE") topic-rows)]
   (if (= :about page)
     [:section.about-page (about-panel)]
     [:div.workspace
      (when (= :topic page)
        [:aside.topic-sidebar-panel
         (topic-panel {:rows topic-rows
                       :set-topic-active! set-topic-active!
                       :show-map! show-map!
                       :mobile? mobile?})])
      (when (= :country page)
        [:aside.country-sidebar-panel
         (country-panel {:countries countries
                         :country-slug country-slug
                         :country-filter country-filter
                         :country-highlight-index country-highlight-index
                         :status status
                         :countries-loading? countries-loading?
                         :select-country! select-country!
                         :set-country-filter! set-country-filter!
                         :set-country-highlight-index! set-country-highlight-index!
                         :navigate! navigate!
                         :ensure-countries-loaded! ensure-countries-loaded!})])
      (when (= :update page)
        (let [offline-msg (when (and (not backend-online?)
                                     (not (display-status-text update-error)))
                            "Backend service is not running")]
          [:section.update-page
           (update-panel {:update-topic-invalid? update-topic-invalid?
                          :update-form update-form
                          :update-table-columns update-table-columns
                          :update-table-rows update-table-rows
                          :update-sort-field update-sort-field
                          :update-sort-dir update-sort-dir
                          :update-loading? update-loading?
                          :update-error (or update-error offline-msg)
                          :update-message update-message
                          :update-delete-enabled? update-delete-enabled?
                          :update-save-dataset-disabled? update-save-dataset-disabled?
                          :update-clipboard-valid-url? update-clipboard-valid-url?
                          :set-update-name! set-update-name!
                          :set-update-locality! set-update-locality!
                          :set-update-homepage! set-update-homepage!
                          :set-update-longitude! set-update-longitude!
                          :set-update-latitude! set-update-latitude!
                          :create-new-update-row! create-new-update-row!
                          :toggle-update-row! toggle-update-row!
                          :set-update-sort! set-update-sort!
                          :toggle-selected-update-row-delete! toggle-selected-update-row-delete!
                          :save-update-dataset! save-update-dataset!
                          :mount-update-map! mount-update-map-fn
                          :unmount-map! unmount-map!})]))
      (when (and (map-page? page)
                 (not (and mobile? (contains? #{:topic :country} page))))
        [:div.map-area {:key "map-area"}
         (when-let [status (display-status-text map-status)]
           [:div.map-status {:data-map-status "true"} status])
         (map-container {:element-id "map"
                         :mount-map! mount-map!
                         :unmount-map! unmount-map!})])])]))
