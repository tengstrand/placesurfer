(ns placesurfer.app-ui.ui.view
  (:require [placesurfer.about-ui.interface :as about-ui]
            [placesurfer.app-ui.ui.pages :as pages]
            [placesurfer.app-ui.ui.workspace :as workspace]
            [placesurfer.nav-ui.interface.tabs :as nav-ui.tabs]
            [placesurfer.settings-ui.interface :as settings-ui]))

(defn view
  [{:keys [page country-iso topic-rows navigate! navigate-to-pin! navigate-to-update!
           backend-online? app-version
           locale t set-locale!
           transit-destination set-transit-destination!
           dropbox-configured? dropbox-connected? dropbox-account-email dropbox-sync-error
           connect-dropbox! disconnect-dropbox!]
    :as props
    :or {page :pin topic-rows [] backend-online? false locale :en
         update-form-field-errors {}
         commit-update-longitude! (fn [_] nil)
         commit-update-latitude! (fn [_] nil)
         t (fn [k] (name k))
         set-locale! (fn [_] nil)
         transit-destination ""
         set-transit-destination! (fn [_] nil)
         connect-dropbox! (fn [] nil)
         disconnect-dropbox! (fn [] nil)}}]
  [:main.app {:data-page (name page)}
   [:nav.nav-tabs
    (nav-ui.tabs/tabs {:page page
                       :navigate! navigate!
                       :navigate-to-pin! navigate-to-pin!
                       :navigate-to-update! navigate-to-update!
                       :backend-online? backend-online?
                       :country-code (or country-iso "SE")
                       :topic-rows topic-rows
                       :app-version app-version
                       :t t})]
   (cond
     (pages/about-page? page)
     [:section.about-page (about-ui/panel props)]

     (pages/settings-page? page)
     [:section.settings-page (settings-ui/panel {:locale locale
                                                 :set-locale! set-locale!
                                                 :t t
                                                 :transit-destination transit-destination
                                                 :set-transit-destination! set-transit-destination!
                                                 :dropbox-configured? dropbox-configured?
                                                 :dropbox-connected? dropbox-connected?
                                                 :dropbox-account-email dropbox-account-email
                                                 :dropbox-sync-error dropbox-sync-error
                                                 :connect-dropbox! connect-dropbox!
                                                 :disconnect-dropbox! disconnect-dropbox!})]

     :else
     (workspace/workspace props))])
