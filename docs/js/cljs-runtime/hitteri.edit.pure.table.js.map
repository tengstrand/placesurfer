(ns hitteri.edit.pure.table
  (:require [hitteri.edit.pure.columns :as columns]
            [hitteri.edit.pure.coords :as coords]
            [hitteri.edit.pure.sort :as sort]))

(def ^:private lead-order
  [:name :longitude :latitude :locality :homepage])

(defn as-update-columns
  [cols]
  (if (sequential? cols) (vec cols) []))

(defn distance-sort-active?
  [selected-row]
  (coords/row-has-coords? selected-row))

(defn visible-data-column-keys
  [update-columns]
  (vec (remove #{:source} (as-update-columns update-columns))))

(defn preferred-column-keys
  [update-columns]
  (let [visible (visible-data-column-keys update-columns)]
    (vec (concat
          [:action-icon :source-icon :meters]
          (filter (set visible) lead-order)
          (remove (set lead-order) visible)))))

(defn table-columns
  ([update-columns] (table-columns update-columns nil))
  ([update-columns t]
   (mapv (fn [k]
           {:key k
            :label (if t
                     (columns/column-label k t)
                     (columns/column-label k))
            :sortable? true})
         (preferred-column-keys update-columns))))

(defn resolve-table-sort
  [update-sort distance-sort?]
  (let [requested-sort-field (if (= (:field update-sort) :distance)
                               :meters
                               (:field update-sort))
        data-sort-field (sort/table-sort-data-field requested-sort-field)
        ui-sort-field (cond
                        requested-sort-field requested-sort-field
                        distance-sort? :meters
                        :else :name)
        sort-field (or data-sort-field ui-sort-field)
        sort-dir (if (and distance-sort? (not requested-sort-field))
                   :asc
                   (let [d (:dir update-sort)]
                     (if (contains? #{:asc :desc} d) d :asc)))]
    {:ui-sort-field ui-sort-field
     :data-sort-field data-sort-field
     :sort-field sort-field
     :sort-dir sort-dir}))

(defn update-columns-for-rows
  [rows]
  (let [all-cols (->> rows
                      (mapcat keys)
                      set
                      (remove #{:row-id :action :pending? :marker-topic :meters :url-form})
                      sort
                      vec)]
    (if (some #{:name} all-cols)
      (vec (cons :name (remove #{:name} all-cols)))
      all-cols)))

(defn sort-update-table-rows
  [rows {:keys [sort-field sort-dir]} pin-row?]
  (let [sortable-rows (remove pin-row? rows)
        sorted-sortable (sort-by #(get % sort-field)
                                 (fn [a b]
                                   (let [cmp (sort/compare-field-values a b)]
                                     (if (= sort-dir :asc) cmp (- cmp))))
                                 sortable-rows)
        pinned-drafts (vec (filter pin-row? rows))]
    (into pinned-drafts sorted-sortable)))
