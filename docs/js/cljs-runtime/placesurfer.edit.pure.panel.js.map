(ns placesurfer.edit.pure.panel
  (:require [placesurfer.edit.pure.cells :as cells]
            [placesurfer.edit.pure.model :as model]
            [placesurfer.edit.pure.scroll :as scroll]
            [placesurfer.edit.pure.splitter :as splitter]
            [placesurfer.edit.pure.sources :as sources]
            [placesurfer.edit.pure.topic-dropdown :as topic-dropdown]
            [placesurfer.edit.pure.topic-switch-dialog :as topic-switch-dialog]
            [placesurfer.edit.pure.topics :as edit-ui.topics]
            [placesurfer.html.interface.description-field :as description-field]
            [placesurfer.map-panel-ui.interface.container :as map-panel-ui.container]
            [placesurfer.map-panel-ui.interface.status :as map-panel-ui.status]
            [placesurfer.map-ui.interface :as map-ui]
            [placesurfer.pin-ui.interface.editor-pane :as pin-editor-pane]
            [placesurfer.pin-ui.interface.list-panel :as pin-list-panel]))

(defn- field-error [field-errors k]
  (when-let [err (get field-errors k)]
    (when-let [text (map-panel-ui.status/display-status-text err)]
      [:p.update-field-error text])))

(defn- update-row-map-hover-handlers [values]
  (let [{:keys [longitude latitude]} values]
    (when (and (number? longitude) (number? latitude))
      {:mouseenter (fn [_]
                    (map-ui/set-marker-row-emphasis!
                     {:longitude longitude :latitude latitude}))
       :mouseleave (fn [_] (map-ui/clear-marker-row-emphasis!))})))

(defn- change-count-box [kind n t]
  [:span.update-change-count
   {:class (str "update-change-count--" (name kind))
    :aria-label (case kind
                  :deleted (t :update/changes-deleted {:n n})
                  :edited (t :update/changes-edited {:n n})
                  :added (t :update/changes-added {:n n}))}
   (str n)])

(defn- map-panel-style [height-px]
  (when height-px
    {:height (str height-px "px")
     :flex (str "0 0 " height-px "px")}))

(defn- map-panel [mount-update-map-fn unmount-map! update-map-height-px]
  (let [map-style (map-panel-style update-map-height-px)]
    [:div.update-map-panel
     {:class (when update-map-height-px "update-map-panel--sized")
      :style map-style}
     (map-panel-ui.container/container {:element-id "update-map"
                                        :mount-map! mount-update-map-fn
                                        :unmount-map! unmount-map!})]))

(defn- editor-splitter [set-update-map-height! schedule-update-map-resize! t]
  [:div.update-editor-splitter
   {:role "separator"
    :aria-orientation "horizontal"
    :aria-label (t :update/splitter-aria)
    :title (t :update/splitter-title)
    :replicant/on-mount (splitter/mount-splitter!
                         set-update-map-height!
                         schedule-update-map-resize!)}])

(defn- dataset-editor-form [props]
  (let [{:keys [update-form update-form-field-errors
                set-update-name! set-update-locality! set-update-homepage!
                set-update-longitude! commit-update-longitude!
                set-update-latitude! commit-update-latitude!
                try-paste-update-coordinates! t]} props
        {:keys [locality homepage longitude latitude]} update-form
        place-name (:name update-form)]
    [:div.update-editor-form
     [:div.update-field-row
      [:label.update-label {:for "update-name"} (t :common/name)]
      [:div.update-field-control
       [:input#update-name.update-input
        {:type "text"
         :value (sources/coerce-form-text place-name)
         :on {:input (fn [e] (set-update-name! (.. e -target -value)))}}]
       (field-error update-form-field-errors :name)]]
     [:div.update-field-row
      [:label.update-label {:for "update-locality"} (t :common/locality)]
      [:div.update-field-control
       [:input#update-locality.update-input
        {:type "text"
         :value (sources/coerce-form-text locality)
         :on {:input (fn [e] (set-update-locality! (.. e -target -value)))}}]]]
     [:div.update-field-row
      [:label.update-label {:for "update-longitude"} (t :common/longitude)]
      [:div.update-field-control
       [:input#update-longitude.update-input
        {:type "text"
         :inputmode "decimal"
         :value (sources/coerce-form-text longitude)
         :on {:input (fn [e] (set-update-longitude! (.. e -target -value)))
              :blur (fn [e] (commit-update-longitude! (.. e -target -value)))
              :paste (fn [e]
                       (when (try-paste-update-coordinates!
                              (.getData (.-clipboardData e) "text"))
                         (.preventDefault e)))}}]
       (field-error update-form-field-errors :longitude)]]
     [:div.update-field-row
      [:label.update-label {:for "update-latitude"} (t :common/latitude)]
      [:div.update-field-control
       [:input#update-latitude.update-input
        {:type "text"
         :inputmode "decimal"
         :value (sources/coerce-form-text latitude)
         :on {:input (fn [e] (set-update-latitude! (.. e -target -value)))
              :blur (fn [e] (commit-update-latitude! (.. e -target -value)))
              :paste (fn [e]
                       (when (try-paste-update-coordinates!
                              (.getData (.-clipboardData e) "text"))
                         (.preventDefault e)))}}]
       (field-error update-form-field-errors :latitude)]]
     [:div.update-field-row
      [:label.update-label {:for "update-homepage"} (t :common/homepage)]
      [:div.update-field-control
       [:input#update-homepage.update-input
        {:type "text"
         :value (sources/coerce-form-text homepage)
         :on {:input (fn [e] (set-update-homepage! (.. e -target -value)))}}]
       (field-error update-form-field-errors :homepage)]]]))

(defn- topic-dropdown-toolbar [props]
  (when (:backend-online? props)
    (let [{:keys [update-topic update-topic-before-pins update-topic-options
                  toggle-update-pin-topic! t]
           :or {t (fn [k] (name k))}} props
          pins-mode? (edit-ui.topics/pins-topic? update-topic)
          toggle-option (when pins-mode?
                          (edit-ui.topics/pin-toggle-target-option
                           update-topic-options
                           update-topic-before-pins))
          icon-url (if pins-mode?
                     (:marker-url toggle-option)
                     edit-ui.topics/pins-topic-icon-url)
          btn-title (if pins-mode? (:label toggle-option) (t :topic/pins))
          icon-topic (when pins-mode? (:topic toggle-option))]
      [:div.update-topic-toolbar-group
       (topic-dropdown/dropdown
        (select-keys props [:update-topic :update-topic-options :request-update-topic-change!]))
       [:button.update-topic-pin-btn
        {:type "button"
         :title btn-title
         :aria-label btn-title
         :on {:click (fn [e]
                       (.stopPropagation e)
                       (toggle-update-pin-topic!))}}
        [:img {:src icon-url
               :alt ""
               :class (if pins-mode?
                        (str "update-topic-pin-btn-icon update-topic-pin-btn-icon--topic"
                             (when icon-topic (str " update-topic-dropdown-icon--" (name icon-topic))))
                        "update-topic-pin-btn-icon update-topic-pin-btn-icon--pin")}]]])))

(defn- dataset-table-panel [props]
  (let [{:keys [update-table-columns update-table-rows update-table-scroll-token
                update-sort-field update-sort-dir update-loading?
                update-show-duplicates? update-restore-enabled?
                update-delete-enabled? update-save-dataset-disabled?
                update-change-counts
                update-row-click! set-update-sort!
                restore-selected-update-row! create-new-update-row!
                toggle-selected-update-row-delete!
                toggle-update-show-duplicates!
                save-update-dataset! t]} props]
    [:div.update-table-wrap
     [:div.update-table-toolbar
      (topic-dropdown-toolbar props)
      (when-not update-loading?
        [:div.update-table-toolbar-controls
         [:button.update-restore-btn
          {:type "button"
           :disabled (not update-restore-enabled?)
           :title (t :update/restore-title)
           :on {:click (fn [_] (restore-selected-update-row!))}}
          [:img {:src "/images/restore.png" :alt (t :update/restore-alt)}]]
         [:button.update-new-btn
          {:type "button"
           :title (t :update/new)
           :on {:click (fn [_] (create-new-update-row!))}}
          (t :update/new)]
         [:button.update-delete-btn
          {:type "button"
           :disabled (not update-delete-enabled?)
           :title (t :update/delete-title)
           :on {:click (fn [e]
                         (.stopPropagation e)
                         (toggle-selected-update-row-delete!))}}
          [:img {:src "/images/trash.png" :alt (t :update/delete-alt)}]]
         [:button.update-duplicates-btn
          {:type "button"
           :class (when update-show-duplicates? "update-duplicates-btn--active")
           :aria-pressed (boolean update-show-duplicates?)
           :title (if update-show-duplicates?
                    (t :update/duplicates-show-all)
                    (t :update/duplicates-show))
           :on {:click (fn [e]
                         (.stopPropagation e)
                         (toggle-update-show-duplicates!))}}
          [:img {:src "/images/duplicate.png" :alt (t :update/duplicates-show)}]]
         [:div.update-change-counts
          (change-count-box :deleted (:deleted update-change-counts 0) t)
          (change-count-box :edited (:edited update-change-counts 0) t)
          (change-count-box :added (:added update-change-counts 0) t)]
         [:button.update-dataset-save
          {:type "button"
           :disabled (boolean update-save-dataset-disabled?)
           :on {:click (fn [e]
                         (.stopPropagation e)
                         (save-update-dataset!))}}
          (t :common/save)]])]
     [:div.update-table-scroll
      {:replicant/on-mount (fn [{:keys [replicant/node]}]
                             (scroll/mount-table-scroll-preservation! node))
       :replicant/on-render (fn [{:keys [replicant/node]}]
                              (scroll/sync-table-wrap-scroll! node update-table-scroll-token))}
      (if update-loading?
        [:p.update-loading (t :update/loading-dataset)]
        [:table.update-table
         [:thead
          [:tr.update-table-header-row
           (for [{:keys [key label sortable?]} update-table-columns]
             ^{:key (name key)}
             [:th
              {:class (cond
                        (= key :action-icon) "update-action-header"
                        (= key :source-icon) "update-source-header"
                        (= key :meters) "update-meters-header"
                        (and sortable? (not update-show-duplicates?)) "update-th-sortable")
               :on (when (and sortable? (not update-show-duplicates?))
                     {:click (fn [_] (set-update-sort! key))})}
              (cells/table-column-header key label update-sort-field update-sort-dir)])]]
         [:tbody
          (for [{:keys [row-id selected? values]} update-table-rows]
            ^{:key row-id}
            [:tr.update-row
             {:class (when selected? "update-row--selected")
              :on (merge {:click (fn [_] (update-row-click! row-id))}
                         (or (update-row-map-hover-handlers values) {}))}
             (for [{:keys [key]} update-table-columns]
               ^{:key (str row-id "-" (name key))}
               (cells/table-cell row-id values key))])]])]]))

(defn view-props
  [state
   {:keys [update-table-model update-restore-enabled?
           update-save-dataset-disabled?
           update-topic-keys
           topic-marker-url-fn
           handlers map-handler-props t]}]
  (let [{:keys [columns rows sort-field sort-dir]} update-table-model
        {:keys [set-update-name! set-update-locality! set-update-homepage!
                set-update-description! flush-update-description! trace-update-description!
                set-update-longitude! commit-update-longitude!
                set-update-latitude! commit-update-latitude!
                try-paste-update-coordinates!
                create-new-update-row! restore-selected-update-row!
                toggle-update-row! update-row-click! set-update-sort!
                toggle-selected-update-row-delete! toggle-update-show-duplicates!
                set-update-map-height! schedule-update-map-resize!
                save-update-dataset!
                toggle-description-edit-mode!
                request-update-topic-change!
                toggle-update-pin-topic!
                cancel-update-topic-switch!
                discard-update-topic-switch!
                save-and-switch-update-topic!
                set-update-search-query! select-update-search-result!
                update-search-keydown!]} handlers
        topic-options (edit-ui.topics/topic-options-for-dropdown
                       update-topic-keys t
                       {:marker-url-fn topic-marker-url-fn})]
    {:update-form (:update-form state)
     :update-form-field-errors (:update-form-field-errors state {})
     :update-table-columns columns
     :update-table-rows rows
     :update-table-scroll-token (:update-table-scroll-token state)
     :update-sort-field sort-field
     :update-sort-dir sort-dir
     :update-loading? (:update-loading? state)
     :update-error (:update-error state)
     :update-show-duplicates? (:update-show-duplicates? state false)
     :update-map-height-px (:update-map-height-px state)
     :update-message (:update-message state)
     :update-delete-enabled? (some? (:update-selected-row-id state))
     :update-restore-enabled? update-restore-enabled?
     :update-save-dataset-disabled? update-save-dataset-disabled?
     :update-change-counts (model/dataset-change-counts state)
     :update-topic (:update-topic state)
     :update-topic-before-pins (:update-topic-before-pins state)
     :update-topic-options topic-options
     :backend-online? (:backend-online? state)
     :update-topic-switch-pending? (some? (:update-topic-switch-pending state))
     :update-search-query (:update-search-query state "")
     :update-search-results (:update-search-results state [])
     :update-search-loading? (:update-search-loading? state false)
     :update-search-highlight-index (:update-search-highlight-index state)
     :description-edit-mode (:description-edit-mode state :text)
     :description-sync-token (:description-sync-token state 0)
     :set-update-name! set-update-name!
     :set-update-locality! set-update-locality!
     :set-update-homepage! set-update-homepage!
     :set-update-description! set-update-description!
     :flush-update-description! flush-update-description!
     :trace-update-description! trace-update-description!
     :set-update-longitude! set-update-longitude!
     :commit-update-longitude! commit-update-longitude!
     :set-update-latitude! set-update-latitude!
     :commit-update-latitude! commit-update-latitude!
     :try-paste-update-coordinates! try-paste-update-coordinates!
     :create-new-update-row! create-new-update-row!
     :restore-selected-update-row! restore-selected-update-row!
     :toggle-update-row! toggle-update-row!
     :update-row-click! update-row-click!
     :set-update-sort! set-update-sort!
     :toggle-selected-update-row-delete! toggle-selected-update-row-delete!
     :toggle-update-show-duplicates! toggle-update-show-duplicates!
     :set-update-map-height! set-update-map-height!
     :schedule-update-map-resize! schedule-update-map-resize!
     :save-update-dataset! save-update-dataset!
     :toggle-description-edit-mode! toggle-description-edit-mode!
     :request-update-topic-change! request-update-topic-change!
     :toggle-update-pin-topic! toggle-update-pin-topic!
     :cancel-update-topic-switch! cancel-update-topic-switch!
     :discard-update-topic-switch! discard-update-topic-switch!
     :save-and-switch-update-topic! save-and-switch-update-topic!
     :set-update-search-query! set-update-search-query!
     :select-update-search-result! select-update-search-result!
     :update-search-keydown! update-search-keydown!
     :mount-update-map! (:mount-update-map! map-handler-props)
     :unmount-map! (:unmount-map! map-handler-props)
     :t t}))

(defn panel
  [{:keys [update-form update-error update-message
           update-map-height-px update-topic update-topic-switch-pending?
           description-edit-mode description-sync-token
           set-update-description! flush-update-description! trace-update-description!
           toggle-description-edit-mode!
           set-update-map-height! schedule-update-map-resize!
           pin-editor-mode
           t]
    :or {t (fn [k] (name k))}
    :as panel-props}]
  (let [mount-update-map-fn (:mount-update-map! panel-props)
        unmount-map! (:unmount-map! panel-props)
        pins-mode? (edit-ui.topics/pins-topic? update-topic)
        description-edit-mode* (or description-edit-mode :text)
        description-sync-token* (or description-sync-token 0)
        {:keys [description]} update-form]
    [:section.update-section
     {:class (str (when update-topic-switch-pending? "update-section--topic-switch-dialog-open ")
                  (when pins-mode? "update-section--pins"))}
     [:div.update-layout
      [:aside.update-editor
       {:class (when update-map-height-px "update-editor--split-set ")}
       (if pins-mode?
         [:div.update-editor-form.update-description-pane
          (pin-editor-pane/editor-pane
           (assoc panel-props :pin-editor-mode pin-editor-mode))]
         (dataset-editor-form panel-props))
          (when-not pins-mode?
         [:div.update-description-pane
          (description-field/description-field
           {:id "update-description"
            :description description
            :mode description-edit-mode*
            :sync-token description-sync-token*
            :set-description! set-update-description!
            :flush-description! flush-update-description!
            :trace-description! trace-update-description!
            :toggle-mode! toggle-description-edit-mode!
            :t t})
          (when-let [err (map-panel-ui.status/display-status-text update-error)]
            [:p.update-error err])
          (when-let [msg (map-panel-ui.status/display-status-text update-message)]
            [:p.update-message msg])])
       (editor-splitter set-update-map-height! schedule-update-map-resize! t)
       (map-panel mount-update-map-fn unmount-map! update-map-height-px)]
      (if pins-mode?
        [:div.pin-list-panel
         (pin-list-panel/list-panel
          (assoc panel-props
                 :show-editor-overlay? false
                 :show-preview-toggle? false
                 :show-drag-handle? false
                 :drag-from-whole-row? true
                 :show-toolbar-search? true
                 :toolbar-prefix (topic-dropdown-toolbar panel-props)))]
        (dataset-table-panel panel-props))]
     (when update-topic-switch-pending?
       (topic-switch-dialog/dialog panel-props))]))
