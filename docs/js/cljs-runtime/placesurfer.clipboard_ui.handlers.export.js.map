(ns placesurfer.clipboard-ui.handlers.export
  (:require [placesurfer.app-ui.interface.effects :as effects]
            [placesurfer.app-ui.interface.state :as app-state]
            [placesurfer.clipboard-ui.pure.browser :as browser]))

(defn export-pins-to-clipboard! []
  (when (browser/clipboard-write-available?)
    (let [items (or (:pin-items @app-state/!state) [])
          groups (mapv #(select-keys % [:label])
                       (filter #(= :separator (:kind %)) items))
          pins (first
                (reduce (fn [[acc current-label] item]
                          (if (= :separator (:kind item))
                            [acc (:label item)]
                            [(conj acc (cond-> (dissoc item :id)
                                         current-label (assoc :group current-label)))
                             current-label]))
                        [[] nil]
                        items))
          payload {:v 1 :type "placesurfer/pin-list" :pins pins :groups groups}
          json (.stringify js/JSON (clj->js payload))]
      (-> (.writeText js/navigator.clipboard json)
          (.then (fn [_]
                   (swap! app-state/!state assoc :pin-export-copied? true)
                   (effects/render!)
                   (js/setTimeout
                    (fn []
                      (swap! app-state/!state dissoc :pin-export-copied?)
                      (effects/render!))
                    1000)))
          (.catch (fn [_] nil))))))
