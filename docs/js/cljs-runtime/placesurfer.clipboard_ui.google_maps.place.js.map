(ns placesurfer.clipboard-ui.google-maps.place
  (:require [clojure.string :as str]
            [placesurfer.clipboard-ui.pure.numbers :as numbers]))

(defn- non-blank [s]
  (when-let [t (not-empty (str/trim (str s)))]
    t))

(defn- coord-text [v]
  (some-> (numbers/parse-number v) str))

(defn normalize-place-payload
  "Normalize bookmarklet `place` map (Google Maps) to kebab-case fields."
  [place]
  (when (map? place)
    {:name (or (non-blank (:name place))
               (non-blank (:title place)))
     :address (non-blank (:address place))
     :longitude (numbers/parse-number (or (:longitude place) (:lng place) (:lon place)))
     :latitude (numbers/parse-number (or (:latitude place) (:lat place)))}))

(defn place-has-coords?
  [place]
  (and (map? place)
       (number? (:latitude place))
       (number? (:longitude place))))

(defn place->pin-form
  "Map normalized Google Maps place + source url to pin editor form."
  [place source-url]
  (let [{:keys [name address longitude latitude]} place]
    {:name (or name "")
     :location (or address "")
     :icon "pin-orange.png"
     :longitude (or (coord-text longitude) "")
     :latitude (or (coord-text latitude) "")
     :url (or (non-blank source-url) "")
     :image ""
     :description ""}))
