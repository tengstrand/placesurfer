(ns hitteri.pin-ui.pure.coords
  (:require [clojure.string :as str]))

(def ^:private decimal-input-pattern
  #"^-?(?:\d+(?:\.\d*)?|\.\d+)$")

(defn- form-field-value-str [v]
  (cond
    (string? v) v
    (nil? v) ""
    :else (str v)))

(defn- normalize-decimal-input [v]
  (-> (form-field-value-str v)
      str/trim
      (str/replace #"\u2212" "-")
      (str/replace #"," ".")))

(defn- decimal-input-matches? [s]
  (boolean (and (seq s) (re-matches decimal-input-pattern s))))

(defn parse-decimal [v]
  (let [s (normalize-decimal-input v)]
    (when (decimal-input-matches? s)
      (let [n (js/parseFloat s)]
        (when-not (js/isNaN n) n)))))

(defn valid-longitude? [v]
  (let [n (parse-decimal v)]
    (and (number? n) (<= -180 n 180))))

(defn valid-latitude? [v]
  (let [n (parse-decimal v)]
    (and (number? n) (<= -90 n 90))))
