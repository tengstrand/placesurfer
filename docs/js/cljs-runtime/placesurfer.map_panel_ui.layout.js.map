(ns placesurfer.map-panel-ui.layout)

(defn sync-layout!
  []
  (when-let [^js nav (.querySelector js/document ".nav-tabs")]
    (let [^js root-style (.-style js/document.documentElement)
          ^js app (.querySelector js/document ".app")
          nav-bottom (.-bottom (.getBoundingClientRect nav))
          ^js nav-style (js/getComputedStyle nav)
          nav-margin-bottom (js/parseFloat (.-marginBottom nav-style))
          ^js app-style (when app (js/getComputedStyle app))
          pad-bottom (if app-style (js/parseFloat (.-paddingBottom app-style)) 12)
          pad-side (if app-style (js/parseFloat (.-paddingLeft app-style)) 12)]
      (.setProperty root-style "--map-nav-bottom"
                    (str (+ nav-bottom nav-margin-bottom) "px"))
      (.setProperty root-style "--map-bottom" (str pad-bottom "px"))
      (.setProperty root-style "--map-side" (str pad-side "px")))))
