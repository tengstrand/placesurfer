(ns placesurfer.edit.pure.baseline
  (:require [clojure.string :as str]
            [placesurfer.edit.pure.sources :as sources]))

(defn form-field-values
  [form]
  {:name (str/trim (str (:name form "")))
   :locality (str/trim (str (:locality form "")))
   :homepage (str/trim (str (:homepage form "")))
   :description (str/trim (str (:description form "")))
   :longitude (str/trim (str (:longitude form "")))
   :latitude (str/trim (str (:latitude form "")))
   :source (sources/source-name-for-save (:source form))})

(defn row->form-baseline
  [row]
  {:google-url ""
   :name (sources/coerce-form-text (:name row))
   :locality (sources/coerce-form-text (:locality row))
   :homepage (sources/coerce-form-text (:homepage row))
   :description (sources/coerce-form-text (:description row))
   :longitude (if (some? (:longitude row)) (str (:longitude row)) "")
   :latitude (if (some? (:latitude row)) (str (:latitude row)) "")
   :source (sources/normalize-update-source (:source row))})

(defn form-edited-from-baseline?
  [form baseline]
  (and (some? baseline)
       (not= (form-field-values form) (form-field-values baseline))))
