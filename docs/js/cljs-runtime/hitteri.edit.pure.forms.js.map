(ns hitteri.edit.pure.forms
  (:require [clojure.string :as str]
            [hitteri.edit.pure.coords :as coords]
            [hitteri.i18n.interface :as i18n]))

(defn- field-has-edge-whitespace? [v]
  (let [s (str v)]
    (and (seq s) (not= s (str/trim s)))))

(defn valid-update-name?
  [v]
  (boolean (seq (str/trim (coords/form-field-value-str v)))))

(defn valid-homepage?
  [v]
  (let [s (str/trim (str v))]
    (or (empty? s)
        (boolean (re-matches #"(?i)^https?://\S+$" s)))))

(defn- coordinate-field-error [v min max label-key t & {:keys [require-core?]}]
  (let [raw (coords/form-field-value-str v)
        s (coords/normalize-decimal-input v)
        label (t label-key)]
    (cond
      (field-has-edge-whitespace? raw)
      (t :validation/no-edge-whitespace)

      (empty? s)
      (when require-core? (t :validation/please-enter {:label label}))

      (not (coords/decimal-input-matches? s))
      (t :validation/coordinate-range {:label label :min min :max max})

      :else
      (let [n (js/parseFloat s)]
        (when (or (js/isNaN n) (not (<= min n max)))
          (t :validation/coordinate-range {:label label :min min :max max}))))))

(defn update-form-field-error
  [k v & {:keys [require-core? t] :or {t (partial i18n/t :en)}}]
  (cond
    (= k :name)
    (cond
      (field-has-edge-whitespace? v)
      (t :validation/no-edge-whitespace)

      (not (valid-update-name? v))
      (t :validation/name-required))

    (= k :longitude)
    (coordinate-field-error v -180 180 :common/longitude t :require-core? require-core?)

    (= k :latitude)
    (coordinate-field-error v -90 90 :common/latitude t :require-core? require-core?)

    (= k :homepage)
    (let [raw (coords/form-field-value-str v)]
      (cond
        (field-has-edge-whitespace? raw)
        (t :validation/no-edge-whitespace)

        (seq (str/trim raw))
        (when-not (valid-homepage? v)
          (t :validation/homepage-url))))

    :else nil))

(defn compute-update-form-field-errors
  ([form] (compute-update-form-field-errors form false))
  ([form require-core?] (compute-update-form-field-errors form require-core? (partial i18n/t :en)))
  ([form require-core? t]
   (into {}
         (keep (fn [k]
                 (when-let [err (update-form-field-error k (get form k)
                                                           :require-core? require-core?
                                                           :t t)]
                   [k err]))
               [:name :longitude :latitude :homepage]))))

(defn valid-update-form?
  [{:keys [name longitude latitude]}]
  (and (valid-update-name? name)
       (coords/valid-longitude? longitude)
       (coords/valid-latitude? latitude)))

(defn form-from-search-result
  "Build update form values from a Photon result, keeping homepage/description."
  [result update-form]
  {:google-url ""
   :name (:name result)
   :locality (or (:locality update-form) "")
   :homepage (or (:homepage update-form) "")
   :description (or (:description update-form) "")
   :longitude (str (:longitude result))
   :latitude (str (:latitude result))
   :source :manual})
