(ns placesurfer.edit.pure.topic-switch-dialog)

(defn dialog
  [{:keys [cancel-update-topic-switch!
           discard-update-topic-switch!
           save-and-switch-update-topic!
           t]
    :or {t (fn [k] (name k))}}]
  [:div.update-topic-switch-overlay
   [:div.update-topic-switch-sheet
    [:p.update-topic-switch-message (t :update/unsaved-changes)]
    [:div.update-topic-switch-actions
     [:button.update-topic-switch-save
      {:type "button"
       :on {:click (fn [_] (save-and-switch-update-topic!))}}
      (t :common/save)]
     [:button.update-topic-switch-discard
      {:type "button"
       :on {:click (fn [_] (discard-update-topic-switch!))}}
      (t :common/discard)]
     [:button.update-topic-switch-cancel
      {:type "button"
       :on {:click (fn [_] (cancel-update-topic-switch!))}}
      (t :common/cancel)]]]])
