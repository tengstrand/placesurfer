(ns placesurfer.googlestreetmap.core
  (:require [clojure.string :as str]))

(defn- parse-number [s]
  (when (seq s)
    (let [n (js/Number s)]
      (when-not (js/isNaN n) n))))

(defn- try-regex [pattern s]
  (when-let [m (re-find pattern s)]
    (if (vector? m) (rest m) [m])))

(defn- extract-lat-lon [url]
  (or
   ;; Common format:
   ;; ...!8m2!3d59.8404034!4d17.5953381...
   (when-let [[lat lon] (try-regex #"!3d(-?\d+(?:\.\d+)?)!4d(-?\d+(?:\.\d+)?)" url)]
     {:latitude (parse-number lat) :longitude (parse-number lon)})

   ;; Alternative format:
   ;; ...@59.8404034,17.5953381,15z...
   (when-let [[lat lon] (try-regex #"@(-?\d+(?:\.\d+)?),(-?\d+(?:\.\d+)?)" url)]
     {:latitude (parse-number lat) :longitude (parse-number lon)})))

(defn- decode [s]
  (when (seq s)
    (-> s js/decodeURIComponent (str/replace "+" " "))))

(defn- extract-name [url]
  (or
   (when-let [[raw] (try-regex #"/maps/place/([^/?]+)" url)]
     (decode raw))
   (when-let [[raw] (try-regex #"/place/([^/?]+)" url)]
     (decode raw))))

(defn- country-code-from-text [text countries]
  (let [text* (some-> text str/lower-case)]
    (some (fn [{:keys [iso label slug aliases]}]
            (let [candidates (remove nil? (concat [label slug] aliases))
                  found? (some #(str/includes? text* (str/lower-case (str %))) candidates)]
              (when found? iso)))
          countries)))

(defn parse-url
  "Parse a Google Maps URL and return map with available fields.
   Returns nil when URL does not contain useful data."
  [url countries]
  (when (seq (str/trim (str url)))
    (let [coords (extract-lat-lon url)
          name (extract-name url)
          country-code (country-code-from-text (str url " " name) countries)]
      (when (or coords name country-code)
        (cond-> {}
          (:latitude coords) (assoc :latitude (:latitude coords))
          (:longitude coords) (assoc :longitude (:longitude coords))
          (seq name) (assoc :name name)
          (seq country-code) (assoc :country-code country-code))))))

(defn parse-coordinates
  "Extract only coordinates from a Google Maps URL."
  [url]
  (when (seq (str/trim (str url)))
    (extract-lat-lon url)))

(defn parse-name
  "Extract place name from a Google Maps URL."
  [url]
  (when (seq (str/trim (str url)))
    (extract-name url)))

(defn build-maps-location-url
  "Google Maps URL that opens a pinned location.

  Prefers coordinates when available; otherwise searches by address text.
  Uses the `?q=` form to avoid `&` in URLs (safer through HTML sanitization)."
  [{:keys [query latitude longitude]}]
  (cond
    (and (number? latitude) (number? longitude))
    (str "https://www.google.com/maps?q=" latitude "," longitude)

    :else
    (when-let [q (not-empty (str/trim (str query)))]
      (str "https://www.google.com/maps?q=" (js/encodeURIComponent q)))))

(defn build-maps-search-url
  "Build a Google Maps search URL for a free-text address query."
  [query]
  (build-maps-location-url {:query query}))

(defn- escape-html-text [s]
  (-> (str s)
      (str/replace #"&(?!amp;|lt;|gt;|quot;|#)" "&amp;")
      (str/replace "<" "&lt;")
      (str/replace ">" "&gt;")
      (str/replace "\"" "&quot;")))

(def ^:private maps-icon-src "/images/google-maps.png")
(def ^:private maps-icon-class "description-maps-icon")
(def ^:private open-icon-src "/images/open.png")
(def ^:private open-icon-class "description-open-icon")

(defn build-maps-search-link-html
  "Wrap address text in a Google Maps link to the listing location."
  [{:keys [query latitude longitude]}]
  (when-let [label (not-empty (str/trim (str query)))]
    (when-let [url (build-maps-location-url {:query label
                                              :latitude latitude
                                              :longitude longitude})]
      (str "<a href=\"" url "\" target=\"_blank\" rel=\"noopener noreferrer\">"
           (escape-html-text label) "</a>"
           "<img class=\"" open-icon-class "\" src=\"" open-icon-src "\" alt=\"\" />"
           "<img class=\"" maps-icon-class "\" src=\"" maps-icon-src "\" alt=\"\" />"))))

(defn build-street-view-url
  "Build a Google Street View URL from coordinates."
  [latitude longitude]
  (when (and (number? latitude) (number? longitude))
    (str "https://www.google.com/maps/@?api=1&map_action=pano&viewpoint="
         latitude "," longitude)))

(def ^:private hemnet-listing-pattern
  #"^https?://(?:www\.)?hemnet\.se/bostad/.+-(\d+)/?$")

(defn- non-blank [s]
  (when-let [t (not-empty (str/trim (str s)))]
    t))

(defn- parse-coord [v]
  (cond
    (number? v) v
    (string? v) (parse-number v)
    :else nil))

(defn google-maps-url?
  "True when `url` points at Google Maps."
  [url]
  (when-let [s (non-blank url)]
    (let [lower (str/lower-case s)]
      (or (str/includes? lower "google.com/maps")
          (str/includes? lower "maps.google.")))))

(defn hemnet-listing-url?
  "True when `url` is a Hemnet property listing page."
  [url]
  (boolean
   (when-let [s (non-blank url)]
     (re-matches hemnet-listing-pattern s))))

(defn complete-address-line?
  "True when `address` has both street and locality (comma-separated parts)."
  [address]
  (when-let [line (non-blank address)]
    (let [parts (remove str/blank? (map str/trim (str/split line #",")))]
      (>= (count parts) 2))))

(def ^:private listing-sites
  [{:id :hemnet
    :pattern #"(?i)hemnet\.se/bostad/"
    :icon-src "/images/hemnet.png"
    :link-class "place-external-link--hemnet"
    :aria "Hemnet"}
   {:id :boneo
    :pattern #"(?i)boneo\.se/bostad/"
    :icon-src "/images/boneo.png"
    :link-class "place-external-link--boneo"
    :aria "Boneo"}])

(defn- detect-listing-site [url]
  (when-let [s (non-blank url)]
    (first (filter #(re-find (:pattern %) s) listing-sites))))

(defn place-external-links
  "Resolve listing-site and Google Maps icon link URLs for a pin-like place map.
  Returns map with :listing-site, :listing-url, :google-maps-url, :hemnet-url (compat)."
  [{:keys [address location url latitude longitude]}]
  (let [address* (or (non-blank address) (non-blank location))
        url* (non-blank url)
        lat (parse-coord latitude)
        lon (parse-coord longitude)
        site (detect-listing-site url*)
        gmaps-source? (google-maps-url? url*)
        listing-url (when site url*)
        google-maps-url (cond
                          gmaps-source? url*
                          (and site (or (and lat lon)
                                        (complete-address-line? address*)))
                          (build-maps-location-url {:query address*
                                                    :latitude lat
                                                    :longitude lon})
                          :else nil)]
    (when (or listing-url google-maps-url)
      {:listing-site site
       :listing-url listing-url
       :google-maps-url google-maps-url
       :hemnet-url (when (= :hemnet (:id site)) listing-url)})))

(def ^:private place-external-link-class "place-external-link")
(def ^:private place-external-icon-class "place-external-link-icon")
(def ^:private google-maps-link-class "place-external-link--google-maps")

(defn- link-class-attr [extra-class]
  (str place-external-link-class
       (when extra-class (str " " extra-class))))

(defn build-external-icon-link-html
  "Icon-only external link HTML."
  [{:keys [url icon-src icon-class link-class aria-label]}]
  (when-let [href (non-blank url)]
    (str "<a class=\"" (escape-html-text (link-class-attr link-class)) "\" href=\""
         (escape-html-text href)
         "\" target=\"_blank\" rel=\"noopener noreferrer\""
         (when aria-label
           (str " aria-label=\"" (escape-html-text aria-label) "\""))
         "><img class=\"" (escape-html-text (or icon-class place-external-icon-class))
         "\" src=\"" (escape-html-text icon-src) "\" alt=\"\" /></a>")))

(defn build-maps-icon-link-html
  "Google Maps icon-only link HTML."
  [{:keys [url aria-label]}]
  (build-external-icon-link-html
   {:url url
    :icon-src maps-icon-src
    :icon-class place-external-icon-class
    :link-class google-maps-link-class
    :aria-label (or aria-label "Google Maps")}))

(defn build-place-external-link-icons-html
  "Icon-only external link HTML fragment (listing site, then Google Maps)."
  [place]
  (when-let [{:keys [listing-site listing-url google-maps-url]} (place-external-links place)]
    (let [parts (remove nil?
                        [(when (and listing-site listing-url)
                           (build-external-icon-link-html
                            {:url listing-url
                             :icon-src (:icon-src listing-site)
                             :icon-class place-external-icon-class
                             :link-class (:link-class listing-site)
                             :aria-label (:aria listing-site)}))
                         (when google-maps-url
                           (build-maps-icon-link-html {:url google-maps-url}))])]
      (when (seq parts)
        (str/join "" parts)))))

(defn build-place-external-links-html
  "HTML row of external place links (Hemnet, Google Maps) for popups."
  [place]
  (when-let [icons (build-place-external-link-icons-html place)]
    (str "<div class=\"place-external-links\" contenteditable=\"false\">"
         icons
         "</div>")))

