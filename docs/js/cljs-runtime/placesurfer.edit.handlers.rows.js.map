(ns placesurfer.edit.handlers.rows
  (:require [clojure.string :as str]
            [placesurfer.edit.interface.baseline :as edit-ui.baseline]
            [placesurfer.edit.interface.duplicates :as edit-ui.duplicates]
            [placesurfer.edit.interface.model :as edit-ui.model]
            [placesurfer.edit.interface.coords :as edit-ui.coords]
            [placesurfer.edit.interface.forms :as edit-ui.forms]
            [placesurfer.edit.interface.match :as edit-ui.match]
            [placesurfer.edit.interface.rows :as edit-ui.rows]
            [placesurfer.i18n.interface :as i18n]
            [placesurfer.map-ui.interface :as map-ui]
            [placesurfer.app-ui.interface.effects :as effects]
            [placesurfer.app-ui.interface.state :as state]))

(defn as-update-pending-places [places]
  (if (sequential? places) (vec places) []))

(defn as-update-rows [rows]
  (if (sequential? rows) (vec rows) []))

(defn find-update-row [rows row-id]
  (when (some? row-id)
    (some #(when (= row-id (:row-id %)) %) (as-update-rows rows))))

(defn find-pending-display-row-by-id [s row-id]
  (some #(when (= row-id (:pending-id %)) (edit-ui.rows/pending-place->row %))
        (as-update-pending-places (:update-pending-places s))))

(defn find-update-display-row [s row-id]
  (or (find-update-row (:update-rows s) row-id)
      (find-pending-display-row-by-id s row-id)))

(defn resolve-update-display-row [s row-id]
  (or (find-update-display-row s row-id)
      (let [selected (:update-selected-row s)]
        (when (and selected (= row-id (:row-id selected)))
          selected))))

(defn next-pending-row-id! []
  (swap! state/!update-pending-id-seq dec))

(defn find-blank-manual-draft-pending-place [s]
  (some (fn [place]
          (when (edit-ui.rows/blank-manual-draft-pending-place? place)
            place))
        (as-update-pending-places (:update-pending-places s))))

(defn draft-row-validation-active? [s]
  (let [selected-id (:update-selected-row-id s)]
    (boolean
     (when (and (some? selected-id) (neg? selected-id))
       (some (fn [place]
               (when (= selected-id (:pending-id place))
                 (edit-ui.rows/empty-draft-pending-place? place)))
             (as-update-pending-places (:update-pending-places s)))))))

(defn compute-update-form-field-errors-for-state [s]
  (let [t (fn ([key] (i18n/t (:locale s :en) key))
               ([key params] (i18n/t (:locale s :en) key params)))]
    (edit-ui.forms/compute-update-form-field-errors (:update-form s)
                                                    (draft-row-validation-active? s)
                                                    t)))

(defn- update-form-field-errors? [s]
  (boolean (seq (:update-form-field-errors s))))

(defn select-or-create-empty-draft-state [s]
  (if (some? (:update-selected-row-id s))
    s
    (let [existing (find-blank-manual-draft-pending-place s)
          place (or existing
                    {:pending-id (next-pending-row-id!)
                     :name ""
                     :location ""
                     :description ""
                     :source :manual
                     :action :added})
          places (if existing
                   (vec (as-update-pending-places (:update-pending-places s)))
                   (conj (vec (as-update-pending-places (:update-pending-places s)))
                         place))
          row (edit-ui.rows/pending-place->row place)]
      (assoc s
             :update-pending-places places
             :update-selected-row-id (:pending-id place)
             :update-selected-row row
             :update-row-baseline (edit-ui.baseline/row->form-baseline row)))))

(defn- apply-edited-action-to-row [row form disk-baseline field-errors]
  (-> row
      (merge (edit-ui.rows/row-field-patch-from-form form field-errors :preserve-row row))
      (edit-ui.rows/recompute-row-action disk-baseline)))

(defn- apply-edited-action-to-pending [place form disk-baseline field-errors draft-validation?]
  (-> place
      (merge (edit-ui.rows/row-field-patch-from-form form field-errors
                                                     :draft-validation? draft-validation?
                                                     :preserve-row place))
      (edit-ui.rows/recompute-row-action disk-baseline)))

(defn sync-form-into-selected-row [s]
  (let [row-id (:update-selected-row-id s)
        form (:update-form s)
        field-errors (:update-form-field-errors s {})
        disk-baseline (:update-disk-baseline s)
        draft-validation? (draft-row-validation-active? s)]
    (if-not (some? row-id)
      s
      (if (edit-ui.rows/saved-update-row-id? row-id)
        (let [s (update s :update-rows
                        (fn [rows]
                          (mapv #(if (= row-id (:row-id %))
                                   (apply-edited-action-to-row % form disk-baseline field-errors)
                                   %)
                                rows)))
              row (find-update-row (:update-rows s) row-id)]
          (if row (assoc s :update-selected-row row) s))
        (let [s (update s :update-pending-places
                        (fn [places]
                          (mapv #(if (= row-id (:pending-id %))
                                   (apply-edited-action-to-pending % form disk-baseline
                                                                   field-errors draft-validation?)
                                   %)
                                places)))
              row (find-update-display-row s row-id)]
          (if row (assoc s :update-selected-row row) s))))))

(defn select-update-display-row [s row-id row]
  (assoc s
         :update-selected-row-id row-id
         :update-selected-row row))

(defn select-update-row-in-state
  "Select a table row and sync the detail form (used after dataset load)."
  [s row]
  (if row
    (let [row-id (:row-id row)
          form (edit-ui.baseline/row->form-baseline row)
          s1 (assoc s
                    :update-form form
                    :update-selected-row-id row-id
                    :update-selected-row row)
          errors (compute-update-form-field-errors-for-state s1)]
      (-> (select-update-display-row s1 row-id row)
          (assoc :update-form form
                 :update-form-field-errors errors
                 :update-row-baseline (edit-ui.baseline/row->form-baseline row)
                 :update-url-form (when (:url-form row) (:url-form row)))
          (state/bump-description-sync-token)
          (update :update-table-scroll-token (fnil inc 0))))
    s))

(defn find-display-row-in-state [s longitude latitude & [use-url-name?]]
  (edit-ui.match/find-display-row-by-coords (as-update-rows (:update-rows s))
                                            (as-update-pending-places
                                             (:update-pending-places s))
                                            longitude latitude
                                            (if (some? use-url-name?) use-url-name? true)))

(defn select-row-for-url-coords [s longitude latitude]
  (if-let [row (find-display-row-in-state s longitude latitude)]
    (select-update-display-row s (:row-id row) row)
    s))

(defn select-saved-row-for-exact-url-coords [s longitude latitude]
  (if-let [row (edit-ui.match/find-saved-row-by-exact-coords (as-update-rows (:update-rows s))
                                                             longitude latitude)]
    (select-update-display-row s (:row-id row) row)
    s))

(defn restore-selected-update-row-enabled? [s]
  (let [row-id (:update-selected-row-id s)]
    (cond
      (and row-id (edit-ui.rows/saved-update-row-id? row-id))
      (let [disk-baseline (:update-disk-baseline s)
            row (some #(when (= row-id (:row-id %)) %)
                      (as-update-rows (:update-rows s)))]
        (and row
             (contains? disk-baseline row-id)
             (or (edit-ui.rows/row-marked-deleted? row)
                 (edit-ui.rows/row-differs-from-disk-baseline? row disk-baseline))))

      (and row-id (neg? row-id))
      (let [baseline (:update-row-baseline s)
            row (find-pending-display-row-by-id s row-id)]
        (and row
             (edit-ui.rows/manual-draft-pending-row? row)
             (some? baseline)
             (edit-ui.baseline/form-edited-from-baseline? (:update-form s) baseline)))

      :else false)))

(defn- row-from-disk-baseline-entry [row baseline disk-baseline]
  (-> {:row-id (:row-id row)}
      (merge baseline)
      (edit-ui.rows/recompute-row-action disk-baseline)))

(defn- after-restore-selected-update-row! []
  (effects/render!)
  (effects/schedule-update-map-pin-sync!)
  (when (= :update (:page @state/!state))
    (effects/sync-update-map!)))

(defn- restore-saved-update-row-from-disk! [row-id baseline]
  (state/clear-update-status!)
  (swap! state/!state
         (fn [s]
           (let [disk-baseline (:update-disk-baseline s)
                 s (update s :update-rows
                           (fn [rows]
                             (mapv #(if (= row-id (:row-id %))
                                      (row-from-disk-baseline-entry % baseline disk-baseline)
                                      %)
                                   rows)))
                 row (some #(when (= row-id (:row-id %)) %)
                           (:update-rows s))
                 form (edit-ui.baseline/row->form-baseline row)
                 errors (compute-update-form-field-errors-for-state
                         (assoc s :update-form form
                                :update-selected-row-id row-id
                                :update-selected-row row))]
             (-> s
                 (assoc :update-form form
                        :update-form-field-errors errors
                        :update-selected-row row
                        :update-row-baseline (edit-ui.baseline/row->form-baseline row)
                        :update-url-form nil)
                 (update :update-form-reset-token (fnil inc 0))))))
  (after-restore-selected-update-row!))

(defn- restore-pending-manual-update-row-from-baseline! [row-id baseline]
  (state/clear-update-status!)
  (swap! state/!state
         (fn [s]
           (let [disk-baseline (:update-disk-baseline s)
                 s (update s :update-pending-places
                           (fn [places]
                             (mapv #(if (= row-id (:pending-id %))
                                      (-> %
                                          (edit-ui.rows/pending-place-from-form-baseline baseline)
                                          (edit-ui.rows/recompute-row-action disk-baseline))
                                      %)
                                   places)))
                 row (find-pending-display-row-by-id s row-id)
                 errors (compute-update-form-field-errors-for-state
                         (assoc s :update-form baseline
                                :update-selected-row-id row-id
                                :update-selected-row row))]
             (-> s
                 (assoc :update-form baseline
                        :update-form-field-errors errors
                        :update-selected-row row
                        :update-url-form nil)
                 (update :update-form-reset-token (fnil inc 0))))))
  (after-restore-selected-update-row!))

(defn restore-selected-update-row! []
  (let [row-id (:update-selected-row-id @state/!state)]
    (cond
      (and (some? row-id) (edit-ui.rows/saved-update-row-id? row-id))
      (when-let [baseline (get (:update-disk-baseline @state/!state) row-id)]
        (restore-saved-update-row-from-disk! row-id baseline))

      (and (some? row-id) (neg? row-id))
      (let [baseline (:update-row-baseline @state/!state)
            row (find-pending-display-row-by-id @state/!state row-id)]
        (when (and row (edit-ui.rows/manual-draft-pending-row? row) baseline)
          (restore-pending-manual-update-row-from-baseline! row-id baseline)))

      :else nil)))

(defn toggle-row-delete-action! [row disk-baseline & {:keys [country-code]}]
  (-> (if (edit-ui.rows/row-marked-deleted? row)
        (dissoc row :action)
        (edit-ui.rows/mark-row-as-deleted row country-code))
      (edit-ui.rows/recompute-row-action disk-baseline)))

(defn- remove-unsaved-pending-row-from-state [s row-id]
  (-> s
      (update :update-pending-places
              (fn [places]
                (vec (remove #(= row-id (:pending-id %)) places))))
      (update :update-rows
              (fn [rows]
                (vec (remove #(= row-id (:row-id %)) rows))))
      (assoc :update-selected-row-id nil
             :update-selected-row nil
             :update-row-baseline nil
             :update-form (state/default-update-form)
             :update-form-field-errors {}
             :update-url-form nil)
      (update :update-form-reset-token (fnil inc 0))))

(defn- remove-identical-duplicate-row-from-state [s row-id]
  (let [rows (as-update-rows (:update-rows s))
        row (find-update-row rows row-id)
        sibling (some (fn [other]
                        (when (and (not= row-id (:row-id other))
                                   (edit-ui.duplicates/fully-identical-rows? row other))
                          other))
                      rows)
        kept-id (:row-id sibling)
        form (when sibling
               (assoc (edit-ui.baseline/row->form-baseline sibling)
                      :google-url ""))]
    (-> s
        (update :update-rows (fn [rs] (vec (remove #(= row-id (:row-id %)) rs))))
        (assoc :update-selected-row-id kept-id
               :update-selected-row sibling
               :update-row-baseline (when sibling
                                     (edit-ui.baseline/row->form-baseline sibling))
               :update-form (or form (state/default-update-form))
               :update-form-field-errors {}
               :update-url-form nil))))

(defn- focus-update-row-on-map! [row]
  (when (and row (number? (:longitude row)) (number? (:latitude row)))
    (when (= :update (:page @state/!state))
      (js/setTimeout
       #(map-ui/center-on-position!
         {:longitude (:longitude row)
          :latitude (:latitude row)
          :preserve-zoom? true
          :animate? true})
       80))))

(defn toggle-update-row! [row-id]
  (when-not (= row-id (:update-selected-row-id @state/!state))
    (when-let [row (find-update-display-row @state/!state row-id)]
      (let [saved-url-draft (:update-url-form @state/!state)
            saved-pending (:update-pending-places @state/!state)
            form (assoc (edit-ui.baseline/row->form-baseline row)
                        :google-url "")]
        (swap! state/!state
               (fn [s]
                 (let [topic (:update-topic s)]
                   (-> (cond-> (assoc s
                                      :update-selected-row-id row-id
                                      :update-selected-row row
                                      :update-row-baseline (edit-ui.baseline/row->form-baseline row)
                                      :update-form form
                                      :update-form-field-errors
                                      (compute-update-form-field-errors-for-state
                                       (assoc s :update-form form
                                              :update-selected-row-id row-id
                                              :update-selected-row row)))
                          (:url-form row)
                          (assoc :update-url-form (:url-form row))
                          (and saved-url-draft (edit-ui.rows/saved-update-row-id? row-id))
                          (assoc :update-url-form saved-url-draft
                                 :update-pending-places saved-pending)
                          topic
                          (assoc-in [:update-topic-row-memory topic] row-id))
                       state/bump-description-sync-token)))))
        (effects/render!)
        (focus-update-row-on-map! row))))

(defn update-row-click! [row-id]
  (let [s @state/!state
        already-selected? (= row-id (:update-selected-row-id s))]
    (if already-selected?
      (when-let [row (find-update-display-row s row-id)]
        (focus-update-row-on-map! row))
      (toggle-update-row! row-id))))

(defn- adjacent-table-row [s row-id]
  (let [table-rows (:rows (edit-ui.model/table-model s))
        idx (some (fn [[i r]] (when (= row-id (:row-id r)) i))
                  (map-indexed vector table-rows))
        adj-row-id (when idx
                     (:row-id (or (get table-rows (inc idx))
                                  (when (pos? idx) (get table-rows (dec idx))))))]
    (when adj-row-id
      (find-update-display-row s adj-row-id))))

(defn toggle-selected-update-row-delete! []
  (let [s @state/!state
        row-id (or (:update-selected-row-id s)
                   (:row-id (:update-selected-row s)))]
    (when (some? row-id)
      (swap! state/!state
             (fn [s]
               (let [rows (as-update-rows (:update-rows s))
                     disk-row (find-update-row rows row-id)
                     row (or disk-row
                             (find-pending-display-row-by-id s row-id)
                             (resolve-update-display-row s row-id))
                     adjacent (adjacent-table-row s row-id)]
                 (cond
                   (edit-ui.rows/pending-row? row)
                   (-> (remove-unsaved-pending-row-from-state s row-id)
                       (select-update-row-in-state adjacent))

                   (and disk-row
                        (edit-ui.duplicates/has-identical-saved-sibling? rows disk-row))
                   (remove-identical-duplicate-row-from-state s row-id)

                   :else
                   (let [disk-baseline (:update-disk-baseline s)
                         country-code (:update-country-code s)
                         s (update s :update-rows
                                   (fn [rows]
                                     (mapv #(if (= row-id (:row-id %))
                                              (toggle-row-delete-action! % disk-baseline
                                                                         :country-code country-code)
                                              %)
                                           rows)))]
                     (if adjacent
                       (select-update-row-in-state s adjacent)
                       (let [row (find-update-row (:update-rows s) row-id)]
                         (if row (assoc s :update-selected-row row) s))))))))
      (effects/render!)
      (effects/schedule-update-map-pin-sync! {:recenter? false}))))

(defn set-update-sort! [sort-key]
  (when-not (:update-show-duplicates? @state/!state)
    (swap! state/!state update :update-sort
           (fn [{:keys [field dir]}]
             (if (= field sort-key)
               {:field sort-key :dir (if (= dir :asc) :desc :asc)}
               {:field sort-key :dir :asc}))))
  (effects/render!))

(defn toggle-update-show-duplicates! []
  (swap! state/!state
         (fn [s]
           (let [enabling? (not (:update-show-duplicates? s))]
             (cond-> (-> s
                         (update :update-show-duplicates? not)
                         (update :update-table-scroll-token (fnil inc 0)))
               enabling?
               (assoc :update-sort-before-duplicates (:update-sort s))

               (not enabling?)
               (-> (assoc :update-sort (or (:update-sort-before-duplicates s)
                                           {:field nil :dir :asc}))
                   (dissoc :update-sort-before-duplicates))))))
  (effects/render!))

(defn toggle-update-show-invalid! []
  (let [s @state/!state
        enabling? (not (:update-show-invalid? s))
        all-rows (edit-ui.model/display-rows s)
        current-has-form-errors? (boolean (seq (:update-form-field-errors s)))
        first-invalid-id (when enabling?
                           (or (when current-has-form-errors? (:update-selected-row-id s))
                               (:row-id (first (filter #(not (edit-ui.rows/row-save-fields-valid? %))
                                                       all-rows)))))]
    (swap! state/!state
           (fn [s]
             (let [remembered-id (:update-invalid-selected-row-id s)
                   new-selected (when enabling?
                                  (or remembered-id first-invalid-id))]
               (cond-> (-> s
                           (update :update-show-invalid? not)
                           (update :update-table-scroll-token (fnil inc 0)))
                 enabling?
                 (-> (assoc :update-selected-row-before-invalid (:update-selected-row-id s))
                     (assoc :update-selected-row-id new-selected))
                 (not enabling?)
                 (-> (assoc :update-invalid-selected-row-id (:update-selected-row-id s))
                     (assoc :update-selected-row-id (:update-selected-row-before-invalid s))
                     (dissoc :update-selected-row-before-invalid))))))
    (effects/render!)))

(defn set-update-map-height! [height-px]
  (swap! state/!state assoc :update-map-height-px height-px)
  (effects/render!)
  (effects/schedule-map-resize!))

(defn merge-selected-form-into-rows [s rows]
  (let [{:keys [update-selected-row-id update-form]} s]
    (if (and (some? update-selected-row-id)
             (edit-ui.forms/valid-update-form? update-form)
             (not (update-form-field-errors? s)))
      (mapv (fn [row]
              (if (= (:row-id row) update-selected-row-id)
                (merge row
                       {:name (:name update-form)
                        :location (:location update-form)
                        :homepage (:homepage update-form)
                        :description (str/trim (str (:description update-form "")))
                        :longitude (edit-ui.coords/parse-decimal (:longitude update-form))
                        :latitude (edit-ui.coords/parse-decimal (:latitude update-form))}
                       (when (or (not (edit-ui.rows/row-source-set? row))
                                 (:url-form row))
                         {:source (edit-ui.baseline/normalize-update-source (:source update-form))}))
                row))
            rows)
      rows)))

(defn save-source-rows [s]
  (into (as-update-rows (:update-rows s))
        (map edit-ui.rows/pending-place->row (as-update-pending-places (:update-pending-places s)))))
