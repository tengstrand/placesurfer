(ns hitteri.edit.pure.splitter)

(def ^:private min-map-height 96)
(def ^:private min-description-height 64)

(defn- clamp [n lo hi]
  (max lo (min hi n)))

(defn- editor-nodes [^js splitter-node]
  (when splitter-node
    (let [editor (.-parentElement splitter-node)]
      {:editor editor
       :description-pane (.querySelector editor ".update-description-pane")
       :map-panel (.querySelector editor ".update-map-panel")
       :form (.querySelector editor ".update-editor-form")})))

(defn- fixed-form-height [{:keys [editor form description-pane map-panel splitter-node]}]
  (- (.-clientHeight editor)
     (.-clientHeight description-pane)
     (.-clientHeight splitter-node)
     (.-clientHeight map-panel)))

(defn- apply-map-height! [^js map-panel height-px]
  (set! (.-flexGrow (.-style map-panel)) "0")
  (set! (.-flexShrink (.-style map-panel)) "0")
  (set! (.-flexBasis (.-style map-panel)) (str height-px "px"))
  (set! (.-height (.-style map-panel)) (str height-px "px")))

(defn mount-splitter!
  "Attach drag handlers on the horizontal splitter between description and map."
  [set-update-map-height! schedule-map-resize!]
  (fn [{:keys [replicant/node]}]
    (when-let [^js splitter-node node]
      (let [mousedown-handler
            (fn [^js e]
              (.preventDefault e)
              (let [nodes (assoc (editor-nodes splitter-node) :splitter-node splitter-node)
                    {:keys [map-panel editor form]} nodes
                    start-y (.-clientY e)
                    start-map-h (.-clientHeight map-panel)
                    form-h (if form (.-clientHeight form) (fixed-form-height nodes))]
                (.add (.-classList splitter-node) "update-editor-splitter--dragging")
                (set! (.-userSelect (.-body js/document)) "none")
                (letfn [(handle-mousemove [^js move-e]
                          (let [dy (- (.-clientY move-e) start-y)
                                max-h (- (.-clientHeight editor)
                                         form-h
                                         min-description-height
                                         (.-clientHeight splitter-node))
                                new-h (clamp (- start-map-h dy) min-map-height max-h)]
                            (apply-map-height! map-panel new-h)
                            (schedule-map-resize!)))
                        (handle-mouseup [_]
                          (.removeEventListener js/document "mousemove" handle-mousemove)
                          (.removeEventListener js/document "mouseup" handle-mouseup)
                          (.remove (.-classList splitter-node) "update-editor-splitter--dragging")
                          (set! (.-userSelect (.-body js/document)) "")
                          (set-update-map-height! (.-clientHeight map-panel)))]
                  (.addEventListener js/document "mousemove" handle-mousemove)
                  (.addEventListener js/document "mouseup" handle-mouseup))))]
        (.addEventListener splitter-node "mousedown" mousedown-handler)))))
