(ns hitteri.topic-ui.selection
  "Pure helpers for active-topic selection rules.")

(defn single-active
  "When exactly one topic is active, return it; otherwise nil."
  [active-topics]
  (when (= 1 (count active-topics))
    (first active-topics)))

(defn update-invalid?
  "Update page requires exactly one active topic."
  [active-topics]
  (nil? (single-active active-topics)))

(def ^:private default-discgolf-fallback
  {:topic :discgolf :marker-url "/images/marker/discgolf.png"})

(defn nav-tab-row
  "Row props for the topic nav tab icon: single active row, else discgolf fallback."
  [topic-rows]
  (let [active-rows (vec (filter :active? topic-rows))
        fallback-discgolf (some #(when (= :discgolf (:topic %)) %) topic-rows)]
    (if (= 1 (count active-rows))
      (first active-rows)
      (or fallback-discgolf default-discgolf-fallback))))
