(ns placesurfer.edit.interface.model
  (:require [placesurfer.edit.pure.model :as model]))

(defn valid-country-code?
  [s]
  (model/valid-country-code? s))

(defn display-rows
  [state]
  (model/display-rows state))

(defn table-model
  ([state] (model/table-model state))
  ([state opts] (model/table-model state opts)))

(defn row-client-save-pending?
  [row disk-baseline]
  (model/row-client-save-pending? row disk-baseline))

(defn dataset-dirty?
  [state]
  (model/dataset-dirty? state))

(defn dataset-preconditions-met?
  [state]
  (model/dataset-preconditions-met? state))

(defn dataset-change-counts
  [state]
  (model/dataset-change-counts state))
