(ns placesurfer.pin-ui.interface.handlers.editor
  (:require [placesurfer.pin-ui.handlers.editor :as editor]))

(defn pin-form-dirty? [& args] (apply editor/pin-form-dirty? args))
(defn open-pin-editor-new! [& args] (apply editor/open-pin-editor-new! args))
(defn open-pin-editor-edit! [& args] (apply editor/open-pin-editor-edit! args))
(defn cancel-pin-editor! [& args] (apply editor/cancel-pin-editor! args))
(defn confirm-pin-editor! [& args] (apply editor/confirm-pin-editor! args))
(defn edit-enabled? [& args] (apply editor/edit-enabled? args))
(defn ok-enabled? [& args] (apply editor/ok-enabled? args))
(defn maybe-save-inline-pin-before-switch! [& args]
  (apply editor/maybe-save-inline-pin-before-switch! args))
(defn load-pin-into-inline-editor! [& args] (apply editor/load-pin-into-inline-editor! args))
(defn start-pin-search! [& args] (apply editor/start-pin-search! args))
(defn focus-pin-toolbar-search! [& args] (apply editor/focus-pin-toolbar-search! args))
(defn open-pin-editor-at-coords! [& args] (apply editor/open-pin-editor-at-coords! args))
