(ns placesurfer.pin-ui.pure.list-panel
  (:require [clojure.string :as str]
            [placesurfer.pin-ui.pure.toolbar-search :as toolbar-search]
            [placesurfer.pin-ui.pure.drag :as drag]
            [placesurfer.pin-ui.pure.editor-overlay :as editor-overlay]
            [placesurfer.pin-ui.pure.forms :as forms]
            [placesurfer.pin-ui.pure.separator-row :as separator-row]
            [placesurfer.map-ui.interface :as map-ui]))

(defn- display-cell [v]
  (cond
    (nil? v) ""
    (number? v) (str v)
    :else (str v)))

(defn- icon-cell [values]
  (let [icon-url (or (:marker-icon-url values)
                     (forms/icon-url (forms/normalize-icon (or (:icon values) forms/default-icon))))]
    [:td.pin-table-icon-cell
     [:img.pin-table-icon {:src icon-url :alt ""}]]))

(defn- drag-handle-cell [t show-drag-handle?]
  (when show-drag-handle?
    [:td.pin-table-drag-cell
     [:button.pin-row-drag-handle
      {:type "button"
       :title (t :pin/drag-to-reorder)
       :aria-label (t :pin/drag-to-reorder)}
      [:img {:src "/images/dots.png" :alt ""}]]]))

(defn- drag-handle [t show-drag-handle?]
  (when show-drag-handle?
    [:button.pin-row-drag-handle
     {:type "button"
      :title (t :pin/drag-to-reorder)
      :aria-label (t :pin/drag-to-reorder)}
     [:img {:src "/images/dots.png" :alt ""}]]))

(defn- table-cell [values key]
  (if (= key :icon)
    (icon-cell values)
    [:td (display-cell (get values key))]))

(defn- row-attrs [id selected? drag-from-whole-row? & [{:keys [topic-row?]}]]
  {:data-pin-row-id id
   :class (str (when selected? "update-row--selected")
               (when topic-row? " pin-table-row--topic")
               (when drag-from-whole-row? " update-row--draggable"))})

(defn- pin-row-map-hover-handlers [id values]
  (let [match (if (and (number? (:longitude values)) (number? (:latitude values)))
                {:longitude (:longitude values) :latitude (:latitude values)}
                {:id id})]
    {:mouseenter (fn [_] (map-ui/set-marker-row-emphasis! match))
     :mouseleave (fn [_] (map-ui/clear-marker-row-emphasis!))}))

(defn- topics-toggle-btn
  [{:keys [pin-show-topics-on-map? toggle-pin-topics-on-map! t]
    :or {t (fn [k] (name k)) pin-show-topics-on-map? true}}]
  [:button.pin-topics-toggle-btn
   {:type "button"
    :title (if pin-show-topics-on-map?
             (t :pin/hide-topics-on-map)
             (t :pin/show-topics-on-map))
    :on {:click (fn [e]
                  (.stopPropagation e)
                  (toggle-pin-topics-on-map!))}}
   [:img {:src (if pin-show-topics-on-map? "/images/visible.png" "/images/hidden.png")
          :alt (if pin-show-topics-on-map?
                 (t :pin/hide-topics-on-map)
                 (t :pin/show-topics-on-map))}]])

(defn- preview-toggle-btn
  [{:keys [pin-show-preview? toggle-pin-preview! t]
    :or {t (fn [k] (name k))}}]
  [:button.pin-preview-toggle-btn
   {:type "button"
    :class (when pin-show-preview? "pin-preview-toggle-btn--active")
    :aria-pressed (boolean pin-show-preview?)
    :title (if pin-show-preview?
             (t :pin/preview-show-table)
             (t :pin/preview-show-listing))
    :on {:click (fn [e]
                  (.stopPropagation e)
                  (toggle-pin-preview!))}}
   [:img {:src "/images/image.png" :alt (t :pin/preview-show-listing)}]])

(defn- browse-toolbar-end [props]
  [:div.update-table-toolbar-end
   (topics-toggle-btn props)
   (preview-toggle-btn props)])

(defn toolbar
  [{:keys [pin-edit-enabled?
           pin-delete-enabled?
           pin-show-preview?
           pin-editor-inline?
           show-preview-toggle?
           pin-export-copied?
           create-new-pin!
           paste-place-from-clipboard!
           export-pins-to-clipboard!
           open-pin-editor-edit!
           delete-selected-pin!
           toggle-pin-preview!
           t]
    :or {t (fn [k] (name k)) show-preview-toggle? true}
    :as props}]
  [:div.update-table-toolbar-controls
   [:button.pin-new-btn
    {:type "button"
     :title (t :pin/new-title)
     :on {:click (fn [e]
                   (.stopPropagation e)
                   (create-new-pin!))}}
    (t :pin/new)]
   [:button.pin-edit-btn
    {:type "button"
     :title (t :pin/new-place-title)
     :on {:click (fn [e]
                   (.stopPropagation e)
                   (paste-place-from-clipboard!))}}
    [:img {:src "/images/import.png" :alt ""}]]
   [:div {:style {:position "relative" :display "inline-flex"}}
    [:button.pin-edit-btn
     {:type "button"
      :title (t :pin/export-title)
      :on {:click (fn [e]
                    (.stopPropagation e)
                    (export-pins-to-clipboard!))}}
     [:img {:src "/images/export.png" :alt ""}]]
    (when pin-export-copied?
      [:span {:style {:position "absolute" :top "100%" :left "50%"
                      :transform "translateX(-50%)"
                      :margin-top "0.25rem"
                      :background "rgba(22,163,74,0.92)" :color "white"
                      :padding "0.2rem 0.5rem" :border-radius "4px"
                      :font-size "0.75rem" :font-weight "500"
                      :white-space "nowrap" :pointer-events "none"
                      :z-index "9999"}}
       (t :pin/export-copied)])]
   (when-not pin-editor-inline?
     [:button.pin-edit-btn
      {:type "button"
       :disabled (not pin-edit-enabled?)
       :title (t :pin/edit-title)
       :on {:click (fn [e]
                     (.stopPropagation e)
                     (open-pin-editor-edit!))}}
      [:img {:src "/images/edit.png" :alt (t :pin/edit-alt)}]])
   [:button.update-delete-btn
    {:type "button"
     :disabled (not pin-delete-enabled?)
     :title (t :pin/delete)
     :on {:click (fn [e]
                   (.stopPropagation e)
                   (delete-selected-pin!))}}
    [:img {:src "/images/trash.png" :alt (t :pin/delete)}]]
   (when show-preview-toggle?
     (preview-toggle-btn props))])

(defn- table-col [key]
  (case key
    :icon [:col.pin-table-icon-col]
    :name [:col.pin-table-name-col]
    :address [:col.pin-table-address-col]
    [:col]))

(defn- table-has-header-labels? [columns]
  (boolean (some #(not (str/blank? (:label %))) columns)))

(defn- compact-table
  [{:keys [pin-table-rows pin-table-columns pin-row-click! show-drag-handle? drag-from-whole-row? t]
    :or {t (fn [k] (name k)) show-drag-handle? true drag-from-whole-row? false}
    :as props}]
  (let [column-count (count pin-table-columns)]
    [:table.update-table
     [:colgroup
      (for [{:keys [key]} pin-table-columns]
        ^{:key (str "col-" (name key))}
        (table-col key))
      (when show-drag-handle?
        ^{:key "col-drag"}
        [:col.pin-table-drag-col])]
     (when (table-has-header-labels? pin-table-columns)
       [:thead
        [:tr.update-table-header-row
         (for [{:keys [key label]} pin-table-columns]
           ^{:key (name key)}
           [:th label])
         (when show-drag-handle?
           ^{:key "drag-header"}
           [:th.pin-table-drag-header ""])]])
     [:tbody
      (for [{:keys [id kind selected? values]} pin-table-rows]
        ^{:key id}
        (if (= kind :separator)
          (separator-row/table-row (assoc props
                                          :id id
                                          :selected? selected?
                                          :values values
                                          :column-count column-count
                                          :show-drag-handle? show-drag-handle?
                                          :drag-from-whole-row? false))
          [:tr.update-row
           (merge (row-attrs id selected? drag-from-whole-row?
                             {:topic-row? (= kind :topic-position)})
                  {:on (merge {:click (fn [_] (pin-row-click! id))}
                              (pin-row-map-hover-handlers id values))})
           (for [{:keys [key]} pin-table-columns]
             ^{:key (str id "-" (name key))}
             (table-cell values key))
           (drag-handle-cell t show-drag-handle?)]))]]))

(defn- preview-list
  [{:keys [pin-table-rows pin-row-click! show-drag-handle? drag-from-whole-row? t]
    :or {t (fn [k] (name k)) show-drag-handle? true drag-from-whole-row? false}
    :as props}]
  [:div.pin-preview-list
   (for [{:keys [id kind selected? values]} pin-table-rows]
     ^{:key id}
     (if (= kind :separator)
       (separator-row/preview-row (assoc props :id id :selected? selected? :values values))
       [:div.pin-preview-row.update-row
        (merge (row-attrs id selected? drag-from-whole-row?
                          {:topic-row? (= kind :topic-position)})
               {:on (merge {:click (fn [e]
                                    (when-not (.. e -target (closest "a"))
                                      (pin-row-click! id)))}
                           (pin-row-map-hover-handlers id values))})
        [:div.pin-preview-row-content {:innerHTML (map-ui/popup-html values
                                                                     {:source-label (t :popup/source-label)})}]
        (drag-handle t show-drag-handle?)]))])

(defn list-panel
  [{:keys [pin-table-rows pin-table-columns pin-row-click! pin-editor-open?
           pin-table-keyboard-focus? pin-show-preview? clear-pin-table-keyboard-focus!
           reorder-pin-row! show-toolbar? show-toolbar-search? show-preview-toggle?
           show-topics-toggle?
           show-editor-overlay? show-drag-handle?
           drag-from-whole-row? toolbar-prefix t]
    :or {t (fn [k] (name k))
         show-toolbar? true
         show-editor-overlay? true
         show-drag-handle? true
         drag-from-whole-row? false}
    :as props}]
  (let [show-preview-toggle?* (if (some? show-preview-toggle?)
                                show-preview-toggle?
                                show-toolbar?)
        show-toolbar-search? (:show-toolbar-search? props false)
        toolbar-search-end? (:toolbar-search-end? props true)]
    [:div.update-table-wrap
     (when (or toolbar-prefix show-toolbar? show-preview-toggle?* show-toolbar-search?)
       [:div.update-table-toolbar
        toolbar-prefix
        (when (and show-toolbar-search? (not toolbar-search-end?))
          (toolbar-search/pin-search props))
        (cond
          show-toolbar? (toolbar props)
          show-preview-toggle?* (if show-topics-toggle?
                                  (browse-toolbar-end props)
                                  [:div.update-table-toolbar-end
                                   (preview-toggle-btn props)]))
        (when (and show-toolbar-search? toolbar-search-end?)
          (toolbar-search/pin-search props))])
   [:div.pin-table-scroll
    {:class (when pin-table-keyboard-focus? "pin-table-scroll--keyboard-nav")
     :on {:mousemove clear-pin-table-keyboard-focus!}
     :replicant/on-render (fn [{:keys [replicant/node]}]
                            (when (and node (or show-drag-handle? drag-from-whole-row?))
                              (drag/ensure-pin-row-drag! node reorder-pin-row!
                                                         {:drag-from-whole-row? drag-from-whole-row?})))}
    (if pin-show-preview?
      (preview-list props)
      (compact-table props))]
   (when (and show-editor-overlay? pin-editor-open?)
     (editor-overlay/overlay props))]))
