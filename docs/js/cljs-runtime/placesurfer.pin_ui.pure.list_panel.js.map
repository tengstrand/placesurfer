(ns placesurfer.pin-ui.pure.list-panel
  (:require [clojure.string :as str]
            [placesurfer.pin-ui.pure.toolbar-search :as toolbar-search]
            [placesurfer.pin-ui.pure.forms :as forms]
            [placesurfer.pin-ui.pure.separator-row :as separator-row]
            [placesurfer.map-ui.interface :as map-ui]))

(defn- icon-cell [values]
  (let [icon-url (or (:marker-icon-url values)
                     (forms/icon-url (forms/normalize-icon (or (:icon values) forms/default-icon))))]
    [:td.pin-table-icon-cell
     [:img.pin-table-icon {:src icon-url :alt ""}]]))

(defn- area-cell [values]
  [:td.pin-table-area-cell
   (when (seq (str/trim (str (:radii values))))
     [:img.pin-table-area-icon
      {:src "/images/area.png"
       :alt ""
       :style {:height "1em" :width "auto" :vertical-align "middle" :display "block"}}])])

(defn- pin-row-map-hover-handlers [id values]
  (let [match (if (and (number? (:longitude values)) (number? (:latitude values)))
                {:longitude (:longitude values) :latitude (:latitude values)}
                {:id id})]
    {:mouseenter (fn [_] (map-ui/set-marker-row-emphasis! match))
     :mouseleave (fn [_] (map-ui/clear-marker-row-emphasis!))}))

(defn- topics-toggle-btn
  [{:keys [pin-show-topics-on-map? toggle-pin-topics-on-map! t]
    :or {t (fn [k] (name k)) pin-show-topics-on-map? true}}]
  [:button.pin-topics-toggle-btn
   {:type "button"
    :title (if pin-show-topics-on-map?
             (t :pin/hide-topics-on-map)
             (t :pin/show-topics-on-map))
    :on {:click (fn [e]
                  (.stopPropagation e)
                  (toggle-pin-topics-on-map!))}}
   [:img {:src (if pin-show-topics-on-map? "/images/visible.png" "/images/hidden.png")
          :alt (if pin-show-topics-on-map?
                 (t :pin/hide-topics-on-map)
                 (t :pin/show-topics-on-map))}]])

(defn- preview-toggle-btn
  [{:keys [pin-show-preview? toggle-pin-preview! t]
    :or {t (fn [k] (name k))}}]
  [:button.pin-preview-toggle-btn
   {:type "button"
    :class (when pin-show-preview? "pin-preview-toggle-btn--active")
    :aria-pressed (boolean pin-show-preview?)
    :title (if pin-show-preview?
             (t :pin/preview-show-table)
             (t :pin/preview-show-listing))
    :on {:click (fn [e]
                  (.stopPropagation e)
                  (toggle-pin-preview!))}}
   [:img {:src "/images/image.png" :alt (t :pin/preview-show-listing)}]])

(defn- browse-toolbar-end [props]
  [:div.update-table-toolbar-end
   (topics-toggle-btn props)
   (preview-toggle-btn props)])

(defn toolbar
  [{:keys [pin-edit-enabled?
           pin-editor-inline?
           show-preview-toggle?
           pin-export-copied?
           create-new-pin!
           paste-place-from-clipboard!
           export-pins-to-clipboard!
           open-pin-editor-edit!
           delete-selected-pin!
           t]
    :or {t (fn [k] (name k)) show-preview-toggle? true}
    :as props}]
  [:div.update-table-toolbar-controls
   [:button.pin-new-btn
    {:type "button"
     :title (t :pin/new-title)
     :on {:click (fn [e]
                   (.stopPropagation e)
                   (create-new-pin!))}}
    (t :pin/new)]
   [:button.pin-edit-btn
    {:type "button"
     :title (t :pin/new-place-title)
     :on {:click (fn [e]
                   (.stopPropagation e)
                   (paste-place-from-clipboard!))}}
    [:img {:src "/images/import.png" :alt ""}]]
   [:div {:style {:position "relative" :display "inline-flex"}}
    [:button.pin-edit-btn
     {:type "button"
      :title (t :pin/export-title)
      :on {:click (fn [e]
                    (.stopPropagation e)
                    (export-pins-to-clipboard!))}}
     [:img {:src "/images/export.png" :alt ""}]]
    (when pin-export-copied?
      [:span {:style {:position "absolute" :top "100%" :left "50%"
                      :transform "translateX(-50%)"
                      :margin-top "0.25rem"
                      :background "rgba(22,163,74,0.92)" :color "white"
                      :padding "0.2rem 0.5rem" :border-radius "4px"
                      :font-size "0.75rem" :font-weight "500"
                      :white-space "nowrap" :pointer-events "none"
                      :z-index "9999"}}
       (t :pin/export-copied)])]
   (when-not pin-editor-inline?
     [:button.pin-edit-btn
      {:type "button"
       :disabled (not pin-edit-enabled?)
       :title (t :pin/edit-title)
       :on {:click (fn [e]
                     (.stopPropagation e)
                     (open-pin-editor-edit!))}}
      [:img {:src "/images/edit.png" :alt (t :pin/edit-alt)}]])
   [:button.update-delete-btn
    {:type "button"
     :disabled (not (:pin-delete-enabled? props))
     :title (t :pin/delete)
     :on {:click (fn [e]
                   (.stopPropagation e)
                   (delete-selected-pin!))}}
    [:img {:src "/images/trash.png" :alt (t :pin/delete)}]]
   (when show-preview-toggle?
     (preview-toggle-btn props))])

(defn- pin-group-map [pin-items]
  (loop [[item & rest-items] pin-items
         current-group nil
         result {}]
    (if (nil? item)
      result
      (if (= :separator (:kind item))
        (recur rest-items (:label item) result)
        (recur rest-items current-group (assoc result (:id item) current-group))))))

(def ^:private stars-sort-key
  {"5-stars.png" 5 "4-stars.png" 4 "3-stars.png" 3
   "2-stars.png" 2 "1-star.png" 1 "0-stars.png" 0})

(defn- sorted-pin-rows [pin-rows group-map {:keys [col dir] :or {col :stars dir :desc}}]
  (let [key-fn (case col
                 :name  #(str/lower-case (str (-> % :values :name)))
                 :group #(str/lower-case (str (get group-map (:id %) "")))
                 :ranking #(get stars-sort-key (-> % :values :ranking) 0)
                 #(get stars-sort-key (-> % :values :ranking) 0))
        sorted (sort-by key-fn pin-rows)]
    (if (= :desc dir) (reverse sorted) (vec sorted))))

(defn- sort-header [label sort-col current-sort set-pin-list-sort!]
  (let [active? (= sort-col (:col current-sort))
        arrow   (when active? (if (= :asc (:dir current-sort)) " ▲" " ▼"))]
    [:th.pin-sort-header
     {:on {:click (fn [_] (when set-pin-list-sort! (set-pin-list-sort! sort-col)))}}
     label
     (when arrow [:span.pin-sort-arrow arrow])]))

(defn- pin-sorted-table
  [{:keys [pin-table-rows pin-items pin-row-click! pin-list-sort set-pin-list-sort! t]
    :or {t (fn [k] (name k))
         pin-list-sort {:col :ranking :dir :desc}}}]
  (let [group-map    (pin-group-map (or pin-items []))
        pin-only     (filter #(= :pin (:kind %)) pin-table-rows)
        sorted-rows  (sorted-pin-rows pin-only group-map pin-list-sort)]
    [:table.update-table.pin-sorted-table
     [:colgroup
      [:col.pin-table-icon-col]
      [:col.pin-table-name-col]
      [:col.pin-table-group-col]
      [:col.pin-table-stars-col]
      [:col.pin-table-area-col]]
     [:thead
      [:tr.update-table-header-row
       [:th ""]
       (sort-header (t :common/name)  :name  pin-list-sort set-pin-list-sort!)
       (sort-header (t :pin/group)    :group pin-list-sort set-pin-list-sort!)
       (sort-header (t :pin/ranking)  :ranking pin-list-sort set-pin-list-sort!)
       [:th ""]]]
     [:tbody
      (for [{:keys [id selected? values]} sorted-rows]
        ^{:key id}
        [:tr.update-row
         {:class (when selected? "update-row--selected")
          :on (merge {:click (fn [_] (when pin-row-click! (pin-row-click! id)))}
                     (pin-row-map-hover-handlers id values))}
         (icon-cell values)
         [:td.pin-table-name-cell  (str (:name values))]
         [:td.pin-table-group-cell (str (get group-map id ""))]
         [:td.pin-table-stars-cell
          [:img.pin-table-stars-icon
           {:src (forms/stars-url (or (:ranking values) (:stars values) "0-stars.png"))
            :alt ""}]]
         (area-cell values)])]]))

(defn- preview-list
  [{:keys [pin-table-rows pin-row-click! t]
    :or {t (fn [k] (name k))}
    :as props}]
  [:div.pin-preview-list
   (for [{:keys [id kind selected? values]} pin-table-rows]
     ^{:key id}
     (if (= kind :separator)
       (separator-row/preview-row (assoc props :id id :selected? selected? :values values))
       [:div.pin-preview-row.update-row
        {:data-pin-row-id id
         :class (when selected? "update-row--selected")
         :on (merge {:click (fn [e]
                              (when-not (.. e -target (closest "a"))
                                (when pin-row-click! (pin-row-click! id))))}
                    (pin-row-map-hover-handlers id values))}
        [:div.pin-preview-row-content
         {:innerHTML (map-ui/popup-html values {:source-label (t :popup/source-label)})}]]))])

(defn list-panel
  [{:keys [pin-table-keyboard-focus? pin-show-preview?
           clear-pin-table-keyboard-focus!
           show-toolbar? show-toolbar-search? show-preview-toggle?
           show-topics-toggle? toolbar-prefix t]
    :or {t (fn [k] (name k))
         show-toolbar? true}
    :as props}]
  (let [show-preview-toggle?* (if (some? show-preview-toggle?)
                                show-preview-toggle?
                                show-toolbar?)
        show-toolbar-search? (:show-toolbar-search? props false)
        toolbar-search-end?  (:toolbar-search-end? props true)]
    [:div.update-table-wrap
     (when (or toolbar-prefix show-toolbar? show-preview-toggle?* show-toolbar-search?)
       [:div.update-table-toolbar
        toolbar-prefix
        (when (and show-toolbar-search? (not toolbar-search-end?))
          (toolbar-search/pin-search props))
        (cond
          show-toolbar?       (toolbar props)
          show-preview-toggle?* (if show-topics-toggle?
                                  (browse-toolbar-end props)
                                  [:div.update-table-toolbar-end
                                   (preview-toggle-btn props)]))
        (when (and show-toolbar-search? toolbar-search-end?)
          (toolbar-search/pin-search props))])
     [:div.pin-table-scroll
      {:class (when pin-table-keyboard-focus? "pin-table-scroll--keyboard-nav")
       :on {:mousemove clear-pin-table-keyboard-focus!}}
      (if pin-show-preview?
        (preview-list props)
        (pin-sorted-table props))]]))
