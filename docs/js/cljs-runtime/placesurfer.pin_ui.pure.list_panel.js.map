(ns placesurfer.pin-ui.pure.list-panel
  (:require [clojure.string :as str]
            [placesurfer.pin-ui.pure.drag :as drag]
            [placesurfer.pin-ui.pure.hemnet-results-panel :as hemnet-results-panel]
            [placesurfer.pin-ui.pure.toolbar-search :as toolbar-search]
            [placesurfer.pin-ui.pure.forms :as forms]
            [placesurfer.map-ui.interface :as map-ui]))

(def ^:private pin-table-column-count 7)

(defn- pin-icon-url [values]
  (or (:marker-icon-url values)
      (forms/icon-url (forms/normalize-icon (or (:icon values) forms/default-icon)))))

(defn- icon-cell [values]
  [:td.pin-table-icon-cell
   [:img.pin-table-icon {:src (pin-icon-url values) :alt ""}]])

(defn- image-cell [values]
  [:td.pin-table-image-cell
   (when (seq (str (:image values)))
     [:img.pin-table-image {:src (:image values) :alt ""}])])

(defn- delete-cell [id delete-pin! t]
  [:td.pin-table-delete-cell
   [:button.hemnet-results-discard-btn
    {:type "button"
     :title (t :pin/delete)
     :on {:click (fn [e]
                   (.stopPropagation e)
                   (when delete-pin! (delete-pin! id)))}}
    [:img {:src "/images/trash.png" :alt (t :pin/delete)}]]])

(defn- edit-cell
  "Jump-to-edit-page button, between the marker icon and the trash column -
   only rendered while the backend is online, since the edit page's Pins
   topic itself can't be reached otherwise (see
   web-app.nav/open-pin-in-editor!)."
  [id backend-online? open-pin-in-editor! t]
  [:td.pin-table-edit-cell
   (when backend-online?
     [:button.hemnet-results-discard-btn
      {:type "button"
       :title (t :pin/edit-title)
       :on {:click (fn [e]
                     (.stopPropagation e)
                     (when open-pin-in-editor! (open-pin-in-editor! id)))}}
      [:img {:src "/images/edit.png" :alt (t :pin/edit-alt)}]])])

(defn- pin-preview-delete-btn
  "Trash button for the preview-mode (large-image) card's action row -
   same remove behaviour and button styling as the table-mode `delete-cell`,
   placed under the text instead of in its own table column (mirrors the
   Hemnet preview card's action row, see hemnet-results-panel/preview-rows)."
  [id delete-pin! t]
  [:button.hemnet-results-discard-btn
   {:type "button"
    :title (t :pin/delete)
    :on {:click (fn [e]
                  (.stopPropagation e)
                  (when delete-pin! (delete-pin! id)))}}
   [:img {:src "/images/trash.png" :alt (t :pin/delete)}]])

(defn- pin-preview-edit-btn
  "Jump-to-edit-page button for the preview-mode card's action row - same
   behaviour as table-mode's `edit-cell`, only shown while the backend is
   online (see web-app.nav/open-pin-in-editor!)."
  [id open-pin-in-editor! t]
  [:button.pin-preview-marker-btn
   {:type "button"
    :title (t :pin/edit-title)
    :on {:click (fn [e]
                  (.stopPropagation e)
                  (when open-pin-in-editor! (open-pin-in-editor! id)))}}
   [:img {:src "/images/edit.png" :alt (t :pin/edit-alt)}]])

(defn- pin-preview-marker-btn
  "The pin's own marker icon, as a dedicated preview-card button - clicking
   it does exactly what clicking a table-mode row already does
   (`pin-row-click!`: select + scroll/focus the pin on the map), as a
   guaranteed, unambiguous target for that action. Most of the card's area
   is otherwise covered by popup-html's own image/source links, which the
   row's own click handler deliberately ignores (see `preview-list`)."
  [id values pin-row-click!]
  [:button.pin-preview-marker-btn
   {:type "button"
    :on {:click (fn [e]
                  (.stopPropagation e)
                  (when pin-row-click! (pin-row-click! id)))}}
   [:img {:src (pin-icon-url values) :alt ""}]])

(defn- area-cell [values]
  [:td.pin-table-area-cell
   (when (seq (str/trim (str (:radii values))))
     [:img.pin-table-area-icon
      {:src "/images/area.png"
       :alt ""
       :style {:height "1em" :width "auto" :vertical-align "middle" :display "block"}}])])

(defn- pin-row-map-hover-handlers [id values]
  (let [match (if (and (number? (:longitude values)) (number? (:latitude values)))
                {:longitude (:longitude values) :latitude (:latitude values)}
                {:id id})]
    {:mouseenter (fn [_] (map-ui/set-marker-row-emphasis! match))
     :mouseleave (fn [_] (map-ui/clear-marker-row-emphasis!))}))

(defn- topics-toggle-btn
  [{:keys [pin-show-topics-on-map? toggle-pin-topics-on-map! t]
    :or {t (fn [k] (name k)) pin-show-topics-on-map? true}}]
  [:button.pin-topics-toggle-btn
   {:type "button"
    :title (if pin-show-topics-on-map?
             (t :pin/hide-topics-on-map)
             (t :pin/show-topics-on-map))
    :on {:click (fn [e]
                  (.stopPropagation e)
                  (toggle-pin-topics-on-map!))}}
   [:img {:src (if pin-show-topics-on-map? "/images/visible.png" "/images/hidden.png")
          :alt (if pin-show-topics-on-map?
                 (t :pin/hide-topics-on-map)
                 (t :pin/show-topics-on-map))}]])

(defn fullscreen-toggle-btn
  "Hides/shows the pin list panel so the map can fill the full width -
   placed at the very start of the toolbar, directly to the left of the
   search field (see list-panel below). Also reused by pin-ui.pure.panel as
   a floating overlay button on the map itself while the list is hidden,
   since that's otherwise the only control left inside the now-hidden list
   panel to toggle it back on."
  [{:keys [pin-list-hidden? toggle-pin-list-hidden! t]
    :or {t (fn [k] (name k))}}]
  [:button.pin-fullscreen-toggle-btn
   {:type "button"
    :title (if pin-list-hidden?
             (t :pin/exit-fullscreen)
             (t :pin/show-fullscreen))
    :on {:click (fn [e]
                  (.stopPropagation e)
                  (toggle-pin-list-hidden!))}}
   [:img {:src (if pin-list-hidden? "/images/fullscreen-collapse.png" "/images/fullscreen-expand.png")
          :alt (if pin-list-hidden?
                 (t :pin/exit-fullscreen)
                 (t :pin/show-fullscreen))}]])

(defn- preview-toggle-btn
  [{:keys [pin-show-preview? toggle-pin-preview! t]
    :or {t (fn [k] (name k))}}]
  [:button.pin-preview-toggle-btn
   {:type "button"
    :class (when pin-show-preview? "pin-preview-toggle-btn--active")
    :aria-pressed (boolean pin-show-preview?)
    :title (if pin-show-preview?
             (t :pin/preview-show-table)
             (t :pin/preview-show-listing))
    :on {:click (fn [e]
                  (.stopPropagation e)
                  (toggle-pin-preview!))}}
   [:img {:src "/images/image.png" :alt (t :pin/preview-show-listing)}]])

(defn- undo-delete-btn
  [{:keys [pin-delete-undo-enabled? undo-pin-delete! t]
    :or {t (fn [k] (name k))}}]
  [:button.pin-edit-btn
   {:type "button"
    :disabled (not pin-delete-undo-enabled?)
    :title (t :pin/undo-delete-title)
    :on {:click (fn [e]
                  (.stopPropagation e)
                  (when undo-pin-delete! (undo-pin-delete!)))}}
   [:img {:src "/images/restore.png" :alt (t :pin/undo-delete-title)}]])

(defn- browse-toolbar-end [props]
  [:div.update-table-toolbar-end
   (undo-delete-btn props)
   (topics-toggle-btn props)
   (preview-toggle-btn props)])

(defn toolbar
  [{:keys [pin-edit-enabled?
           pin-editor-inline?
           show-preview-toggle?
           pin-export-copied?
           create-new-pin!
           paste-place-from-clipboard!
           export-pins-to-clipboard!
           open-pin-editor-edit!
           delete-selected-pin!
           t]
    :or {t (fn [k] (name k)) show-preview-toggle? true}
    :as props}]
  [:div.update-table-toolbar-controls
   [:button.pin-new-btn
    {:type "button"
     :title (t :pin/new-title)
     :on {:click (fn [e]
                   (.stopPropagation e)
                   (create-new-pin!))}}
    (t :pin/new)]
   [:button.pin-edit-btn
    {:type "button"
     :title (t :pin/new-place-title)
     :on {:click (fn [e]
                   (.stopPropagation e)
                   (paste-place-from-clipboard!))}}
    [:img {:src "/images/import.png" :alt ""}]]
   [:div {:style {:position "relative" :display "inline-flex"}}
    [:button.pin-edit-btn
     {:type "button"
      :title (t :pin/export-title)
      :on {:click (fn [e]
                    (.stopPropagation e)
                    (export-pins-to-clipboard!))}}
     [:img {:src "/images/export.png" :alt ""}]]
    (when pin-export-copied?
      [:span {:style {:position "absolute" :top "100%" :left "50%"
                      :transform "translateX(-50%)"
                      :margin-top "0.25rem"
                      :background "rgba(22,163,74,0.92)" :color "white"
                      :padding "0.2rem 0.5rem" :border-radius "4px"
                      :font-size "0.75rem" :font-weight "500"
                      :white-space "nowrap" :pointer-events "none"
                      :z-index "9999"}}
       (t :pin/export-copied)])]
   (when-not pin-editor-inline?
     [:button.pin-edit-btn
      {:type "button"
       :disabled (not pin-edit-enabled?)
       :title (t :pin/edit-title)
       :on {:click (fn [e]
                     (.stopPropagation e)
                     (open-pin-editor-edit!))}}
      [:img {:src "/images/edit.png" :alt (t :pin/edit-alt)}]])
   [:button.update-delete-btn
    {:type "button"
     :disabled (not (:pin-delete-enabled? props))
     :title (t :pin/delete)
     :on {:click (fn [e]
                   (.stopPropagation e)
                   (delete-selected-pin!))}}
    [:img {:src "/images/trash.png" :alt (t :pin/delete)}]]
   (undo-delete-btn props)
   (when show-preview-toggle?
     (preview-toggle-btn props))])

(def ^:private stars-sort-key
  {"5-stars.png" 5 "4-stars.png" 4 "3-stars.png" 3
   "2-stars.png" 2 "1-star.png" 1 "0-stars.png" 0})

(defn- sorted-pin-rows [pin-rows {:keys [col dir] :or {col :stars dir :desc}}]
  (let [key-fn (case col
                 :name  #(str/lower-case (str (-> % :values :name)))
                 :ranking #(get stars-sort-key (-> % :values :ranking) 0)
                 #(get stars-sort-key (-> % :values :ranking) 0))
        sorted (sort-by key-fn pin-rows)]
    (if (= :desc dir) (reverse sorted) (vec sorted))))

(defn- sort-header [label sort-col current-sort set-pin-list-sort!]
  (let [active? (= sort-col (:col current-sort))
        arrow   (when active? (if (= :asc (:dir current-sort)) " ▲" " ▼"))]
    [:th.pin-sort-header
     {:on {:click (fn [_] (when set-pin-list-sort! (set-pin-list-sort! sort-col)))}}
     label
     (when arrow [:span.pin-sort-arrow arrow])]))

(defn- pin-sorted-table
  [{:keys [pin-table-rows pin-row-click! pin-list-sort set-pin-list-sort!
           delete-pin! show-hemnet-results? backend-online? open-pin-in-editor!
           drag-from-whole-row? t]
    :or {t (fn [k] (name k))
         pin-list-sort {:col :ranking :dir :desc}}
    :as props}]
  (let [pin-only     (filter #(= :pin (:kind %)) pin-table-rows)
        sorted-rows  (sorted-pin-rows pin-only pin-list-sort)]
    [:table.update-table.pin-sorted-table
     [:colgroup
      [:col.pin-table-image-col]
      [:col.pin-table-name-col]
      [:col.pin-table-stars-col]
      [:col.pin-table-area-col]
      [:col.pin-table-delete-col]
      [:col.pin-table-edit-col]
      [:col.pin-table-icon-col]]
     [:thead
      [:tr.update-table-header-row
       [:th ""]
       (sort-header (t :common/name)  :name  pin-list-sort set-pin-list-sort!)
       (sort-header (t :pin/ranking)  :ranking pin-list-sort set-pin-list-sort!)
       [:th ""]
       [:th ""]
       [:th ""]
       [:th ""]]]
     [:tbody
      (for [{:keys [id selected? values]} sorted-rows]
        ^{:key id}
        [:tr.update-row
         {:data-pin-row-id id
          :class (str (when selected? "update-row--selected ")
                     (when drag-from-whole-row? "update-row--draggable"))
          :on (merge {:click (fn [_] (when pin-row-click! (pin-row-click! id)))}
                     (pin-row-map-hover-handlers id values))}
         (image-cell values)
         [:td.pin-table-name-cell (str (:name values))]
         [:td.pin-table-stars-cell
          [:img.pin-table-stars-icon
           {:src (forms/stars-url (or (:ranking values) (:stars values) "0-stars.png"))
            :alt ""}]]
         (area-cell values)
         (icon-cell values)
         (edit-cell id backend-online? open-pin-in-editor! t)
         (delete-cell id delete-pin! t)])]
     (when show-hemnet-results?
       (when-let [hemnet-rows (hemnet-results-panel/table-rows
                                (assoc props :column-count pin-table-column-count))]
         (into [:tbody] hemnet-rows)))]))

(defn- preview-list
  [{:keys [pin-table-rows pin-row-click! delete-pin! show-hemnet-results?
           backend-online? open-pin-in-editor! drag-from-whole-row? t]
    :or {t (fn [k] (name k))}
    :as props}]
  [:div.pin-preview-list
   (for [{:keys [id kind selected? values]} pin-table-rows
         :when (not= kind :separator)]
     ^{:key id}
     [:div.pin-preview-row.update-row
      {:data-pin-row-id id
       :class (str (when selected? "update-row--selected ")
                   (when drag-from-whole-row? "update-row--draggable"))
       :on (merge {:click (fn [e]
                            (when-not (.. e -target (closest "a"))
                              (when pin-row-click! (pin-row-click! id))))}
                  (pin-row-map-hover-handlers id values))}
      [:div.hemnet-results-preview-card
       [:div.pin-preview-row-content
        {:innerHTML (map-ui/popup-html values {:source-label (t :popup/source-label)})}]
       [:div.hemnet-results-preview-actions
        (pin-preview-marker-btn id values pin-row-click!)
        (when backend-online? (pin-preview-edit-btn id open-pin-in-editor! t))
        (pin-preview-delete-btn id delete-pin! t)]]])
   (when show-hemnet-results?
     (hemnet-results-panel/preview-rows props))])

(defn list-panel
  [{:keys [pin-table-keyboard-focus? pin-show-preview?
           clear-pin-table-keyboard-focus!
           show-toolbar? show-toolbar-search? show-preview-toggle?
           show-topics-toggle? show-fullscreen-toggle? toolbar-prefix
           reorder-pin-row! drag-from-whole-row? t]
    :or {t (fn [k] (name k))
         show-toolbar? true}
    :as props}]
  (let [show-preview-toggle?* (if (some? show-preview-toggle?)
                                show-preview-toggle?
                                show-toolbar?)
        show-toolbar-search? (:show-toolbar-search? props false)
        toolbar-search-end?  (:toolbar-search-end? props true)]
    [:div.update-table-wrap
     (when (or show-fullscreen-toggle? toolbar-prefix show-toolbar? show-preview-toggle?* show-toolbar-search?)
       [:div.update-table-toolbar
        toolbar-prefix
        (when show-fullscreen-toggle? (fullscreen-toggle-btn props))
        (when (and show-toolbar-search? (not toolbar-search-end?))
          (toolbar-search/pin-search props))
        (cond
          show-toolbar?       (toolbar props)
          show-preview-toggle?* (if show-topics-toggle?
                                  (browse-toolbar-end props)
                                  [:div.update-table-toolbar-end
                                   (preview-toggle-btn props)]))
        (when (and show-toolbar-search? toolbar-search-end?)
          (toolbar-search/pin-search props))])
     [:div.pin-table-scroll
      {:class (when pin-table-keyboard-focus? "pin-table-scroll--keyboard-nav")
       :on {:mousemove clear-pin-table-keyboard-focus!}
       :replicant/on-render (fn [{:keys [replicant/node]}]
                              (when (and node reorder-pin-row!)
                                (drag/ensure-pin-row-drag! node reorder-pin-row!
                                                           {:drag-from-whole-row? drag-from-whole-row?})))}
      (if pin-show-preview?
        (preview-list props)
        (pin-sorted-table props))]]))
