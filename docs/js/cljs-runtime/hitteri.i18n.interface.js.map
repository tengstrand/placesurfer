(ns hitteri.i18n.interface
  (:require [hitteri.i18n.core :as core]
            [hitteri.i18n.pure.storage :as storage]))

(defn default-locale [] core/default-locale)

(defn supported-locales [] core/supported-locales)

(defn normalize-locale [& args] (apply core/normalize-locale args))

(defn t [& args] (apply core/t args))

(defn read-locale! [] (core/read-locale!))

(defn save-locale! [& args] (apply core/save-locale! args))

(defn read-settings! [] (storage/read-settings!))

(defn save-settings! [& args] (apply storage/save-settings! args))

(defn topic-label [& args] (apply core/topic-label args))
