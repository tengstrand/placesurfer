(ns hitteri.browser-storage.interface
  "Stable public API for browser cookies and URL topic persistence."
  (:require [hitteri.browser-storage.core :as core]))

(defn read-cookie [k] (core/read-cookie k))
(defn write-cookie! [k v] (core/write-cookie! k v))
(defn clear-cookie! [k] (core/clear-cookie! k))
(defn read-active-topics [default-active-topics] (core/read-active-topics default-active-topics))
(defn save-active-topics! [topics] (core/save-active-topics! topics))
(defn read-country-slug [] (core/read-country-slug))
(defn save-country-slug! [slug] (core/save-country-slug! slug))
(defn read-topic-from-url [] (core/read-topic-from-url))
(defn read-page-from-url [] (core/read-page-from-url))
