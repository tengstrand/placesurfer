(ns placesurfer.pin-ui.handlers.hemnet-search
  "Ephemeral Hemnet search-result list shown on the pin page - kept entirely
   separate from :pin-items, but persisted to its own localStorage key and
   synced to Dropbox under a dedicated :search doc (see bases/web-app/...
   /dropbox.cljs's register-sync-doc!), independent of how pins are stored."
  (:require [placesurfer.app-ui.interface.state :as app-state]
            [placesurfer.dropbox.interface :as dropbox]
            [placesurfer.pin-ui.handlers.map :as pin-map]
            [placesurfer.pin-ui.handlers.rows :as rows]
            [placesurfer.pin-ui.handlers.state :as pin-state]
            [placesurfer.pin-ui.pure.storage :as storage]))

(defn- persist-and-push! [results]
  (storage/save-search-results! results)
  (when (dropbox/connected?) (dropbox/push!)))

(defn upsert-results!
  "Merge `results` (pin-form-shaped maps, each with :id) into
   :search-results: an existing entry with the same :id has its data
   replaced by the freshly-imported version rather than duplicated, but its
   :deleted flag carries over unchanged - re-importing a search (e.g.
   re-running/paging the same Hemnet search) must not silently un-delete
   rows the user already discarded via the trash icon.

   Returns {:total (count results) :visible N}, where N excludes any of the
   incoming results that got carried over as :deleted - callers use this to
   tell a clean \"5 imported\" apart from \"2 of 5 imported, 3 were already
   discarded\" for the import-count toast (see clipboard-ui.handlers.apply)."
  [results]
  (let [total (count results)
        visible (atom total)]
    (when (seq results)
      (let [merged (atom nil)]
        (pin-state/swap-render!
         (fn [s]
           (let [existing (:search-results s [])
                 existing-by-id (into {} (map (juxt :id identity)) existing)
                 incoming-ids (into #{} (map :id) results)
                 kept (remove #(contains? incoming-ids (:id %)) existing)
                 updated (map (fn [r]
                                (cond-> r
                                  (:deleted (get existing-by-id (:id r))) (assoc :deleted true)))
                              results)
                 next-results (into (vec kept) updated)]
             (reset! merged next-results)
             (reset! visible (count (remove :deleted updated)))
             (assoc s :search-results next-results))))
        (persist-and-push! @merged))
      (pin-map/schedule-pin-map-sync! {:recenter? false}))
    {:total total :visible @visible}))

(defn clear-results! []
  (pin-state/swap-render! #(assoc % :search-results [] :hemnet-selected-id nil))
  (persist-and-push! [])
  (pin-map/schedule-pin-map-sync! {:recenter? false}))

(defn discard-result!
  "Soft-delete one Hemnet search result: mark it :deleted true rather than
   removing it, so it disappears from the list and the map (see
   `pin-ui.handlers.map/hemnet-search-result-positions` and
   `pin-ui.pure.panel/view-props`) but the data itself is kept - persisted
   locally and still synced to Dropbox. Re-importing the same listing later
   via `upsert-results!` refreshes its data but keeps it marked :deleted.
   Stashes {:kind :search-result :id id} in :pin-delete-undo, same slot
   `pin-ui.handlers.rows/delete-pin!` uses, so the pin-page toolbar's one
   undo button works for either kind of row."
  [id]
  (let [next-results (atom nil)]
    (pin-state/swap-render!
     (fn [s]
       (let [updated (mapv (fn [r] (if (= id (:id r)) (assoc r :deleted true) r))
                           (:search-results s []))]
         (reset! next-results updated)
         (cond-> (assoc s :search-results updated :pin-delete-undo {:kind :search-result :id id})
           (= id (:hemnet-selected-id s)) (assoc :hemnet-selected-id nil)))))
    (when @next-results (persist-and-push! @next-results)))
  (pin-map/schedule-pin-map-sync! {:recenter? false}))

(defn- find-result [id]
  (first (filter #(and (= id (:id %)) (not (:deleted %)))
                 (:search-results @app-state/!state []))))

(defn select-result-row!
  "Select a Hemnet search-result row: highlight it in the list and focus the
   map on it - the row-click mirror of `pin-ui.handlers.rows/select-display-row!`."
  [id]
  (when-let [item (find-result id)]
    (pin-state/swap-render! #(assoc % :hemnet-selected-id id))
    (pin-map/focus-hemnet-result-on-map! item)))

(defn handle-marker-click!
  "Reverse of `select-result-row!`: highlight the list row matching a clicked
   search-result map marker, without re-centering the map or re-opening the
   popup (the marker click itself already handled that). Matched by :id
   against :search-results rather than by :marker-topic, so this works the
   same regardless of which site the result came from (Hemnet, Booli, Notar,
   ...) - see `pin-ui.handlers.map/search-result-marker-topic` for how topics
   get assigned per :source."
  [position]
  (when-let [id (:id position)]
    (when (find-result id)
      (pin-state/swap-render! #(assoc % :hemnet-selected-id id)))))

(defn save-result-as-pin!
  "Save one Hemnet search result as a regular saved pin, then drop it from
   the ephemeral results list."
  [id]
  (when-let [result (find-result id)]
    (rows/import-pin-items! {:pins [(dissoc result :id)]})
    (let [remaining (atom nil)]
      (pin-state/swap-render!
       (fn [s]
         (let [next-results (vec (remove #(= id (:id %)) (:search-results s [])))]
           (reset! remaining next-results)
           (assoc s :search-results next-results))))
      (persist-and-push! @remaining))))
