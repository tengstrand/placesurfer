(ns hitteri.about-ui.panel
  (:require [hitteri.about-ui.sources :as sources]))

(def ^:private github-sponsors-url "https://github.com/sponsors/tengstrand")
(def ^:private linkedin-url "https://www.linkedin.com/in/joakim-tengstrand/")
(def ^:private hemnet-url "https://www.hemnet.se/")
(def ^:private google-maps-url "https://www.google.com/maps")

(defn- external-link [href label]
  [:a.about-link
   {:href href :target "_blank" :rel "noopener noreferrer"}
   label])

(defn- bookmarklet-href [script-name]
  (let [origin (try (.-origin js/location) (catch :default _ ""))]
    (str "javascript:(function(){var s=document.createElement('script');s.src='"
         origin
         "/" script-name "';document.body.appendChild(s);})();")))

(defn- sponsor-section [t]
  [:motion.about-section
   [:h2.about-heading (t :about/heading-me)]
   [:p.about-bio
    (t :about/bio-intro)
    (external-link linkedin-url (t :about/bio-author))
    (t :about/bio-sponsor-intro)
    (external-link github-sponsors-url (t :about/bio-sponsors-link))
    (t :about/bio-end)]])

(defn- place-section [t]
  [:motion.about-section
   [:h2.about-heading (t :about/heading-hemnet)]
   [:ol.about-hemnet-steps
    [:li.about-hemnet-step
     (t :about/hemnet-step1-drag)
     [:a.about-bookmarklet {:href (bookmarklet-href "place-bookmarklet.js")}
      (t :about/hemnet-bookmarklet-link)]
     (t :about/hemnet-step1-to-bar)
     [:p.about-hint (t :about/hemnet-hint)]]
    [:li.about-hemnet-step
     (t :about/place-step2-prefix)
     (external-link hemnet-url (t :about/place-step2-hemnet))
     (t :about/place-step2-or-place)
     (external-link google-maps-url (t :about/place-step2-google-maps))
     (t :about/place-step2-after-sources)
     [:img.about-menu-icon {:src "/images/edit.png" :alt (t :nav/update-alt)}]
     (t :about/place-step2-after-edit)
     [:img.about-menu-icon {:src "/images/pin.png" :alt (t :about/hemnet-step3-pins-alt)}]
     (t :about/place-step2-after-pin)
     [:img.about-menu-icon {:src "/images/import.png" :alt ""}]
     (t :about/place-step2-or-press)
     [:code "Ctrl+V"]
     (t :about/hemnet-step3-or)
     [:code "Cmd+V"]
     (t :about/place-step2-end)]]])

(defn panel
  [{:keys [t]
    :or {t (fn [k] (name k))}}]
  [:div.about-sections
   (sponsor-section t)
   (place-section t)
   (sources/section t)])
