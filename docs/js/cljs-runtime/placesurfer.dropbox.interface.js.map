(ns placesurfer.dropbox.interface
  (:require [placesurfer.dropbox.config :as config]
            [placesurfer.dropbox.core :as core]))

(def pull-timeout-ms config/pull-timeout-ms)

(defn connected? [] (core/connected?))
(defn configured? [] (core/configured?))
(defn account-email [] (core/account-email))
(defn set-on-push-error! [f] (core/set-on-push-error! f))
(defn register-sync-doc! [doc-key opts] (core/register-sync-doc! doc-key opts))
(defn begin-connect! [] (core/begin-connect!))
(defn handle-oauth-callback! [] (core/handle-oauth-callback!))
(defn push! [] (core/push!))
(defn pull! [] (core/pull!))
(defn disconnect! [] (core/disconnect!))
(defn fetch-account-email! [] (core/fetch-account-email!))
