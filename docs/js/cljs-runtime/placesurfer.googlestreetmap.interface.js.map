(ns placesurfer.googlestreetmap.interface
  (:require [placesurfer.googlestreetmap.core :as core]))

(defn parse-url [url countries]
  (core/parse-url url countries))

(defn parse-coordinates [url]
  (core/parse-coordinates url))

(defn parse-name [url]
  (core/parse-name url))

(defn build-maps-search-url [& args]
  (apply core/build-maps-search-url args))

(defn build-maps-location-url [& args]
  (apply core/build-maps-location-url args))

(defn build-maps-search-link-html [& args]
  (apply core/build-maps-search-link-html args))

(defn build-street-view-url [& args]
  (apply core/build-street-view-url args))

(defn google-maps-url? [& args] (apply core/google-maps-url? args))
(defn hemnet-listing-url? [& args] (apply core/hemnet-listing-url? args))
(defn complete-address-line? [& args] (apply core/complete-address-line? args))
(defn place-external-links [& args] (apply core/place-external-links args))
(defn build-external-icon-link-html [& args] (apply core/build-external-icon-link-html args))
(defn build-maps-icon-link-html [& args] (apply core/build-maps-icon-link-html args))
(defn build-place-external-link-icons-html [& args]
  (apply core/build-place-external-link-icons-html args))
(defn build-place-external-links-html [& args] (apply core/build-place-external-links-html args))

