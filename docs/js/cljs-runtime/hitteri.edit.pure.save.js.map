(ns hitteri.edit.pure.save
  (:require [clojure.string :as str]
            [hitteri.edit.pure.coords :as coords]
            [hitteri.edit.pure.rows :as rows]
            [hitteri.edit.pure.sources :as sources]))

(def save-row-ui-keys
  #{:row-id :pending? :marker-topic :meters :url-form :url-pin :pending-id})

(def tombstone-dissoc-keys
  (conj save-row-ui-keys :row-id :action :pending-id))

(defn- empty-save-value? [v]
  (or (nil? v)
      (and (string? v) (str/blank? v))))

(defn- compact-save-position [position]
  (into {} (remove (fn [[_ v]] (empty-save-value? v)) position)))

(defn delete-row->tombstone
  [country-code row]
  (let [lon (if (number? (:longitude row))
              (:longitude row)
              (coords/parse-decimal (:longitude row)))
        lat (if (number? (:latitude row))
              (:latitude row)
              (coords/parse-decimal (:latitude row)))
        country-code* (or (:country-code row) country-code)
        base (let [base (-> row
                            (#(reduce (fn [m k] (dissoc m k)) % tombstone-dissoc-keys))
                            (assoc :country-code country-code*
                                   :longitude lon
                                   :latitude lat
                                   :action :deleted))
               name (some-> (:name base) str str/trim)]
           (if (seq name)
             (assoc base :name name)
             (dissoc base :name)))]
    (-> (if (contains? base :source)
          (assoc base :source (sources/source-name-for-save (:source base)))
          base)
        compact-save-position)))

(defn row->save-position
  [country-code row]
  (if (rows/row-save-as-tombstone? row)
    (delete-row->tombstone country-code row)
    (let [lon (if (number? (:longitude row))
                (:longitude row)
                (coords/parse-decimal (:longitude row)))
          lat (if (number? (:latitude row))
                (:latitude row)
                (coords/parse-decimal (:latitude row)))
          base (-> row
                   (dissoc save-row-ui-keys)
                   (assoc :country-code country-code
                          :longitude lon
                          :latitude lat))
          base (if (rows/saved-update-row-id? (:row-id row))
                 base
                 (dissoc base :action))
          base (if (contains? base :source)
                 (assoc base :source (sources/source-name-for-save (:source base)))
                 base)]
      (-> (cond
            (rows/row-marked-edited? base) (assoc base :action :edited)
            (or (rows/row-marked-added? base) (rows/pending-row? row)) (dissoc base :action)
            (#{:delete :deleted} (:action base)) (dissoc base :action)
            :else base)
          compact-save-position))))

(defn- action-name-for-compare
  [action]
  (when (seq (str/trim (str action)))
    (if (keyword? action) (name action) (str action))))

(defn normalize-save-position-for-compare
  [position]
  (let [{:keys [name locality homepage description country-code longitude latitude source action
                holes layout-name]} position
        description* (str/trim (str (or description "")))
        trimmed-name (str/trim (str (or name "")))
        src (when (seq (str/trim (str source)))
              (if (keyword? source) source (keyword (str/trim (str source)))))
        action-kw (when (seq (str/trim (str action)))
                    (let [kw (if (keyword? action) action (keyword (str/trim (str action))))]
                      (if (#{:delete :deleted} kw) :deleted kw)))]
    (if (and (number? longitude) (number? latitude))
      (cond-> {:name trimmed-name
               :longitude (double longitude)
               :latitude (double latitude)
               :country-code (some-> country-code str/trim str/upper-case)
               :description description*}
        (seq (str/trim (str locality))) (assoc :locality (str/trim (str locality)))
        (seq (str/trim (str homepage))) (assoc :homepage (str/trim (str homepage)))
        src (assoc :source src)
        action-kw (assoc :action action-kw)
        (some? holes) (assoc :holes holes)
        (seq (str/trim (str layout-name))) (assoc :layout-name (str/trim (str layout-name))))
      (when (seq trimmed-name)
        (cond-> {:name trimmed-name
                 :country-code (some-> country-code str/trim str/upper-case)
                 :description description*}
          (seq (str/trim (str locality))) (assoc :locality (str/trim (str locality)))
          (seq (str/trim (str homepage))) (assoc :homepage (str/trim (str homepage)))
          src (assoc :source src)
          action-kw (assoc :action action-kw)
          (some? holes) (assoc :holes holes)
          (seq (str/trim (str layout-name))) (assoc :layout-name (str/trim (str layout-name))))))))

(defn save-positions-identity-key
  [position]
  (if (and (number? (:longitude position)) (number? (:latitude position)))
    [(:longitude position) (:latitude position) (action-name-for-compare (:action position))]
    [(:name position) (action-name-for-compare (:action position))]))

(defn canonical-save-positions
  [positions]
  (->> positions
       (keep normalize-save-position-for-compare)
       (sort-by save-positions-identity-key)
       vec))
