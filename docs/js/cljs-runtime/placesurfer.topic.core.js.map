(ns placesurfer.topic.core
  (:require [cljs.reader :as reader]
            [placesurfer.load.interface.art :as load-art]
            [placesurfer.load.interface.discgolf :as load-discgolf]
            [placesurfer.load.interface.table-tennis :as load-table-tennis]))

(def countries-url "data/world-countries.edn")
(def country-bounds-url "data/country-bounds.edn")
(def country-pick-bounds-url "data/country-pick-bounds.edn")

(def topics
  {:discgolf {:label "Discgolf courses"
              :marker-url "/images/marker/discgolf.png"
              :count-loader load-discgolf/load-counts!
              :country-loader load-discgolf/load-country!}
   :art {:label "Museums and art galleries"
         :marker-url "/images/marker/art.png"
         :count-loader load-art/load-counts!
         :country-loader load-art/load-country!}
   :table-tennis {:label "Table tennis clubs"
                  :marker-url "/images/marker/table-tennis.png"
                  :count-loader load-table-tennis/load-counts!
                  :country-loader load-table-tennis/load-country!}})

(def default-active-topics #{:discgolf :art})

(defn topic-keys []
  (keys topics))

(defn topic-label [topic]
  (:label (topics topic)))

(defn topic-marker-url [topic]
  (:marker-url (topics topic)))

(defn- fetch-text! [url]
  (-> (js/fetch url)
      (.then (fn [resp]
               (if (.-ok resp)
                 (.text resp)
                 (js/Promise.reject
                  (js/Error. (str "Failed to load " url ", status " (.-status resp)))))))))

(defn- fetch-counts! [topic]
  (if-let [loader (:count-loader (topics topic))]
    (loader)
    (js/Promise.resolve {})))

(defn- disk-deleted-browse-position? [position]
  (let [action (some-> (:action position) keyword)]
    (contains? #{:delete :deleted} action)))

(defn browse-map-positions [positions]
  (vec (remove disk-deleted-browse-position? positions)))

(defn load-topic-country! [topic slug]
  (if-let [loader (:country-loader (topics topic))]
    (-> (loader slug)
        (.then (fn [{:keys [country count positions]}]
                 (js/Promise.resolve
                  {:country country
                   :count count
                   :positions (mapv #(assoc % :topic topic)
                                    (browse-map-positions positions))})))
        (.catch (fn [_]
                  (js/Promise.resolve {:country slug :count 0 :positions []}))))
    (js/Promise.resolve {:country slug :count 0 :positions []})))

(defn- topics-to-load [active-topics]
  (vec (keep #(when (contains? active-topics %) %) (keys topics))))

(defn- sum-counts [count-maps slug active-topics]
  (reduce + 0
          (map #(get (count-maps %) slug 0)
               (topics-to-load active-topics))))

(defn- merge-country-counts [countries count-maps active-topics]
  (mapv #(assoc % :count (sum-counts count-maps (:slug %) active-topics)) countries))

(defn- parse-countries [countries-text]
  (sort-by :label (reader/read-string countries-text)))

(defn- merge-country-bounds [countries bounds-text]
  (let [bounds (reader/read-string bounds-text)
        by-iso (into {} (map (juxt :iso identity) bounds))]
    (mapv (fn [country]
            (if-let [{:keys [west east south north]} (by-iso (:iso country))]
              (assoc country :west west :east east :south south :north north)
              country))
          countries)))

(defn- merge-country-pick-bounds [countries pick-bounds-text]
  (let [bounds (reader/read-string pick-bounds-text)
        by-iso (into {} (map (juxt :iso identity) bounds))]
    (mapv (fn [country]
            (if-let [{:keys [west east south north]} (by-iso (:iso country))]
              (assoc country
                     :pick-west west :pick-east east :pick-south south :pick-north north)
              country))
          countries)))

(defn load-countries!
  "Load the world country list. Does not wait on per-topic count files, so the
   sidebar can render immediately."
  [_active-topics]
  (-> (js/Promise.all [(fetch-text! countries-url)
                       (-> (fetch-text! country-bounds-url)
                           (.catch (fn [_] nil)))
                       (-> (fetch-text! country-pick-bounds-url)
                           (.catch (fn [_] nil)))])
      (.then (fn [[countries-text bounds-text pick-bounds-text]]
               (let [countries (parse-countries countries-text)
                     with-bounds (if bounds-text
                                   (merge-country-bounds countries bounds-text)
                                   countries)]
                 (if pick-bounds-text
                   (merge-country-pick-bounds with-bounds pick-bounds-text)
                   with-bounds))))))

(defn enrich-countries-with-counts!
  "Optional: merge topic course/place counts into an existing country list.
   Never rejects — returns the original list on failure."
  [active-topics countries]
  (let [topics-to-load (topics-to-load active-topics)]
    (if (empty? topics-to-load)
      (js/Promise.resolve countries)
      (-> (js/Promise.all (mapv fetch-counts! topics-to-load))
          (.then (fn [count-maps]
                   (sort-by :label
                            (merge-country-counts countries
                                                  (zipmap topics-to-load count-maps)
                                                  active-topics))))
          (.catch (fn [_]
                    (js/Promise.resolve countries)))))))

(defn load-country-topics! [slug active-topics]
  (let [topics-to-load (topics-to-load active-topics)]
    (if (empty? topics-to-load)
      (js/Promise.resolve {:count 0 :positions []})
      (-> (js/Promise.all (mapv #(load-topic-country! % slug) topics-to-load))
          (.then (fn [results]
                   (let [positions (vec (mapcat :positions results))
                         count (count positions)]
                     (js/Promise.resolve {:count count :positions positions}))))))))

(defn load-country-topics-with-progress! [slug active-topics {:keys [on-topic-started on-topic-loaded]}]
  (let [topics-to-load (topics-to-load active-topics)
        started! (or on-topic-started (fn [_] nil))
        loaded! (or on-topic-loaded (fn [_ _] nil))]
    (if (empty? topics-to-load)
      (js/Promise.resolve {:count 0 :positions []})
      (-> (js/Promise.all
           (mapv (fn [topic]
                   (started! topic)
                   (-> (load-topic-country! topic slug)
                       (.then (fn [result]
                                (loaded! topic result)
                                (js/Promise.resolve result)))))
                 topics-to-load))
          (.then (fn [results]
                   (let [positions (vec (mapcat :positions results))
                         count (count positions)]
                     (js/Promise.resolve {:count count :positions positions}))))))))
