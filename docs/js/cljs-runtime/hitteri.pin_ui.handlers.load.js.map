(ns hitteri.pin-ui.handlers.load
  "Initial pin data load."
  (:require [hitteri.app-ui.interface.effects :as effects]
            [hitteri.pin-ui.handlers.rows :as pin-rows]
            [hitteri.pin-ui.handlers.state :as pin-state]
            [hitteri.pin-ui.pure.forms :as forms]
            [hitteri.pin-ui.pure.storage :as storage]))

(defn load-pin-icons! []
  (-> (js/fetch "/data/pin-icons.json")
      (.then #(.json %))
      (.then (fn [data]
               (forms/set-icon-options! (js->clj data :keywordize-keys false))
               (effects/render!)))
      (.catch (fn [_] nil))))

(defn load-pins-from-storage! []
  (pin-state/swap-render!
   (fn [s]
     (pin-rows/refresh-table-rows
      (-> s
          (assoc :pin-items (storage/read-pins!)
                 :pin-form (forms/default-form)
                 :pin-form-baseline (forms/default-form)
                 :pin-selected-id nil)
          (pin-state/clear-search-ui))))))
