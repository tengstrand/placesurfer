(ns placesurfer.pin-ui.pure.editor-pane
  (:require [placesurfer.pin-ui.pure.form-fields :as form-fields]
            [placesurfer.pin-ui.pure.search-field :as search-field]
            [placesurfer.map-panel-ui.interface.status :as map-panel-ui.status]))

(defn- form-content [props]
  (let [edit-mode? (= :edit (:pin-editor-mode props))
        new-mode? (= :new (:pin-editor-mode props))
        inline? (:pin-editor-inline? props false)
        show-search? (and (not inline?)
                          (or (:pin-show-search? props false)
                              (and new-mode? (not inline?))))
        show-form-fields? (or inline?
                              edit-mode?
                              (and new-mode? (not inline?)))]
    (into [:div.pin-editor-form]
          (concat (when show-form-fields? (form-fields/field-rows props))
                  (when show-search? [(search-field/search props)])))))

(defn editor-pane
  [{:keys [pin-message t]
    :or {t (fn [k] (name k))}
    :as props}]
  [:div.pin-editor-pane
   (form-content props)
   (when-let [msg (map-panel-ui.status/display-status-text pin-message)]
     [:p.pin-editor-message msg])])
