(ns placesurfer.web-app.render
  (:require [clojure.string :as str]
            [placesurfer.app-ui.interface :as app-ui.interface]
            [placesurfer.app-ui.interface.description :as app-description]
            [placesurfer.app-ui.interface.ui :as app-ui]
            [placesurfer.map-panel-ui.interface.mount :as map-panel-ui.mount]
            [placesurfer.map-ui.interface :as map-ui]
            [placesurfer.topic.interface :as data]
            [placesurfer.web-app.debug :as debug]
            [placesurfer.web-app.draw-layers :as draw-layers]
            [placesurfer.web-app.dropbox :as web-app.dropbox]
            [placesurfer.app-ui.interface.load :as app-load]
            [placesurfer.web-app.map-country :as map-country]
            [placesurfer.web-app.map-sync :as map-sync]
            [placesurfer.i18n.interface :as i18n]
            [placesurfer.web-app.home-search :as home-search]
            [placesurfer.web-app.locale :as locale]
            [placesurfer.web-app.transit :as transit]
            [placesurfer.web-app.nav :as nav]
            [placesurfer.web-app.state :as state]
            [placesurfer.edit.interface.handlers.form :as update-form]
            [placesurfer.edit.interface.handlers.search :as update-search]
            [placesurfer.edit.interface.handlers.description-trace :as description-trace]
            [placesurfer.edit.interface.handlers.map :as update-map]
            [placesurfer.edit.interface.handlers.rows :as update-rows]
            [placesurfer.edit.interface.handlers.save :as update-save]
            [placesurfer.edit.interface.handlers.topic :as update-topic]
            [placesurfer.edit.interface.panel :as edit-ui.panel]
            [placesurfer.pin-ui.interface.handlers.form :as pin-form]
            [placesurfer.pin-ui.interface.handlers.editor :as pin-editor]
            [placesurfer.clipboard-ui.interface.handlers.export :as clipboard-export]
            [placesurfer.clipboard-ui.interface.handlers.paste :as clipboard-paste]
            [placesurfer.pin-ui.interface.handlers.hemnet :as pin-hemnet]
            [placesurfer.pin-ui.interface.handlers.hemnet-search :as pin-hemnet-search]
            [placesurfer.pin-ui.interface.handlers.interaction :as pin-interaction]
            [placesurfer.pin-ui.interface.handlers.map :as pin-map]
            [placesurfer.pin-ui.interface.handlers.rows :as pin-rows]
            [placesurfer.pin-ui.interface.panel :as pin-ui.panel]
            [replicant.dom :as r]))

(def mount-map!
  (map-panel-ui.mount/create-main-mount!
   {:map-ui-mount map-ui/mount-map!
    :sync-map! map-sync/sync-map!
    :schedule-resize! map-sync/schedule-map-resize!}))

(def mount-update-map!
  (map-panel-ui.mount/create-update-mount!
   {:map-ui-mount map-ui/mount-map!
    :refresh-pending-places! update-map/refresh-update-pending-places!
    :sync-update-map! update-map/sync-update-map!
    :schedule-pin-sync! update-map/schedule-update-map-pin-sync!
    :schedule-resize! map-sync/schedule-map-resize!}))

(def mount-pin-map!
  (map-panel-ui.mount/create-pin-mount!
   {:map-ui-mount map-ui/mount-map!
    :sync-pin-map! pin-map/sync-pin-map!
    :schedule-pin-sync! pin-map/schedule-pin-map-sync!
    :schedule-resize! map-sync/schedule-map-resize!}))

(declare render!)

(def unmount-map!
  (map-panel-ui.mount/create-unmount! map-ui/destroy-map!))

(defn sync-marker-pick-handler! []
  (if (= :pin (:page @state/!state))
    (pin-map/sync-marker-pick-handler!)
    (update-map/sync-marker-pick-handler!)))

(defn render-handlers []
   {:navigate! nav/navigate!
   :navigate-to-pin! nav/navigate-to-pin!
   :navigate-to-update! nav/navigate-to-update!
   :navigate-to-update-tab! (fn [tab]
                               (swap! state/!state assoc :update-panel-tab tab)
                               (nav/navigate! :update))
   :set-update-panel-tab! nav/set-update-panel-tab!
   :select-country! nav/select-country!
   :set-country-filter! nav/set-country-filter!
   :set-country-highlight-index! nav/set-country-highlight-index!
   :set-topic-active! app-load/set-topic-active!
   :ensure-countries-loaded! app-load/ensure-countries-loaded!
   :show-map! nav/show-map!
   :set-update-name! #(update-form/set-update-form! :name %)
   :set-update-location! #(update-form/set-update-form! :location %)
   :set-update-homepage! #(update-form/set-update-form! :homepage %)
   :set-update-description! #(update-form/set-update-form! :description %)
   :flush-update-description! update-form/flush-update-description-from-dom!
   :trace-update-description! (fn [event extra] (description-trace/trace! event extra))
   :set-update-longitude! #(update-form/set-update-form! :longitude % {:sync-display? false})
   :commit-update-longitude! #(update-form/set-update-form! :longitude %)
   :set-update-latitude! #(update-form/set-update-form! :latitude % {:sync-display? false})
   :commit-update-latitude! #(update-form/set-update-form! :latitude %)
   :try-paste-update-coordinates! update-form/try-apply-pasted-coordinate-text!
   :create-new-update-row! update-form/create-new-update-row!
   :restore-selected-update-row! update-rows/restore-selected-update-row!
   :toggle-update-row! update-rows/toggle-update-row!
   :update-row-click! update-rows/update-row-click!
   :toggle-selected-update-row-delete! update-rows/toggle-selected-update-row-delete!
   :toggle-update-show-duplicates! update-rows/toggle-update-show-duplicates!
   :toggle-update-show-invalid! update-rows/toggle-update-show-invalid!
   :set-update-map-height! update-rows/set-update-map-height!
   :schedule-update-map-resize! map-sync/schedule-map-resize!
   :set-update-sort! update-rows/set-update-sort!
   :save-update-dataset! update-save/save-update-dataset!
   :request-update-topic-change! update-topic/request-update-topic-change!
   :toggle-update-pin-topic! update-topic/toggle-update-pin-topic!
   :cancel-update-topic-switch! update-topic/cancel-update-topic-switch!
   :discard-update-topic-switch! update-topic/discard-update-topic-switch!
   :save-and-switch-update-topic! update-topic/save-and-switch-update-topic!
   :set-update-search-query! update-search/set-update-search-query!
   :select-update-search-result! update-search/select-update-search-result!
   :update-search-keydown! update-search/update-search-keydown!
   :toggle-add-pin-mode! update-map/toggle-add-pin-mode!
   :set-pin-name! pin-form/set-pin-name!
   :set-pin-address! pin-form/set-pin-address!
   :set-pin-icon! pin-form/set-pin-icon!
   :set-pin-stars! pin-form/set-pin-stars!
   :set-pin-radii! pin-form/set-pin-radii!
   :set-pin-url! pin-form/set-pin-url!
   :set-pin-image! pin-form/set-pin-image!
   :set-pin-agent-url! pin-form/set-pin-agent-url!
   :set-pin-agent-name! pin-form/set-pin-agent-name!
   :set-pin-description! pin-form/set-pin-description!
   :set-pin-longitude! pin-form/set-pin-longitude!
   :commit-pin-longitude! pin-form/commit-pin-longitude!
   :set-pin-latitude! pin-form/set-pin-latitude!
   :commit-pin-latitude! pin-form/commit-pin-latitude!
   :set-pin-search-query! pin-form/set-pin-search-query!
   :select-pin-search-result! pin-form/select-pin-search-result!
   :select-map-search-result! pin-form/select-map-search-result!
   :pin-search-keydown! pin-form/pin-search-keydown!
   :map-search-keydown! pin-form/map-search-keydown!
   :add-pin! pin-rows/add-pin!
   :save-pin! pin-rows/save-pin!
   :toggle-pin-row! pin-interaction/pin-row-click!
   :pin-row-click! pin-interaction/pin-row-click!
   :clear-pin-table-keyboard-focus! pin-interaction/clear-pin-table-keyboard-focus!
   :toggle-pin-preview! pin-interaction/toggle-pin-preview!
   :toggle-pin-stars! pin-interaction/toggle-pin-stars!
   :toggle-update-stars! pin-interaction/toggle-update-stars!
   :toggle-pin-topics-on-map! pin-interaction/toggle-pin-topics-on-map!
   :toggle-pin-list-hidden! pin-interaction/toggle-pin-list-hidden!
   :reorder-pin-row! pin-rows/reorder-pin-row!
   :reorder-stars-row! pin-rows/reorder-stars-row!
   :reorder-stars-pin! pin-rows/reorder-stars-pin!
   :set-pin-list-sort! pin-rows/set-pin-list-sort!
   :delete-selected-pin! pin-rows/delete-selected-pin!
   :delete-pin! pin-rows/delete-pin!
   :undo-pin-delete! pin-rows/undo-pin-delete!
   :open-pin-in-editor! nav/open-pin-in-editor!
   :create-new-pin! pin-hemnet/create-new-pin!
   :paste-place-from-clipboard! clipboard-paste/paste-place-from-clipboard!
   :export-pins-to-clipboard! clipboard-export/export-pins-to-clipboard!
   :create-new-pin-from-clipboard! pin-hemnet/create-new-pin-from-clipboard!
   :save-hemnet-result-as-pin! pin-hemnet-search/save-result-as-pin!
   :clear-hemnet-search-results! pin-hemnet-search/clear-results!
   :select-hemnet-result! pin-hemnet-search/select-result-row!
   :discard-hemnet-result! pin-hemnet-search/discard-result!
   :open-pin-editor-new! pin-editor/open-pin-editor-new!
   :open-pin-editor-edit! pin-editor/open-pin-editor-edit!
   :cancel-pin-editor! pin-editor/cancel-pin-editor!
   :confirm-pin-editor! pin-editor/confirm-pin-editor!
   :schedule-pin-map-resize! map-sync/schedule-map-resize!
   :toggle-description-edit-mode! app-description/toggle-description-edit-mode!
   :set-locale! locale/set-locale!
   :set-transit-destination! transit/set-transit-destination!
   :connect-dropbox! web-app.dropbox/connect!
   :disconnect-dropbox! web-app.dropbox/disconnect!
   :set-home-search-query! home-search/set-home-search-query!
   :select-home-search-result! home-search/select-home-search-result!
   :home-search-keydown! home-search/home-search-keydown!
   :toggle-layer! (fn [layer-id active?]
                    (let [next-overlays (if active?
                                          (conj (:active-overlays @state/!state) layer-id)
                                          (disj (:active-overlays @state/!state) layer-id))]
                      (swap! state/!state assoc :active-overlays next-overlays)
                      (map-ui/sync-overlay-layers! next-overlays)))
   :select-draw-layer! draw-layers/select-layer!
   :add-draw-layer! (fn []
                      (let [label (str/trim
                                   (or (:draw-layer-draft-label @state/!state) ""))
                            id    (-> label
                                      str/lower-case
                                      (str/replace #"[åä]" "a")
                                      (str/replace #"ö" "o")
                                      (str/replace #"[^a-z0-9]" "-")
                                      (str/replace #"-+" "-")
                                      (str/replace #"^-|-$" ""))]
                        (when (seq id)
                          (swap! state/!state
                                 (fn [s]
                                   (-> s
                                       (update :draw-layers
                                               (fn [layers]
                                                 (if (some #(= (:id %) id) layers)
                                                   layers
                                                   (conj (or layers []) {:id id :label label
                                                                         :color app-ui.interface/default-layer-color}))))
                                       (assoc :draw-selected-layer-id id)
                                       (assoc :draw-layer-draft-label ""))))
                          (map-ui/set-draw-canvas-color! app-ui.interface/default-layer-color)
                          (map-ui/load-draw-layer! id)
                          (draw-layers/sync-reference-images!))))
   :delete-draw-layer! draw-layers/delete-layer!
   :set-draw-layer-draft-label! (fn [v]
                                  (swap! state/!state assoc :draw-layer-draft-label v))
   :set-draw-layer-color! (fn [color]
                            (let [layer-id (:draw-selected-layer-id @state/!state)]
                              (swap! state/!state update :draw-layers
                                     (fn [layers]
                                       (mapv #(if (= (:id %) layer-id)
                                                (assoc % :color color)
                                                %)
                                             layers)))
                              (map-ui/set-draw-canvas-color! color)
                              (render!)))
   :save-draw-layers-config! (fn [] (draw-layers/save-config!))
   :set-image-layer-opacity! draw-layers/set-image-opacity!})

(defn- view-props [s]
  (let [handlers (render-handlers)
        t (locale/make-t s)
        map-handler-props (map-panel-ui.mount/handler-props
                           {:mount-map! mount-map!
                            :mount-update-map! mount-update-map!
                            :mount-pin-map! mount-pin-map!
                            :unmount-map! unmount-map!})
        edit-deps {:update-table-model (update-save/update-table-model s)
                   :update-restore-enabled? (update-rows/restore-selected-update-row-enabled? s)
                   :update-save-dataset-disabled?
                   (or (not (update-save/update-dataset-preconditions-met? s))
                       (not (update-save/update-dataset-dirty? s)))
                   :update-topic-keys (data/topic-keys)
                   :topic-marker-url-fn data/topic-marker-url
                   :handlers handlers
                   :map-handler-props map-handler-props
                   :t t}
        base-props (app-ui.interface/view-props
                    s
                    {:topic-keys (data/topic-keys)
                     :topic-label-fn (fn [topic] (i18n/topic-label (:locale s :en) topic))
                     :topic-marker-url-fn data/topic-marker-url
                     :mobile? (nav/small-screen?)
                     :handlers handlers
                     :map-handler-props map-handler-props
                     :t t})]
    (merge base-props
           {:locale (:locale s :en)
            :t t
            :set-locale! (:set-locale! handlers)
            :transit-destination (:transit-destination s "")
            :set-transit-destination! (:set-transit-destination! handlers)
            :connect-dropbox! (:connect-dropbox! handlers)
            :disconnect-dropbox! (:disconnect-dropbox! handlers)
            :set-home-search-query! home-search/set-home-search-query!
            :select-home-search-result! home-search/select-home-search-result!
            :home-search-keydown! home-search/home-search-keydown!}
           (edit-ui.panel/view-props s edit-deps)
           (pin-ui.panel/view-props s handlers map-handler-props t)
           {:render-update-panel edit-ui.panel/panel
            :render-pin-panel pin-ui.panel/panel})))

(defn render! []
  (when-let [root (.getElementById js/document "app")]
    (let [s @state/!state]
      (r/render root (app-ui/view (view-props s)))))
  (sync-marker-pick-handler!)
  (map-country/sync-map-country-pick!)
  (debug/publish-debug-status!))
