(ns hitteri.pin-ui.pure.search
  (:require [hitteri.country.interface :as country]))

(defn highlight-index-for-results [results]
  (when (seq results) 0))

(defn step-highlight-index [current-index result-count delta]
  (country/step-highlight-index current-index result-count delta))

(defn highlighted-result [results highlight-index]
  (when (and (seq results) (some? highlight-index))
    (nth results highlight-index nil)))

(defn enter-key?
  "True for Enter / NumpadEnter without modifiers."
  [^js e]
  (and e
       (not (.-repeat e))
       (not (.-ctrlKey e))
       (not (.-metaKey e))
       (not (.-altKey e))
       (#{"Enter" "NumpadEnter"} (.-key e))))

(defn enter-action
  "Return [:select index] for Enter in the pin search field when results are open."
  [results _form-valid? highlight-index]
  (when (seq results)
    [:select (or highlight-index 0)]))
