(ns hitteri.html.description
  (:require [clojure.string :as str]
            [hitteri.html.sanitize :as sanitize]))

(def ^:private url-pattern
  #"(https?://[^\s<&\"']+|mailto:[^\s<&\"']+)")

(defn- linkify-text-segment [text]
  (str/replace text url-pattern
               (fn [match]
                 (let [url (first match)]
                   (str "<a href=\"" url "\">" url "</a>")))))

(defn linkify-bare-urls
  "Wrap bare URLs in anchor tags; leave existing HTML tags untouched."
  [s]
  (loop [remaining (str s) out ""]
    (if-let [idx (str/index-of remaining "<")]
      (let [text (subs remaining 0 idx)
            after (subs remaining idx)
            tag-end (str/index-of after ">")]
        (if tag-end
          (let [tag (subs after 0 (inc tag-end))]
            (recur (subs after (inc tag-end))
                   (str out (linkify-text-segment text) tag)))
          (str out (linkify-text-segment text) after)))
      (str out (linkify-text-segment remaining)))))

(defn normalize-editor-html
  "Normalize contenteditable HTML before sanitization."
  [html]
  (-> (str html)
      (str/replace #"\r\n" "\n")
      (str/replace #"&nbsp;" " ")
      (str/replace #"(?i)</div>\s*<div[^>]*>" "<br>")
      (str/replace #"(?i)</div>" "")
      (str/replace #"(?i)<div[^>]*>" "<br>")
      (str/replace #"(?i)<br\s*/?>" "<br>")
      (str/replace #"(?i)(?:<br>)+$" "")
      (str/replace #"(?i)^(?:<br>)+" "")))

(def ^:private place-external-links-suffix-pattern
  #"(?is)(?:<br\s*/?>\s*)*<div class=\"place-external-links\"[^>]*>.*?</div>\s*$")

(defn strip-place-external-links-suffix
  "Remove auto-appended place link row from editor HTML before saving."
  [html]
  (str/replace (str html) place-external-links-suffix-pattern ""))

(defn description-for-text-display
  "Sanitized HTML safe to assign to a contenteditable div."
  [description]
  (sanitize/sanitize-description-html description))

(defn description-from-text-editor
  "Read contenteditable HTML and return canonical sanitized description."
  [inner-html]
  (-> inner-html
      strip-place-external-links-suffix
      normalize-editor-html
      linkify-bare-urls
      sanitize/sanitize-description-html))

(defn plain-text->description
  "Convert plain text (newlines, bare URLs) to canonical description HTML."
  [text]
  (-> text
      linkify-bare-urls
      sanitize/sanitize-description-html))
