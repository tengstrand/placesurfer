(ns placesurfer.pin-ui.handlers.separator
  "Pin list separator manage overlay (modal)."
  (:require [placesurfer.app-ui.interface.state :as app-state]
            [placesurfer.pin-ui.handlers.editor :as editor]
            [placesurfer.pin-ui.handlers.rows :as rows-handler]
            [placesurfer.pin-ui.handlers.state :as pin-state]
            [placesurfer.pin-ui.pure.rows :as rows]
            [placesurfer.pin-ui.pure.storage :as storage]))

(defn- close-overlay [s]
  (assoc s
         :pin-separator-overlay-open? false
         :pin-separator-overlay-rows []
         :pin-separator-overlay-selected-id nil
         :pin-separator-overlay-snapshot nil
         :pin-separator-overlay-draft-label ""
         :pin-separator-overlay-editing-id nil))

(defn- overlay-snapshot [s]
  {:rows (:pin-separator-overlay-rows s [])
   :selected-id (:pin-separator-overlay-selected-id s)})

(defn- restore-overlay-snapshot! [s snapshot]
  (assoc s
         :pin-separator-overlay-rows (:rows snapshot [])
         :pin-separator-overlay-selected-id (:selected-id snapshot)))

(defn- cancel-pin-editor-if-open! []
  (when (:pin-editor-open? @app-state/!state)
    (editor/cancel-pin-editor!)))

(defn open-pin-separator-overlay! []
  (cancel-pin-editor-if-open!)
  (pin-state/swap-render!
   (fn [s]
     (let [overlay-rows (rows/separator-overlay-rows-from-items (:pin-items s))]
       (assoc s
              :pin-separator-overlay-open? true
              :pin-separator-overlay-rows overlay-rows
              :pin-separator-overlay-selected-id (:id (first overlay-rows))
              :pin-separator-overlay-snapshot {:rows overlay-rows
                                               :selected-id (:id (first overlay-rows))})))))

(defn cancel-pin-separator-overlay! []
  (pin-state/swap-render!
   (fn [s]
     (-> s
         (restore-overlay-snapshot! (:pin-separator-overlay-snapshot s (overlay-snapshot s)))
         close-overlay))))

(defn select-separator-overlay-row! [id]
  (pin-state/swap-render! #(assoc % :pin-separator-overlay-selected-id id)))

(defn set-separator-overlay-label! [id label]
  (pin-state/swap-render!
   (fn [s]
     (update s :pin-separator-overlay-rows
             (fn [overlay-rows]
               (mapv (fn [row]
                       (if (= id (:id row))
                         (assoc row :label (str (or label "")))
                         row))
                     overlay-rows))))))

(defn- focus-separator-overlay-input! [id]
  (when (js* "typeof document !== 'undefined' && document.getElementById")
    (let [element-id (str "pin-separator-manage-input-" id)]
      (doseq [delay-ms [0 60 140 260]]
        (js/setTimeout
         #(when-let [el (.getElementById js/document element-id)]
            (.focus el))
         delay-ms)))))

(defn add-separator-overlay-row! []
  (let [id (storage/new-pin-id)]
    (pin-state/swap-render!
     (fn [s]
       (assoc s
              :pin-separator-overlay-rows
              (conj (vec (:pin-separator-overlay-rows s []))
                    {:id id :label "" :new? true})
              :pin-separator-overlay-selected-id id)))
    (focus-separator-overlay-input! id)))

(defn delete-separator-overlay-row! [id]
  (pin-state/swap-render!
   (fn [s]
     (let [overlay-rows (vec (:pin-separator-overlay-rows s []))
           remaining (vec (remove #(= id (:id %)) overlay-rows))
           selected-id (:pin-separator-overlay-selected-id s)]
       (assoc s
              :pin-separator-overlay-rows remaining
              :pin-separator-overlay-selected-id
              (if (= selected-id id)
                (:id (first remaining))
                selected-id))))))

(defn- persist-items! [items]
  (storage/save-pins! items))

(defn confirm-separator-overlay! []
  (let [saved (atom nil)]
    (pin-state/swap-state!
     (fn [s]
       (let [next-items (rows/apply-separator-overlay-edits
                         (:pin-items s)
                         (:pin-separator-overlay-rows s []))]
         (reset! saved next-items)
         (rows-handler/refresh-table-rows
          (-> s (assoc :pin-items next-items) close-overlay)))))
    (when @saved
      (persist-items! @saved)
      (pin-state/render!))))
