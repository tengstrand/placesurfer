(ns placesurfer.web-app.nav
  (:require [placesurfer.app-ui.interface.pages :as app-ui.pages]
            [placesurfer.country.interface :as country]
            [placesurfer.edit.interface.baseline :as edit-ui.baseline]
            [placesurfer.edit.interface.topics :as edit-topics]
            [placesurfer.map-ui.interface :as map-ui]
            [placesurfer.web-app.analytics :as analytics]
            [placesurfer.web-app.backend :as backend]
            [placesurfer.web-app.effects :as effects]
            [placesurfer.app-ui.interface.load :as app-load]
            [placesurfer.web-app.map-country :as map-country]
            [placesurfer.web-app.map-sync :as map-sync]
            [placesurfer.web-app.state :as state]
            [placesurfer.i18n.interface :as i18n]
            [placesurfer.nav-ui.interface.toast :as nav-ui.toast]
            [placesurfer.edit.interface.handlers.map :as update-map]
            [placesurfer.edit.interface.handlers.save :as update-save]
            [placesurfer.edit.interface.handlers.topic :as update-topic]
            [placesurfer.group-ui.interface.handlers :as group-handlers]
            [placesurfer.pin-ui.interface.handlers.editor :as pin-editor]
            [placesurfer.pin-ui.interface.handlers.form :as pin-form]
            [placesurfer.pin-ui.interface.handlers.map :as pin-map]
            [placesurfer.pin-ui.interface.handlers.rows :as pin-rows]))

(declare navigate!)

(defn show-update-topic-hint! []
  (nav-ui.toast/show! (i18n/t (:locale @state/!state :en) :nav/update-topic-hint))
  (effects/render!))

(defn small-screen? []
  (try (<= (.-innerWidth js/window) 767) (catch :default _ false)))

(defn- focus-country-search! []
  (doseq [delay-ms [0 60 140 260]]
    (js/setTimeout
     #(when-let [el (.querySelector js/document ".country-search")]
        (.focus el))
     delay-ms)))

(defn track-page! [page]
  (analytics/track-page! page))

(defn navigate-to-pin! []
  (navigate! :pin))

(defn navigate-to-update! []
  (let [s @state/!state]
    (if (and (:backend-online? s)
             (= :update (:page s))
             (edit-topics/pins-topic? (:update-topic s)))
      (update-topic/toggle-update-pin-topic!)
      (navigate! :update))))

(defn set-update-panel-tab! [tab]
  (let [s @state/!state
        pins-topic? (edit-topics/pins-topic? (:update-topic s))]
    (swap! state/!state assoc :update-panel-tab tab)
    (cond
      (= tab :groups)
      (when (empty? (:pin-separator-overlay-rows @state/!state))
        (group-handlers/init-groups-edit!))
      (= tab :topic)
      (cond
        pins-topic?       (update-topic/toggle-update-pin-topic!)
        (seq (:update-rows s)) nil
        :else             (do (update-save/reload-update-dataset!)
                              (update-map/schedule-update-map-pin-sync!)))
      (= tab :pins)
      (when-not pins-topic?
        (update-topic/toggle-update-pin-topic!)))
    (effects/render!)))

(defn navigate! [page]
  (let [prev-page (:page @state/!state)
        target-page page
        leaving-update? (= :update prev-page)
        leaving-groups? (= :groups prev-page)
        leaving-update-groups? (and leaving-update?
                                    (= :groups (:update-panel-tab @state/!state)))
        {:keys [focus-search?]} (country/navigate-country-plan target-page)]
    (when (and leaving-update? (not= target-page :update))
      (update-save/save-current-update-dataset-to-cache-if-clean!))
    (when leaving-update-groups?
      (group-handlers/leave-groups-page!))
    (when (and leaving-groups? (not= target-page :groups))
      (group-handlers/leave-groups-page!))
    (swap! state/!state
           (fn [s]
             (-> s
                 (assoc :page target-page :map-country-pick? false)
                 (dissoc :map-restore-view)
                 (cond-> (not= target-page :update) (assoc :pin-editor-inline? false)))))
    (effects/render!)
    (when (app-ui.pages/map-page? target-page)
      (js/setTimeout #(map-ui/resize-map!) 50))
    (when focus-search?
      (focus-country-search!))
    (when (= target-page :update)
      (swap! state/!state
             (fn [s]
               (cond-> (assoc s :update-country-code
                              (or (:country-iso s) (:update-country-code s) "SE"))
                 (nil? (:update-selected-row-id s))
                 (update-in [:update-form :source] edit-ui.baseline/normalize-update-source))))
      (update-topic/ensure-update-topic!)
      (backend/check-backend!)
      (let [pins? (edit-topics/pins-topic? (:update-topic @state/!state))
            prev-tab (:update-panel-tab @state/!state)
            tab (or prev-tab (if pins? :pins :topic))]
        (swap! state/!state assoc :update-panel-tab tab)
        (cond
          (= tab :groups)
          (group-handlers/init-groups-edit!)
          pins?
          (do (pin-rows/refresh-pin-table!)
              (update-map/schedule-update-map-pin-sync!))
          :else
          (do (update-save/reload-update-dataset!)
              (update-map/schedule-update-map-pin-sync!)))))
    (when (= target-page :pin)
      (pin-rows/refresh-pin-table!)
      (pin-map/schedule-pin-map-sync! {:recenter? true})
      (pin-editor/focus-pin-toolbar-search!))
    (when (= target-page :groups)
      (group-handlers/init-groups-edit!))
    (when (app-ui.pages/map-page? target-page)
      (map-sync/schedule-map-resize!)
      (map-sync/sync-map! {:fit? false :animate? false}))
    (when (= target-page :topic)
      (app-load/ensure-active-topic-positions!))
    (when (= target-page :country)
      (app-load/ensure-countries-loaded!))
    (effects/sync-marker-pick-handler!)
    (map-country/sync-map-country-pick!)
    (track-page! target-page)))

(defn select-country! [slug]
  (map-country/disable-country-pick!)
  (let [{:keys [same-country?
                clear-filter?
                switch-to-country-page?
                focus-search?
                load-country?
                navigate-home?
                load-options]}
        (country/select-country-plan {:current-slug (:country-slug @state/!state)
                                      :page (:page @state/!state)
                                      :mobile? (small-screen?)}
                                     slug)]
    (when clear-filter?
      (swap! state/!state assoc :country-filter "" :country-highlight-index nil))
    (cond
      same-country?
      (effects/render!)

      :else
      (do
        (swap! state/!state
               (fn [s]
                 (-> s
                     (assoc :update-country-code
                            (or (country/iso-for-slug slug (:countries @state/!state))
                                (:update-country-code @state/!state)
                                "SE"))
                     (state/clear-update-selection-state))))
        (when (= :update (:page @state/!state))
          (if (edit-topics/pins-topic? (:update-topic @state/!state))
            (do (pin-rows/refresh-pin-table!)
                (update-map/schedule-update-map-pin-sync!))
            (update-save/reload-update-dataset! {:clear-selection? true})))
        (when (= :pin (:page @state/!state))
          (pin-rows/refresh-pin-table!))
        (when switch-to-country-page?
          (swap! state/!state assoc :page :country)
          (effects/render!)
          (when focus-search?
            (focus-country-search!)))
        (when load-country?
          (app-load/load-country! slug load-options))
        (when navigate-home?
          (navigate! :home))))))

(defn set-country-filter!
  ([query] (set-country-filter! query nil))
  ([query visible-count]
   (let [{:keys [country-filter]} (country/set-country-filter-plan query)]
     (swap! state/!state assoc
            :country-filter country-filter
            :country-highlight-index (if (some? visible-count)
                                      (country/highlight-index-after-filter visible-count)
                                      (:country-highlight-index @state/!state))))
   (effects/render!)))

(defn set-country-highlight-index! [idx]
  (swap! state/!state assoc :country-highlight-index idx)
  (effects/render!))

(defn show-map! []
  (navigate! :home))
