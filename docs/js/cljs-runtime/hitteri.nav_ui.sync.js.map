(ns hitteri.nav-ui.sync)

(defonce !synced-nav-page (atom nil))
(defonce !suppress-tab-show-navigation? (atom false))

(defn- show-tab-panel! [^js group name]
  (reset! !suppress-tab-show-navigation? true)
  (try
    (.show group name)
    (catch :default _ nil))
  (js/setTimeout #(reset! !suppress-tab-show-navigation? false) 0))

(defn sync-tab-group-on-page!
  [^js group page]
  (when (and group (not= page @!synced-nav-page))
    (let [name (name page)
          run (fn []
                (when (and group (.-show group))
                  (let [active-tab (.-activeTab group)
                        active-panel (when active-tab (.-panel active-tab))]
                    (when (not= active-panel name)
                      (show-tab-panel! group name))
                    (reset! !synced-nav-page page))))]
      (if (.-show group) (run) (js/setTimeout run 0)))))

(defn reset-synced-page!
  [page]
  (reset! !synced-nav-page page))
