(ns placesurfer.pin-ui.pure.photon
  (:require [clojure.string :as str]
            [placesurfer.country.interface :as country]))

(def api-base "https://photon.komoot.io/api/")

(defn- feature->result [^js feature]
  (when feature
    (let [^js props (.-properties feature)
          ^js geometry (.-geometry feature)
          ^js coords (.-coordinates geometry)
          lon (aget coords 0)
          lat (aget coords 1)
          place-name (or (.-name props) (.-street props) (.-city props) "")]
      (when (and (number? lon) (number? lat) (seq (str/trim place-name)))
        {:name (str/trim place-name)
         :longitude lon
         :latitude lat
         :countrycode (some-> (.-countrycode props) str/upper-case)
         :label (str place-name
                     (when-let [city (.-city props)]
                       (str ", " city))
                     (when-let [cc (.-countrycode props)]
                       (str " (" (str/upper-case cc) ")")))}))))

(defn parse-response
  "Parse Photon GeoJSON FeatureCollection into result maps."
  [^js body]
  (when body
    (let [^js features (.-features body)]
      (->> (array-seq features)
           (keep feature->result)
           vec))))

(def min-search-chars 1)

(defn build-search-url
  [query limit & {:keys [countries country-slug]}]
  (let [trimmed (str/trim query)
        base (str api-base "?q=" (js/encodeURIComponent trimmed)
                  "&limit=" limit
                  "&lang=en")
        bbox (when (and (seq countries) country-slug)
               (when-let [bounds (country/country-bounds-for-slug country-slug countries)]
                 (let [{:keys [west east south north]} bounds]
                   (str "&bbox=" west "," south "," east "," north))))]
    (str base (or bbox ""))))

(defn point-in-country-bounds?
  [lon lat countries country-slug]
  (if-let [bounds (country/country-bounds-for-slug country-slug countries)]
    (let [{:keys [west east south north]} bounds]
      (and (number? west) (number? east) (number? south) (number? north)
           (<= west lon east)
           (<= south lat north)))
    true))

(defn result-in-search-country?
  "Relaxed filter for Photon suggestions: ISO match plus in-country bounds when known."
  [{:keys [longitude latitude countrycode]} country-iso countries country-slug]
  (and country-iso
       (= countrycode country-iso)
       (or (not (seq countries))
           (not country-slug)
           (point-in-country-bounds? longitude latitude countries country-slug))))

(defn result-in-current-country?
  [{:keys [longitude latitude countrycode]} country-iso countries country-slug]
  (result-in-search-country? {:longitude longitude
                              :latitude latitude
                              :countrycode countrycode}
                             country-iso countries country-slug))

(defn filter-results-for-country
  [results country-iso countries country-slug]
  (if country-iso
    (vec (filter #(result-in-search-country? % country-iso countries country-slug)
                 results))
    (vec results)))
