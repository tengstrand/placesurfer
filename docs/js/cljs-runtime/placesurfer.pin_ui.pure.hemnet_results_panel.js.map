(ns placesurfer.pin-ui.pure.hemnet-results-panel
  "Hemnet search-result rows, appended after the saved pins in the SAME
   list/table on the pin page (components/pin_ui/pure/list_panel.cljs) rather
   than as a separate panel - `table-rows` for table mode, `preview-rows` for
   the large-image preview mode. Both take the same props."
  (:require [clojure.string :as str]
            [placesurfer.map-ui.interface :as map-ui]))

(def ^:private hemnet-icon-url "/images/marker/hemnet.png")
(def ^:private booli-icon-url "/images/marker/booli.png")
(def ^:private notar-icon-url "/images/marker/notar.png")

(defn- result-icon-url
  "Which marker icon a search-result row shows, keyed off the item's own
   :source (see clipboard-ui.hemnet.form) - defaults to Hemnet's for
   older/plain items with no :source, mirroring
   pin_ui.handlers.map/search-result-marker-topic."
  [item]
  (case (:source item)
    "booli" booli-icon-url
    "notar" notar-icon-url
    hemnet-icon-url))

(defn- table-row-class [selected?]
  (when selected? "hemnet-results-row--selected"))

(defn- divider-label [search-results t]
  (str (t :pin/hemnet-results-heading) " (" (count search-results) ")"))

(defn- row-map-hover-handlers
  "Same row-hover -> map-marker-emphasis behaviour as saved-pin rows
   (list-panel's `pin-row-map-hover-handlers`) - matches by :id, which every
   Hemnet search-result marker carries (see handlers/map.cljs's
   `hemnet-search-result-position`)."
  [id]
  {:mouseenter (fn [_] (map-ui/set-marker-row-emphasis! {:id id}))
   :mouseleave (fn [_] (map-ui/clear-marker-row-emphasis!))})

(defn- clear-btn [clear-hemnet-search-results! t]
  [:button.hemnet-results-clear-btn
   {:type "button"
    :title (t :pin/hemnet-results-clear)
    :on {:click (fn [_] (when clear-hemnet-search-results! (clear-hemnet-search-results!)))}}
   (t :pin/hemnet-results-clear)])

(defn- save-button [id save-hemnet-result-as-pin! t]
  [:button.hemnet-results-save-btn
   {:type "button"
    :title (t :pin/hemnet-results-save)
    :on {:click (fn [e]
                  (.stopPropagation e)
                  (when save-hemnet-result-as-pin! (save-hemnet-result-as-pin! id)))}}
   (t :pin/hemnet-results-save)])

(defn- discard-button [id discard-hemnet-result! t]
  [:button.hemnet-results-discard-btn
   {:type "button"
    :title (t :pin/hemnet-results-discard)
    :on {:click (fn [e]
                  (.stopPropagation e)
                  (when discard-hemnet-result! (discard-hemnet-result! id)))}}
   [:img {:src "/images/trash.png" :alt (t :pin/hemnet-results-discard)}]])

(defn- action-buttons
  "Save-as-pin and discard buttons, as flex-row siblings - the preview-mode
   card's action row (table mode keeps them in separate cells - discard sits
   in its own rightmost cell there, see `table-rows`)."
  [id save-hemnet-result-as-pin! discard-hemnet-result! t]
  (list (save-button id save-hemnet-result-as-pin! t)
        (discard-button id discard-hemnet-result! t)))

(defn- hemnet-map-icon-btn
  "The Hemnet marker icon, as a dedicated preview-card button - mirrors
   list-panel's `pin-preview-marker-btn`: clicking it does exactly what
   clicking a table-mode row already does (`select-hemnet-result!`: select +
   scroll/focus the result on the map), as a guaranteed, unambiguous target
   for that action regardless of how much of the card is covered by
   popup-html's own image/source links."
  [item select-hemnet-result!]
  [:button.pin-preview-marker-btn
   {:type "button"
    :on {:click (fn [e]
                  (.stopPropagation e)
                  (when select-hemnet-result! (select-hemnet-result! (:id item))))}}
   [:img {:src (result-icon-url item) :alt ""}]])

(defn- row-text
  "Name/address only - kept in its own `<td>`, separate from the action
   buttons, so the buttons don't eat into the text column's flex width and
   the text gets the full name/group/stars column span to itself."
  [name location]
  [:div.hemnet-results-row-body
   [:div.hemnet-results-row-name (str name)]
   [:div.hemnet-results-row-address (str location)]])

(defn- result->popup-position
  "Map a raw Hemnet search-result item onto the field names `map-ui/popup-html`
   expects (it already knows how to render a Hemnet source-link icon for a
   hemnet.se/bostad/ :url, the same as it does for a saved pin)."
  [{:keys [name image location url description agent-url agent-name]}]
  {:name name :image image :address location :description description
   :url url :agent-url agent-url :agent-name agent-name})

(defn table-rows
  "Divider `<tr>` + one `<tr>` per Hemnet result, for `pin-sorted-table`'s
   `<tbody>`. `column-count` is the pin table's total column count (image,
   name, stars, area, delete, edit, icon) so the divider/content cells can
   span the columns that don't apply to Hemnet rows. Save/marker-icon/discard
   all live together in one trailing cell (spanning every column after the
   name/address content) rather than split across two cells - keeping them
   as one flex group that can be right-aligned as a whole, instead of the
   marker icon overflowing out of a too-narrow actions cell and getting
   clipped behind the discard button at the panel's scrollable edge."
  [{:keys [search-results save-hemnet-result-as-pin! clear-hemnet-search-results!
           select-hemnet-result! discard-hemnet-result! hemnet-selected-id t
           column-count]
    :or {t (fn [k] (name k)) column-count 7}}]
  (when (seq search-results)
    (let [content-colspan 2
          actions-colspan (max 1 (- column-count 1 content-colspan))]
      (cons
       ^{:key "hemnet-divider"}
       [:tr.hemnet-results-divider-row
        [:td.hemnet-results-divider-cell {:colSpan column-count}
         [:span.hemnet-results-divider-label (divider-label search-results t)]
         (clear-btn clear-hemnet-search-results! t)]]
       (for [{:keys [id name location image] :as result} search-results
             :let [selected? (= id hemnet-selected-id)]]
         ^{:key id}
         [:tr.hemnet-results-table-row
          {:class (table-row-class selected?)
           :replicant/on-render (fn [{:keys [replicant/node]}]
                                  (when (and selected? node)
                                    (.scrollIntoView node #js {:block "nearest"})))
           :on (merge {:click (fn [_] (when select-hemnet-result! (select-hemnet-result! id)))}
                      (row-map-hover-handlers id))}
          [:td.pin-table-image-cell
           (when (seq image) [:img.pin-table-image {:src image :alt ""}])]
          [:td.hemnet-results-content-cell {:colSpan content-colspan}
           (row-text name location)]
          [:td.hemnet-results-actions-cell {:colSpan actions-colspan}
           [:div.hemnet-results-row-actions
            (save-button id save-hemnet-result-as-pin! t)
            [:img.pin-table-icon {:src (result-icon-url result) :alt ""}]
            (discard-button id discard-hemnet-result! t)]]])))))

(defn preview-rows
  "Divider `<div>` + one card per Hemnet result, for `preview-list`
   (large-image mode) - rendered via the SAME `map-ui/popup-html` pins use
   there (big image + name/address/description/source-link), so Hemnet
   results look exactly like pins once big-image mode is on. The
   save-as-pin/discard buttons (which popup-html knows nothing about) are
   appended below that content."
  [{:keys [search-results save-hemnet-result-as-pin! clear-hemnet-search-results!
           select-hemnet-result! discard-hemnet-result! hemnet-selected-id t]
    :or {t (fn [k] (name k))}}]
  (when (seq search-results)
    (cons
     ^{:key "hemnet-divider"}
     [:div.hemnet-results-divider-row.hemnet-results-divider-row--preview
      [:span.hemnet-results-divider-label (divider-label search-results t)]
      (clear-btn clear-hemnet-search-results! t)]
     (for [{:keys [id name location] :as result} search-results
           :let [selected? (= id hemnet-selected-id)]]
       ^{:key id}
       [:div.pin-preview-row.update-row
        {:class (when selected? "update-row--selected")
         :replicant/on-render (fn [{:keys [replicant/node]}]
                                (when (and selected? node)
                                  (.scrollIntoView node #js {:block "nearest"})))
         :on (merge {:click (fn [e]
                              (when-not (.. e -target (closest "a"))
                                (when select-hemnet-result! (select-hemnet-result! id))))}
                    (row-map-hover-handlers id))}
        [:div.hemnet-results-preview-card
         [:div.pin-preview-row-content
          {:innerHTML (map-ui/popup-html (result->popup-position result)
                                         {:source-label (t :popup/source-label)})}]
         [:div.hemnet-results-preview-actions
          (action-buttons id save-hemnet-result-as-pin! discard-hemnet-result! t)
          (hemnet-map-icon-btn result select-hemnet-result!)]]]))))
