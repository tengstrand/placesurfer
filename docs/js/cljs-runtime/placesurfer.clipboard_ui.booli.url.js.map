(ns placesurfer.clipboard-ui.booli.url
  "Booli listing URL helpers - mirrors clipboard-ui.hemnet.url, but Booli's
   listing path is just a bare numeric id (/bostad/1719819), unlike Hemnet's
   slug-NNNNN form. The extracted id is prefixed with \"booli:\" so it can
   never collide with a bare-numeric Hemnet id in the same :search-results
   list (both sites happen to use similarly-sized numeric ids)."
  (:require [clojure.string :as str]))

(def ^:private booli-listing-pattern
  #"^https?://(?:www\.)?booli\.se/bostad/(\d+)/?$")

(defn valid-booli-listing-url?
  "True when `url` looks like a Booli property listing page."
  [url]
  (boolean
   (when-let [s (not-empty (str/trim (str url)))]
     (re-matches booli-listing-pattern s))))

(defn listing-id-from-url
  "Extract a namespaced listing id (\"booli:<id>\") from a Booli listing URL."
  [url]
  (when-let [s (not-empty (str/trim (str url)))]
    (some->> (re-matches booli-listing-pattern s) second (str "booli:"))))
