(ns placesurfer.pin-ui.pure.group-field)

(defn- close-group-dropdown! [e]
  (when-let [details (.closest (.-target e) "details")]
    (.removeAttribute details "open")))

(defn- group-option [group-id label selected? set-pin-group!]
  [:button {:type "button"
            :class (if selected?
                     "pin-group-dropdown-option pin-group-dropdown-option--selected"
                     "pin-group-dropdown-option")
            :on {:click (fn [e]
                          (.preventDefault e)
                          (set-pin-group! group-id)
                          (close-group-dropdown! e))}}
   label])

(defn group-row
  [{:keys [group-id group-options selected-label set-pin-group! t]
    :or {t (fn [k] (name k))}}]
  [:div.update-field-row
   [:label.update-label (t :pin/group)]
   [:div.update-field-control
    [:details.pin-group-dropdown
     [:summary.pin-group-dropdown-trigger
      [:span.pin-group-dropdown-label selected-label]]
     [:div.pin-group-dropdown-menu
      (group-option nil "-" (nil? group-id) set-pin-group!)
      (for [{:keys [id label]} group-options]
        ^{:key id}
        (group-option id label (= group-id id) set-pin-group!))]]]])
