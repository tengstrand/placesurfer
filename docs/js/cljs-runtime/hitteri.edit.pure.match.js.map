(ns hitteri.edit.pure.match
  (:require [clojure.string :as str]
            [hitteri.edit.pure.coords :as coords]
            [hitteri.edit.pure.rows :as rows]))

(def default-coord-match-threshold-m 300.0)

(defn- vec-seq [xs]
  (if (sequential? xs) xs []))

(defn coords-exact-match?
  [lon-a lat-a lon-b lat-b]
  (and (number? lon-a) (number? lat-a) (number? lon-b) (number? lat-b)
       (= lon-a lon-b)
       (= lat-a lat-b)))

(defn coords-match?
  ([lon-a lat-a lon-b lat-b]
   (coords-match? lon-a lat-a lon-b lat-b default-coord-match-threshold-m))
  ([lon-a lat-a lon-b lat-b threshold-m]
   (and (number? lon-a) (number? lat-a) (number? lon-b) (number? lat-b)
        (<= (coords/haversine-distance-m lon-a lat-a lon-b lat-b)
            threshold-m))))

(defn coords-exist-in-update-rows?
  [longitude latitude rows]
  (boolean
   (some (fn [row]
           (when-let [c (coords/row-lon-lat row)]
             (coords-exact-match? longitude latitude
                                  (:longitude c)
                                  (:latitude c))))
         (vec-seq rows))))

(defn find-saved-row-by-exact-coords
  [rows longitude latitude]
  (some (fn [row]
          (when-let [c (coords/row-lon-lat row)]
            (when (coords-exact-match? longitude latitude
                                        (:longitude c)
                                        (:latitude c))
              row)))
        (if (sequential? rows) (vec rows) [])))

(defn- normalized-place-name [name]
  (some-> name str str/trim str/lower-case))

(defn find-saved-row-by-name-without-coords
  "When exactly one saved row matches the place name and has no coordinates."
  [rows place-name]
  (when (seq (str/trim (str place-name)))
    (let [target (normalized-place-name place-name)
          matches (filter (fn [row]
                            (and (rows/saved-update-row-id? (:row-id row))
                                 (nil? (coords/row-lon-lat row))
                                 (= target (normalized-place-name (:name row)))))
                          (if (sequential? rows) (vec rows) []))]
      (when (= 1 (count matches))
        (first matches)))))

(defn row-coord-distance-m
  [row longitude latitude]
  (when-let [c (coords/row-lon-lat row)]
    (coords/haversine-distance-m longitude latitude
                                 (:longitude c)
                                 (:latitude c))))

(defn find-pending-place-index
  [places longitude latitude]
  (first (keep-indexed (fn [idx place]
                          (when (coords-exact-match? longitude latitude
                                                      (:longitude place)
                                                      (:latitude place))
                            idx))
                        (vec-seq places))))

(defn closest-row-within-coord-threshold
  ([rows longitude latitude]
   (closest-row-within-coord-threshold rows longitude latitude
                                       default-coord-match-threshold-m))
  ([rows longitude latitude threshold-m]
   (some->> rows
           (keep (fn [row]
                   (when-let [distance (row-coord-distance-m row longitude latitude)]
                     (when (<= distance threshold-m)
                       {:row row :distance distance}))))
           (sort-by :distance)
           first
           :row)))

(defn coords-match-deleted-row-at?
  [rows places longitude latitude row-pred?]
  (boolean
   (some (fn [row]
           (when (row-pred? row)
             (when-let [c (coords/row-lon-lat row)]
               (coords-match? longitude latitude
                              (:longitude c)
                              (:latitude c)))))
         (concat (vec-seq rows) (vec-seq places)))))

(defn find-display-row-by-coords
  ([saved-rows pending-places longitude latitude]
   (find-display-row-by-coords saved-rows pending-places longitude latitude true))
  ([saved-rows pending-places longitude latitude use-url-name?]
   (let [saved (if (sequential? saved-rows) (vec saved-rows) [])
         pending-rows (map rows/pending-place->row (vec-seq pending-places))]
     (or (find-saved-row-by-exact-coords saved longitude latitude)
         (when-not use-url-name?
           (or (closest-row-within-coord-threshold saved longitude latitude)
               (find-saved-row-by-exact-coords pending-rows longitude latitude)))
         (find-saved-row-by-exact-coords pending-rows longitude latitude)))))
