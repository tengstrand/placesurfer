(ns placesurfer.app-ui.ui.workspace
  (:require [placesurfer.app-ui.ui.draw-layers-panel :as draw-layers-panel]
            [placesurfer.app-ui.ui.pages :as pages]
            [placesurfer.country-ui.interface.panel :as country-ui]
            [placesurfer.layers-ui.interface.panel :as layers-ui]
            [placesurfer.map-panel-ui.interface.area :as map-panel-ui.area]
            [placesurfer.topic-ui.interface :as topic-ui]))

(defn workspace
  [props]
  (let [{:keys [page countries country-slug country-filter country-highlight-index
                status countries-loading? map-status topic-rows mobile?
                set-topic-active! show-map! select-country! set-country-filter!
                set-country-highlight-index! navigate! navigate-to-update-tab!
                ensure-countries-loaded!
                mount-map! unmount-map! t toggle-layer! active-overlays
                home-search-query home-search-results home-search-loading?
                home-search-highlight-index set-home-search-query!
                select-home-search-result! home-search-keydown!
                draw-layers draw-selected-layer-id draw-layer-draft-label
                select-draw-layer! add-draw-layer! delete-draw-layer!
                set-draw-layer-draft-label! set-draw-layer-color! save-draw-layers-config!
                backend-online? update-topic-options]} props]
    [:div.workspace
     (when (or (pages/topic-page? page) (pages/layers-page? page))
       [:aside.topic-sidebar-panel
        (topic-ui/panel {:rows topic-rows
                         :set-topic-active! set-topic-active!
                         :show-map! show-map!
                         :mobile? mobile?})
        [:hr.topic-layers-divider]
        (layers-ui/panel
         {:rows [{:layer-id :flood
                  :active? (contains? (or active-overlays #{}) :flood)
                  :label "Översvämningsområden"}]
          :toggle-layer! toggle-layer!})])
     (when (pages/country-page? page)
       [:aside.country-sidebar-panel
        (country-ui/panel {:countries countries
                           :country-slug country-slug
                           :country-filter country-filter
                           :country-highlight-index country-highlight-index
                           :status status
                           :countries-loading? countries-loading?
                           :select-country! select-country!
                           :set-country-filter! set-country-filter!
                           :set-country-highlight-index! set-country-highlight-index!
                           :navigate! navigate!
                           :ensure-countries-loaded! ensure-countries-loaded!
                           :t t})])
     (when (pages/update-page? page)
       [:section.update-page
        ((:render-update-panel props) props)])
     (when (pages/pin-page? page)
       [:section.pin-page
        ((:render-pin-panel props) props)])
     (when (pages/groups-page? page)
       ((:render-groups-panel props) props))
     (when (pages/show-main-map-area? {:page page :mobile? mobile?})
       (map-panel-ui.area/area {:map-status map-status
                                :mount-map! mount-map!
                                :unmount-map! unmount-map!
                                :home-search-query (when-not (pages/draw-page? page) home-search-query)
                                :home-search-results (when-not (pages/draw-page? page) home-search-results)
                                :home-search-loading? (when-not (pages/draw-page? page) home-search-loading?)
                                :home-search-highlight-index (when-not (pages/draw-page? page) home-search-highlight-index)
                                :set-home-search-query! (when-not (pages/draw-page? page) set-home-search-query!)
                                :select-home-search-result! (when-not (pages/draw-page? page) select-home-search-result!)
                                :home-search-keydown! (when-not (pages/draw-page? page) home-search-keydown!)
                                :t t}))
     (when (pages/draw-page? page)
       (draw-layers-panel/panel
        {:draw-layers draw-layers
         :draw-selected-layer-id draw-selected-layer-id
         :draw-layer-draft-label draw-layer-draft-label
         :navigate-to-update-tab! navigate-to-update-tab!
         :select-draw-layer! select-draw-layer!
         :add-draw-layer! add-draw-layer!
         :delete-draw-layer! delete-draw-layer!
         :set-draw-layer-draft-label! set-draw-layer-draft-label!
         :set-draw-layer-color! set-draw-layer-color!
         :save-draw-layers-config! save-draw-layers-config!
         :backend-online? backend-online?
         :update-topic-options update-topic-options
         :t t}))]))
