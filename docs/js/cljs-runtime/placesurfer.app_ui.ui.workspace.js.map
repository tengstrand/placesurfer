(ns placesurfer.app-ui.ui.workspace
  (:require [placesurfer.app-ui.ui.pages :as pages]
            [placesurfer.country-ui.interface.panel :as country-ui]
            [placesurfer.map-panel-ui.interface.area :as map-panel-ui.area]
            [placesurfer.topic-ui.interface :as topic-ui]))

(defn workspace
  [props]
  (let [{:keys [page countries country-slug country-filter country-highlight-index
                status countries-loading? map-status topic-rows mobile?
                set-topic-active! show-map! select-country! set-country-filter!
                set-country-highlight-index! navigate! ensure-countries-loaded!
                mount-map! unmount-map! t
                home-search-query home-search-results home-search-loading?
                home-search-highlight-index set-home-search-query!
                select-home-search-result! home-search-keydown!]} props]
    [:div.workspace
     (when (pages/topic-page? page)
       [:aside.topic-sidebar-panel
        (topic-ui/panel {:rows topic-rows
                         :set-topic-active! set-topic-active!
                         :show-map! show-map!
                         :mobile? mobile?})])
     (when (pages/country-page? page)
       [:aside.country-sidebar-panel
        (country-ui/panel {:countries countries
                           :country-slug country-slug
                           :country-filter country-filter
                           :country-highlight-index country-highlight-index
                           :status status
                           :countries-loading? countries-loading?
                           :select-country! select-country!
                           :set-country-filter! set-country-filter!
                           :set-country-highlight-index! set-country-highlight-index!
                           :navigate! navigate!
                           :ensure-countries-loaded! ensure-countries-loaded!
                           :t t})])
     (when (pages/update-page? page)
       [:section.update-page
        ((:render-update-panel props) props)])
     (when (pages/pin-page? page)
       [:section.pin-page
        ((:render-pin-panel props) props)])
     (when (pages/groups-page? page)
       ((:render-groups-panel props) props))
     (when (pages/show-main-map-area? {:page page :mobile? mobile?})
       (map-panel-ui.area/area {:map-status map-status
                                :mount-map! mount-map!
                                :unmount-map! unmount-map!
                                :home-search-query home-search-query
                                :home-search-results home-search-results
                                :home-search-loading? home-search-loading?
                                :home-search-highlight-index home-search-highlight-index
                                :set-home-search-query! set-home-search-query!
                                :select-home-search-result! select-home-search-result!
                                :home-search-keydown! home-search-keydown!
                                :t t}))]))
