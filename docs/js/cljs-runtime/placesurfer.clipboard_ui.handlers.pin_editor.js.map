(ns placesurfer.clipboard-ui.handlers.pin-editor
  "Shared pin editor integration for bookmarklet paste."
  (:require [clojure.string :as str] [placesurfer.app-ui.interface.effects :as effects]
            [placesurfer.app-ui.interface.state :as app-state]
            [placesurfer.clipboard-ui.pure.browser :as browser]
            [placesurfer.clipboard-ui.pure.context :as context]
            [placesurfer.i18n.interface :as i18n]
            [placesurfer.pin-ui.interface.forms :as forms]
            [placesurfer.pin-ui.interface.handlers.editor :as editor]
            [placesurfer.pin-ui.interface.handlers.map :as pin-map]
            [placesurfer.pin-ui.interface.handlers.rows :as pin-rows]
            [placesurfer.pin-ui.interface.handlers.state :as pin-state]
            [placesurfer.pin-ui.interface.update-context :as update-context]))

(defn- missing-coords-message [form]
  (when-not (forms/form-valid? form)
    (i18n/t (get @app-state/!state :locale :en) :pin/missing-place-fields)))

(defn apply-form-to-editor! [form]
  (pin-state/swap-render!
   (fn [s]
     (-> s
         (assoc :pin-form form
                :pin-form-baseline form
                :pin-message (missing-coords-message form))
         pin-state/clear-search-ui
         app-state/bump-description-sync-token)))
  (pin-map/schedule-pin-map-sync!
   {:recenter? (not (update-context/update-pins-mode? @app-state/!state))}))

(defn- form-has-name? [form]
  (seq (str/trim (or (:name form) ""))))

(defn- prepare-new-pin-for-place-paste! []
  (let [s @app-state/!state
        current-form (:pin-form s (forms/default-form))]
    (when (form-has-name? current-form)
      (editor/maybe-save-inline-pin-before-switch!)
      (pin-state/swap-render!
       (fn [state]
         (-> state
             (assoc :pin-editor-mode :new
                    :pin-selected-id nil)
             pin-state/clear-search-ui))))))

(defn- apply-place-on-update-pins! [form]
  (let [create-new? (form-has-name? (:pin-form @app-state/!state (forms/default-form)))]
    (when create-new?
      (prepare-new-pin-for-place-paste!))
    (apply-form-to-editor! form)
    (if (forms/form-valid? form)
      (do (pin-rows/add-pin! {:force-new? create-new?})
          (when-let [id (:pin-selected-id @app-state/!state)]
            (editor/load-pin-into-inline-editor! id))
          (browser/clear-clipboard!)
          true)
      false)))

(defn apply-resolved-place-form! [form]
  (cond
    (update-context/update-pins-mode? @app-state/!state)
    (apply-place-on-update-pins! form)

    (context/pin-page? @app-state/!state)
    (do (editor/open-pin-editor-new!)
        (apply-form-to-editor! form)
        (browser/clear-clipboard!)
        true)

    :else false))
