(ns placesurfer.dropbox.core
  (:require [cljs.reader :as reader]
            [clojure.string :as str]
            [placesurfer.dropbox.auth-storage :as auth-storage]
            [placesurfer.dropbox.config :as config]
            [placesurfer.dropbox.pkce :as pkce]))

(defn connected? []
  (some? (:refresh-token (auth-storage/read-auth!))))

(defn configured? []
  (config/configured?))

(defn account-email []
  (:account-email (auth-storage/read-auth!)))

(defonce ^:private !on-push-error (atom nil))

(defn set-on-push-error!
  "Registers a callback (fn [error]) invoked when a background push! fails.
   Keeps this component UI-agnostic - the caller decides how to surface it (e.g. a toast)."
  [f]
  (reset! !on-push-error f))

(defonce ^:private !sync-docs (atom {}))

(defn register-sync-doc!
  "Registers a named EDN document to sync to/from Dropbox, at its own remote path
   (e.g. \"/prefs.edn\"). `read` is a (fn [] -> edn-value) called on push! to produce
   what gets uploaded; `write` is a (fn [edn-value]) called on pull! with whatever was
   downloaded. Keeps this component fully agnostic of what it's syncing (prefs, pins,
   anything else) - the caller owns the data and the storage it lives in."
  [doc-key {:keys [remote-path read write]}]
  (swap! !sync-docs assoc doc-key {:remote-path remote-path :read read :write write}))

(defn- redirect-uri []
  (str (.-origin js/location) (.-pathname js/location)))

(defn- search-params [m]
  (js/URLSearchParams. (clj->js (into {} (map (fn [[k v]] [(name k) (str v)])) m))))

(defn- post-form! [url params]
  (js/fetch url (clj->js {:method "POST"
                           :headers {"Content-Type" "application/x-www-form-urlencoded"}
                           :body (.toString (search-params params))})))

(defn- store-token-response! [^js json]
  (let [expires-in (or (aget json "expires_in") 0)
        expires-at (+ (js/Date.now) (* 1000 expires-in))
        current (auth-storage/read-auth!)
        refresh-token (or (aget json "refresh_token") (:refresh-token current))]
    (auth-storage/write-auth! {:access-token (aget json "access_token")
                               :refresh-token refresh-token
                               :expires-at expires-at
                               :account-email (:account-email current)})))

(defn begin-connect!
  "Redirects the browser to Dropbox's OAuth2 PKCE authorize screen.
   Rejects without redirecting if this deployment has no DROPBOX_APP_KEY configured."
  []
  (if-not (config/configured?)
    (js/Promise.reject (js/Error. "dropbox-not-configured"))
    (let [verifier (pkce/generate-code-verifier)
          state (pkce/generate-state)]
      (-> (pkce/code-challenge-from-verifier verifier)
          (.then
           (fn [challenge]
             (auth-storage/write-pkce-session! {:verifier verifier :state state})
             (let [query (search-params {:response_type "code"
                                          :client_id (config/app-key)
                                          :code_challenge challenge
                                          :code_challenge_method "S256"
                                          :redirect_uri (redirect-uri)
                                          :token_access_type "offline"
                                          :state state})]
               (set! (.-href js/location) (str config/authorize-url "?" (.toString query))))))))))

(defn parse-callback-params
  "Pure: extracts {:code :state} from a location.search-style string, or nil when no code is present."
  [search-string]
  (let [params (js/URLSearchParams. (or search-string ""))
        code (.get params "code")]
    (when (seq code)
      {:code code :state (.get params "state")})))

(defn- oauth-callback-params []
  (parse-callback-params (.-search js/location)))

(defn- strip-oauth-params! []
  (try
    (let [url (js/URL. (.-href js/location))]
      (.delete (.-searchParams url) "code")
      (.delete (.-searchParams url) "state")
      (.replaceState js/history nil "" (.toString url)))
    (catch :default _ nil)))

(defn- exchange-code! [code verifier]
  (-> (post-form! config/token-url {:grant_type "authorization_code"
                                     :code code
                                     :client_id (config/app-key)
                                     :code_verifier verifier
                                     :redirect_uri (redirect-uri)})
      (.then (fn [resp]
               (-> (.json resp)
                   (.then (fn [json]
                            (if (.-ok resp)
                              (store-token-response! json)
                              (js/Promise.reject (js/Error. "dropbox-token-exchange-failed"))))))))))

(defn handle-oauth-callback!
  "If the current URL carries an OAuth redirect (?code=&state=), validates it (CSRF guard),
   exchanges the code for tokens, and strips the query params. Resolves true if a callback
   was handled (successfully or not), false if there was nothing to handle."
  []
  (if-let [{:keys [code state]} (oauth-callback-params)]
    (let [session (auth-storage/read-pkce-session!)]
      (if (and session (= state (:state session)))
        (-> (exchange-code! code (:verifier session))
            (.then (fn [_]
                     (auth-storage/clear-pkce-session!)
                     (strip-oauth-params!)
                     true))
            (.catch (fn [_]
                      (auth-storage/clear-pkce-session!)
                      (strip-oauth-params!)
                      false)))
        (do
          (auth-storage/clear-pkce-session!)
          (strip-oauth-params!)
          (js/Promise.resolve false))))
    (js/Promise.resolve false)))

(defn- expired? [auth]
  (< (:expires-at auth 0) (+ (js/Date.now) config/token-expiry-margin-ms)))

(defn- refresh-access-token! []
  (let [auth (auth-storage/read-auth!)]
    (cond
      (nil? (:refresh-token auth))
      (js/Promise.resolve nil)

      (not (expired? auth))
      (js/Promise.resolve (:access-token auth))

      :else
      (-> (post-form! config/token-url {:grant_type "refresh_token"
                                         :refresh_token (:refresh-token auth)
                                         :client_id (config/app-key)})
          (.then (fn [resp]
                   (-> (.json resp)
                       (.then (fn [json]
                                (if (.-ok resp)
                                  (do (store-token-response! json)
                                      (:access-token (auth-storage/read-auth!)))
                                  (do (auth-storage/clear-auth!) nil)))))))
          (.catch (fn [_] (auth-storage/clear-auth!) nil))))))

(defn- with-access-token [f]
  (-> (refresh-access-token!)
      (.then (fn [token]
               (if token
                 (f token)
                 (js/Promise.reject (js/Error. "dropbox-not-connected")))))))

(defn- pad [n] (apply str (repeat n " ")))

(defn- format-map-entries [m indent]
  (str/join (str "\n" (pad indent))
            (map (fn [[k v]] (str (pr-str k) " " (pr-str v))) m)))

(defn- format-edn
  "Pretty-prints edn-value one entry per line, but always keeps a key and its value
   together on that same line regardless of length - unlike cljs.pprint's generic
   dispatch, which happily wraps a long value onto its own line. Tailored to exactly
   the two shapes this component ever writes (a flat map, or a vector of flat maps);
   anything else just falls back to a plain pr-str."
  [v]
  (cond
    (map? v)
    (str "{" (format-map-entries v 1) "}")

    (and (vector? v) (seq v) (every? map? v))
    (str "["
         (str/join "\n " (map (fn [m] (str "{" (format-map-entries m 2) "}")) v))
         "]")

    :else
    (pr-str v)))

(defn- upload-doc! [token remote-path edn-value]
  (-> (js/fetch config/upload-url
                (clj->js {:method "POST"
                          :headers {"Authorization" (str "Bearer " token)
                                    "Dropbox-API-Arg" (js/JSON.stringify
                                                        (clj->js {:path remote-path
                                                                  :mode "overwrite"}))
                                    "Content-Type" "application/octet-stream"}
                          :body (format-edn edn-value)}))
      (.then (fn [^js resp]
               (if (.-ok resp)
                 nil
                 (-> (.text resp)
                     (.then (fn [body]
                              (js/Promise.reject
                               (js/Error. (str "dropbox-push-failed: " remote-path " " (.-status resp) " " body))))))))) ))

(defn- do-push! []
  (-> (with-access-token
        (fn [token]
          (js/Promise.all
           (clj->js (for [[_doc-key {:keys [remote-path read]}] @!sync-docs]
                      (upload-doc! token remote-path (read)))))))
      (.then (fn [_] nil))))

(defonce ^:private !push-timer (atom nil))

(defn push!
  "Debounced upload of every registered sync doc's current value to Dropbox.
   No-op unless connected, and a no-op with nothing registered."
  []
  (when (connected?)
    (when-let [t @!push-timer] (js/clearTimeout t))
    (reset! !push-timer
            (js/setTimeout
             (fn []
               (reset! !push-timer nil)
               (-> (do-push!)
                   (.catch (fn [err]
                             (when-let [f @!on-push-error] (f err))))))
             config/push-debounce-ms))))

(defn- not-found-response? [^js resp]
  (= 409 (.-status resp)))

(defn- download-doc! [token remote-path]
  (-> (js/fetch config/download-url
                (clj->js {:method "POST"
                          :headers {"Authorization" (str "Bearer " token)
                                    "Dropbox-API-Arg" (js/JSON.stringify
                                                        (clj->js {:path remote-path}))}}))
      (.then (fn [^js resp]
               (cond
                 (.-ok resp) (.text resp)
                 (not-found-response? resp) nil
                 :else (js/Promise.reject (js/Error. (str "dropbox-pull-failed: " remote-path))))))
      (.then (fn [body]
               (when (seq body)
                 (try
                   (reader/read-string body)
                   (catch :default _ nil)))))))

(defn pull!
  "Downloads every registered sync doc and hydrates it via that doc's `write` fn.
   Resolves nil (gracefully) when not connected; a doc that doesn't exist yet on
   Dropbox (first-time user) is skipped rather than treated as an error."
  []
  (if-not (connected?)
    (js/Promise.resolve nil)
    (with-access-token
      (fn [token]
        (js/Promise.all
         (clj->js (for [[_doc-key {:keys [remote-path write]}] @!sync-docs]
                    (-> (download-doc! token remote-path)
                        (.then (fn [edn-value]
                                 (when (some? edn-value)
                                   (write edn-value))))))))))))

(defn disconnect!
  "Best-effort token revoke, then always clears local auth state."
  []
  (let [auth (auth-storage/read-auth!)
        token (:access-token auth)]
    (-> (if token
          (-> (js/fetch config/revoke-url
                        (clj->js {:method "POST"
                                  :headers {"Authorization" (str "Bearer " token)}}))
              (.catch (fn [_] nil)))
          (js/Promise.resolve nil))
        (.then (fn [_]
                 (auth-storage/clear-auth!)
                 (auth-storage/clear-pkce-session!)
                 nil)))))

(defn fetch-account-email! []
  (-> (with-access-token
        (fn [token]
          (js/fetch config/account-url
                    (clj->js {:method "POST"
                              :headers {"Authorization" (str "Bearer " token)
                                        "Content-Type" "application/json"}
                              :body "null"}))))
      (.then (fn [^js resp] (when (.-ok resp) (.json resp))))
      (.then (fn [^js json]
               (when json
                 (let [email (aget json "email")]
                   (when email
                     (auth-storage/write-auth! (assoc (auth-storage/read-auth!) :account-email email)))
                   email))))
      (.catch (fn [_] nil))))
