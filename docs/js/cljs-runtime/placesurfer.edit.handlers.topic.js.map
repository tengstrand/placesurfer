(ns placesurfer.edit.handlers.topic
  (:require [placesurfer.app-ui.interface.effects :as effects]
            [placesurfer.app-ui.interface.state :as state]
            [placesurfer.edit.interface.baseline :as edit-ui.baseline]
            [placesurfer.edit.interface.model :as edit-ui.model]
            [placesurfer.edit.interface.rows :as edit-ui.rows]
            [placesurfer.edit.handlers.description-sync :as description-sync]
            [placesurfer.edit.handlers.rows :as update-rows]
            [placesurfer.edit.handlers.save :as update-save]
            [placesurfer.edit.handlers.set-topic :as update-set-topic]
            [placesurfer.edit.pure.topics :as edit-ui.topics]
            [placesurfer.i18n.interface :as i18n]
            [placesurfer.pin-ui.interface.handlers.editor :as pin-editor]
            [placesurfer.pin-ui.interface.handlers.rows :as pin-rows]
            [placesurfer.pin-ui.interface.forms :as pin-forms]
            [placesurfer.topic.interface :as topic-data]))

(defn- dataset-change-counts-dirty?
  [s]
  (let [{:keys [deleted edited added]} (edit-ui.model/dataset-change-counts s)]
    (or (pos? deleted) (pos? edited) (pos? added))))

(defn- dataset-draft-in-progress?
  [s]
  (some (fn [row]
          (and (edit-ui.rows/manual-draft-pending-row? row)
               (edit-ui.rows/manual-draft-differs-from-empty-baseline? row)))
        (concat (update-rows/as-update-rows (:update-rows s))
                (update-rows/as-update-pending-places (:update-pending-places s)))))

(defn- unsaved-dataset-changes?
  [s]
  (or (update-save/update-dataset-dirty? s)
      (dataset-change-counts-dirty? s)
      (dataset-draft-in-progress? s)
      (update-rows/restore-selected-update-row-enabled? s)
      (description-sync/description-editor-differs-from-baseline? s)
      (edit-ui.baseline/form-edited-from-baseline?
       (:update-form s)
       (:update-row-baseline s))))

(defn- unsaved-update-changes?
  [s]
  (if (edit-ui.topics/pins-topic? (:update-topic s))
    (or (pin-editor/pin-form-dirty? s)
        (:pin-separator-overlay-open? s false))
    (unsaved-dataset-changes? s)))

(defn- t-for-state [s]
  (let [locale (:locale s :en)]
    (fn [k & args]
      (apply i18n/t locale k args))))

(defn default-update-topic-for-state [s]
  (edit-ui.topics/default-update-topic (topic-data/topic-keys) (t-for-state s)))

(defn ensure-update-topic!
  "Set :update-topic when unset (Pins). Offline update page always uses Pins."
  []
  (let [s @state/!state]
    (cond
      (nil? (:update-topic s))
      (update-set-topic/set-update-topic! edit-ui.topics/pins-topic)

      (and (not (:backend-online? s))
           (not (edit-ui.topics/pins-topic? (:update-topic s))))
      (update-set-topic/set-update-topic! edit-ui.topics/pins-topic))))

(defn- normalize-topic [topic]
  (cond
    (keyword? topic) topic
    (string? topic) (keyword topic)
    :else nil))

(defn- finalize-topic-switch! [topic]
  (let [continuation (:update-topic-switch-continuation @state/!state)]
    (swap! state/!state dissoc :update-topic-switch-pending :update-topic-switch-continuation)
    (update-set-topic/set-update-topic! topic)
    (when continuation
      (js/setTimeout continuation 0))))

(defn request-update-topic-change!
  ([topic] (request-update-topic-change! topic nil))
  ([topic continuation]
   (when-let [topic (normalize-topic topic)]
     (let [current (:update-topic @state/!state)
           dirty-before-flush? (unsaved-update-changes? @state/!state)]
       (description-sync/flush-update-description-from-dom!)
       (when (and topic (not= topic current))
         (let [dirty? (or dirty-before-flush? (unsaved-update-changes? @state/!state))]
           (if dirty?
             (do (swap! state/!state
                        #(-> %
                             (assoc :update-topic-switch-pending topic
                                    :update-topic-switch-continuation continuation)
                             (dissoc :update-message)))
                 (effects/render!))
             (do
               (when continuation
                 (swap! state/!state assoc :update-topic-switch-continuation continuation))
               (finalize-topic-switch! topic)))))))))

(defn- switch-to-pins-and-run! [f]
  (when f
    (swap! state/!state assoc :update-topic-switch-continuation f))
  (finalize-topic-switch! edit-ui.topics/pins-topic))

(defn run-in-update-pins-mode!
  "On the edit page, ensure Pins topic before running `f`.
  Prompts to save/discard/cancel when the current dataset has unsaved changes."
  [f]
  (let [s @state/!state]
    (cond
      (not= :update (:page s))
      (f)

      (edit-ui.topics/pins-topic? (:update-topic s))
      (f)

      (unsaved-dataset-changes? s)
      (request-update-topic-change! edit-ui.topics/pins-topic f)

      :else
      (switch-to-pins-and-run! f))))

(defn toggle-update-pin-topic!
  "Switch between Pins and the last dataset topic (or the first in the list)."
  []
  (when (:backend-online? @state/!state)
    (let [s @state/!state]
      (if (edit-ui.topics/pins-topic? (:update-topic s))
        (request-update-topic-change!
         (or (:update-topic-before-pins s)
             (default-update-topic-for-state s)))
        (request-update-topic-change! edit-ui.topics/pins-topic)))))

(defn cancel-update-topic-switch! []
  (swap! state/!state dissoc :update-topic-switch-pending :update-topic-switch-continuation)
  (effects/render!))

(defn- discard-pin-form-changes! []
  (swap! state/!state
         (fn [s]
           (let [baseline (:pin-form-baseline s (pin-forms/default-form))]
             (-> s
                 (assoc :pin-form baseline)
                 (dissoc :pin-separator-overlay-open?
                         :pin-separator-overlay-rows
                         :pin-separator-overlay-selected-id
                         :pin-separator-overlay-snapshot))))))

(defn discard-update-topic-switch! []
  (when-let [topic (:update-topic-switch-pending @state/!state)]
    (let [current (:update-topic @state/!state)
          switching-to-pins? (edit-ui.topics/pins-topic? topic)
          on-pins? (edit-ui.topics/pins-topic? current)
          finalize! (fn [] (finalize-topic-switch! topic))]
      (cond
        on-pins?
        (do (discard-pin-form-changes!)
            (finalize!))

        switching-to-pins?
        (update-save/discard-unsaved-dataset-changes! finalize!)

        :else
        (finalize!)))))

(defn save-and-switch-update-topic! []
  (when-let [pending (:update-topic-switch-pending @state/!state)]
    (if (edit-ui.topics/pins-topic? (:update-topic @state/!state))
      (let [s @state/!state
            mode (:pin-editor-mode s)]
        (when (or (and (= mode :edit) (pin-rows/save-enabled? s))
                  (and (= mode :new) (pin-forms/form-valid? (:pin-form s (pin-forms/default-form)))))
          (case mode
            :new (pin-rows/add-pin!)
            :edit (pin-rows/save-pin!)))
        (finalize-topic-switch! pending))
      (update-save/save-update-dataset!
       {:on-success (fn [_] (finalize-topic-switch! pending))
        :on-failure (fn [_]
                      (swap! state/!state dissoc :update-topic-switch-pending)
                      (effects/render!))}))))
