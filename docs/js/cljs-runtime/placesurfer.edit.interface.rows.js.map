(ns placesurfer.edit.interface.rows
  (:require [placesurfer.edit.pure.rows :as rows]))

(defn ensure-position-description
  [position]
  (rows/ensure-position-description position))

(defn ensure-position-image
  [position]
  (rows/ensure-position-image position))

(defn row-source-set?
  [row-or-place]
  (rows/row-source-set? row-or-place))

(defn pending-place->row
  [place]
  (rows/pending-place->row place))

(defn coerce-action-keyword
  [action]
  (rows/coerce-action-keyword action))

(defn row-marked-deleted?
  [row]
  (rows/row-marked-deleted? row))

(defn saved-delete-row?
  [row]
  (rows/saved-delete-row? row))

(defn row-marked-edited?
  [row]
  (rows/row-marked-edited? row))

(defn row-marked-added?
  [row]
  (rows/row-marked-added? row))

(defn disk-tombstone-row?
  [row]
  (rows/disk-tombstone-row? row))

(defn row-save-as-tombstone?
  [row]
  (rows/row-save-as-tombstone? row))

(defn enrich-row-country-code
  [row country-code]
  (rows/enrich-row-country-code row country-code))

(defn mark-row-as-deleted
  [row country-code]
  (rows/mark-row-as-deleted row country-code))

(defn pending-row?
  [row]
  (rows/pending-row? row))

(defn saved-update-row-id?
  [id]
