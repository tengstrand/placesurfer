(defn row-save-fields-valid?
  [row]
  (rows/row-save-fields-valid? row))

(defn manual-draft-pending-row?
  [row-or-place]
  (rows/manual-draft-pending-row? row-or-place))

(defn manual-draft-differs-from-empty-baseline?
  [row-or-place]
  (rows/manual-draft-differs-from-empty-baseline? row-or-place))

(defn removable-pending-row-without-url?
  [row-or-place]
  (rows/removable-pending-row-without-url? row-or-place))

(defn incomplete-manual-draft?
  [row-or-place]
  (rows/incomplete-manual-draft? row-or-place))

(defn saved-row-unchanged-without-coords?
  [row]
  (rows/saved-row-unchanged-without-coords? row))

(defn blank-manual-draft-pending-place?
  [place]
  (rows/blank-manual-draft-pending-place? place))

(defn empty-draft-pending-place?
  [place]
