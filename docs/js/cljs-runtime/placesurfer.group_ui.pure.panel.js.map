(ns placesurfer.group-ui.pure.panel
  (:require [placesurfer.group-ui.pure.row :as row]
            [placesurfer.pin-ui.interface.drag :as drag]
            [placesurfer.pin-ui.interface.search :as search]))

(defn- submit-draft! [{:keys [group-editing? add-group! confirm-group-edit!]}]
  (if group-editing?
    (confirm-group-edit!)
    (add-group!)))

(defn panel
  [{:keys [group-rows
           group-selected-id
           group-draft-label
           group-editing?
           group-submit-enabled?
           select-group-row!
           set-group-draft-label!
           start-group-row-edit!
           add-group!
           confirm-group-edit!
           delete-group-row!
           reorder-group-row!
           t]
    :or {t (fn [k] (name k))}
    :as props}]
  [:section.groups-page
   [:div.group-ui-panel
    [:div.update-table-wrap
     [:div.group-list
      {:replicant/on-render (fn [{:keys [replicant/node]}]
                             (when (and node reorder-group-row!)
                               (drag/ensure-pin-row-drag! node reorder-group-row!
                                                          {:drag-from-whole-row? true})))}
      (if (seq group-rows)
        (for [{:keys [id label]} group-rows]
          ^{:key id}
          (row/row {:id id
                    :label label
                    :selected? (= id group-selected-id)
                    :select-group-row! select-group-row!
                    :start-group-row-edit! start-group-row-edit!
                    :delete-group-row! delete-group-row!
                    :t t}))
        [:p.group-list-empty (t :pin/separator-manage-empty)])]
     [:div.group-draft-row
      [:input.group-draft-input
       {:id "group-draft-input"
        :type "text"
        :value (or group-draft-label "")
        :on {:input (fn [e]
                      (set-group-draft-label! (.. e -target -value)))
             :keydown (fn [e]
                         (when (and group-submit-enabled? (search/enter-key? e))
                           (.preventDefault e)
                           (submit-draft! props)))}}]
      [:button.group-draft-submit-btn
       {:type "button"
        :disabled (not group-submit-enabled?)
        :on {:click (fn [_] (submit-draft! props))}}
       (if group-editing?
         (t :pin/separator-ok)
         (t :pin/new))]]]]])
