(ns hitteri.load-art.core
  (:require [cljs.reader :as reader]))

(def countries-url "data/world-countries.edn")
(def place-counts-url "data/art/place-counts.edn")

(defn- gis-url [slug]
  (str "data/art/gis/" slug ".edn"))

(defn- parse-edn [text]
  (let [data (reader/read-string text)]
    {:country (:country data)
     :count (:count data)
     :positions (:positions data)}))

(defn- fetch-text! [url]
  (-> (js/fetch url)
      (.then (fn [resp]
               (if (.-ok resp)
                 (.text resp)
                 (js/Promise.reject
                  (js/Error. (str "Failed to load " url ", status " (.-status resp)))))))))

(defn- merge-country-counts [countries counts-by-slug]
  (mapv #(assoc % :count (get counts-by-slug (:slug %) 0)) countries))

(defn load-counts! []
  (-> (fetch-text! place-counts-url)
      (.then #(js/Promise.resolve (reader/read-string %)))
      (.catch (fn [_]
                (js/Promise.resolve {})))))

(defn load-countries! []
  (-> (js/Promise.all
       [(fetch-text! countries-url) (load-counts!)])
      (.then (fn [[countries-text counts]]
               (let [countries (reader/read-string countries-text)]
                 (js/Promise.resolve
                  (sort-by :label (merge-country-counts countries counts))))))))

(defn load-country! [slug]
  (-> (js/fetch (gis-url slug))
      (.then (fn [resp]
               (cond
                 (.-ok resp)
                 (.then (.text resp) parse-edn)

                 (= 404 (.-status resp))
                 (js/Promise.resolve {:country slug :count 0 :positions []})

                 :else
                 (js/Promise.reject
                  (js/Error. (str "Failed to load " (gis-url slug)
                                  ", status " (.-status resp)))))))))

