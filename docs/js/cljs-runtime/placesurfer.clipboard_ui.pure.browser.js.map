(ns placesurfer.clipboard-ui.pure.browser
  (:require [clojure.string :as str]))

(defn trimmed-text [text]
  (str/trim (str text)))

(defn clipboard-read-available? []
  (boolean (when-let [cb (and js/navigator (.-clipboard js/navigator))]
             (.-readText cb))))

(defn clipboard-write-available? []
  (boolean (when-let [cb (and js/navigator (.-clipboard js/navigator))]
             (.-writeText cb))))

(defn clear-clipboard! []
  (when (clipboard-write-available?)
    (-> (.writeText js/navigator.clipboard "")
        (.catch (fn [_] nil)))))

(defn read-clipboard-text!
  "Read clipboard text, invoking `then!` with trimmed text or nil on failure."
  [then!]
  (if-not (clipboard-read-available?)
    (then! nil)
    (-> (.readText js/navigator.clipboard)
        (.then (fn [text] (then! (trimmed-text text))))
        (.catch (fn [_] (then! nil))))))
