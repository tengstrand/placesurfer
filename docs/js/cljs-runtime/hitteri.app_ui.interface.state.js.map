(defn default-update-form [] (core/default-update-form))
(defn clear-update-selection-state [state] (core/clear-update-selection-state state))

(def !state core/!state)
(def !resolve-location-request-id core/!resolve-location-request-id)
(def !update-load-request-id core/!update-load-request-id)
