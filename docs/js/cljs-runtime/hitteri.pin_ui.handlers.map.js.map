(ns hitteri.pin-ui.handlers.map
  (:require [clojure.string :as str]
            [hitteri.app-ui.interface.effects :as effects]
            [hitteri.app-ui.interface.state :as state]
            [hitteri.map-ui.interface :as map-ui]
            [hitteri.pin-ui.pure.coords :as coords]
            [hitteri.pin-ui.pure.forms :as forms]
            [hitteri.pin-ui.pure.rows :as rows]
            [hitteri.pin-ui.pure.update-context :as update-context]
            [hitteri.i18n.interface :as i18n]))

(defn- popup-opts [s]
  {:source-label (i18n/t (:locale s :en) :popup/source-label)})

(def ^:private pin-map-center-zoom 9)
(def ^:private pin-focus-popup-delay-ms 750)

(defn- center-on-pin-map! [coords]
  (map-ui/center-on-position!
   (assoc coords :zoom pin-map-center-zoom :animate? true)))

(defn- pin-popup-match [item]
  (cond-> {}
    (:id item) (assoc :id (:id item))
    (and (number? (:longitude item)) (number? (:latitude item)))
    (assoc :longitude (:longitude item) :latitude (:latitude item))))

(defn- pin-marker-icon-url [icon]
  (forms/icon-url icon))

(defn- pin-item-position [item]
  (let [icon (get item :icon forms/default-icon)]
    (cond-> {:id (:id item)
             :longitude (:longitude item)
             :latitude (:latitude item)
             :name (:name item)
             :address (:address item)
             :url (:url item)
             :description (:description item)
             :marker-topic :pin
             :marker-icon-url (pin-marker-icon-url (forms/normalize-icon icon))}
      (seq (str/trim (or (:image item) "")))
      (assoc :image (:image item))
      (seq (str/trim (or (:agent-url item) "")))
      (assoc :agent-url (:agent-url item)))))

(defn- stored-pins-for-view [s]
  (if (= :pin (:page s))
    (vec (remove rows/separator-item? (:pin-items s)))
    (rows/pins-for-country (:pin-items s)
                           (:countries s)
                           (rows/country-slug-for-view s))))

(defn- saved-pin-positions [s]
  (mapv pin-item-position (stored-pins-for-view s)))

(defn- pin-form-position [s]
  (when-let [form (:pin-form s)]
    (when-let [lon (coords/parse-decimal (:longitude form))]
      (when-let [lat (coords/parse-decimal (:latitude form))]
        (cond-> {:longitude lon
                 :latitude lat
                 :name (:name form)
                 :address (:address form)
                 :url (:url form)
                 :description (:description form)
                 :marker-topic :pin
                 :marker-icon-url (pin-marker-icon-url
                                   (forms/normalize-icon (:icon form)))}
          (seq (str/trim (or (:image form) "")))
          (assoc :image (:image form))
          (seq (str/trim (or (:agent-url form) "")))
          (assoc :agent-url (:agent-url form)))))))

(defn- coords-match? [a b]
  (and (= (:longitude a) (:longitude b))
       (= (:latitude a) (:latitude b))))

(defn- merge-editor-form-into-pins [saved s]
  (if-not (or (:pin-editor-open? s) (:pin-editor-inline? s))
    saved
    (let [draft (pin-form-position s)]
      (if-not draft
        saved
        (case (:pin-editor-mode s)
          :edit
          (if-let [id (:pin-selected-id s)]
            (let [overlay (assoc draft :id id)]
              (conj (vec (remove #(= id (:id %)) saved)) overlay))
            saved)

          (if (some #(coords-match? draft %) saved)
            saved
            (conj saved draft)))))))

(defn- selected-pin-item [s]
  (when-let [id (:pin-selected-id s)]
    (rows/find-by-id (:pin-items s) id)))

(defn- pin-already-on-map? [positions pin-pos]
  (when-let [id (:id pin-pos)]
    (some #(= id (:id %)) positions)))

(defn main-map-positions
  "Topic markers for the current view plus saved pins in the current country."
  [s]
  (let [base (vec (state/visible-positions s))
        pin-overlays (merge-editor-form-into-pins (saved-pin-positions s) s)]
    (reduce (fn [acc pin-pos]
              (if (pin-already-on-map? acc pin-pos)
                acc
                (conj acc pin-pos)))
            base
            pin-overlays)))

(defn- position-matches-click? [click pin-pos]
  (or (and (:id click) (:id pin-pos)
           (= (str (:id click)) (str (:id pin-pos))))
      (and (number? (:longitude click)) (number? (:latitude click))
           (number? (:longitude pin-pos)) (number? (:latitude pin-pos))
           (= (:longitude click) (:longitude pin-pos))
           (= (:latitude click) (:latitude pin-pos)))))

(defn- normalize-click-position [raw-position]
  (let [position (if (map? raw-position)
                     raw-position
                     (js->clj raw-position :keywordize-keys true))
        lon (coords/parse-decimal (:longitude position))
        lat (coords/parse-decimal (:latitude position))]
    (cond-> position
      lon (assoc :longitude lon)
      lat (assoc :latitude lat))))

(defn- main-map-pin-positions [s]
  (filter #(= :pin (:marker-topic %)) (main-map-positions s)))

(defn main-map-pin-for-click
  "Return the saved pin map overlay matching a marker click, if any."
  [s raw-position]
  (let [click (normalize-click-position raw-position)]
    (first (filter #(position-matches-click? click %) (main-map-pin-positions s)))))

(defn saved-pin-on-main-map?
  "True when `raw-position` matches a saved pin currently drawn on the main map."
  [s raw-position]
  (boolean (main-map-pin-for-click s raw-position)))

(defn pins-only-map-positions
  "Saved pins (plus inline editor draft) without topic markers."
  [s]
  (vec (merge-editor-form-into-pins (saved-pin-positions s) s)))

(defn pin-map-positions
  "Map markers for the dedicated pin page: active topics plus all saved pins."
  [s]
  (if (= :pin (:page s))
    (if (:pin-show-topics-on-map? s true)
      (main-map-positions s)
      (pins-only-map-positions s))
    (pins-only-map-positions s)))

(defn sync-pin-map!
  ([] (sync-pin-map! {}))
  ([{:keys [recenter? open-popup-for] :or {recenter? true}}]
   (map-ui/apply-state! {:positions (pin-map-positions @state/!state)
                         :fit? false
                         :animate? false
                         :open-popup-for open-popup-for
                         :popup-opts (popup-opts @state/!state)})
   (when recenter?
     (when-let [form (:pin-form @state/!state)]
       (when-let [lon (coords/parse-decimal (:longitude form))]
         (when-let [lat (coords/parse-decimal (:latitude form))]
           (center-on-pin-map! {:longitude lon :latitude lat})))))))

(defn schedule-pin-map-sync!
  [& [opts]]
  (let [s @state/!state]
    (cond
      (= :pin (:page s))
      (sync-pin-map! (merge {:recenter? true} (or opts {})))

      (and (= :update (:page s))
           (update-context/update-pins-mode? s))
      (effects/schedule-update-map-pin-sync! opts))))

(defn- schedule-pin-popup! [match & [{:keys [attempt delay-ms]
                                       :or {attempt 0 delay-ms 150}}]]
  (when (<= attempt 8)
    (if (map-ui/open-marker-popup! match)
      nil
      (js/setTimeout #(schedule-pin-popup! match {:attempt (inc attempt)
                                                  :delay-ms delay-ms})
                     delay-ms))))

(defn schedule-selected-pin-popup!
  "Open the popup for `:pin-selected-id` on the current map, retrying until mounted."
  []
  (when-let [id (:pin-selected-id @state/!state)]
    (schedule-pin-popup! {:id id})))

(defn selected-pin-on-main-map?
  "True when `:pin-selected-id` refers to a pin currently drawn on the main map."
  [s]
  (boolean
   (when-let [id (:pin-selected-id s)]
     (some #(and (= id (:id %)) (= :pin (:marker-topic %)))
           (main-map-positions s)))))

(defn schedule-focus-selected-pin-on-main-map!
  "Fly to the selected pin on the main map and open its popup."
  ([] (schedule-focus-selected-pin-on-main-map! 0))
  ([attempt]
   (when (<= attempt 10)
     (when-let [item (selected-pin-item @state/!state)]
       (when (selected-pin-on-main-map? @state/!state)
         (when (and (number? (:longitude item)) (number? (:latitude item)))
           (let [coords {:longitude (:longitude item) :latitude (:latitude item)}
                 match (pin-popup-match item)]
             (center-on-pin-map! coords)
             (when-not (map-ui/open-marker-popup! match)
               (js/setTimeout #(schedule-focus-selected-pin-on-main-map! (inc attempt))
                              (+ pin-focus-popup-delay-ms (* attempt 100)))))))))))

(defn- sync-map-for-current-page! [opts]
  (let [s @state/!state
        page (:page s)]
    (cond
      (= :pin page)
      (sync-pin-map! opts)

      (and (= :update page)
           (update-context/update-pins-mode? s))
      (effects/sync-update-map! (merge {:recenter? false} (or opts {})))

      :else
      (map-ui/apply-state! (merge {:positions (main-map-positions s)
                                   :fit? false
                                   :animate? false
                                   :popup-opts (popup-opts s)}
                                  (select-keys opts [:open-popup-for]))))))

(defn- open-popup-on-focus? [s]
  (not (and (= :update (:page s))
            (update-context/update-pins-mode? s))))

(defn focus-pin-on-map!
  [item & [{:keys [open-popup?]}]]
  (when (and item (number? (:longitude item)) (number? (:latitude item)))
    (let [open-popup?* (if (some? open-popup?)
                         (boolean open-popup?)
                         (open-popup-on-focus? @state/!state))
          match (pin-popup-match item)]
      (sync-map-for-current-page! (cond-> {:recenter? false}
                                    open-popup?* (assoc :open-popup-for match)))
      (center-on-pin-map! {:longitude (:longitude item)
                           :latitude (:latitude item)})
      (when open-popup?*
        (js/setTimeout
         #(schedule-pin-popup! match)
         pin-focus-popup-delay-ms)))))

(defn schedule-center-on-pin!
  [position & [{:keys [delay-ms] :or {delay-ms 80}}]]
  (when (and (map? position)
             (number? (:longitude position))
             (number? (:latitude position)))
    (js/setTimeout
     #(center-on-pin-map!
       {:longitude (:longitude position)
        :latitude (:latitude position)})
     delay-ms)))

(defn sync-marker-pick-handler! []
  ;; Dedicated pin page uses list editing; map picks stay disabled there.
  (when (= :pin (:page @state/!state))
    (map-ui/set-marker-pick-handler! nil)))
