(ns placesurfer.edit.pure.topics
  (:require [clojure.string :as str]))

(def pins-topic :pins)
(def pins-topic-icon-url "/images/pin.png")

(defn pins-topic? [topic]
  (= pins-topic topic))

(defn topic-i18n-key [topic]
  (keyword "topic" (name topic)))

(defn sorted-topic-options
  ([topic-keys t]
   (sorted-topic-options topic-keys t {}))
  ([topic-keys t {:keys [marker-url-fn]}]
   (->> topic-keys
        (map (fn [topic]
               (cond-> {:topic topic
                        :label (t (topic-i18n-key topic))}
                 marker-url-fn (assoc :marker-url (marker-url-fn topic)))))
        (sort-by :label #(compare (str/lower-case %1) (str/lower-case %2))))))

(defn pins-topic-option [t]
  {:topic pins-topic
   :label (t :topic/pins)
   :marker-url pins-topic-icon-url})

(defn topic-options-for-dropdown
  ([topic-keys t]
   (topic-options-for-dropdown topic-keys t {}))
  ([topic-keys t opts]
   (into [(pins-topic-option t)]
         (sorted-topic-options topic-keys t opts))))

(defn option-for-topic [options topic]
  (some #(when (= topic (:topic %)) %) options))

(defn dataset-topic-options [options]
  (vec (remove #(pins-topic? (:topic %)) options)))

(defn first-dataset-topic-option [options]
  (first (dataset-topic-options options)))

(defn pin-toggle-target-option
  [options before-pins-topic]
  (let [target (or before-pins-topic (:topic (first-dataset-topic-option options)))]
    (or (option-for-topic options target)
        (first-dataset-topic-option options))))

(defn topic-marker-icon-class [topic]
  (when topic
    (str "update-topic-dropdown-icon update-topic-dropdown-icon--" (name topic))))

(defn default-update-topic
  [topic-keys t]
  (:topic (first (sorted-topic-options topic-keys t))))
