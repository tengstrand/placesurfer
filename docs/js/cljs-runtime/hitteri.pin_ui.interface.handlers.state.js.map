(ns hitteri.pin-ui.interface.handlers.state
  (:require [hitteri.pin-ui.handlers.state :as state]))

(defn render! [] (state/render!))
(defn swap-state! [& args] (apply state/swap-state! args))
(defn swap-render! [& args] (apply state/swap-render! args))
(defn clear-search-ui [& args] (apply state/clear-search-ui args))
