(ns placesurfer.app-ui.load
  (:require [placesurfer.country.interface :as country]
            [placesurfer.topic.interface :as data]
            [placesurfer.app-ui.interface.effects :as effects]
            [placesurfer.app-ui.interface.state :as state]
            [placesurfer.browser-storage.interface :as storage]
            [placesurfer.i18n.interface :as i18n]))

(defn- locale [s]
  (:locale s :en))

(defn- t-for
  ([s key]
   (t-for s key {}))
  ([s key params]
   (i18n/t (locale s) key params)))

(defn positions-for-topic? [positions topic]
  (boolean (some #(= topic (:topic %)) positions)))

(defn missing-active-topics [active-topics positions]
  (into #{}
        (remove #(positions-for-topic? positions %)
                active-topics)))

(defn- coords-in-slug-bounds? [lon lat slug countries]
  (if-let [{:keys [west east south north]} (country/country-bounds-for-slug slug countries)]
    (and (number? lon) (number? lat)
         (<= west lon east)
         (<= south lat north))
    true))

(defn- pin-in-slug-country? [pin slug countries]
  (when pin
    (coords-in-slug-bounds? (:longitude pin) (:latitude pin) slug countries)))

(defn- clear-pin-selection-outside-slug [s slug]
  (if-let [id (:pin-selected-id s)]
    (let [pin (first (filter #(= id (:id %)) (:pin-items s)))]
      (if (pin-in-slug-country? pin slug (:countries s))
        s
        (assoc s :pin-selected-id nil)))
    s))

(defn- merge-topic-positions! [topic positions]
  (let [merged (into (vec (remove #(= topic (:topic %)) (:positions @state/!state)))
                     (vec positions))]
    (swap! state/!state assoc :positions merged :count (count merged))
    (effects/render!)
    (if (= :update (:page @state/!state))
      (effects/sync-update-map! {:recenter? false})
      (effects/sync-main-map! {:fit? false :animate? false}))))

(defn- country-label-for-state [s]
  (or (country/country-label (:country-slug s) (:countries s))
      (:country-slug s)
      ""))

(defn- empty-topics-status [s]
  (t-for s :load/no-places {:label (country-label-for-state s)}))

(defn- set-error! [message]
  (swap! state/!state assoc
         :status message
         :count 0
         :positions []
         :country-loading? false
         :loading-topics #{})
  (effects/render!)
  (effects/sync-main-map! {:fit? false}))

(defn- handle-country-data! [load-id slug label fit? animate? {:keys [positions]}]
  (when (and (= load-id @state/!load-id)
             (= slug (:country-slug @state/!state)))
    (let [active (:active-topics @state/!state)
          positions (vec (filter #(contains? active (:topic %)) positions))
          n (count positions)]
      (swap! state/!state assoc
             :status (if (pos? n)
                       (t-for @state/!state :load/loaded {:label label})
                       (t-for @state/!state :load/no-places {:label label}))
             :count n
             :positions positions
             :country-loading? false
             :loading-topics #{})
      (set! (.-placesurferBoot js/window) (str "ready:" n))
      (effects/render!)
      (let [fit-bounds (when (and fit? (zero? n))
                         (country/country-bounds-for-slug slug (:countries @state/!state)))]
        (effects/sync-main-map! {:fit? (or (pos? n) (some? fit-bounds))
                             :fit-bounds fit-bounds
                             :animate? animate?})))))

(defn load-country!
  [slug {:keys [active-topics indicator-topics fit? animate?]
         :or {fit? false animate? true}}]
  (let [load-id (swap! state/!load-id inc)
        active (set (or active-topics (:active-topics @state/!state)))
        spinner-topics (set (or indicator-topics active))
        label (or (country/country-label slug (:countries @state/!state)) slug)]
    (storage/save-country-slug! slug)
    (swap! state/!state
           (fn [s]
             (-> s
                 (assoc :status (t-for s :load/loading {:label label})
                        :country-slug slug
                        :country-iso (or (country/iso-for-slug slug (:countries s))
                                         (:country-iso s))
                        :positions []
                        :count 0
                        :country-loading? true
                        :loading-topics #{})
                 (clear-pin-selection-outside-slug slug))))
    (effects/render!)
    (let [fit-bounds (when fit?
                       (country/country-bounds-for-slug slug (:countries @state/!state)))]
      (effects/sync-main-map! {:fit? (some? fit-bounds)
                               :fit-bounds fit-bounds
                               :animate? animate?}))
    (if (empty? active)
      (do
        (let [fit-bounds (when fit?
                           (country/country-bounds-for-slug slug (:countries @state/!state)))]
          (swap! state/!state assoc
                 :status (empty-topics-status @state/!state)
                 :count 0
                 :positions []
                 :country-loading? false
                 :loading-topics #{})
          (effects/render!)
          (effects/sync-main-map! {:fit? (some? fit-bounds)
                               :fit-bounds fit-bounds
                               :animate? animate?})))
      (-> (data/load-country-topics-with-progress! slug active
                                                   {:on-topic-started
                                                    (fn [loading-topic]
                                                      (when (and (= load-id @state/!load-id)
                                                                 (= slug (:country-slug @state/!state))
                                                                 (contains? spinner-topics loading-topic))
                                                        (swap! state/!state update :loading-topics conj loading-topic)
                                                        (effects/render!)))
                                                    :on-topic-loaded
                                                    (fn [loaded-topic {:keys [positions]}]
                                                      (when (and (= load-id @state/!load-id)
                                                                 (= slug (:country-slug @state/!state))
                                                                 (contains? active loaded-topic))
                                                        (swap! state/!state update :loading-topics disj loaded-topic)
                                                        (merge-topic-positions! loaded-topic positions)))})
          (.then #(handle-country-data! load-id slug label fit? animate? %))
          (.catch (fn [error]
                    (when (and (= load-id @state/!load-id)
                               (= slug (:country-slug @state/!state)))
                      (set-error! (t-for @state/!state :load/error {:message (.-message error)})))))))))

(defn load-countries-into-state! []
  (if-let [in-flight @state/!countries-load-promise]
    in-flight
    (let [request-id (swap! state/!countries-load-request-id inc)
          active (:active-topics @state/!state)]
      (swap! state/!state assoc :countries-loading? true)
      (effects/render!)
      (let [p (-> (data/load-countries! active)
                  (.then (fn [countries]
                           (if (= request-id @state/!countries-load-request-id)
                             (do
                               (swap! state/!state assoc
                                      :countries countries
                                      :countries-loading? false)
                               (effects/render!)
                               (-> (data/enrich-countries-with-counts! active countries)
                                   (.then (fn [enriched]
                                            (when (and enriched
                                                       (= request-id @state/!countries-load-request-id))
                                              (swap! state/!state assoc :countries enriched)
                                              (effects/render!)))))
                               countries)
                             (js/Promise.resolve nil))))
                (.catch (fn [error]
                          (when (= request-id @state/!countries-load-request-id)
                            (swap! state/!state assoc
                                   :countries-loading? false
                                   :status (t-for @state/!state :load/error {:message (.-message error)}))
                            (effects/render!))
                          (js/Promise.reject error)))
                  (.finally (fn []
                              (when (= request-id @state/!countries-load-request-id)
                                (reset! state/!countries-load-promise nil)))))]
        (reset! state/!countries-load-promise p)
        p))))

(defn reload-countries! []
  (reset! state/!countries-load-promise nil)
  (load-countries-into-state!))

(defn ensure-countries-loaded! []
  (when (empty? (:countries @state/!state))
    (load-countries-into-state!)))

(defn- remove-topic-positions! [topic]
  (let [positions (vec (remove #(= topic (:topic %)) (:positions @state/!state)))]
    (swap! state/!state assoc :positions positions :count (count positions))
    (swap! state/!state update :loading-topics disj topic)
    (effects/render!)
    (effects/sync-main-map! {:fit? false :animate? false})))

(defn load-topic-positions! [topic]
  (let [load-id (get (swap! state/!topic-load-ids update topic (fnil inc 0)) topic)
        slug (:country-slug @state/!state)]
    (swap! state/!state update :loading-topics conj topic)
    (effects/render!)
    (-> (data/load-topic-country! topic slug)
        (.then (fn [{:keys [positions]}]
                 (when (and (= load-id (get @state/!topic-load-ids topic))
                            (= slug (:country-slug @state/!state)))
                   (swap! state/!state update :loading-topics disj topic)
                   (merge-topic-positions! topic positions))))
        (.catch (fn [error]
                  (when (= load-id (get @state/!topic-load-ids topic))
                    (swap! state/!state update :loading-topics disj topic)
                    (set-error! (t-for @state/!state :load/error {:message (.-message error)}))))))))

(defn ensure-active-topic-positions! []
  (let [{:keys [active-topics positions]} @state/!state]
    (when (seq active-topics)
      (doseq [topic (missing-active-topics active-topics positions)]
        (load-topic-positions! topic)))))

(defn- after-active-topics-change! [topic active?]
  (when-not active?
    (remove-topic-positions! topic))
  (-> (reload-countries!)
      (.then (fn [_]
               (when active?
                 (load-topic-positions! topic))))))

(defn- clear-topic-batch-sync! []
  (set! (.-placesurferTopicBatchSync js/window) false))

(defn set-topic-active! [topic active?]
  (set! (.-placesurferTopicBatchSync js/window) true)
  (let [next-active (if active?
                      (conj (set (:active-topics @state/!state)) topic)
                      (disj (set (:active-topics @state/!state)) topic))]
    (storage/save-active-topics! next-active)
    (swap! state/!state assoc :active-topics next-active)
    (effects/render!)
    (if (empty? next-active)
      (let [positions (vec (remove #(= topic (:topic %)) (:positions @state/!state)))]
        (swap! state/!state assoc
               :status (empty-topics-status @state/!state)
               :count (count positions)
               :positions positions
               :country-loading? false
               :loading-topics #{})
        (effects/sync-main-map! {:fit? false :animate? false})
        (effects/render!)
        (-> (reload-countries!)
            (.then (fn [_]
                     (effects/render!)
                     (clear-topic-batch-sync!)))
            (.catch (fn [_]
                      (clear-topic-batch-sync!)))))
      (-> (after-active-topics-change! topic active?)
          (.then (fn [_]
                   (effects/render!)
                   (clear-topic-batch-sync!)))
          (.catch (fn [_]
                    (clear-topic-batch-sync!)))))))

(defn toggle-topic! [topic]
  (set-topic-active! topic (not (contains? (:active-topics @state/!state) topic))))

(defn- apply-url-page! []
  (when-let [page (storage/read-page-from-url)]
    (if (= page :pin)
      (effects/navigate-to-pin!)
      (effects/navigate! page))))

(defn- init-after-countries-loaded! [countries]
  (when (seq countries)
    (let [countries countries
          active (:active-topics @state/!state)
          iso (country/locale->iso)
          cookie-slug (storage/read-country-slug)
          slug (or (when (some #(= cookie-slug (:slug %)) countries) cookie-slug)
                   (country/slug-for-iso iso countries)
                   "sweden")
          resolved-iso (or (country/iso-for-slug slug countries) iso "SE")]
      (swap! state/!state assoc
             :country-slug slug
             :country-iso resolved-iso
             :update-country-code resolved-iso)
      (set! (.-placesurferBoot js/window) "countries")
      (effects/render!)
      (effects/check-backend!)
      (if (seq active)
        (-> (load-country! slug {:fit? true :animate? false})
            (.then (fn [_]
                     (ensure-active-topic-positions!)
                     (apply-url-page!)))
            (.catch (fn [error]
                      (set! (.-placesurferBoot js/window) "error")
                      (set-error! (t-for @state/!state :load/error {:message (.-message error)})))))
        (apply-url-page!)))))

(defn init-load! []
  (set! (.-placesurferBoot js/window) "loading")
  (let [url-topic (storage/read-topic-from-url)
        url-page (storage/read-page-from-url)
        active (if url-topic #{url-topic}
                   (storage/read-active-topics state/default-active-topics))
        default-page (if (empty? active) :topic :home)
        initial-page (or url-page default-page)]
    (when url-topic
      (storage/save-active-topics! active))
    (swap! state/!state assoc
           :active-topics active
           :page initial-page)
    (effects/render!)
    (-> (load-countries-into-state!)
        (.then init-after-countries-loaded!)
        (.catch (fn [error]
                  (set! (.-placesurferBoot js/window) "error")
                  (set-error! (t-for @state/!state :load/error {:message (.-message error)})))))))
