(ns placesurfer.load.gis
  (:require [cljs.reader :as reader]
            [clojure.string :as str]))

(def countries-url "data/world-countries.edn")

(defn- ensure-position-description [position]
  (assoc position :description (str/trim (str (or (:description position) "")))))

(defn- ensure-position-image [position]
  (assoc position :image (str/trim (str (or (:image position) "")))))

(defn- parse-edn [text]
  (let [data (reader/read-string text)
        positions (mapv (fn [position]
                          (-> position ensure-position-image ensure-position-description))
                        (:positions data))]
    {:country (:country data)
     :count (:count data)
     :positions positions}))

(defn- fetch-text! [url]
  (-> (js/fetch url)
      (.then (fn [resp]
               (if (.-ok resp)
                 (.text resp)
                 (js/Promise.reject
                  (js/Error. (str "Failed to load " url ", status " (.-status resp)))))))))

(defn- merge-country-counts [countries counts-by-slug]
  (mapv #(assoc % :count (get counts-by-slug (:slug %) 0)) countries))

(defn load-counts! [counts-url]
  (-> (fetch-text! counts-url)
      (.then #(js/Promise.resolve (reader/read-string %)))
      (.catch (fn [_]
                (js/Promise.resolve {})))))

(defn load-countries! [counts-url]
  (-> (js/Promise.all
       [(fetch-text! countries-url) (load-counts! counts-url)])
      (.then (fn [[countries-text counts]]
               (let [countries (reader/read-string countries-text)]
                 (js/Promise.resolve
                  (sort-by :label (merge-country-counts countries counts))))))))

(defn load-country! [gis-url-fn slug]
  (-> (js/fetch (gis-url-fn slug))
      (.then (fn [resp]
               (cond
                 (.-ok resp)
                 (.then (.text resp) parse-edn)

                 (= 404 (.-status resp))
                 (js/Promise.resolve {:country slug :count 0 :positions []})

                 :else
                 (js/Promise.reject
                  (js/Error. (str "Failed to load " (gis-url-fn slug)
                                  ", status " (.-status resp)))))))))
