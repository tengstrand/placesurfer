(ns placesurfer.browser-storage.core
  (:require [clojure.string :as str]
            [placesurfer.topic.interface :as data]))

(def topics-cookie-key "placesurfer_active_topics")
(def country-cookie-key "placesurfer_country_slug")
(def cookie-max-age-seconds (* 60 60 24 365 2))

(defn read-cookie [k]
  (try
    (let [pairs (.split (or (.-cookie js/document) "") ";")]
      (some (fn [pair]
              (let [trimmed (str/trim pair)
                    idx (.indexOf trimmed "=")]
                (when (and (pos? idx)
                           (= (subs trimmed 0 idx) k))
                  (js/decodeURIComponent (subs trimmed (inc idx))))))
            pairs))
    (catch :default _ nil)))

(defn write-cookie! [k v]
  (set! (.-cookie js/document)
        (str k "=" (js/encodeURIComponent (str v))
             "; path=/; max-age=" cookie-max-age-seconds
             "; samesite=lax")))

(defn clear-cookie! [k]
  (set! (.-cookie js/document)
        (str k "=; path=/; max-age=0; samesite=lax")))

(defn read-active-topics [default-active-topics]
  (let [raw (read-cookie topics-cookie-key)
        allowed (set (data/topic-keys))]
    (if (seq raw)
      (let [parsed (set (keep (fn [v]
                                (let [k (keyword v)]
                                  (when (contains? allowed k) k)))
                              (.split raw ",")))]
        (if (seq parsed) parsed (default-active-topics)))
      (default-active-topics))))

(defn save-active-topics! [topics]
  (if (empty? topics)
    (clear-cookie! topics-cookie-key)
    (write-cookie! topics-cookie-key
                   (str/join "," (map name (sort topics))))))

(defn read-country-slug []
  (some-> (read-cookie country-cookie-key) str/trim not-empty))

(defn save-country-slug! [slug]
  (if (seq slug)
    (write-cookie! country-cookie-key slug)
    (clear-cookie! country-cookie-key)))

(defn read-topic-from-url []
  (try
    (let [params (js/URLSearchParams. (or (.-search js/location) ""))
          raw (.get params "topic")
          topic (some-> raw str/trim str/lower-case keyword)
          allowed (set (data/topic-keys))]
      (when (contains? allowed topic) topic))
    (catch :default _ nil)))

(def ^:private allowed-url-pages
  #{:home :topic :country :pin :update :about :settings})

(defn read-page-from-url []
  (try
    (let [params (js/URLSearchParams. (or (.-search js/location) ""))
          raw (.get params "page")
          page (some-> raw str/trim str/lower-case keyword)]
      (when (contains? allowed-url-pages page) page))
    (catch :default _ nil)))
