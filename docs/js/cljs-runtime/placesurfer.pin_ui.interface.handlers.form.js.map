(ns placesurfer.pin-ui.interface.handlers.form
  (:require [placesurfer.pin-ui.handlers.form :as form]
            [placesurfer.pin-ui.handlers.load :as load]
            [placesurfer.pin-ui.handlers.search :as search]))

(defn set-pin-name! [& args] (apply form/set-pin-name! args))
(defn set-pin-address! [& args] (apply form/set-pin-address! args))
(defn set-pin-group! [& args] (apply form/set-pin-group! args))
(defn set-pin-icon! [& args] (apply form/set-pin-icon! args))
(defn set-pin-url! [& args] (apply form/set-pin-url! args))
(defn set-pin-image! [& args] (apply form/set-pin-image! args))
(defn set-pin-agent-url! [& args] (apply form/set-pin-agent-url! args))
(defn set-pin-description! [& args] (apply form/set-pin-description! args))
(defn set-pin-longitude! [& args] (apply form/set-pin-longitude! args))
(defn commit-pin-longitude! [& args] (apply form/commit-pin-longitude! args))
(defn set-pin-latitude! [& args] (apply form/set-pin-latitude! args))
(defn commit-pin-latitude! [& args] (apply form/commit-pin-latitude! args))
(defn set-pin-search-query! [& args] (apply search/set-pin-search-query! args))
(defn select-pin-search-result! [& args] (apply search/select-pin-search-result! args))
(defn set-pin-search-highlight-index! [& args] (apply search/set-pin-search-highlight-index! args))
(defn pin-search-keydown! [& args] (apply search/pin-search-keydown! args))
(defn pin-search-enter! [& args] (apply search/pin-search-enter! args))
(defn load-pin-icons! [& args] (apply load/load-pin-icons! args))
(defn load-pins-from-storage! [& args] (apply load/load-pins-from-storage! args))
