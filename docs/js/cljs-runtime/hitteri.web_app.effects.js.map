(ns hitteri.web-app.effects
  "Re-exports app-effects for web-app base modules."
  (:require [hitteri.app-ui.interface.effects :as app-effects]))

(defn wire! [handlers] (app-effects/wire! handlers))
(defn render! [] (app-effects/render!))
(defn navigate! [& args] (apply app-effects/navigate! args))
(defn select-country! [& args] (apply app-effects/select-country! args))
(defn resolve-update-location-from-coordinates! [& args] (apply app-effects/resolve-update-location-from-coordinates! args))
(defn sync-marker-pick-handler! [] (app-effects/sync-marker-pick-handler!))
(defn reload-update-dataset! [& args] (apply app-effects/reload-update-dataset! args))
(defn sync-update-map! [& args] (apply app-effects/sync-update-map! args))
(defn load-topic-positions! [topic] (app-effects/load-topic-positions! topic))
(defn schedule-update-map-pin-sync! [& args] (apply app-effects/schedule-update-map-pin-sync! args))
(defn schedule-center-on-position! [& args] (apply app-effects/schedule-center-on-position! args))
(defn sync-main-map! [& args] (apply app-effects/sync-main-map! args))
(defn check-backend! [& args] (apply app-effects/check-backend! args))
(defn track-page! [& args] (apply app-effects/track-page! args))
