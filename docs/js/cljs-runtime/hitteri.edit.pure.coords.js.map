(ns hitteri.edit.pure.coords
  (:require [clojure.string :as str]))

(def ^:private decimal-input-pattern
  #"^-?(?:\d+(?:\.\d*)?|\.\d+)$")

(defn form-field-value-str
  [v]
  (cond
    (string? v) v
    (nil? v) ""
    :else (str v)))

(defn normalize-decimal-input
  [v]
  (-> (form-field-value-str v)
      str/trim
      (str/replace #"\u2212" "-")
      (str/replace #"," ".")))

(defn decimal-input-matches?
  [s]
  (boolean (and (seq s) (re-matches decimal-input-pattern s))))

(defn parse-decimal
  [v]
  (let [s (normalize-decimal-input v)]
    (when (decimal-input-matches? s)
      (let [n (js/parseFloat s)]
        (when-not (js/isNaN n) n)))))

(def ^:private dms-component-re
  #"(\d+(?:[.,]\d+)?)\s*[°º]\s*(\d+(?:[.,]\d+)?)?\s*['′]?\s*(\d+(?:[.,]\d+)?)?\s*[\"″]?\s*([NnSsEeWw])")

(defn- dms-component->decimal [[_ deg min sec dir]]
  (let [d (or (parse-decimal deg) 0)
        m (or (parse-decimal min) 0)
        s (or (parse-decimal sec) 0)
        decimal (+ d (/ m 60.0) (/ s 3600.0))
        direction (str/upper-case dir)]
    (case direction
      ("N" "E") decimal
      ("S" "W") (- decimal)
      nil)))

(defn- coords-from-dms-components [components]
  (when (= 2 (count components))
    (let [[c1 c2] (map dms-component->decimal components)
          [d1 d2] (map #(str/upper-case (nth % 4)) components)]
      (cond
        (and (#{"N" "S"} d1) (#{"E" "W"} d2) (number? c1) (number? c2))
        {:latitude c1 :longitude c2}

        (and (#{"E" "W"} d1) (#{"N" "S"} d2) (number? c1) (number? c2))
        {:longitude c1 :latitude c2}

        :else nil))))

(defn parse-dms-coordinates
  "Parse strings like 60°23'59.2\"N 24°45'29.5\"E into decimal :latitude / :longitude."
  [text]
  (when-let [{:keys [latitude longitude] :as coords}
             (some->> text
                       str
                       str/trim
                       (re-seq dms-component-re)
                       not-empty
                       vec
                       coords-from-dms-components)]
    (when (and (number? latitude) (number? longitude)
               (<= -90 latitude 90)
               (<= -180 longitude 180))
      coords)))

(defn- decimal-pair-parts [text]
  (let [trimmed (str/trim (str text))]
    (cond
      (str/includes? trimmed ",")
      (let [parts (map str/trim (str/split trimmed #"," 2))]
        (when (= 2 (count parts)) parts))

      (str/includes? trimmed ";")
      (let [parts (map str/trim (str/split trimmed #";" 2))]
        (when (= 2 (count parts)) parts))

      :else
      (when-let [parts (seq (re-seq decimal-input-pattern trimmed))]
        (when (= 2 (count parts)) parts)))))

(defn- coords-from-decimal-pair [v1 v2]
  (when (and (number? v1) (number? v2))
    (let [a (js/Math.abs v1)
          b (js/Math.abs v2)
          {:keys [latitude longitude]}
          (cond
            (> a 90)
            {:latitude v2 :longitude v1}

            (> b 90)
            {:latitude v1 :longitude v2}

            (> a b)
            {:latitude v1 :longitude v2}

            (< a b)
            {:latitude v2 :longitude v1}

            :else
            {:latitude v1 :longitude v2})]
      (when (and (<= -90 latitude 90)
                 (<= -180 longitude 180))
        {:latitude latitude :longitude longitude}))))

(defn parse-decimal-coordinate-pair
  "Parse strings like 59.8126, 17.6685 into decimal :latitude / :longitude."
  [text]
  (when-let [[p1 p2] (decimal-pair-parts text)]
    (when-let [v1 (parse-decimal p1)]
      (when-let [v2 (parse-decimal p2)]
        (coords-from-decimal-pair v1 v2)))))

(defn parse-pasted-coordinates
  "Parse DMS or decimal coordinate pairs from clipboard/paste text."
  [text]
  (or (parse-dms-coordinates text)
      (parse-decimal-coordinate-pair text)))

(defn valid-longitude?
  [v]
  (let [n (parse-decimal v)]
    (and (number? n) (<= -180 n 180))))

(defn valid-latitude?
  [v]
  (let [n (parse-decimal v)]
    (and (number? n) (<= -90 n 90))))

(defn form-has-coords?
  "True when update form longitude and latitude are both valid."
  [form]
  (and (valid-longitude? (:longitude form))
       (valid-latitude? (:latitude form))))

(defn- to-radians [deg]
  (* deg (/ js/Math.PI 180)))

(defn haversine-distance-m
  [lon1 lat1 lon2 lat2]
  (let [r 6371000.0
        dlat (- (to-radians lat2) (to-radians lat1))
        dlon (- (to-radians lon2) (to-radians lon1))
        a (+ (* (js/Math.sin (/ dlat 2)) (js/Math.sin (/ dlat 2)))
             (* (js/Math.cos (to-radians lat1))
                (js/Math.cos (to-radians lat2))
                (js/Math.sin (/ dlon 2))
                (js/Math.sin (/ dlon 2))))]
    (* r 2 (js/Math.atan2 (js/Math.sqrt a) (js/Math.sqrt (- 1 a))))))

(defn row-lon-lat
  [row]
  (let [lon (if (number? (:longitude row))
              (:longitude row)
              (parse-decimal (:longitude row)))
        lat (if (number? (:latitude row))
              (:latitude row)
              (parse-decimal (:latitude row)))]
    (when (and (number? lon) (number? lat))
      {:longitude lon :latitude lat})))

(defn row-has-coords?
  [row]
  (boolean (row-lon-lat row)))

(defn row-distance-m
  [reference-row row]
  (when-let [{:keys [longitude latitude]} (row-lon-lat reference-row)]
    (when-let [row-coords (row-lon-lat row)]
      (js/Math.round (haversine-distance-m longitude latitude
                                           (:longitude row-coords)
                                           (:latitude row-coords))))))
