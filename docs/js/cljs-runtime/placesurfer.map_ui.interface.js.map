(ns placesurfer.map-ui.interface
  (:require [placesurfer.map-ui.core :as core]
            [placesurfer.map-ui.popup :as popup]))

(defn mount-map! [element]
  (core/mount-map! element))

(defn destroy-map! []
  (core/destroy-map!))

(defn destroy-map-if-attached! [element]
  (core/destroy-map-if-attached! element))

(defn resize-map! []
  (core/resize-map!))

(defn apply-state!
  "Replace map markers and optionally fit bounds.

   Options:
     :positions     collection of {:longitude :latitude :topic ...}
     :fit-bounds    optional {:west :east :south :north} when fitting without positions
     :draft-marker  optional {:longitude :latitude :marker-topic :url-pin ...}
     :fit?          fit bounds to positions or :fit-bounds (default false)
     :animate?      animate the fit (default true)
     :popup-opts    optional map passed to popup-html (e.g. {:source-label \"Source: \"})"
  [state]
  (core/apply-state! state))

(defn set-marker-pick-handler! [handler]
  (core/set-marker-pick-handler! handler))

(defn sync-country-pick-state! [state]
  (core/sync-country-pick-state! state))

(defn sync-add-pin-mode! [state]
  (core/sync-add-pin-mode! state))

(defn close-all-popups! []
  (core/close-all-popups!))

(defn open-marker-popup! [match]
  (core/open-marker-popup! match))

(defn set-marker-row-emphasis! [match]
  (core/set-marker-row-emphasis! match))

(defn clear-marker-row-emphasis! []
  (core/clear-marker-row-emphasis!))

(defn map-center-coords []
  (core/map-center-coords))

(defn map-view-state []
  (core/map-view-state))

(defn fly-to-view! [view]
  (core/fly-to-view! view))

(defn center-on-position! [position]
  (core/center-on-position! position))

(defn popup-html [& args]
  (apply popup/popup-html args))
