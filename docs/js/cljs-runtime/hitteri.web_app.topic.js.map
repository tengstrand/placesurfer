(ns hitteri.web-app.topic)

(defn topic-page? [page]
  (= page :topic))

(defn toggle-active-topics [active-topics topic]
  (if (contains? active-topics topic)
    (disj active-topics topic)
    (conj active-topics topic)))

(defn topic-toggle-plan
  "Pure plan for toggling a topic (used by main and tests)."
  [active-topics topic]
  (let [next-topics (toggle-active-topics active-topics topic)]
    {:active-topics next-topics
     :empty? (empty? next-topics)
     :reload-countries? true
     :load-map? (not (empty? next-topics))}))

(defn topic-panel-props
  "Props for topic-panel; topic-keys must be a seq of keywords."
  [{:keys [active-topics topic-keys topic-label topic-marker-url set-topic-active!]}]
  {:active-topics active-topics
   :topic-keys (vec (sort topic-keys))
   :rows (mapv (fn [topic]
                 {:topic topic
                  :active? (contains? active-topics topic)
                  :label (topic-label topic)
                  :marker-url (topic-marker-url topic)})
               topic-keys)
   :set-topic-active! set-topic-active!})
