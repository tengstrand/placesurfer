(ns hitteri.web-app.locale
  (:require [hitteri.app-ui.interface.effects :as effects]
            [hitteri.app-ui.interface.state :as app-state]
            [hitteri.i18n.interface :as i18n]))

(defn set-locale!
  [locale]
  (let [locale (i18n/normalize-locale locale)]
    (swap! app-state/!state assoc :locale locale)
    (i18n/save-locale! locale)
    (effects/render!)))

(defn init-locale!
  []
  (swap! app-state/!state assoc :locale (i18n/read-locale!)))

(defn t-for-state
  ([state key]
   (t-for-state state key {}))
  ([state key params]
   (i18n/t (:locale state i18n/default-locale) key params)))

(defn make-t
  [state]
  (fn
    ([key] (t-for-state state key))
    ([key params] (t-for-state state key params))))
