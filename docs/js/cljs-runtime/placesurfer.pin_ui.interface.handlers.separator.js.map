(ns placesurfer.pin-ui.interface.handlers.separator
  (:require [placesurfer.pin-ui.handlers.separator :as separator]))

(defn open-pin-separator-overlay! [& args] (apply separator/open-pin-separator-overlay! args))
(defn cancel-pin-separator-overlay! [& args] (apply separator/cancel-pin-separator-overlay! args))
(defn select-separator-overlay-row! [& args] (apply separator/select-separator-overlay-row! args))
(defn set-separator-overlay-label! [& args] (apply separator/set-separator-overlay-label! args))
(defn add-separator-overlay-row! [& args] (apply separator/add-separator-overlay-row! args))
