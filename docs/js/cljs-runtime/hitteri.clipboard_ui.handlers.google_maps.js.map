(ns hitteri.clipboard-ui.handlers.google-maps
  (:require [hitteri.clipboard-ui.google-maps.place :as google-maps-place]
            [hitteri.clipboard-ui.google-maps.payload :as google-maps-payload]
            [hitteri.clipboard-ui.handlers.pin-editor :as pin-editor]
            [hitteri.clipboard-ui.pure.browser :as browser]))

(defn- trimmed-text [text]
  (browser/trimmed-text text))

(defn apply-payload!
  "Apply Google Maps bookmarklet payload to the pin editor."
  [payload]
  (when-let [place (google-maps-payload/payload->place payload)]
    (let [source-url (not-empty (trimmed-text (:url payload)))
          form (google-maps-place/place->pin-form place source-url)]
      (pin-editor/apply-resolved-place-form! form)
      true)))
