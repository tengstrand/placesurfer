(ns hitteri.group-ui.handlers.groups
  "Groups admin page: list selection, draft input, persist to pin-items."
  (:require [clojure.string :as str]
            [hitteri.app-ui.interface.state :as app-state]
            [hitteri.pin-ui.interface.handlers.editor :as pin-editor]
            [hitteri.pin-ui.interface.handlers.rows :as pin-rows]
            [hitteri.pin-ui.interface.handlers.state :as pin-state]
            [hitteri.pin-ui.interface.rows :as rows]
            [hitteri.pin-ui.interface.storage :as storage]))

(defn- clear-draft [s]
  (assoc s
         :pin-separator-overlay-draft-label ""
         :pin-separator-overlay-editing-id nil))

(defn- focus-group-draft-input! []
  (when (js* "typeof document !== 'undefined' && document.getElementById")
    (doseq [delay-ms [0 60 140 260]]
      (js/setTimeout
       #(when-let [el (.getElementById js/document "group-draft-input")]
          (.focus el))
       delay-ms))))

(defn- sync-groups-from-items [s items]
  (let [overlay-rows (rows/separator-overlay-rows-from-items items)
        selected-id (:id (first overlay-rows))]
    (pin-rows/refresh-table-rows
     (-> s
         (assoc :pin-items items
                :pin-separator-overlay-rows overlay-rows
                :pin-separator-overlay-selected-id selected-id
                :pin-separator-overlay-snapshot {:rows overlay-rows
                                                 :selected-id selected-id})
         clear-draft))))

(defn- cancel-pin-editor-if-open! []
  (when (:pin-editor-open? @app-state/!state)
    (pin-editor/cancel-pin-editor!)))

(defn- persist-overlay-rows! [overlay-rows]
  (let [saved (atom nil)]
    (pin-state/swap-state!
     (fn [s]
       (let [next-items (rows/apply-separator-overlay-edits (:pin-items s) overlay-rows)]
         (reset! saved next-items)
         (sync-groups-from-items s next-items))))
    (when @saved
      (storage/save-pins! @saved)
      (pin-state/render!))
    (focus-group-draft-input!)))

(defn init-groups-edit! []
  (cancel-pin-editor-if-open!)
  (pin-state/swap-render!
   (fn [s]
     (let [overlay-rows (rows/separator-overlay-rows-from-items (:pin-items s))
           selected-id (:id (first overlay-rows))]
       (-> s
           (assoc :pin-separator-overlay-rows overlay-rows
                  :pin-separator-overlay-selected-id selected-id
                  :pin-separator-overlay-snapshot {:rows overlay-rows
                                                   :selected-id selected-id})
           clear-draft))))
  (focus-group-draft-input!))

(defn leave-groups-page! []
  (pin-state/swap-render!
   (fn [s]
     (-> s clear-draft
         (assoc :pin-separator-overlay-rows []
                :pin-separator-overlay-selected-id nil
                :pin-separator-overlay-snapshot nil)))))

(defn select-group-row! [id]
  (let [editing-id (:pin-separator-overlay-editing-id @app-state/!state)]
    (pin-state/swap-render!
     (fn [s]
       (cond-> (assoc s :pin-separator-overlay-selected-id id)
         (and editing-id (not= id editing-id))
         clear-draft)))
    (focus-group-draft-input!)))

(defn set-group-draft-label! [label]
  (pin-state/swap-render! #(assoc % :pin-separator-overlay-draft-label (str (or label "")))))

(defn start-group-row-edit! [id]
  (when-let [row (first (filter #(= id (:id %))
                                (:pin-separator-overlay-rows @app-state/!state [])))]
    (pin-state/swap-render!
     (fn [s]
       (assoc s
              :pin-separator-overlay-selected-id id
              :pin-separator-overlay-draft-label (:label row "")
              :pin-separator-overlay-editing-id id)))))

(defn add-group! []
  (let [s @app-state/!state
        draft (str/trim (:pin-separator-overlay-draft-label s ""))]
    (when (and (nil? (:pin-separator-overlay-editing-id s))
               (not (str/blank? draft)))
      (let [next-rows (conj (vec (:pin-separator-overlay-rows s []))
                            {:id (storage/new-pin-id) :label draft :new? true})]
        (persist-overlay-rows! next-rows)))))

(defn confirm-group-edit! []
  (let [s @app-state/!state
        editing-id (:pin-separator-overlay-editing-id s)
        draft (str/trim (:pin-separator-overlay-draft-label s ""))]
    (when (and editing-id (not (str/blank? draft)))
      (let [next-rows (mapv (fn [row]
                              (if (= editing-id (:id row))
                                (assoc row :label draft)
                                row))
                            (:pin-separator-overlay-rows s []))]
        (persist-overlay-rows! next-rows)))))

(defn delete-group-row! [id]
  (let [overlay-rows (vec (remove #(= id (:id %))
                                  (:pin-separator-overlay-rows @app-state/!state [])))]
    (persist-overlay-rows! overlay-rows)))

(defn reorder-group-row! [drag-id to-index]
  (let [s @app-state/!state
        overlay-rows (vec (:pin-separator-overlay-rows s []))
        from-index (first (keep-indexed (fn [idx row]
                                          (when (= drag-id (:id row)) idx))
                                        overlay-rows))]
    (when (and (some? from-index) (some? to-index))
      (when-let [next-rows (rows/move-item-to-index overlay-rows from-index to-index)]
        (persist-overlay-rows! next-rows)))))
