(ns placesurfer.web-app.home-search
  "Photon place search for the home map — zooms to the selected location."
  (:require [clojure.string :as str]
            [placesurfer.app-ui.interface.effects :as effects]
            [placesurfer.app-ui.interface.state :as app-state]
            [placesurfer.map-ui.interface :as map-ui]
            [placesurfer.pin-ui.interface.photon :as photon]
            [placesurfer.pin-ui.interface.search :as search-pure]))

(def ^:private search-debounce-ms 400)

(defonce !search-request-id (atom 0))
(defonce !search-timeout (atom nil))

(defn clear-home-search-ui [s]
  (assoc s
         :home-search-query ""
         :home-search-results []
         :home-search-highlight-index nil
         :home-search-loading? false))

(defn- finish-search! [request-id results]
  (when (= request-id @!search-request-id)
    (swap! app-state/!state assoc
           :home-search-results results
           :home-search-loading? false
           :home-search-highlight-index (search-pure/highlight-index-for-results results))
    (effects/render!)))

(defn- run-photon-search! [query]
  (let [request-id (swap! !search-request-id inc)
        trimmed (str/trim query)]
    (if (< (count trimmed) photon/min-search-chars)
      (finish-search! request-id [])
      (do
        (swap! app-state/!state assoc :home-search-loading? true)
        (effects/render!)
        (let [{:keys [countries country-slug]} @app-state/!state
              url (photon/build-search-url trimmed 8
                                           {:countries countries
                                            :country-slug country-slug})]
          (-> (js/fetch url)
              (.then (fn [resp]
                       (when (= request-id @!search-request-id)
                         (if (.-ok resp)
                           (-> (.json resp)
                               (.then (fn [body]
                                        (finish-search! request-id
                                                        (photon/parse-response body))))
                               (.catch (fn [_] (finish-search! request-id []))))
                           (finish-search! request-id [])))))
              (.catch (fn [_] (finish-search! request-id [])))))))))

(defn set-home-search-query! [query]
  (swap! app-state/!state assoc
         :home-search-query query
         :home-search-highlight-index nil)
  (when-let [t @!search-timeout] (js/clearTimeout t))
  (reset! !search-timeout
          (js/setTimeout #(run-photon-search!
                           (:home-search-query @app-state/!state))
                         search-debounce-ms))
  (effects/render!))

(defn- set-highlight-index! [idx]
  (swap! app-state/!state assoc :home-search-highlight-index idx)
  (effects/render!))

(defn select-home-search-result! [result]
  (swap! app-state/!state clear-home-search-ui)
  (effects/render!)
  (map-ui/center-on-position! {:longitude (:longitude result)
                                :latitude (:latitude result)
                                :zoom 12
                                :animate? true}))

(defn- home-search-enter! []
  (let [{:keys [home-search-results home-search-highlight-index]} @app-state/!state
        action (search-pure/enter-action home-search-results nil
                                          home-search-highlight-index)]
    (when (vector? action)
      (when-let [result (search-pure/highlighted-result home-search-results
                                                         (second action))]
        (select-home-search-result! result)))))

(defn home-search-keydown! [^js e]
  (let [{:keys [home-search-results home-search-highlight-index]} @app-state/!state
        n (count home-search-results)
        key (.-key e)]
    (cond
      (= "ArrowDown" key)
      (when (pos? n)
        (.preventDefault e)
        (set-highlight-index!
         (search-pure/step-highlight-index home-search-highlight-index n 1)))

      (= "ArrowUp" key)
      (when (pos? n)
        (.preventDefault e)
        (set-highlight-index!
         (search-pure/step-highlight-index home-search-highlight-index n -1)))

      (search-pure/enter-key? e)
      (do
        (.preventDefault e)
        (.stopPropagation e)
        (home-search-enter!))

      :else nil)))
