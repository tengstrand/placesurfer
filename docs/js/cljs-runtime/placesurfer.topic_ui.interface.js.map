(ns placesurfer.topic-ui.interface
  (:require [placesurfer.topic-ui.definitions :as definitions]
            [placesurfer.topic-ui.pages :as pages]
            [placesurfer.topic-ui.panel :as panel]
            [placesurfer.topic-ui.rows :as rows]
            [placesurfer.topic-ui.selection :as selection]
            [placesurfer.topic-ui.toggle :as toggle]))

(defn definitions
  "Topic definition maps from sorted keys and lookup functions."
  [topic-keys label-fn marker-url-fn]
  (definitions/from-keys topic-keys label-fn marker-url-fn))

(defn rows
  "Topic panel/nav row props from active and loading topic sets plus definitions."
  [active-topics loading-topics topic-definitions]
  (rows/for-topics active-topics loading-topics topic-definitions))

(defn single-active
  "When exactly one topic is active, return it; otherwise nil."
  [active-topics]
  (selection/single-active active-topics))

(defn update-invalid?
  "Update page requires exactly one active topic."
  [active-topics]
  (selection/update-invalid? active-topics))

(defn nav-tab-row
  [topic-rows]
  (selection/nav-tab-row topic-rows))

(defn panel
  "Topic sidebar panel Hiccup."
  [props]
  (panel/panel props))

(defn nav-tab
  "Topic nav tab Hiccup."
  [topic-rows active-page]
  (panel/nav-tab topic-rows active-page))

(defn topic-page?
  [page]
  (pages/topic-page? page))

(defn toggle-plan
  [active-topics topic]
  (toggle/toggle-plan active-topics topic))
