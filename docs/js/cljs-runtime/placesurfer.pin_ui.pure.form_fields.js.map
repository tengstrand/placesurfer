(ns placesurfer.pin-ui.pure.form-fields
  (:require [placesurfer.html.interface.description-field :as description-field]
            [placesurfer.pin-ui.pure.forms :as forms]
            [placesurfer.pin-ui.pure.group-field :as group-field]))

(defn- name-row [place-name set-pin-name! t]
  [:div.update-field-row
   [:label.update-label {:for "pin-name"} (t :common/name)]
   [:div.update-field-control
    [:input#pin-name.update-input
     {:type "text"
      :value (forms/coerce-text place-name)
      :on {:input (fn [e] (set-pin-name! (.. e -target -value)))}}]]])

(defn- address-row [address set-pin-address! t]
  [:div.update-field-row
   [:label.update-label {:for "pin-address"} (t :common/address)]
   [:div.update-field-control
    [:input#pin-address.update-input
     {:type "text"
      :value (forms/coerce-text address)
      :on {:input (fn [e] (set-pin-address! (.. e -target -value)))}}]]])

(defn- close-icon-dropdown! [e]
  (when-let [details (.closest (.-target e) "details")]
    (.removeAttribute details "open")))

(defn- icon-dropdown-option [filename selected? set-pin-icon!]
  [:button {:type "button"
            :class (if selected?
                     "pin-icon-dropdown-option pin-icon-dropdown-option--selected"
                     "pin-icon-dropdown-option")
            :aria-label filename
            :on {:click (fn [e]
                          (.preventDefault e)
                          (set-pin-icon! filename)
                          (close-icon-dropdown! e))}}
   [:img {:src (forms/icon-url filename) :alt ""}]])

(defn- icon-row [icon set-pin-icon! t]
  (let [selected-icon (forms/normalize-icon icon)]
    [:div.update-field-row
     [:label.update-label (t :pin/icon)]
     [:div.update-field-control
      [:details.pin-icon-dropdown
       [:summary.pin-icon-dropdown-trigger
        [:img {:src (forms/icon-url selected-icon) :alt ""}]]
       [:div.pin-icon-dropdown-menu
        (for [filename (forms/icon-options)]
          ^{:key filename}
          (icon-dropdown-option filename (= filename selected-icon) set-pin-icon!))]]]]))

(defn- longitude-row [longitude set-pin-longitude! commit-pin-longitude! t]
  [:div.update-field-row
   [:label.update-label {:for "pin-longitude"} (t :common/longitude)]
   [:div.update-field-control
    [:input#pin-longitude.update-input
     {:type "text"
      :inputmode "decimal"
      :value (forms/coerce-text longitude)
      :on {:input (fn [e] (set-pin-longitude! (.. e -target -value)))
           :blur (fn [e] (commit-pin-longitude! (.. e -target -value)))}}]]])

(defn- latitude-row [latitude set-pin-latitude! commit-pin-latitude! t]
  [:div.update-field-row
   [:label.update-label {:for "pin-latitude"} (t :common/latitude)]
   [:div.update-field-control
    [:input#pin-latitude.update-input
     {:type "text"
      :inputmode "decimal"
      :value (forms/coerce-text latitude)
      :on {:input (fn [e] (set-pin-latitude! (.. e -target -value)))
           :blur (fn [e] (commit-pin-latitude! (.. e -target -value)))}}]]])

(defn- url-row [url set-pin-url! t]
  [:div.update-field-row
   [:label.update-label {:for "pin-url"} (t :common/url)]
   [:div.update-field-control
    [:input#pin-url.update-input
     {:type "text"
      :value (forms/coerce-text url)
      :on {:input (fn [e] (set-pin-url! (.. e -target -value)))}}]]])

(defn- image-row [image set-pin-image! t]
  [:div.update-field-row
   [:label.update-label {:for "pin-image"} (t :pin/image-url)]
   [:div.update-field-control
    [:input#pin-image.update-input
     {:type "text"
      :value (forms/coerce-text image)
      :on {:input (fn [e] (set-pin-image! (.. e -target -value)))}}]]])

(defn- agent-url-row [agent-url set-pin-agent-url! t]
  [:div.update-field-row
   [:label.update-label {:for "pin-agent-url"} (t :pin/agent-url)]
   [:div.update-field-control
    [:input#pin-agent-url.update-input
     {:type "text"
      :value (forms/coerce-text agent-url)
      :on {:input (fn [e] (set-pin-agent-url! (.. e -target -value)))}}]]])

(defn- description-row [props]
  (let [{:keys [description description-edit-mode description-sync-token
                set-pin-description! toggle-description-edit-mode! t]} props]
    (description-field/description-field
     {:id "pin-description"
      :description description
      :mode description-edit-mode
      :sync-token description-sync-token
      :set-description! set-pin-description!
      :toggle-mode! toggle-description-edit-mode!
      :t t})))

(defn field-rows
  [props]
  (let [{:keys [pin-form
                pin-items
                pin-selected-id
                pin-editor-mode
                description-edit-mode
                description-sync-token
                show-pin-group-field?
                pin-group-id
                pin-group-options
                set-pin-name!
                set-pin-address!
                set-pin-group!
                set-pin-icon!
                set-pin-longitude!
                commit-pin-longitude!
                set-pin-latitude!
                commit-pin-latitude!
                set-pin-url!
                set-pin-image!
                set-pin-agent-url!
                set-pin-description!
                toggle-description-edit-mode!
                t]
         :or {t (fn [k] (name k))}} props]
    (let [{:keys [longitude latitude url image agent-url description address icon]} pin-form
          place-name (:name pin-form)
          selected-icon (forms/normalize-icon icon)
          new-mode? (= :new pin-editor-mode)
          group-label (if pin-group-id
                        (or (:label (first (filter #(= pin-group-id (:id %)) pin-group-options)))
                            "-")
                        "-")]
      (remove nil?
              [(name-row place-name set-pin-name! t)
               (address-row address set-pin-address! t)
               (when (and show-pin-group-field? set-pin-group!)
                 (group-field/group-row {:group-id pin-group-id
                                         :group-options pin-group-options
                                         :selected-label group-label
                                         :set-pin-group! set-pin-group!
                                         :t t}))
               (icon-row selected-icon set-pin-icon! t)
               (longitude-row longitude set-pin-longitude! commit-pin-longitude! t)
               (latitude-row latitude set-pin-latitude! commit-pin-latitude! t)
               (when new-mode? (url-row url set-pin-url! t))
               (image-row image set-pin-image! t)
               (agent-url-row agent-url set-pin-agent-url! t)
               (description-row (assoc props
                                       :description description
                                       :t t))]))))
