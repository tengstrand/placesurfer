(ns placesurfer.pin-ui.pure.form-fields
  (:require [clojure.string :as str]
            [placesurfer.html.interface.description-field :as description-field]
            [placesurfer.pin-ui.pure.forms :as forms]
            [placesurfer.pin-ui.pure.group-field :as group-field]))

(defn- name-row [place-name set-pin-name! t]
  [:div.update-field-row
   [:label.update-label {:for "pin-name"} (t :common/name)]
   [:div.update-field-control
    [:input#pin-name.update-input
     {:type "text"
      :value (forms/coerce-text place-name)
      :on {:input (fn [e] (set-pin-name! (.. e -target -value)))}}]]])

(defn- location-row [location set-pin-address! t]
  [:div.update-field-row
   [:label.update-label {:for "pin-address"} (t :common/location)]
   [:div.update-field-control
    [:input#pin-address.update-input
     {:type "text"
      :value (forms/coerce-text location)
      :on {:input (fn [e] (set-pin-address! (.. e -target -value)))}}]]])

(defn- close-dropdown! [e]
  (when-let [details (.closest (.-target e) "details")]
    (.removeAttribute details "open")))

(defn- close-icon-dropdown! [e] (close-dropdown! e))

(defn- icon-dropdown-option [filename selected? set-pin-icon!]
  [:button {:type "button"
            :class (if selected?
                     "pin-icon-dropdown-option pin-icon-dropdown-option--selected"
                     "pin-icon-dropdown-option")
            :aria-label filename
            :on {:click (fn [e]
                          (.preventDefault e)
                          (set-pin-icon! filename)
                          (close-icon-dropdown! e))}}
   [:img {:src (forms/icon-url filename) :alt ""}]])

(defn- stars-dropdown-option [filename selected? set-pin-stars!]
  [:button {:type "button"
            :class (if selected?
                     "pin-stars-dropdown-option pin-stars-dropdown-option--selected"
                     "pin-stars-dropdown-option")
            :aria-label filename
            :on {:click (fn [e]
                          (.preventDefault e)
                          (set-pin-stars! filename)
                          (close-dropdown! e))}}
   [:img {:src (forms/stars-url filename) :alt ""}]])

(defn- icon-and-radii-row [icon set-pin-icon! ranking set-pin-stars! radii set-pin-radii! t]
  (let [selected-icon  (forms/normalize-icon icon)
        selected-ranking (forms/normalize-stars ranking)
        radii-str      (forms/coerce-text radii)
        radii-invalid? (and (seq (str/trim radii-str))
                            (not (forms/radii-valid? radii-str)))]
    [:div.update-field-row
     [:label.update-label (t :pin/icon)]
     [:div.update-field-control
      {:style {:flex-direction "row" :align-items "center" :gap "0.5rem" :position "relative"}}
      [:div {:style {:flex "0 0 auto"}}
       [:details.pin-icon-dropdown
        {:style {:width "auto" :position "static"}}
        [:summary.pin-icon-dropdown-trigger
         [:img {:src (forms/icon-url selected-icon) :alt ""}]]
        [:div.pin-icon-dropdown-menu
         {:style {:position "absolute" :left "0" :right "0" :z-index "100" :top "100%"}}
         (for [filename (forms/icon-options)]
           ^{:key filename}
           (icon-dropdown-option filename (= filename selected-icon) set-pin-icon!))]]]
      [:label.update-label {:style {:white-space "nowrap" :margin-left "2ch"}} (t :pin/ranking)]
      [:div {:style {:flex "0 0 auto" :position "relative"}}
       [:details.pin-stars-dropdown
        {:style {:position "static"}}
        [:summary.pin-stars-dropdown-trigger
         [:img {:src (forms/stars-url selected-ranking) :alt ""}]]
        [:div.pin-stars-dropdown-menu
         {:style {:position "absolute" :left "0" :z-index "200" :top "100%"}}
         (for [filename forms/stars-options]
           ^{:key filename}
           (stars-dropdown-option filename (= filename selected-ranking) set-pin-stars!))]]]
      [:label.update-label {:for "pin-radii" :style {:white-space "nowrap" :margin-left "2ch"}} (t :pin/radii)]
      [:input#pin-radii.update-input
       {:type "text"
        :class (when radii-invalid? "update-input--invalid")
        :value radii-str
        :style {:flex "1" :min-width "0"}
        :on {:input (fn [e] (set-pin-radii! (.. e -target -value)))}}]]]))

(defn- coords-row [longitude latitude set-pin-longitude! commit-pin-longitude!
                   set-pin-latitude! commit-pin-latitude! t]
  [:div.update-field-row
   [:label.update-label {:for "pin-longitude"} (t :common/longitude)]
   [:div.update-field-control
    {:style {:flex-direction "row" :align-items "center" :gap "0.5rem"}}
    [:input#pin-longitude.update-input
     {:type "text"
      :inputmode "decimal"
      :value (forms/coerce-text longitude)
      :style {:flex "1" :min-width "0"}
      :on {:input (fn [e] (set-pin-longitude! (.. e -target -value)))
           :blur (fn [e] (commit-pin-longitude! (.. e -target -value)))}}]
    [:label.update-label {:for "pin-latitude" :style {:margin-left "2rem" :white-space "nowrap"}} (t :common/latitude)]
    [:input#pin-latitude.update-input
     {:type "text"
      :inputmode "decimal"
      :value (forms/coerce-text latitude)
      :style {:flex "1" :min-width "0"}
      :on {:input (fn [e] (set-pin-latitude! (.. e -target -value)))
           :blur (fn [e] (commit-pin-latitude! (.. e -target -value)))}}]]])

(defn- source-icon-url [url]
  (when (seq url)
    (cond
      (str/includes? url "boneo")  "/images/boneo.png"
      (str/includes? url "hemnet") "/images/hemnet.png"
      (str/includes? url "google") "/images/google-maps.png"
      :else nil)))

(defn- field-link-control [input extra-link]
  [:div {:class (str "update-field-control" (when extra-link " update-field-control--with-link"))}
   input
   extra-link])

(defn- url-row [url set-pin-url! t]
  (let [icon (source-icon-url url)]
    [:div.update-field-row
     [:label.update-label {:for "pin-url"} (t :common/source)]
     (field-link-control
      [:input#pin-url.update-input
       {:type "text"
        :value (forms/coerce-text url)
        :on {:input (fn [e] (set-pin-url! (.. e -target -value)))}}]
      (when icon
        [:a.pin-field-link {:href url :target "_blank" :rel "noopener noreferrer"}
         [:img.pin-field-link-icon {:src icon :alt ""}]]))]))

(defn- image-row [image set-pin-image! t]
  [:div.update-field-row
   [:label.update-label {:for "pin-image"} (t :pin/image-url)]
   (field-link-control
    [:input#pin-image.update-input
     {:type "text"
      :value (forms/coerce-text image)
      :on {:input (fn [e] (set-pin-image! (.. e -target -value)))}}]
    (when (seq image)
      [:a.pin-field-link.pin-field-link--preview {:href image :target "_blank" :rel "noopener noreferrer"}
       [:img.pin-field-link-preview {:src image :alt ""}]]))])

(defn- agent-url-row [agent-url set-pin-agent-url! agent-name set-pin-agent-name! t]
  [:div.update-field-row
   [:label.update-label {:for "pin-agent-url"} (t :pin/agent-url)]
   [:div.update-field-control
    {:style {:flex-direction "row" :align-items "center" :gap "0.5rem"}}
    [:input#pin-agent-url.update-input
     {:type "text"
      :value (forms/coerce-text agent-url)
      :style {:flex "2" :min-width "0"}
      :on {:input (fn [e] (set-pin-agent-url! (.. e -target -value)))}}]
    [:label.update-label {:for "pin-agent-name" :style {:white-space "nowrap"}} (t :common/name)]
    [:input#pin-agent-name.update-input
     {:type "text"
      :value (forms/coerce-text agent-name)
      :style {:flex "1" :min-width "0"}
      :on {:input (fn [e] (set-pin-agent-name! (.. e -target -value)))}}]
    (when (seq agent-url)
      [:a.pin-field-link {:href agent-url :target "_blank" :rel "noopener noreferrer"}
       [:img.pin-field-link-icon {:src "/images/agent.png" :alt ""}]])]])

(defn- description-row [props]
  (let [{:keys [description description-edit-mode description-sync-token
                set-pin-description! toggle-description-edit-mode! t]} props]
    (description-field/description-field
     {:id "pin-description"
      :description description
      :mode description-edit-mode
      :sync-token description-sync-token
      :set-description! set-pin-description!
      :toggle-mode! toggle-description-edit-mode!
      :t t})))

(defn field-rows
  [props]
  (let [{:keys [pin-form
                pin-items
                pin-selected-id
                pin-editor-mode
                description-edit-mode
                description-sync-token
                show-pin-group-field?
                pin-group-id
                pin-group-options
                set-pin-name!
                set-pin-address!
                set-pin-group!
                set-pin-icon!
                set-pin-stars!
                set-pin-radii!
                set-pin-longitude!
                commit-pin-longitude!
                set-pin-latitude!
                commit-pin-latitude!
                set-pin-url!
                set-pin-image!
                set-pin-agent-url!
                set-pin-agent-name!
                set-pin-description!
                toggle-description-edit-mode!
                t]
         :or {t (fn [k] (name k))}} props]
    (let [{:keys [longitude latitude url image agent-url agent-name description location icon ranking radii]} pin-form
          place-name (:name pin-form)
          selected-icon (forms/normalize-icon icon)
          group-label (if pin-group-id
                        (or (:label (first (filter #(= pin-group-id (:id %)) pin-group-options)))
                            "-")
                        "-")]
      (remove nil?
              [(name-row place-name set-pin-name! t)
               (location-row location set-pin-address! t)
               (when (and show-pin-group-field? set-pin-group!)
                 (group-field/group-row {:group-id pin-group-id
                                         :group-options pin-group-options
                                         :selected-label group-label
                                         :set-pin-group! set-pin-group!
                                         :t t}))
               (icon-and-radii-row selected-icon set-pin-icon! ranking set-pin-stars! radii set-pin-radii! t)
               (coords-row longitude latitude
                           set-pin-longitude! commit-pin-longitude!
                           set-pin-latitude! commit-pin-latitude! t)
               (url-row url set-pin-url! t)
               (image-row image set-pin-image! t)
               (agent-url-row agent-url set-pin-agent-url! agent-name set-pin-agent-name! t)
               (description-row (assoc props
                                       :description description
                                       :t t))]))))
