(ns placesurfer.edit.handlers.form
  (:require [clojure.string :as str]
            [placesurfer.edit.interface.baseline :as edit-ui.baseline]
            [placesurfer.edit.interface.coords :as edit-ui.coords]
            [placesurfer.edit.interface.model :as edit-ui.model]
            [placesurfer.edit.interface.forms :as edit-ui.forms]
            [placesurfer.edit.interface.match :as edit-ui.match]
            [placesurfer.edit.interface.rows :as edit-ui.rows]
            [placesurfer.googlestreetmap.interface :as googlestreetmap]
            [placesurfer.api-client.interface :as api-client]
            [placesurfer.app-ui.interface.effects :as effects]
            [placesurfer.app-ui.interface.state :as state]
            [placesurfer.edit.handlers.description-trace :as description-trace]
            [placesurfer.edit.handlers.map :as update-map]
            [placesurfer.edit.handlers.rows :as update-rows]
            [placesurfer.edit.handlers.save :as update-save]
            [placesurfer.edit.handlers.set-topic :as update-set-topic]
            [placesurfer.edit.handlers.description-sync :as description-sync]
            [placesurfer.pin-ui.interface.forms :as pin-forms]))

(def ^:private invalid-google-maps-url-error
  "Not a valid Google Maps link")

(defn- valid-update-google-maps-url? [url]
  (let [s (str/trim (str url))]
    (when (seq s)
      (let [coords (googlestreetmap/parse-coordinates url)
            place-name (googlestreetmap/parse-name url)]
        (or (number? (:longitude coords))
            (number? (:latitude coords))
            (state/non-empty-text? place-name)
            (str/includes? s "google.com/maps"))))))

(defn- country-label-for-code [iso countries]
  (or (some (fn [country]
              (when (= iso (:iso country))
                (:label country)))
            countries)
      iso))

(defn update-url-country-mismatch-error [resolved-iso selected-iso countries]
  (str "The pasted country ("
       (country-label-for-code resolved-iso countries)
       ") doesn't match selected country ("
       (country-label-for-code selected-iso countries)
       ")."))

(defn- clear-update-url-draft-state [s]
  (assoc s
         :update-url-form nil
         :update-pending-places
         (vec (remove :url-form (update-rows/as-update-pending-places (:update-pending-places s))))))

(defn update-url-country-mismatch? [selected-country resolved-country]
  (and (edit-ui.model/valid-country-code? selected-country)
       (edit-ui.model/valid-country-code? resolved-country)
       (not= selected-country resolved-country)))

(defn- find-blank-manual-draft-pending-place [s]
  (some (fn [place]
          (when (edit-ui.rows/blank-manual-draft-pending-place? place)
            place))
        (update-rows/as-update-pending-places (:update-pending-places s))))

(defn- next-pending-row-id! []
  (swap! state/!update-pending-id-seq dec))

(defn ensure-empty-draft-update-row! []
  (state/clear-update-status!)
  (swap! state/!state
         (fn [s]
           (let [existing (find-blank-manual-draft-pending-place s)
                 place (if existing
                         (edit-ui.rows/blank-empty-draft-pending-place existing)
                         {:pending-id (next-pending-row-id!)
                          :name ""
                          :location ""
                          :description ""
                          :source :manual
                          :action :added})
                 places (if existing
                          (mapv #(if (= (:pending-id place) (:pending-id %))
                                   place
                                   %)
                                (update-rows/as-update-pending-places (:update-pending-places s)))
                          (conj (vec (update-rows/as-update-pending-places (:update-pending-places s)))
                                place))
                 form (state/default-update-form)
                 row (edit-ui.rows/pending-place->row place)
                 errors (edit-ui.forms/compute-update-form-field-errors form true)]
             (-> (assoc s
                        :update-url-form nil
                        :update-pending-places places
                        :update-form form
                        :update-selected-row-id (:pending-id place)
                        :update-selected-row row
                        :update-row-baseline (edit-ui.baseline/row->form-baseline row)
                        :update-sort {:field nil :dir :asc}
                        :update-form-field-errors errors
                        :update-form-reset-token (inc (or (:update-form-reset-token s) 0)))
                 state/bump-description-sync-token))))
  (effects/render!)
  (update-map/schedule-update-map-pin-sync!))

(defn flush-update-description-from-dom! []
  (description-sync/flush-update-description-from-dom!))

(defn description-editor-differs-from-baseline? [s]
  (description-sync/description-editor-differs-from-baseline? s))

(defn set-update-form!
  ([k v] (set-update-form! k v {:sync-display? true}))
  ([k v {:keys [sync-display?] :or {sync-display? true}}]
   (let [form-before (when (= k :description) (:description (:update-form @state/!state)))]
     (when (= k :description)
       (description-trace/trace! :set-update-form {:form-description-before form-before}))
     (state/clear-update-status!)
     (swap! state/!state
            (fn [s]
              (let [form (assoc-in (:update-form s) [k] v)
                    s (-> s
                          (assoc :update-form form)
                          (update-rows/select-or-create-empty-draft-state))
                    errors (update-rows/compute-update-form-field-errors-for-state s)
                    s (assoc s :update-form-field-errors errors)]
                (if sync-display?
                  (update-rows/sync-form-into-selected-row s)
                  s))))
     (when (= k :description)
       (description-trace/trace! :set-update-form-after))
     (effects/render!)
     (when (and (= :update (:page @state/!state)) sync-display? (not= k :description))
       (update-map/sync-update-map!)))))

(defn clear-update-form! []
  (state/clear-update-status!)
  (swap! state/!state
         (fn [s]
           (-> s
               state/clear-update-selection-state
               (update :update-form-reset-token (fnil inc 0)))))
  (effects/render!)
  (update-map/schedule-update-map-pin-sync!))

(defn apply-parsed-update-url! [s {:keys [trimmed coords place-name url-has-coords? autofilled?]}]
  (let [lon (:longitude coords)
        lat (:latitude coords)
        saved-rows (update-rows/as-update-rows (:update-rows s))
        exact-saved-row (when (and url-has-coords? (number? lon) (number? lat))
                          (edit-ui.match/find-saved-row-by-exact-coords saved-rows lon lat))
        name-only-saved-row (when (and url-has-coords? (state/non-empty-text? place-name)
                                       (not exact-saved-row))
                              (edit-ui.match/find-saved-row-by-name-without-coords
                               saved-rows place-name))
        target-saved-row (or exact-saved-row name-only-saved-row)
        next-form (cond-> (-> (:update-form s)
                              (assoc :google-url (if autofilled? "" trimmed))
                              (assoc :source (if (and target-saved-row
                                                      (edit-ui.rows/row-source-set? target-saved-row))
                                               (:source target-saved-row)
                                               :manual)))
                    target-saved-row
                    (assoc :name (edit-ui.baseline/coerce-form-text (:name target-saved-row))
                           :location (edit-ui.baseline/coerce-form-text (:location target-saved-row))
                           :homepage (edit-ui.baseline/coerce-form-text (:homepage target-saved-row))
                           :description (edit-ui.baseline/coerce-form-text (:description target-saved-row)))
                    (and (state/non-empty-text? place-name) (not target-saved-row))
                    (assoc :name place-name)
                    url-has-coords? (assoc :longitude (str lon))
                    url-has-coords? (assoc :latitude (str lat))
                    url-has-coords? (assoc :location "")
                    (not url-has-coords?) (assoc :homepage ""))
        s (-> (assoc s :update-form next-form)
              (assoc :update-form-field-errors
                     (update-rows/compute-update-form-field-errors-for-state
                      (assoc s :update-form next-form)))
              (cond-> url-has-coords?
                (assoc :update-url-form
                       (if target-saved-row
                         (dissoc next-form :google-url)
                         (assoc (dissoc next-form :google-url) :source :manual)))))]
    (update-rows/sync-form-into-selected-row
     (if target-saved-row
       (update-rows/select-update-display-row s (:row-id target-saved-row) target-saved-row)
       s))))

(defn- apply-resolved-location! [location]
  (when location
    (swap! state/!state
           (fn [s]
             (cond-> (assoc-in s [:update-form :location] location)
               (:update-url-form s)
               (assoc-in [:update-url-form :location] location))))))

(defn resolve-update-location-from-coordinates!
  ([longitude latitude]
   (resolve-update-location-from-coordinates! longitude latitude {}))
  ([longitude latitude {:keys [on-country-match on-country-mismatch url-paste?]
                        :or {url-paste? false}}]
   (let [request-id (swap! state/!resolve-location-request-id inc)
         selected-country (:update-country-code @state/!state)]
     (-> (js/fetch (api-client/resolve-location-url)
                   (clj->js {:method "POST"
                             :headers {"Content-Type" "application/json"}
                             :body (.stringify js/JSON
                                               (clj->js {:longitude longitude
                                                         :latitude latitude}))}))
         (.then (fn [resp]
                  (-> (.json resp)
                      (.then (fn [body]
                               (when (= request-id @state/!resolve-location-request-id)
                                 (if (.-ok resp)
                                   (let [resolved-country (some-> (state/non-empty-js-string? (aget body "country-code"))
                                                                  state/normalize-country-code)
                                         location (state/non-empty-js-string? (aget body "location"))
                                         city (state/non-empty-js-string? (aget body "city"))]
                                     (if (update-url-country-mismatch? selected-country resolved-country)
                                       (cond
                                         on-country-mismatch
                                         (on-country-mismatch resolved-country)

                                         url-paste?
                                         (do
                                           (swap! state/!state
                                                  (fn [s]
                                                    (-> s
                                                        (assoc :update-error
                                                               (update-url-country-mismatch-error
                                                                resolved-country
                                                                selected-country
                                                                (:countries s)))
                                                        clear-update-url-draft-state)))
                                           (update-map/schedule-update-map-pin-sync!))

                                         :else
                                         (apply-resolved-location! location))
                                       (cond
                                         on-country-match
                                         (on-country-match resolved-country location city)

                                         url-paste?
                                         (do
                                           (apply-resolved-location! location)
                                           (when (and resolved-country
                                                      (not= selected-country resolved-country))
                                             (swap! state/!state assoc :update-country-code resolved-country))
                                           (update-save/reload-update-dataset!))

                                         :else
                                         (apply-resolved-location! location))))
                                   (swap! state/!state assoc
                                          :update-error (or (state/update-error-text (aget body "error"))
                                                            "Could not resolve location from URL")))
                                 (effects/render!)))))))
         (.catch (fn [_]
                   (when (= request-id @state/!resolve-location-request-id)
                     (swap! state/!state assoc :update-error "Could not resolve location from URL")
                     (effects/render!))))))))

(defn set-update-url! [url]
  (when (seq (str/trim (str url)))
    (state/clear-update-status!)
    (let [trimmed (str/trim (str url))
          valid? (boolean (valid-update-google-maps-url? url))
          on-update? (= :update (:page @state/!state))
          coords (when valid? (googlestreetmap/parse-coordinates url))
          place-name (when valid? (googlestreetmap/parse-name url))
          url-has-coords? (and (number? (:longitude coords))
                               (number? (:latitude coords)))
          autofilled? (when valid?
                        (or (state/non-empty-text? place-name)
                            url-has-coords?
                            (str/includes? trimmed "google.com/maps/place")))
          parsed-payload {:trimmed trimmed
                          :coords coords
                          :place-name place-name
                          :url-has-coords? url-has-coords?
                          :autofilled? autofilled?}
          defer-country-check? (and on-update?
                                    (edit-ui.model/valid-country-code? (:update-country-code @state/!state))
                                    valid?
                                    url-has-coords?)]
      (cond
        (not valid?)
        (do
          (swap! state/!state
                 (fn [s]
                   (-> s
                       (assoc-in [:update-form :google-url] trimmed)
                       (assoc :update-error invalid-google-maps-url-error
                              :update-url-form nil))))
          (if on-update?
            (effects/render!)
            (effects/navigate! :update)))

        defer-country-check?
        (resolve-update-location-from-coordinates!
         (:longitude coords) (:latitude coords)
         {:on-country-mismatch
          (fn [resolved-country]
            (swap! state/!state
                   (fn [s]
                     (assoc s :update-error
                            (update-url-country-mismatch-error
                             resolved-country
                             (:update-country-code s)
                             (:countries s))))))
          :on-country-match
          (fn [_resolved-country location _city]
            (swap! state/!state
                   (fn [s]
                     (let [s (apply-parsed-update-url! s parsed-payload)]
                       (cond-> s
                         location (assoc-in [:update-form :location] location)
                         (and location (:update-url-form s))
                         (assoc-in [:update-url-form :location] location)))))
            (update-map/refresh-update-pending-places! true)
            (update-save/reload-update-dataset!))})

        :else
        (do
          (swap! state/!state #(apply-parsed-update-url! % parsed-payload))
          (when url-has-coords?
            (update-map/refresh-update-pending-places! true))
          (if on-update?
            (do
              (when url-has-coords?
                (resolve-update-location-from-coordinates!
                 (:longitude coords) (:latitude coords)
                 {:url-paste? true}))
              (when-not url-has-coords?
                (effects/render!)))
            (do
              (effects/navigate! :update)
              (when url-has-coords?
                (resolve-update-location-from-coordinates!
                 (:longitude coords) (:latitude coords)
                 {:url-paste? true})))))))))

(defn set-update-source! [source]
  (set-update-form! :source (when (seq (str/trim (str source)))
                              (keyword source))))

(defn set-update-topic! [topic]
  (update-set-topic/set-update-topic! topic))

(defn set-update-country! [country-code]
  (state/clear-update-status!)
  (update-save/save-current-update-dataset-to-cache-if-clean!)
  (swap! state/!state
         (fn [s]
           (-> s
               (assoc :update-country-code (state/normalize-country-code country-code))
               state/clear-update-selection-state)))
  (effects/render!)
  (update-save/reload-update-dataset! {:clear-selection? true
                                       :reset-client-actions? true})
  (update-map/schedule-update-map-pin-sync!))

(defn- clipboard-read-available? []
  (boolean (when-let [cb (and js/navigator (.-clipboard js/navigator))]
             (.-readText cb))))

(defn- clipboard-write-available? []
  (boolean (when-let [cb (and js/navigator (.-clipboard js/navigator))]
             (.-writeText cb))))

(defn- clear-update-clipboard-after-paste! []
  (when (clipboard-write-available?)
    (-> (.writeText js/navigator.clipboard "")
        (.catch (fn [_] nil)))))

(defn apply-pasted-decimal-coordinates!
  "Set update form longitude/latitude from decimal degrees."
  [longitude latitude]
  (state/clear-update-status!)
  (swap! state/!state
         (fn [s]
           (let [form (-> (:update-form s)
                          (assoc :longitude (str longitude)
                                 :latitude (str latitude)))
                 s (-> s
                       (assoc :update-form form)
                       (update-rows/select-or-create-empty-draft-state))
                 errors (update-rows/compute-update-form-field-errors-for-state
                         (assoc s :update-form form))]
             (update-rows/sync-form-into-selected-row
              (assoc s :update-form-field-errors errors)))))
  (effects/render!)
  (update-map/sync-update-map!)
  (resolve-update-location-from-coordinates! longitude latitude {}))

(defn try-apply-pasted-coordinate-text!
  "When `text` is a DMS or decimal coordinate pair, set longitude and latitude. Returns true if applied."
  [text]
  (when-let [{:keys [longitude latitude]}
             (edit-ui.coords/parse-pasted-coordinates (str/trim (str text)))]
    (apply-pasted-decimal-coordinates! longitude latitude)
    true))

(defn- apply-clipboard-text-as-new-update-row! [trimmed]
  (cond
    (and (seq trimmed) (valid-update-google-maps-url? trimmed))
    (do
      (set-update-url! trimmed)
      (clear-update-clipboard-after-paste!))

    (try-apply-pasted-coordinate-text! trimmed)
    (clear-update-clipboard-after-paste!)

    :else
    (ensure-empty-draft-update-row!)))

(defn apply-pasted-update-clipboard-text!
  "Apply Maps URL or coordinates from pasted text. Returns true when handled."
  [text]
  (let [trimmed (str/trim (str text))]
    (cond
      (and (seq trimmed) (valid-update-google-maps-url? trimmed))
      (do (set-update-url! trimmed)
          (clear-update-clipboard-after-paste!)
          true)

      (try-apply-pasted-coordinate-text! trimmed)
      (do (clear-update-clipboard-after-paste!)
          true)

      :else false)))

(defn create-new-update-row! []
  (if-not (clipboard-read-available?)
    (ensure-empty-draft-update-row!)
    (-> (.readText js/navigator.clipboard)
        (.then (fn [text]
                 (apply-clipboard-text-as-new-update-row!
                  (str/trim (str text)))))
        (.catch (fn [_]
                  (ensure-empty-draft-update-row!))))))
