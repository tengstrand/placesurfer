(ns placesurfer.clipboard-ui.pure.numbers
  (:require [clojure.string :as str]))

(defn parse-number
  "Parse coordinate-like numbers from strings or numbers."
  [v]
  (cond
    (number? v) v
    (string? v) (let [n (js/parseFloat (str/trim v))]
                  (when-not (js/isNaN n) n))
    :else nil))
