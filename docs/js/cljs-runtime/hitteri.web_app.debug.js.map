(ns hitteri.web-app.debug
  (:require [clojure.string :as str]
            [hitteri.edit.interface.handlers.description-trace :as description-trace]
            [hitteri.edit.interface.sources :as edit-ui.sources]
            [hitteri.web-app.state :as state]))

(defn publish-debug-status! []
  (let [state @state/!state
        {:keys [status positions country-slug active-topics country-loading?
                update-form update-rows update-selected-row-id]}
        state
        place-count (:count state)
        discgolf-n (cljs.core/count (filter #(= :discgolf (:topic %)) positions))
        art-n (cljs.core/count (filter #(= :art (:topic %)) positions))
        selected-row (when update-selected-row-id
                       (some #(when (= (:row-id %) update-selected-row-id) %)
                             update-rows))
        first-row-index-with-description
        (first (keep-indexed
                (fn [idx row]
                  (when (seq (str/trim (str (:description row ""))))
                    idx))
                update-rows))]
    (set! (.-hitteriDebug js/window)
          (clj->js (merge
                    {:boot (or (.-hitteriBoot js/window) "unknown")
                     :status status
                     :count place-count
                     :discgolf discgolf-n
                     :art art-n
                     :country country-slug
                     :activeTopics (vec (sort active-topics))
                     :countryLoading country-loading?
                     :updatePendingPlaces (:update-pending-places state)
                     :updateSelectedRowId update-selected-row-id
                     :updateSelectedRowAction (edit-ui.sources/keyword-name-safe (:action selected-row))
                     :updateFormDescription (:description update-form)
                     :updateRowCount (count update-rows)
                     :updateFirstRowIndexWithDescription first-row-index-with-description
                     :updateUrlForm (:update-url-form state)}
                    (description-trace/diagnostics state))
                    {:updateTopic (:update-topic state)
                     :updateTopicSwitchPending (:update-topic-switch-pending state)}))))
