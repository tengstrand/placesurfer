(ns placesurfer.dropbox.pkce
  (:require [clojure.string :as str]))

(defn- bytes->base64url [^js typed-array]
  (let [binary (.apply (.-fromCharCode js/String) nil (js/Array.from typed-array))]
    (-> (js/btoa binary)
        (str/replace "+" "-")
        (str/replace "/" "_")
        (str/replace #"=+$" ""))))

(defn random-bytes-base64url
  "Base64url-encodes n cryptographically random bytes."
  [n]
  (let [arr (js/Uint8Array. n)]
    (.getRandomValues js/crypto arr)
    (bytes->base64url arr)))

(defn generate-code-verifier
  "PKCE code_verifier per RFC 7636: 43-128 chars from the unreserved charset.
   64 random bytes -> 86 base64url chars, well within range."
  []
  (random-bytes-base64url 64))

(defn generate-state []
  (random-bytes-base64url 16))

(defn sha256-base64url
  "Returns a Promise<string> of the base64url SHA-256 digest of s's UTF-8 bytes."
  [s]
  (let [data (.encode (js/TextEncoder.) s)]
    (-> (.digest js/crypto.subtle "SHA-256" data)
        (.then (fn [digest] (bytes->base64url (js/Uint8Array. digest)))))))

(defn code-challenge-from-verifier
  "Promise<string> PKCE code_challenge (S256) for the given verifier."
  [verifier]
  (sha256-base64url verifier))
