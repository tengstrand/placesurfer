(ns placesurfer.pin-ui.interface.photon
  (:require [placesurfer.pin-ui.pure.photon :as photon]))

(defn parse-response [body] (photon/parse-response body))
(def min-search-chars photon/min-search-chars)
(defn build-search-url [& args] (apply photon/build-search-url args))
(defn result-in-current-country? [& args] (apply photon/result-in-current-country? args))
(defn filter-results-for-country [& args] (apply photon/filter-results-for-country args))
