(ns placesurfer.app-ui.effects
  "Startup-wired cross-module calls that break circular namespace deps.

  Prefer direct namespace calls when there is no cycle. Handlers are registered
  once via `init/wire-effects!` and invoked through this namespace.")

(defonce ^:private !handlers (atom {}))

(defn wire!
  [handlers]
  (swap! !handlers merge handlers))

(defn- invoke [k & args]
  (when-let [f (get @!handlers k)]
    (apply f args)))

(defn render! []
  (invoke :render!))

(defn navigate! [& args]
  (apply invoke :navigate! args))

(defn navigate-to-pin! []
  (invoke :navigate-to-pin!))

(defn navigate-to-update! []
  (invoke :navigate-to-update!))

(defn select-country! [& args]
  (apply invoke :select-country! args))

(defn resolve-update-location-from-coordinates! [& args]
  (apply invoke :resolve-update-location-from-coordinates! args))

(defn sync-marker-pick-handler! []
  (invoke :sync-marker-pick-handler!))

(defn reload-update-dataset! [& args]
  (apply invoke :reload-update-dataset! args))

(defn sync-update-map! [& args]
  (apply invoke :sync-update-map! args))

(defn load-topic-positions! [topic]
  (invoke :load-topic-positions! topic))

(defn schedule-update-map-pin-sync! [& args]
  (apply invoke :schedule-update-map-pin-sync! args))

(defn schedule-center-on-position! [& args]
  (apply invoke :schedule-center-on-position! args))

(defn schedule-map-resize! []
  (invoke :schedule-map-resize!))

(defn sync-main-map! [& args]
  (apply invoke :sync-main-map! args))

(defn check-backend! [& args]
  (apply invoke :check-backend! args))

(defn track-page! [& args]
  (apply invoke :track-page! args))

(defn set-update-topic! [& args]
  (apply invoke :set-update-topic! args))

(defn run-in-update-pins-mode! [& args]
  (apply invoke :run-in-update-pins-mode! args))
