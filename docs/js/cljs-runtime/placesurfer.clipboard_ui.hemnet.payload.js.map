(ns placesurfer.clipboard-ui.hemnet.payload
  (:require [placesurfer.clipboard-ui.hemnet.listing :as listing]))

(def payload-type "placesurfer/hemnet-listing")
(def search-results-payload-type "placesurfer/hemnet-search-results")

(defn hemnet-bookmarklet-payload?
  "True when `data` is a Hemnet bookmarklet clipboard payload map."
  [data]
  (and (map? data)
       (= payload-type (:type data))
       (map? (:listing data))))

(defn hemnet-search-results-payload?
  "True when `data` is a Hemnet search-results bookmarklet clipboard payload map."
  [data]
  (and (map? data)
       (= search-results-payload-type (:type data))
       (sequential? (:items data))))

(defn payload->listing
  "Extract normalized listing map (kebab-case keys) from Hemnet bookmarklet payload."
  [payload]
  (when (hemnet-bookmarklet-payload? payload)
    (listing/normalize-listing-payload (:listing payload))))
