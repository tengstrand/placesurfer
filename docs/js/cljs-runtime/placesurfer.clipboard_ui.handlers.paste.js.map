(ns placesurfer.clipboard-ui.handlers.paste
  (:require [placesurfer.app-ui.interface.effects :as effects]
            [placesurfer.app-ui.interface.state :as app-state]
            [placesurfer.clipboard-ui.handlers.apply :as apply-place]
            [placesurfer.clipboard-ui.pure.browser :as browser]
            [placesurfer.clipboard-ui.pure.context :as context]
            [placesurfer.clipboard-ui.pure.payload :as payload]
            [placesurfer.pin-ui.interface.update-context :as update-context]))

(defn apply-place-clipboard-text!
  "When `text` is bookmarklet JSON, apply place data in pin/pins context.
  Returns true when handled."
  [text]
  (if (context/full-place-paste-context? @app-state/!state)
    (if-let [parsed (payload/parse-bookmarklet-text (browser/trimmed-text text))]
      (boolean (apply-place/apply-place-payload! parsed))
      false)
    false))

(defn apply-hemnet-clipboard-text!
  "Backward-compatible alias for apply-place-clipboard-text!."
  [text]
  (apply-place-clipboard-text! text))

(defn- ensure-search-results-context-then!
  "Ensure we're viewing a context that shows Hemnet search results (the pin
   page, or the edit page's Pins topic) before invoking `f` - switching page
   or topic first when we're currently somewhere else."
  [f]
  (let [s @app-state/!state]
    (cond
      (context/pin-page? s) (f)
      (update-context/update-pins-mode? s) (f)
      (update-context/update-page? s) (effects/run-in-update-pins-mode! f)
      :else (do (effects/navigate-to-pin!) (f)))))

(defn apply-search-results-clipboard-text!
  "When `text` is a Hemnet search-results bookmarklet payload, apply it
   regardless of which page/tab is currently active - switching to the pin
   page (or the edit page's Pins topic) first when needed. Returns true when
   handled."
  [text]
  (boolean
   (when-let [parsed (payload/parse-bookmarklet-text (browser/trimmed-text text))]
     (when (payload/hemnet-search-results-payload? parsed)
       (ensure-search-results-context-then! #(apply-place/apply-place-payload! parsed))
       true))))

(defn paste-place-from-clipboard! []
  (browser/read-clipboard-text!
   (fn [text]
     (when (and text (payload/clipboard-hint-valid? text))
       (apply-place-clipboard-text! text)))))
