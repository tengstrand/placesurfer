(ns placesurfer.clipboard-ui.handlers.paste
  (:require [placesurfer.app-ui.interface.state :as app-state]
            [placesurfer.clipboard-ui.handlers.apply :as apply-place]
            [placesurfer.clipboard-ui.pure.browser :as browser]
            [placesurfer.clipboard-ui.pure.context :as context]
            [placesurfer.clipboard-ui.pure.payload :as payload]))

(defn apply-place-clipboard-text!
  "When `text` is bookmarklet JSON, apply place data in pin/pins context.
  Returns true when handled."
  [text]
  (if (context/full-place-paste-context? @app-state/!state)
    (if-let [parsed (payload/parse-bookmarklet-text (browser/trimmed-text text))]
      (boolean (apply-place/apply-place-payload! parsed))
      false)
    false))

(defn apply-hemnet-clipboard-text!
  "Backward-compatible alias for apply-place-clipboard-text!."
  [text]
  (apply-place-clipboard-text! text))

(defn paste-place-from-clipboard! []
  (browser/read-clipboard-text!
   (fn [text]
     (when (and text (payload/clipboard-hint-valid? text))
       (apply-place-clipboard-text! text)))))
