(ns hitteri.group-ui.pure.row)

(defn row
  [{:keys [id label selected? select-group-row! start-group-row-edit! delete-group-row! t]
    :or {t (fn [k] (name k))}}]
  [:div
   {:data-pin-row-id id
    :class (str "group-row update-row update-row--draggable"
                (when selected? " update-row--selected"))
    :on {:click (fn [_] (select-group-row! id))}}
   [:button.group-row-edit-btn
    {:type "button"
     :title (t :pin/edit-title)
     :aria-label (t :pin/edit-title)
     :on {:click (fn [e]
                   (.stopPropagation e)
                   (start-group-row-edit! id))}}
    [:img {:src "/images/edit.png" :alt (t :pin/edit-alt)}]]
   [:span.group-row-label label]
   [:button.group-row-delete
    {:type "button"
     :title (t :pin/separator-delete)
     :aria-label (t :pin/separator-delete)
     :on {:click (fn [e]
                   (.stopPropagation e)
                   (delete-group-row! id))}}
    [:img {:src "/images/trash.png" :alt ""}]]])
