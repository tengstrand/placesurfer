(ns hitteri.country.interface
  (:require [hitteri.country.core :as core]))

(defn locale->iso []
  (core/locale->iso))

(defn slug-for-iso [iso countries]
  (core/slug-for-iso iso countries))

(defn iso-for-slug [slug countries]
  (core/iso-for-slug slug countries))

(defn country-label [slug countries]
  (core/country-label slug countries))

(defn country-bounds-for-slug [slug countries]
  (core/country-bounds-for-slug slug countries))

(defn slug-for-point [lon lat countries]
  (core/slug-for-point lon lat countries))

(defn navigate-country-plan [target-page]
  (core/navigate-country-plan target-page))

(defn set-country-filter-plan [query]
  (core/set-country-filter-plan query))

(defn highlight-index-after-filter [visible-count]
  (core/highlight-index-after-filter visible-count))

(defn step-highlight-index [current-index visible-count delta]
  (core/step-highlight-index current-index visible-count delta))

(defn select-country-plan [context slug]
  (core/select-country-plan context slug))
