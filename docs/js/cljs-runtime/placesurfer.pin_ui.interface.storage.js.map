(ns placesurfer.pin-ui.interface.storage
  (:require [placesurfer.pin-ui.pure.storage :as storage]))

(defn read-pins! [] (storage/read-pins!))
(defn save-pins! [items] (storage/save-pins! items))
(defn new-pin-id [& args] (apply storage/new-pin-id args))
(defn read-search-results! [] (storage/read-search-results!))
(defn save-search-results! [results] (storage/save-search-results! results))
