(ns hitteri.load.discgolf
  (:require [hitteri.load.gis :as gis]))

(def ^:private counts-url "data/discgolf/course-counts.edn")

(defn- gis-url [slug]
  (str "data/discgolf/" slug ".edn"))

(defn load-counts! []
  (gis/load-counts! counts-url))

(defn load-countries! []
  (gis/load-countries! counts-url))

(defn load-country! [slug]
  (gis/load-country! gis-url slug))
