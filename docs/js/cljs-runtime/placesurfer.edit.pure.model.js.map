(ns placesurfer.edit.pure.model
  (:require [clojure.set :as set]
            [clojure.string :as str]
            [placesurfer.edit.pure.coords :as coords]
            [placesurfer.edit.pure.duplicates :as duplicates]
            [placesurfer.edit.pure.rows :as rows]
            [placesurfer.edit.pure.table :as table]))

(defn- as-update-rows [rows]
  (if (sequential? rows) (vec rows) []))

(defn- as-update-pending-places [places]
  (if (sequential? places) (vec places) []))

(defn- form-field-errors? [state]
  (boolean (seq (:update-form-field-errors state))))

(defn valid-country-code?
  [s]
  (boolean (re-matches #"^[A-Z]{2}$" (str/trim (str s)))))

(defn display-rows
  [state]
  (rows/display-rows (:update-rows state) (:update-pending-places state)))

(defn- meter-calculation-active? [{:keys [update-sort update-show-duplicates?]}]
  (or update-show-duplicates?
      (let [field (:field update-sort)]
        (or (= field :meters) (= field :distance)))))

(defn table-model
  ([state] (table-model state {}))
  ([state {:keys [t]}]
   (let [{:keys [update-selected-row-id update-sort update-show-duplicates?]} state
         all-rows (display-rows state)
         duplicate-filter? (boolean update-show-duplicates?)
         meter-calc? (meter-calculation-active? state)
         reference-row (when meter-calc?
                         (or (when update-selected-row-id
                               (some #(when (= update-selected-row-id (:row-id %)) %)
                                     all-rows))
                             (:update-selected-row state)))
         with-meters (if meter-calc?
                       (mapv (fn [row]
                               (assoc row :meters (coords/row-distance-m reference-row row)))
                             all-rows)
                       all-rows)
         {:keys [visible-rows ui-sort-field sort-dir]}
         (if duplicate-filter?
           (let [dup-ids (duplicates/duplicate-row-id-set all-rows)
                 dup-rows (filterv #(contains? dup-ids (:row-id %)) with-meters)]
             {:visible-rows (duplicates/sort-rows-by-duplicate-clusters dup-rows)
              :ui-sort-field :duplicates
              :sort-dir :asc})
           (let [{:keys [ui-sort-field sort-field sort-dir]}
                 (table/resolve-table-sort update-sort false)
                 sorted-rows (table/sort-update-table-rows
                              with-meters
                              {:sort-field sort-field :sort-dir sort-dir}
                              rows/incomplete-manual-draft?)]
             {:visible-rows sorted-rows
              :ui-sort-field ui-sort-field
              :sort-dir sort-dir}))
         table-columns (table/table-columns (:update-columns state) t)
         field-errors? (form-field-errors? state)
         table-rows (mapv (fn [row]
                            {:row-id (:row-id row)
                             :selected? (= (:row-id row) update-selected-row-id)
                             :values (if (and field-errors?
                                              (= (:row-id row) update-selected-row-id))
                                       (assoc row :form-validation-warning? true)
                                       row)})
                          visible-rows)]
     {:columns table-columns
      :rows table-rows
      :sort-field ui-sort-field
      :sort-dir sort-dir})))

(defn row-client-save-pending?
  [row disk-baseline]
  (cond
    (rows/row-marked-deleted? row) true
    (rows/row-marked-added? row) true
    (and (rows/pending-row? row) (= :added (:action row))) true
    (and (rows/row-marked-edited? row)
         (rows/saved-update-row-id? (:row-id row))
         (rows/row-differs-from-disk-baseline? row disk-baseline)) true
    :else false))

(defn- active-saved-row-ids
  [rows]
  (->> rows
       as-update-rows
       (remove rows/row-save-as-tombstone?)
       (keep :row-id)
       (filter rows/saved-update-row-id?)
       set))

(defn- disk-saved-row-ids-changed?
  [state]
  (when-let [disk-baseline (:update-disk-baseline state)]
    (let [baseline-ids (set (keys disk-baseline))
          current-ids (active-saved-row-ids (:update-rows state))]
      (and (seq baseline-ids)
           (not= baseline-ids current-ids)))))

(defn- row-unsaved-added?
  [row]
  (cond
    (rows/row-marked-added? row) true
    (and (rows/pending-row? row)
         (= :added (:action row))
         (rows/row-save-fields-valid? row)) true
    (and (rows/pending-row? row)
         (:url-form row)
         (rows/row-save-fields-valid? row)) true
    :else false))

(defn- row-unsaved-edited?
  [row disk-baseline]
  (and (rows/saved-update-row-id? (:row-id row))
       (not (rows/row-save-as-tombstone? row))
       (not (rows/pending-row? row))
       (rows/row-differs-from-disk-baseline? row disk-baseline)))

(defn- work-rows-for-change-counts
  [state]
  (let [rows (as-update-rows (:update-rows state))
        places (as-update-pending-places (:update-pending-places state))
        row-pending-ids (set (keep :row-id (filter rows/pending-row? rows)))
        orphan-places (remove #(contains? row-pending-ids (:pending-id %)) places)]
    (into rows (map rows/pending-place->row orphan-places))))

(defn dataset-change-counts
  "Unsaved row changes relative to disk baseline: deleted, edited, added."
  [state]
  (let [disk-baseline (:update-disk-baseline state)
        rows (as-update-rows (:update-rows state))
        all-rows (work-rows-for-change-counts state)
        baseline-ids (set (keys disk-baseline))
        current-ids (active-saved-row-ids (:update-rows state))
        client-tombstone-ids (set/intersection
                              baseline-ids
                              (set (map :row-id (filter rows/row-marked-deleted? rows))))
        removed-ids (set/difference baseline-ids current-ids)
        deleted (count (set/union client-tombstone-ids removed-ids))
        edited (count (filter #(row-unsaved-edited? % disk-baseline) rows))
        added (count (filter row-unsaved-added? all-rows))]
    {:deleted deleted
     :edited edited
     :added added}))

(defn dataset-dirty?
  [state]
  (let [disk-baseline (:update-disk-baseline state)]
    (or (disk-saved-row-ids-changed? state)
        (some #(row-client-save-pending? % disk-baseline)
              (as-update-rows (:update-rows state)))
        (some #(row-client-save-pending? % disk-baseline)
              (as-update-pending-places (:update-pending-places state))))))

(defn dataset-preconditions-met?
  [state]
  (and (:backend-online? state)
       (some? (:update-topic state))
       (valid-country-code? (:update-country-code state))))
