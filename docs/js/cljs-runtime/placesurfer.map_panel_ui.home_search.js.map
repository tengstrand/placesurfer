(ns placesurfer.map-panel-ui.home-search
  (:require [clojure.string :as str]))

(defn- coerce-text [v]
  (cond (string? v) v (nil? v) "" :else (str v)))

(defn home-search
  [{:keys [query results loading? highlight-index
           set-query! select-result! keydown! t]
    :or {t (fn [k] (name k))}}]
  [:div.map-home-search
   [:img.update-toolbar-search-icon
    {:src "/images/search.png" :alt ""}]
   [:input.update-toolbar-search-input
    {:type "text"
     :id "home-search"
     :aria-label (t :pin/search-place)
     :aria-autocomplete "list"
     :aria-expanded (boolean (seq results))
     :value (coerce-text query)
     :on {:input (fn [e] (set-query! (.. e -target -value)))
          :keydown (fn [e] (keydown! e))}}]
   (when loading?
     [:p.update-toolbar-search-loading (t :pin/searching)])
   (when (seq results)
     [:ul.update-toolbar-search-results
      {:role "listbox"
       :id "home-search-results"}
      (map-indexed
       (fn [idx {:keys [label] :as result}]
         ^{:key (str label "-" (:longitude result) "-" (:latitude result))}
         [:li.update-toolbar-search-result
          {:id (str "home-search-results-result-" idx)
           :role "option"
           :aria-selected (= idx highlight-index)
           :class (when (= idx highlight-index)
                    "update-toolbar-search-result--highlighted")
           :on {:click (fn [_] (select-result! result))}}
          label])
       results)])])
