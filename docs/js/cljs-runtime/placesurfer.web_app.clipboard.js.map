(ns placesurfer.web-app.clipboard
  (:require [clojure.string :as str]
            [placesurfer.edit.interface.handlers.form :as update-form]
            [placesurfer.edit.interface.topics :as edit-topics]
            [placesurfer.clipboard-ui.interface.handlers.paste :as clipboard-paste]
            [placesurfer.clipboard-ui.interface.payload :as place-payload]
            [placesurfer.web-app.state :as state]))

(defn- typing-in-field-element? [^js el]
  (when el
    (let [tag (some-> el .-tagName .toUpperCase)]
      (or (= tag "INPUT")
          (= tag "TEXTAREA")
          (true? (.-isContentEditable el))))))

(defn- update-pins-mode? [s]
  (and (= :update (:page s))
       (edit-topics/pins-topic? (:update-topic s))))

(defn- full-place-paste-context? [s]
  (or (= :pin (:page s))
      (update-pins-mode? s)))

(defn- clear-clipboard! []
  (when-let [write-text (some-> js/navigator .-clipboard .-writeText)]
    (-> (write-text "")
        (.catch (fn [_] nil)))))

(defn- apply-topic-place-coords-from-text! [text]
  (when-let [payload (place-payload/parse-bookmarklet-text (str/trim (str text)))]
    (when-let [{:keys [longitude latitude]} (place-payload/payload->coordinates payload)]
      (update-form/apply-pasted-decimal-coordinates! longitude latitude)
      (clear-clipboard!)
      true)))

(defn on-document-paste!
  "Route paste to place clipboard (pin / pins) or update URL/coords (dataset edit)."
  [^js e]
  (let [s @state/!state
        text (.. e -clipboardData (getData "text"))
        in-field? (typing-in-field-element? (.-target e))]
    (cond
      (and (full-place-paste-context? s)
           (clipboard-paste/apply-place-clipboard-text! text))
      (.preventDefault e)

      (and (not in-field?)
           (= :update (:page s))
           (not (update-pins-mode? s))
           (apply-topic-place-coords-from-text! text))
      (.preventDefault e)

      (and (not in-field?)
           (= :update (:page s))
           (not (update-pins-mode? s))
           (update-form/apply-pasted-update-clipboard-text! text))
      (.preventDefault e)

      :else nil)))
