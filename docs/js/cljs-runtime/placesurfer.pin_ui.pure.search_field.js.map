(ns placesurfer.pin-ui.pure.search-field
  (:require [placesurfer.pin-ui.pure.forms :as forms]))

(defn search
  [{:keys [pin-search-query
           pin-search-results
           pin-search-loading?
           pin-search-highlight-index
           set-pin-search-query!
           select-pin-search-result!
           pin-search-keydown!
           t]
    :or {t (fn [k] (name k))}}]
  [:div.update-field-row.pin-search-row
   [:div.pin-search-leading
    [:img.pin-search-field-icon
     {:src "/images/search.png" :alt ""}]]
   [:input#pin-search.update-input
    {:type "text"
     :aria-label (t :pin/search-place)
     :aria-autocomplete "list"
     :aria-expanded (boolean (seq pin-search-results))
     :value (forms/coerce-text pin-search-query)
     :on {:input (fn [e] (set-pin-search-query! (.. e -target -value)))
          :keydown (fn [e] (pin-search-keydown! e))}}]
   (when pin-search-loading?
     [:p.pin-search-loading (t :pin/searching)])
   (when (seq pin-search-results)
     [:ul.pin-search-results
      {:role "listbox"
       :id "pin-search-results"}
      (map-indexed
       (fn [idx {:keys [label] :as result}]
         ^{:key (str label "-" (:longitude result) "-" (:latitude result))}
         [:li.pin-search-result
          {:id (str "pin-search-result-" idx)
           :role "option"
           :aria-selected (= idx pin-search-highlight-index)
           :class (when (= idx pin-search-highlight-index)
                    "pin-search-result--highlighted")
           :on {:click (fn [_] (select-pin-search-result! result))}}
          label])
       pin-search-results)])])
