(ns placesurfer.clipboard-ui.notar.url
  "Notar listing URL helpers - mirrors clipboard-ui.booli.url, but Notar's
   listing path uses an opaque alphanumeric id
   (/kopa-bostad/objekt/5IM2R58CSTE542KM), unlike Booli's bare numeric id.
   The extracted id is prefixed with \"notar:\" so it can never collide with
   a Hemnet/Booli id in the same :search-results list."
  (:require [clojure.string :as str]))

(def ^:private notar-listing-pattern
  #"^https?://(?:www\.)?notar\.se/kopa-bostad/objekt/([A-Za-z0-9]+)/?$")

(defn valid-notar-listing-url?
  "True when `url` looks like a Notar property listing page."
  [url]
  (boolean
   (when-let [s (not-empty (str/trim (str url)))]
     (re-matches notar-listing-pattern s))))

(defn listing-id-from-url
  "Extract a namespaced listing id (\"notar:<id>\") from a Notar listing URL."
  [url]
  (when-let [s (not-empty (str/trim (str url)))]
    (some->> (re-matches notar-listing-pattern s) second (str "notar:"))))
