(ns placesurfer.clipboard-ui.handlers.hemnet
  (:require [clojure.string :as str]
            [placesurfer.app-ui.interface.state :as app-state]
            [placesurfer.clipboard-ui.handlers.pin-editor :as pin-editor]
            [placesurfer.clipboard-ui.hemnet.form :as hemnet-form]
            [placesurfer.clipboard-ui.hemnet.listing :as hemnet-listing]
            [placesurfer.clipboard-ui.hemnet.payload :as hemnet-payload]
            [placesurfer.clipboard-ui.pure.browser :as browser]
            [placesurfer.i18n.interface :as i18n]
            [placesurfer.pin-ui.interface.forms :as forms]
            [placesurfer.pin-ui.interface.photon :as photon]))

(defn- trimmed-text [text]
  (browser/trimmed-text text))

(defn- guess-coords-from-address! [address then!]
  (let [trimmed (str/trim (str address))]
    (if (str/blank? trimmed)
      (then! nil)
      (let [s @app-state/!state
            countries (:countries s [])
            country-slug (:country-slug s "sweden")
            country-iso (:country-iso s "SE")]
        (-> (js/fetch (photon/build-search-url trimmed 1
                                                {:countries countries
                                                 :country-slug country-slug}))
            (.then #(.json %))
            (.then (fn [body]
                     (first (photon/filter-results-for-country
                             (photon/parse-response body)
                             country-iso countries country-slug))))
            (.catch (fn [_] nil))
            (.then then!))))))

(defn- listing->form-with-geocode! [listing source-url done!]
  (let [locale (get @app-state/!state :locale :en)
        plot-label (i18n/t locale :common/plot)
        form (hemnet-form/listing->pin-form listing source-url plot-label)]
    (cond
      (forms/form-valid? form)
      (done! form)

      (hemnet-listing/listing-complete-address? listing)
      (guess-coords-from-address!
       (hemnet-form/address-line-for-geocoding listing)
       (fn [result]
         (done! (if result
                  (assoc form
                         :longitude (str (:longitude result))
                         :latitude (str (:latitude result)))
                  form))))

      :else
      (done! form))))

(defn apply-payload!
  "Apply Hemnet bookmarklet payload to the pin editor."
  [payload]
  (when-let [listing (hemnet-payload/payload->listing payload)]
    (let [source-url (or (not-empty (trimmed-text (:url payload)))
                         (not-empty (trimmed-text (:url listing))))]
      (listing->form-with-geocode! listing source-url pin-editor/apply-resolved-place-form!)
      true)))
