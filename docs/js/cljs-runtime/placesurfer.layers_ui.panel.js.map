(ns placesurfer.layers-ui.panel)

(defn- sync-checkbox! [^js node active?]
  (when (and node (not= (.-checked node) active?))
    (set! (.-placesurferSyncing node) true)
    (set! (.-checked node) active?)
    (js/setTimeout #(set! (.-placesurferSyncing node) false) 0)))

(defn- layer-row [{:keys [layer-id active? label toggle-layer!]}]
  [:div.layer-row
   [:sl-checkbox {:size "small"
                  :checked active?
                  :replicant/on-render (fn [{:keys [replicant/node]}]
                                         (sync-checkbox! node active?))
                  :on {:sl-change (fn [^js e]
                                    (let [^js target (.-target e)]
                                      (when-not (.-placesurferSyncing target)
                                        (toggle-layer! layer-id (.-checked target)))))}}
    [:span.layer-row-label label]]])

(defn panel
  [{:keys [rows toggle-layer!]}]
  [:div.layers-section
   [:div.layers-list
    (for [{:keys [layer-id active? label]} rows]
      ^{:key (name layer-id)}
      (layer-row {:layer-id layer-id
                  :active? active?
                  :label label
                  :toggle-layer! toggle-layer!}))]])
