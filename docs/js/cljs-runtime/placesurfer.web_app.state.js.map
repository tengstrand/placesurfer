(ns placesurfer.web-app.state
  "Re-exports app-state for web-app base modules."
  (:require [placesurfer.app-ui.interface.state :as app-state]
            [placesurfer.edit.interface.baseline :as edit-ui.baseline]
            [placesurfer.edit.interface.model :as edit-ui.model]))

(defn default-active-topics [] (app-state/default-active-topics))
(defn default-update-form [] (app-state/default-update-form))
(defn clear-update-selection-state [state] (app-state/clear-update-selection-state state))

(def !state app-state/!state)
(def !resolve-location-request-id app-state/!resolve-location-request-id)
(def !update-load-request-id app-state/!update-load-request-id)
(def !update-pending-id-seq app-state/!update-pending-id-seq)
(def !health-check-request-id app-state/!health-check-request-id)
(def !backend-health-online? app-state/!backend-health-online?)
(def !load-id app-state/!load-id)
(def !topic-load-ids app-state/!topic-load-ids)
(def !countries-load-request-id app-state/!countries-load-request-id)
(def !countries-load-promise app-state/!countries-load-promise)

(defn clear-update-status! [] (app-state/clear-update-status!))
(defn normalize-country-code [s] (app-state/normalize-country-code s))
(defn valid-country-code? [s] (edit-ui.model/valid-country-code? s))
(defn non-empty-js-string? [v] (app-state/non-empty-js-string? v))
(defn non-empty-text? [v] (app-state/non-empty-text? v))
(defn update-error-text [v] (app-state/update-error-text v))
(defn normalize-update-source [source] (edit-ui.baseline/normalize-update-source source))
(defn valid-topic? [topic] (app-state/valid-topic? topic))
(defn visible-positions [s] (app-state/visible-positions s))
