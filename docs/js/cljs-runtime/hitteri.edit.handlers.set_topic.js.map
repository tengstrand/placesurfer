(ns hitteri.edit.handlers.set-topic
  (:require [hitteri.app-ui.interface.effects :as effects]
            [hitteri.app-ui.interface.state :as state]
            [hitteri.edit.handlers.save :as update-save]
            [hitteri.edit.handlers.map :as update-map]
            [hitteri.edit.pure.topics :as edit-topics]
            [hitteri.pin-ui.interface.handlers.rows :as pin-rows]
            [hitteri.pin-ui.interface.forms :as pin-forms]))

(defn set-update-topic! [topic]
  (state/clear-update-status!)
  (if (edit-topics/pins-topic? topic)
    (do
      (update-save/save-current-update-dataset-to-cache-if-clean!)
      (swap! state/!state
             (fn [s]
               (let [from-topic (:update-topic s)]
                 (cond-> (-> s
                             (assoc :update-topic topic)
                             (dissoc :pin-editor-open? :pin-editor-snapshot)
                             (assoc :pin-editor-inline? true
                                    :pin-editor-mode nil
                                    :pin-show-search? false)
                             state/clear-update-selection-state
                             (assoc :pin-form (pin-forms/default-form)
                                    :pin-form-baseline (pin-forms/default-form)
                                    :pin-selected-id nil))
                   (and (edit-topics/pins-topic? topic)
                        (not (edit-topics/pins-topic? from-topic))
                        (some? from-topic))
                   (assoc :update-topic-before-pins from-topic)))))
      (effects/render!)
      (pin-rows/refresh-pin-table!)
      (js/setTimeout #(update-map/schedule-update-map-pin-sync!) 0))
    (do
      (update-save/save-current-update-dataset-to-cache-if-clean!)
      (swap! state/!state assoc :update-topic topic)
      (effects/render!)
      (update-save/reload-update-dataset! {:clear-selection? true
                                           :reset-client-actions? true}))))
