(ns hitteri.pin-ui.pure.drag)

(def ^:private drag-threshold-px 5)

(defn- row-final-index-at-y
  "Return the target index for a dragged row given pointer Y."
  [^js rows client-y]
  (let [n (.-length rows)]
    (cond
      (zero? n) 0
      :else
      (loop [i 0]
        (if (>= i n)
          (dec n)
          (let [^js row (aget rows i)
                rect (.getBoundingClientRect row)
                mid (+ (.-top rect) (/ (.-height rect) 2))]
            (if (< client-y mid)
              i
              (recur (inc i)))))))))

(defn- clear-drop-targets! [^js scroll-node]
  (doseq [^js row (.querySelectorAll scroll-node ".pin-row--drop-target")]
    (.remove (.-classList row) "pin-row--drop-target")))

(defn- update-drop-targets! [^js scroll-node ^js rows client-y]
  (let [to-index (row-final-index-at-y rows client-y)]
    (clear-drop-targets! scroll-node)
    (when-let [^js target-row (aget rows to-index)]
      (.add (.-classList target-row) "pin-row--drop-target"))))

(defn- finish-row-drag! [^js scroll-node ^js row from-index ^js rows client-y reorder-pin-row! drag-id]
  (clear-drop-targets! scroll-node)
  (.remove (.-classList row) "pin-row--dragging")
  (set! (.-userSelect (.-body js/document)) "")
  (let [to-index (row-final-index-at-y rows client-y)]
    (when (not= from-index to-index)
      (reorder-pin-row! drag-id to-index))))

(defn- row-id [^js row]
  (some-> (.-dataset row) (.-pinRowId)))

(defn- interactive-target? [^js target]
  (boolean (.closest target "a, button, input, textarea, select, label, details, summary")))

(defn- drag-handle-from-event [^js e drag-from-whole-row?]
  (let [^js target (.-target e)]
    (or (when drag-from-whole-row?
          (when-not (interactive-target? target)
            (.closest target ".update-row")))
        (.closest target ".pin-row-drag-handle"))))

(defn- attach-row-drag-listeners! [^js scroll-node ^js row ^js rows drag-id from-index reorder-pin-row!]
  (.add (.-classList row) "pin-row--dragging")
  (set! (.-userSelect (.-body js/document)) "none")
  (letfn [(handle-mousemove [^js move-e]
            (update-drop-targets! scroll-node rows (.-clientY move-e)))
          (handle-mouseup [^js up-e]
            (.removeEventListener js/document "mousemove" handle-mousemove)
            (.removeEventListener js/document "mouseup" handle-mouseup)
            (finish-row-drag! scroll-node row from-index rows (.-clientY up-e) reorder-pin-row! drag-id))]
    (.addEventListener js/document "mousemove" handle-mousemove)
    (.addEventListener js/document "mouseup" handle-mouseup)))

(defn- attach-threshold-row-drag-listeners! [^js scroll-node ^js row ^js rows drag-id from-index reorder-pin-row! start-x start-y]
  (let [drag-started? (atom false)]
    (letfn [(handle-mousemove [^js move-e]
              (if (not @drag-started?)
                (when (> (js/Math.hypot
                          (- (.-clientX move-e) start-x)
                          (- (.-clientY move-e) start-y))
                         drag-threshold-px)
                  (reset! drag-started? true)
                  (.add (.-classList row) "pin-row--dragging")
                  (set! (.-userSelect (.-body js/document)) "none"))
                (update-drop-targets! scroll-node rows (.-clientY move-e))))
            (handle-mouseup [^js up-e]
              (.removeEventListener js/document "mousemove" handle-mousemove)
              (.removeEventListener js/document "mouseup" handle-mouseup)
              (if @drag-started?
                (do
                  (.preventDefault up-e)
                  (.stopPropagation up-e)
                  (finish-row-drag! scroll-node row from-index rows (.-clientY up-e) reorder-pin-row! drag-id))
                (do
                  (clear-drop-targets! scroll-node)
                  (.remove (.-classList row) "pin-row--dragging")
                  (set! (.-userSelect (.-body js/document)) ""))))]
      (.addEventListener js/document "mousemove" handle-mousemove)
      (.addEventListener js/document "mouseup" handle-mouseup))))

(defn- handle-row-drag-mousedown!
  [^js e ^js scroll-node reorder-pin-row! {:keys [drag-from-whole-row?] :or {drag-from-whole-row? false}}]
  (when-let [^js handle (drag-handle-from-event e drag-from-whole-row?)]
    (let [^js row (.closest handle ".update-row")
          drag-id (row-id row)
          ^js rows (.querySelectorAll scroll-node ".update-row")
          from-index (first (keep-indexed (fn [idx ^js r]
                                            (when (= drag-id (row-id r)) idx))
                                          (array-seq rows)))
          whole-row? (and drag-from-whole-row? (= handle row))]
      (when (and drag-id (some? from-index))
        (if whole-row?
          (attach-threshold-row-drag-listeners!
           scroll-node row rows drag-id from-index reorder-pin-row!
           (.-clientX e) (.-clientY e))
          (do
            (.preventDefault e)
            (.stopPropagation e)
            (attach-row-drag-listeners! scroll-node row rows drag-id from-index reorder-pin-row!)))))))

(defn ensure-pin-row-drag!
  "Attach or refresh drag-to-reorder on `scroll-node`."
  [^js scroll-node reorder-pin-row! opts]
  (when scroll-node
    (set! (.-hitteriPinRowDragReorder scroll-node) reorder-pin-row!)
    (set! (.-hitteriPinRowDragOpts scroll-node) opts)
    (when-not (.-hitteriPinRowDragMounted scroll-node)
      (set! (.-hitteriPinRowDragMounted scroll-node) true)
      (.addEventListener scroll-node "mousedown"
                         (fn [^js e]
                           (let [reorder (.-hitteriPinRowDragReorder scroll-node)
                                 opts* (.-hitteriPinRowDragOpts scroll-node)]
                             (when (and reorder opts*)
                               (handle-row-drag-mousedown! e scroll-node reorder opts*))))))))

(defn mount-pin-row-drag!
  "Replicant hook: keep drag handlers in sync with current props."
  ([reorder-pin-row!] (mount-pin-row-drag! reorder-pin-row! {}))
  ([reorder-pin-row! opts]
   (fn [{:keys [replicant/node]}]
     (ensure-pin-row-drag! node reorder-pin-row! opts))))
