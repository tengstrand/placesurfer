(ns placesurfer.api-client.urls)

(def ^:private base-url "")

(defn health-url []
  (str base-url "/health"))

(defn dataset-url []
  (str base-url "/api/backend/dataset"))

(defn save-dataset-url []
  (str base-url "/api/backend/save-dataset"))

(defn resolve-location-url []
  (str base-url "/api/backend/resolve-location"))

(defn upsert-row-url []
  (str base-url "/api/backend/upsert-row"))
