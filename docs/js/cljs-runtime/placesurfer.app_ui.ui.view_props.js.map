(ns placesurfer.app-ui.ui.view-props
  (:require [placesurfer.map-panel-ui.interface.status :as map-panel-ui.status]
            [placesurfer.topic-ui.interface :as topic-ui]))

(defn- topic-props
  [state topic-keys topic-label-fn topic-marker-url-fn]
  (let [definitions (topic-ui/definitions (sort topic-keys)
                                          topic-label-fn
                                          topic-marker-url-fn)]
    {:topic-rows (topic-ui/rows (:active-topics state)
                                (:loading-topics state)
                                definitions)}))

(defn- nav-handler-props
  [{:keys [navigate! navigate-to-update-tab! select-country! set-country-filter!
           set-country-highlight-index! set-topic-active!
           ensure-countries-loaded! show-map! toggle-layer!
           select-draw-layer! add-draw-layer! delete-draw-layer!
           set-draw-layer-draft-label! set-draw-layer-color! save-draw-layers-config!]}]
  {:navigate! navigate!
   :navigate-to-update-tab! navigate-to-update-tab!
   :select-country! select-country!
   :set-country-filter! set-country-filter!
   :set-country-highlight-index! set-country-highlight-index!
   :set-topic-active! set-topic-active!
   :ensure-countries-loaded! ensure-countries-loaded!
   :show-map! show-map!
   :toggle-layer! toggle-layer!
   :select-draw-layer! select-draw-layer!
   :add-draw-layer! add-draw-layer!
   :delete-draw-layer! delete-draw-layer!
   :set-draw-layer-draft-label! set-draw-layer-draft-label!
   :set-draw-layer-color! set-draw-layer-color!
   :save-draw-layers-config! save-draw-layers-config!})

(defn- map-status-props
  [state t]
  (let [status-t (or t (fn [k] (name k)))]
    {:map-status (map-panel-ui.status/map-status-text
                  {:status (:status state)
                   :count (:count state)
                   :country-loading? (:country-loading? state)
                   :t status-t})}))

(defn view-props
  [state
   {:keys [topic-keys topic-label-fn topic-marker-url-fn mobile? handlers
           map-handler-props t]}]
  (merge state
         (topic-props state topic-keys topic-label-fn topic-marker-url-fn)
         (nav-handler-props handlers)
         {:mobile? mobile?
          :t t}
         (map-status-props state t)
         map-handler-props))
