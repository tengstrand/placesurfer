(ns hitteri.topic-data.core
  (:require [cljs.reader :as reader]))

(def countries-url "data/world-countries.edn")

(def topics
  {:discgolf {:label "Disc golf courses"
              :marker-url "data/discgolf/marker.png"
              :counts-url "data/discgolf/course-counts.edn"
              :gis-prefix "data/discgolf/gis/"}
   :art {:label "Art galleries and museums"
         :marker-url "data/art/marker.png"
         :counts-url "data/art/place-counts.edn"
         :gis-prefix "data/art/gis/"}})

(def default-active-topics #{:discgolf :art})

(defn topic-keys []
  (keys topics))

(defn topic-label [topic]
  (:label (topics topic)))

(defn topic-marker-url [topic]
  (:marker-url (topics topic)))

(defn- gis-url [topic slug]
  (str (:gis-prefix (topics topic)) slug ".edn"))

(defn- parse-edn [text topic]
  (let [data (reader/read-string text)]
    {:country (:country data)
     :count (:count data)
     :positions (mapv #(assoc % :topic topic) (:positions data))}))

(defn- fetch-text! [url]
  (-> (js/fetch url)
      (.then (fn [resp]
               (if (.-ok resp)
                 (.text resp)
                 (js/Promise.reject
                  (js/Error. (str "Failed to load " url ", status " (.-status resp)))))))))

(defn- fetch-counts! [topic]
  (let [url (:counts-url (topics topic))]
    (-> (fetch-text! url)
        (.then #(js/Promise.resolve (reader/read-string %)))
        (.catch (fn [_]
                  (js/Promise.resolve {}))))))

(defn- load-topic-country! [topic slug]
  (let [url (gis-url topic slug)]
    (-> (js/fetch url)
        (.then (fn [resp]
                 (cond
                   (.-ok resp)
                   (.then (.text resp) #(parse-edn % topic))

                   (= 404 (.-status resp))
                   (js/Promise.resolve {:country slug :count 0 :positions []})

                   :else
                   (js/Promise.reject
                    (js/Error. (str "Failed to load " url ", status " (.-status resp)))))))
        (.catch (fn [_]
                  (js/Promise.resolve {:country slug :count 0 :positions []}))))))

(defn- sum-counts [count-maps slug active-topics]
  (reduce + 0
          (map #(get (count-maps %) slug 0)
               (filter active-topics (keys topics)))))

(defn- merge-country-counts [countries count-maps active-topics]
  (mapv #(assoc % :count (sum-counts count-maps (:slug %) active-topics)) countries))

(defn load-countries! [active-topics]
  (let [topics-to-load (vec (filter active-topics (keys topics)))]
    (-> (fetch-text! countries-url)
        (.then (fn [countries-text]
                 (let [countries (reader/read-string countries-text)]
                   (if (empty? topics-to-load)
                     (js/Promise.resolve (sort-by :label countries))
                     (-> (js/Promise.all (mapv fetch-counts! topics-to-load))
                         (.then (fn [count-maps]
                                  (js/Promise.resolve
                                   (sort-by :label
                                            (merge-country-counts countries
                                                                (zipmap topics-to-load count-maps)
                                                                active-topics)))))))))))))

(defn load-country-topics! [slug active-topics]
  (let [topics-to-load (vec (filter active-topics (keys topics)))]
    (if (empty? topics-to-load)
      (js/Promise.resolve {:count 0 :positions []})
      (-> (js/Promise.all (mapv #(load-topic-country! % slug) topics-to-load))
          (.then (fn [results]
                   (let [positions (vec (mapcat :positions results))
                         count (count positions)]
                     (js/Promise.resolve {:count count :positions positions}))))))))
