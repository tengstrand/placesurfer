(ns placesurfer.nav-ui.tabs
  (:require [placesurfer.nav-ui.flags :as flags]
            [placesurfer.nav-ui.sync :as sync]
            [placesurfer.topic-ui.interface.nav :as topic-panel]))

(defn- nav-home-tab
  "The logo tab - doubles as the pin page's entry point (the pin page, with
   its map + saved-pin list, is the app's home page; see
   web-app.nav/open-pin-in-editor! and friends for :pin as the default
   landing page)."
  [{:keys [active-page navigate! navigate-to-pin! app-version t]}]
  [:sl-tab.nav-home-tab
   {:slot "nav"
    :panel "pin"
    :active (= :pin active-page)
    :on {:click (fn [_]
                  (cond
                    navigate-to-pin! (navigate-to-pin!)
                    navigate! (navigate! :pin)))}}
   [:img.nav-home-icon
    {:src "/images/logo.webp"
     :alt (t :nav/home)
     :title (when app-version (str (t :nav/version) " " app-version))}]])

(defn- nav-country-tab [country-code active-page]
  [:sl-tab.nav-country-tab
   {:slot "nav"
    :panel "country"
    :active (= :country active-page)}
   [:span.nav-country-tab-icon (flags/iso->flag (or country-code "SE"))]])

(defn- nav-layers-tab
  [{:keys [active-page navigate! t]}]
  [:sl-tab.nav-layers-tab
   {:slot "nav"
    :panel "layers"
    :active (= :layers active-page)
    :on {:click (fn [_]
                  (when navigate!
                    (navigate! :layers)))}}
   [:img.nav-layers-icon
    {:src "/images/layers.png"
     :alt (when t (t :nav/layers-alt))}]])

(defn- nav-update-tab
  [{:keys [active-page navigate! navigate-to-update! t]}]
  [:sl-tab.nav-update-tab
   {:slot "nav"
    :panel "update"
    :active (= :update active-page)
    :on {:click (fn [_]
                  (cond
                    navigate-to-update! (navigate-to-update!)
                    navigate! (navigate! :update)))}}
   [:span.nav-update-tab-content
    [:img.nav-update-icon
     {:src "/images/edit.png"
      :alt (t :nav/update-alt)}]]])

(defn- nav-about-tab
  [{:keys [active-page navigate! t]}]
  [:sl-tab.nav-about-tab
   {:slot "nav"
    :panel "about"
    :active (= :about active-page)
    :on {:click (fn [_]
                  (when navigate!
                    (navigate! :about)))}}
   [:img.nav-about-icon
    {:src "/images/info.png"
     :alt (t :nav/about-alt)}]])

(defn- nav-settings-tab
  [{:keys [active-page navigate! t]}]
  [:sl-tab.nav-settings-tab
   {:slot "nav"
    :panel "settings"
    :active (= :settings active-page)
    :on {:click (fn [_]
                  (when navigate!
                    (navigate! :settings)))}}
   [:img.nav-settings-icon
    {:src "/images/settings.png"
     :alt (t :settings/title)}]])

(defn tabs
  [{:keys [page navigate! navigate-to-pin! navigate-to-update! country-code topic-rows app-version t]
    :or {t (fn [k] (name k))}}]
  [:sl-tab-group.nav-tab-group
   {:replicant/on-mount (fn [{:keys [replicant/node]}]
                          (sync/sync-tab-group-on-page! node page))
    :replicant/on-render (fn [{:keys [replicant/node]}]
                           (sync/sync-tab-group-on-page! node page))
    :on {:sl-tab-show (fn [^js e]
                        (let [name (.-name (.-detail e))]
                          (when (seq name)
                            (sync/reset-synced-page! (keyword name))
                            (when (and (not @sync/!suppress-tab-show-navigation?)
                                       (not= page (keyword name)))
                            (cond
                              (and (= (keyword name) :pin) navigate-to-pin!)
                              (navigate-to-pin!)

                              (and (= (keyword name) :update) navigate-to-update!)
                              (navigate-to-update!)

                              :else
                              (navigate! (keyword name)))))))}}
   (nav-home-tab {:active-page page
                  :navigate! navigate!
                  :navigate-to-pin! navigate-to-pin!
                  :app-version app-version
                  :t t})
   (nav-update-tab {:active-page page
                    :navigate! navigate!
                    :navigate-to-update! navigate-to-update!
                    :t t})
   (topic-panel/nav-tab topic-rows page t)
   (nav-country-tab country-code page)
   (nav-about-tab {:active-page page
                   :navigate! navigate!
                   :t t})
   (nav-settings-tab {:active-page page
                      :navigate! navigate!
                      :t t})
   [:sl-tab-panel {:name "topic"}]
   [:sl-tab-panel {:name "country"}]
   [:sl-tab-panel {:name "pin"}]
   [:sl-tab-panel {:name "update"}]
   [:sl-tab-panel {:name "about"}]
   [:sl-tab-panel {:name "settings"}]])
