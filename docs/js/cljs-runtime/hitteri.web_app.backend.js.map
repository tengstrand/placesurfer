(ns hitteri.web-app.backend
  (:require [clojure.string :as str]
            [hitteri.api-client.interface :as api-client]
            [hitteri.edit.interface.handlers.topic :as update-topic]
            [hitteri.web-app.effects :as effects]
            [hitteri.web-app.state :as state]))

(defonce !consecutive-health-failures (atom 0))

(defn- update-page? [page]
  (= page :update))

(defn- abort-error? [err]
  (let [name (.-name err)
        msg (str/lower-case (str (.-message err) ""))]
    (or (= name "AbortError")
        (str/includes? msg "abort"))))

(defn- mark-backend-offline! [s]
  (assoc s :backend-online? false))

(defn- apply-health-check-success! [request-id was-offline?]
  (when (= request-id @state/!health-check-request-id)
    (reset! !consecutive-health-failures 0)
    (reset! state/!backend-health-online? true)
    (swap! state/!state
           (fn [s]
             (cond-> (assoc s :backend-online? true)
               (= "Backend service is not running" (:update-error s))
               (assoc :update-error nil))))
    (effects/render!)
    (when (and was-offline?
               (= :update (:page @state/!state)))
      (effects/reload-update-dataset!))
    (effects/sync-marker-pick-handler!)))

(defn- apply-health-check-failure! [request-id err was-online?]
  (when (and (= request-id @state/!health-check-request-id)
             (not (abort-error? err)))
    (let [failures (swap! !consecutive-health-failures inc)]
      (when (>= failures 2)
        (reset! state/!backend-health-online? false)
        (swap! state/!state
               (fn [s]
                 (cond-> (mark-backend-offline! s)
                   (= "Backend service is not running" (:update-error s))
                   (assoc :update-error nil))))
        (when (and was-online? (update-page? (:page @state/!state)))
          (update-topic/ensure-update-topic!))
        (effects/sync-marker-pick-handler!)
        (effects/render!)))))

(defn check-backend! []
  (let [request-id (swap! state/!health-check-request-id inc)
        was-offline? (not @state/!backend-health-online?)
        was-online? @state/!backend-health-online?
        p (js/fetch (api-client/health-url) #js {:cache "no-store"})]
    (-> (.then p
               (fn [resp]
                 (if (.-ok resp)
                   (.json resp)
                   (js/Promise.reject
                    (js/Error. (str "Backend not reachable, status " (.-status resp)))))))
        (.then (fn [_] (apply-health-check-success! request-id was-offline?)))
        (.catch (fn [err]
                  (apply-health-check-failure! request-id err was-online?))))))
