(ns placesurfer.dropbox.config)

(defn app-key
  "Dropbox App key (OAuth2 PKCE client_id), read from the dropbox-app-key meta tag.
   Injected into index.html at build time from the DROPBOX_APP_KEY env var
   (scripts/placesurfer_root.clj) - never hardcoded/committed here, so each
   deployment can use its own Dropbox app without touching version control."
  []
  (when-let [el (.querySelector js/document "meta[name=dropbox-app-key]")]
    (not-empty (.getAttribute el "content"))))

(defn configured? []
  (some? (app-key)))

(def token-url "https://api.dropboxapi.com/oauth2/token")
(def authorize-url "https://www.dropbox.com/oauth2/authorize")
(def upload-url "https://content.dropboxapi.com/2/files/upload")
(def download-url "https://content.dropboxapi.com/2/files/download")
(def revoke-url "https://api.dropboxapi.com/2/auth/token/revoke")
(def account-url "https://api.dropboxapi.com/2/users/get_current_account")

(def push-debounce-ms 700)
(def pull-timeout-ms 4000)
(def token-expiry-margin-ms 60000)
