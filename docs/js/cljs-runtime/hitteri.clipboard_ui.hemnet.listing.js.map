(ns hitteri.clipboard-ui.hemnet.listing
  (:require [clojure.string :as str]
            [hitteri.clipboard-ui.pure.numbers :as numbers]))

(defn- non-blank [s]
  (when-let [t (not-empty (str/trim (str s)))]
    t))

(defn parse-number
  "Parse coordinate-like numbers from strings or numbers."
  [v]
  (numbers/parse-number v))

(defn- parse-number* [v] (parse-number v))

(defn formatted-value
  "Extract display text from Hemnet formatted objects or scalars."
  [v]
  (cond
    (string? v) (non-blank v)
    (number? v) (str v)
    (map? v) (or (non-blank (:formatted v))
                 (when-let [amount (parse-number* (:amount v))]
                   (str amount)))
    :else nil))

(defn- housing-form-text [v]
  (cond
    (string? v) (non-blank v)
    (map? v) (non-blank (:name v))
    :else nil))

(defn- rooms-text [v]
  (cond
    (string? v) (non-blank v)
    (number? v) (str v " rum")
    :else nil))

(defn- image-url-from-object [img]
  (when img
    (cond
      (string? img) (non-blank img)
      (map? img) (or (non-blank (:url img))
                     (non-blank (:src img))
                     (non-blank (:largeUrl img))
                     (non-blank (:large img)))
      :else nil)))

(defn prefer-large-image-url
  "Prefer Hemnet's large image variant when the URL encodes a thumbnail size."
  [url]
  (when-let [u (non-blank url)]
    (-> u
        (str/replace #"/small_" "/large_")
        (str/replace #"/thumb_" "/large_")
        (str/replace #"/(?:small|thumb|mini)\." "/large."))))

(defn- image-url-width-score [url]
  (or (some-> (re-find #"[?&]w=(\d+)" url) second js/parseInt)
      (cond
        (re-find #"/large" (str/lower-case url)) 2000
        (re-find #"/(?:small|thumb|mini)" (str/lower-case url)) 100
        :else 500)))

(defn- best-url-from-image-object [img]
  (cond
    (string? img) (prefer-large-image-url img)
    (map? img)
    (let [best (atom nil)
          best-width (atom -1)
          consider! (fn [url width]
                      (when-let [u (prefer-large-image-url url)]
                        (let [w (or width (image-url-width-score u))]
                          (when (>= w @best-width)
                            (reset! best-width w)
                            (reset! best u)))))]
      (doseq [fmt (:formats img)]
        (when-let [url (image-url-from-object fmt)]
          (consider! url (when (number? (:width fmt)) (:width fmt)))))
      (when (map? (:sizes img))
        (doseq [key ["original" "large" "full" "medium" "small" "thumb"]]
          (when-let [url (image-url-from-object (get (:sizes img) key))]
            (consider! url nil))))
      (when-let [direct (image-url-from-object img)]
        (consider! direct (when (number? (:width img)) (:width img))))
      @best)
    :else nil))

(defn- best-image-url-from-node [node]
  (when (map? node)
    (let [direct (prefer-large-image-url (or (non-blank (:imageUrl node))
                                             (non-blank (:image-url node))
                                             (non-blank (:primaryImageUrl node))))
          primary (best-url-from-image-object (or (:primaryImage node)
                                                  (:primary_image node)
                                                  (:mainImage node)))
          from-collections (mapcat (fn [coll-key]
                                     (when-let [coll (seq (get node coll-key))]
                                       (keep best-url-from-image-object coll)))
                                   [:images :thumbnails :gallery :pictures])
          all (vec (remove nil? (concat (when direct [direct])
                                        (when primary [primary])
                                        from-collections)))]
      (when (seq all)
        (apply max-key image-url-width-score all)))))

(defn- coords-from-node [node]
  (when (map? node)
    (let [coords (or (:coordinates node) (:coordinate node))
          lat (or (parse-number* (:latitude node))
                  (parse-number* (:lat node))
                  (when (map? coords) (parse-number* (:lat coords)))
                  (when (map? coords) (parse-number* (:latitude coords))))
          lon (or (parse-number* (:longitude node))
                 (parse-number* (:long node))
                 (parse-number* (:lon node))
                 (parse-number* (:lng node))
                 (when (map? coords) (parse-number* (:long coords)))
                 (when (map? coords) (parse-number* (:lon coords)))
                 (when (map? coords) (parse-number* (:lng coords)))
                 (when (map? coords) (parse-number* (:longitude coords))))]
      (when (and (number? lat) (number? lon))
        {:latitude lat :longitude lon}))))

(defn- extra-values-from [node]
  (vec (remove nil?
               [(formatted-value (or (:monthlyFee node) (:fee node)))
                (formatted-value (or (:supplementalArea node) (:supplemental_area node)))
                (when-let [tenure (:tenure node)]
                  (when (map? tenure) (non-blank (:name tenure))))
                (formatted-value (:square_meter_price node))])))

(defn listing-completeness-score
  "Higher score means a more complete Hemnet listing node."
  [node]
  (when (map? node)
    (let [coords (coords-from-node node)
          score (atom 0)]
      (when (or (non-blank (:streetAddress node))
                (non-blank (:street_address node)))
        (swap! score + 1))
      (when coords (swap! score + 4))
      (when (best-image-url-from-node node)
        (swap! score + 2))
      (when (formatted-value (or (:askingPrice node) (:asking_price node)))
        (swap! score + 2))
      (when (formatted-value (or (:livingArea node) (:living_area node)))
        (swap! score + 1))
      (when (housing-form-text (or (:housingForm node) (:housing_form node)))
        (swap! score + 1))
      (when (some? (or (:numberOfRooms node) (:rooms node)))
        (swap! score + 1))
      @score)))

(defn- listing-title-from-node [node]
  (or (non-blank (:listingTitle node))
      (non-blank (:listing-title node))
      (non-blank (:title node))
      (non-blank (:heading node))))

(defn- municipality-only? [s]
  (boolean (re-find #" kommun$" (str/lower-case (str s)))))

(defn postal-city-from-location-description
  "Extract postort from Hemnet location text like \"Kristdala, Oskarshamns kommun\"."
  [s]
  (when-let [t (non-blank s)]
    (when-let [first-part (non-blank (first (str/split t #",")))]
      (when-not (municipality-only? first-part)
        first-part))))

(defn- locality-from-location [location]
  (when (map? location)
    (or (non-blank (:locality location))
        (non-blank (:postalCity location))
        (non-blank (:postal_city location)))))

(defn- postal-city-from-node [node]
  (or (non-blank (:postalCity node))
      (non-blank (:postal_city node))
      (non-blank (:postal-city node))
      (locality-from-location (:location node))
      (postal-city-from-location-description
       (or (:locationDescription node) (:location_description node)))
      (non-blank (:postalArea node))
      (non-blank (:postal_area node))))

(defn normalize-listing-node
  "Map a raw Hemnet listing node (GraphQL or bookmarklet flat) to kebab-case fields."
  [node]
  (when (map? node)
    (let [coords (coords-from-node node)
          extras (extra-values-from node)]
      {:listing-title (listing-title-from-node node)
       :street-address (or (non-blank (:streetAddress node))
                           (non-blank (:street_address node))
                           (listing-title-from-node node))
       :postal-city (postal-city-from-node node)
       :longitude (:longitude coords)
       :latitude (:latitude coords)
       :image-url (best-image-url-from-node node)
       :housing-form (housing-form-text (or (:housingForm node) (:housing_form node)))
       :rooms (rooms-text (or (:numberOfRooms node) (:rooms node)))
       :living-area (formatted-value (or (:livingArea node) (:living_area node)))
       :plot-area (formatted-value (or (:landArea node) (:land_area node) (:plotArea node)))
       :asking-price (formatted-value (or (:askingPrice node) (:asking_price node)))
       :extra-values (if (seq extras)
                       extras
                       (vec (mapv non-blank (or (:extraValues node) (:extra-values node) []))))
       :agent-url (or (non-blank (:agentUrl node))
                      (non-blank (:agent-url node))
                      (when-let [broker (or (:broker node) (:brokerFirm node) (:agent node))]
                        (when (map? broker)
                          (or (non-blank (get-in broker [:profilePage :href]))
                              (non-blank (:profilePageUrl broker))
                              (non-blank (:url broker))))))})))

(defn normalize-listing-payload
  "Normalize bookmarklet `listing` map, including nested GraphQL shapes."
  [listing]
  (when (map? listing)
    (normalize-listing-node listing)))

(defn listing-has-coords?
  "True when normalized listing includes latitude and longitude."
  [listing]
  (and (map? listing)
       (number? (:latitude listing))
       (number? (:longitude listing))))

(defn listing-complete-address?
  "True when listing has both street address and postal city for geocoding."
  [listing]
  (and (map? listing)
       (non-blank (:street-address listing))
       (non-blank (:postal-city listing))))
