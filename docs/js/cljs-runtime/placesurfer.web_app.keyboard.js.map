(ns placesurfer.web-app.keyboard
  (:require [placesurfer.app-ui.interface.pages :as app-ui.pages]
            [placesurfer.pin-ui.interface.handlers.interaction :as pin-interaction]
            [placesurfer.web-app.map-country :as map-country]
            [placesurfer.web-app.nav :as nav]
            [placesurfer.web-app.state :as state]))

(defn- typing-in-field? [^js e]
  (let [el (.-target e)
        tag (some-> el .-tagName .toUpperCase)]
    (or (= tag "INPUT")
        (= tag "TEXTAREA")
        (true? (.-isContentEditable el)))))

(defn- modifier-key-held? [^js e]
  (or (.-ctrlKey e) (.-metaKey e) (.-altKey e)))

(defn- update-pins-mode? [s]
  (and (= :update (:page s))
       (= :pins (:update-topic s))))

(defn- pin-row-nav-delta [^js e]
  (case (.-key e)
    "ArrowDown" 1
    "ArrowUp" -1
    nil))

(defn- pin-row-nav-key? [^js e]
  (and (or (= :pin (:page @state/!state))
           (update-pins-mode? @state/!state))
       (some? (pin-row-nav-delta e))
       (not (typing-in-field? e))
       (not (modifier-key-held? e))))

(defn on-document-keydown! [^js e]
  (when-not (.-repeat e)
    (cond
      (pin-row-nav-key? e)
      (do (.preventDefault e)
          (pin-interaction/select-adjacent-pin-row! (pin-row-nav-delta e)))

      (and (not (typing-in-field? e))
           (not (modifier-key-held? e)))
      (let [key (.toLowerCase (.-key e))
            page (:page @state/!state)]
        (cond
          (= "t" key) (do (.preventDefault e) (nav/navigate! :topic))
          (= "h" key) (do (.preventDefault e) (nav/navigate! :home))
          (and (= "c" key) (app-ui.pages/map-page? page))
          (do (.preventDefault e) (map-country/enable-country-pick!))
          (and (= "c" key) (not (app-ui.pages/map-page? page)))
          (do (.preventDefault e) (nav/navigate! :country))
          (and (= "u" key) (not (.-repeat e)))
          (do (.preventDefault e) (nav/navigate-to-update!))
          (= "p" key) (do (.preventDefault e) (nav/navigate-to-pin!))
          (= "a" key) (do (.preventDefault e) (nav/navigate! :about)))))))
