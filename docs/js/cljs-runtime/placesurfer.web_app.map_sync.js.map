(ns placesurfer.web-app.map-sync
  (:require [placesurfer.i18n.interface :as i18n]
            [placesurfer.map-panel-ui.interface.resize :as map-panel-ui.resize]
            [placesurfer.map-ui.interface :as map-ui]
            [placesurfer.web-app.draw-layers :as draw-layers]
            [placesurfer.web-app.state :as state]
            [placesurfer.edit.interface.handlers.map :as update-map]
            [placesurfer.pin-ui.interface.handlers.map :as pin-map]))

(defn- popup-opts [s]
  {:source-label (i18n/t (:locale s :en) :popup/source-label)
   :delete-label (i18n/t (:locale s :en) :pin/delete)
   :edit-label (i18n/t (:locale s :en) :pin/edit-title)
   :transit-label (i18n/t (:locale s :en) :popup/transit-label)
   :departures-label (i18n/t (:locale s :en) :popup/departures-label)
   :editable? (boolean (:backend-online? s))})

(defn sync-map!
  ([] (sync-map! {}))
  ([{:keys [fit? fit-bounds animate?] :or {fit? false animate? true}}]
   (cond
     (= :draw (:page @state/!state))
     (do
       (map-ui/apply-state! {:positions []})
       (draw-layers/enter-draw-page!))

     (= :update (:page @state/!state))
     (do
       (update-map/refresh-update-pending-places!)
       (map-ui/apply-state! {:positions (update-map/update-map-positions @state/!state)
                             :fit? fit?
                             :animate? animate?
                             :popup-opts (popup-opts @state/!state)}))

     (= :pin (:page @state/!state))
     (pin-map/sync-pin-map! {:recenter? false})

     :else
     (let [s @state/!state
           pin-selected? (some? (:pin-selected-id s))
           effective-fit? (and fit? (not pin-selected?))]
       (map-ui/sync-overlay-layers! (or (:active-overlays s) #{}))
       (map-ui/apply-state! {:positions (pin-map/main-map-positions s)
                             :fit? effective-fit?
                             :fit-bounds fit-bounds
                             :animate? animate?
                             :popup-opts (popup-opts s)})
       (when (and pin-selected? (pin-map/selected-pin-on-main-map? s))
         (pin-map/schedule-focus-selected-pin-on-main-map!))))))

(defn schedule-map-resize! []
  (map-panel-ui.resize/schedule-resize! map-ui/resize-map!))
