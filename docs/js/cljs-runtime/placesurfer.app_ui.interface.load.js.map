(ns placesurfer.app-ui.interface.load
  "Country/topic loading orchestration for the SPA."
  (:require [placesurfer.app-ui.load :as core]))

(defn positions-for-topic? [positions topic]
  (core/positions-for-topic? positions topic))

(defn missing-active-topics [active-topics positions]
  (core/missing-active-topics active-topics positions))

(defn load-country! [slug opts]
  (core/load-country! slug opts))

(defn load-countries-into-state! []
  (core/load-countries-into-state!))

(defn reload-countries! []
  (core/reload-countries!))

(defn ensure-countries-loaded! []
  (core/ensure-countries-loaded!))

(defn load-topic-positions! [topic]
  (core/load-topic-positions! topic))

(defn ensure-active-topic-positions! []
  (core/ensure-active-topic-positions!))

(defn set-topic-active! [topic active?]
  (core/set-topic-active! topic active?))

(defn toggle-topic! [topic]
  (core/toggle-topic! topic))

(defn init-load! []
  (core/init-load!))
