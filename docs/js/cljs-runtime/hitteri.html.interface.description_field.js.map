(ns hitteri.html.interface.description-field
  (:require [hitteri.html.description-field :as field]))

(defn description-field [& args]
  (apply field/description-field args))

(defn read-editor-canonical [& args]
  (apply field/read-editor-canonical args))

(defn flush-editor! [& args]
  (apply field/flush-editor! args))

(defn editor-contains-focus? [& args]
  (apply field/editor-contains-focus? args))
