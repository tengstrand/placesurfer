(ns placesurfer.pin-ui.handlers.hemnet
  "Pin toolbar actions unrelated to bookmarklet clipboard paste."
  (:require [placesurfer.app-ui.interface.effects :as effects]
            [placesurfer.app-ui.interface.state :as app-state]
            [placesurfer.pin-ui.handlers.editor :as editor]
            [placesurfer.pin-ui.pure.update-context :as update-context]))

(defn- start-new-pin-flow! []
  (if (update-context/update-pins-mode? @app-state/!state)
    (editor/open-pin-editor-new-empty!)
    (if (update-context/update-page? @app-state/!state)
      (effects/run-in-update-pins-mode!
       (fn [] (editor/open-pin-editor-new-empty!)))
      (editor/open-pin-editor-new!))))

(defn create-new-pin! []
  (start-new-pin-flow!))

(defn create-new-pin-from-clipboard!
  "Backward-compatible alias for create-new-pin!."
  []
  (create-new-pin!))
