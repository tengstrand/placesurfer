(ns placesurfer.i18n.core
  (:require [clojure.string :as str]
            [placesurfer.i18n.pure.storage :as storage]
            [placesurfer.i18n.pure.translations :as translations]))

(def default-locale :en)

(def supported-locales #{:en :sv :es :fr :fi :de :pt :no :da :ja})

(defn normalize-locale
  [locale]
  (let [k (cond
            (keyword? locale) locale
            (string? locale) (keyword (str/lower-case locale))
            :else nil)]
    (if (contains? supported-locales k) k default-locale)))

(defn- interpolate [text params]
  (reduce (fn [s [k v]]
            (str/replace s (str "{" (name k) "}") (str v)))
          (str text)
          params))

(defn t
  ([locale key]
   (t locale key {}))
  ([locale key params]
   (let [locale (normalize-locale locale)
         en-text (get translations/en key)
         text (or (get (translations/for-locale locale) key) en-text (name key))]
     (if (seq params)
       (interpolate text params)
       text))))

(defn read-locale!
  []
  (normalize-locale (:locale (storage/read-settings!))))

(defn save-locale!
  [locale]
  (storage/save-settings!
   (assoc (storage/read-settings!) :locale (name (normalize-locale locale)))))

(defn topic-label
  [locale topic]
  (t locale (keyword "topic" (name topic))))
