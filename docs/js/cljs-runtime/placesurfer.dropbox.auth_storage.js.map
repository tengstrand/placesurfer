(ns placesurfer.dropbox.auth-storage
  (:require [cljs.reader :as reader]))

(def auth-storage-key "placesurfer_dropbox_auth")
(def pkce-session-key "placesurfer_dropbox_pkce")

(defn- local-storage []
  (when (exists? js/localStorage) js/localStorage))

(defn- session-storage []
  (when (exists? js/sessionStorage) js/sessionStorage))

(defn- read-edn! [storage k]
  (when storage
    (try
      (when-let [raw (.getItem storage k)]
        (reader/read-string raw))
      (catch :default _ nil))))

(defn- write-edn! [storage k v]
  (when storage
    (try
      (.setItem storage k (pr-str v))
      (catch :default _ nil))))

(defn- clear! [storage k]
  (when storage
    (try
      (.removeItem storage k)
      (catch :default _ nil))))

(defn read-auth!
  "{:access-token :refresh-token :expires-at :account-email} or nil."
  []
  (read-edn! (local-storage) auth-storage-key))

(defn write-auth! [auth-map]
  (write-edn! (local-storage) auth-storage-key auth-map))

(defn clear-auth! []
  (clear! (local-storage) auth-storage-key))

(defn write-pkce-session!
  "Transient {:verifier :state} kept only across the redirect round-trip."
  [session]
  (write-edn! (session-storage) pkce-session-key session))

(defn read-pkce-session! []
  (read-edn! (session-storage) pkce-session-key))

(defn clear-pkce-session! []
  (clear! (session-storage) pkce-session-key))
