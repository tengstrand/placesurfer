(ns placesurfer.web-app.init
  (:require [placesurfer.map-panel-ui.interface.layout :as map-panel-ui.layout]
            [placesurfer.map-ui.interface :as map-ui]
            [placesurfer.web-app.backend :as backend]
            [placesurfer.web-app.clipboard :as clipboard]
            [placesurfer.web-app.effects :as effects]
            [placesurfer.web-app.keyboard :as keyboard]
            [placesurfer.app-ui.interface.load :as app-load]
            [placesurfer.web-app.analytics :as analytics]
            [placesurfer.web-app.map-sync :as map-sync]
            [placesurfer.web-app.locale :as locale]
            [placesurfer.web-app.nav :as nav]
            [placesurfer.web-app.render :as render]
            [placesurfer.web-app.state :as state]
            [placesurfer.edit.interface.handlers.form :as update-form]
            [placesurfer.edit.interface.handlers.map :as update-map]
            [placesurfer.edit.interface.handlers.save :as update-save]
            [placesurfer.edit.interface.handlers.topic :as update-topic]
            [placesurfer.pin-ui.interface.handlers.form :as pin-form]))

(defn wire-effects! []
  (effects/wire!
   {:render! (fn [& _] (render/render!))
    :navigate! (fn [& args] (apply nav/navigate! args))
    :navigate-to-pin! (fn [& _] (nav/navigate-to-pin!))
    :navigate-to-update! (fn [& _] (nav/navigate-to-update!))
    :select-country! (fn [& args] (apply nav/select-country! args))
    :resolve-update-location-from-coordinates!
    (fn [& args] (apply update-form/resolve-update-location-from-coordinates! args))
    :sync-marker-pick-handler! (fn [& _] (render/sync-marker-pick-handler!))
    :reload-update-dataset! (fn [& args] (apply update-save/reload-update-dataset! args))
    :set-update-topic! (fn [& args] (apply update-form/set-update-topic! args))
    :run-in-update-pins-mode! (fn [& args] (apply update-topic/run-in-update-pins-mode! args))
    :sync-update-map! (fn [& args] (apply update-map/sync-update-map! args))
    :load-topic-positions! (fn [topic] (app-load/load-topic-positions! topic))
    :schedule-update-map-pin-sync! (fn [& args] (apply update-map/schedule-update-map-pin-sync! args))
    :schedule-center-on-position! (fn [& args] (apply update-map/schedule-center-on-position! args))
    :schedule-map-resize! (fn [& _] (map-sync/schedule-map-resize!))
    :sync-main-map! (fn [& args] (apply map-sync/sync-map! args))
    :check-backend! (fn [& _] (backend/check-backend!))
    :track-page! (fn [& args] (apply analytics/track-page! args))}))

(defn- read-app-version []
  (when-let [el (.querySelector js/document "meta[name=app-version]")]
    (js/parseInt (.getAttribute el "content") 10)))

(defn- load-layers-config! []
  (-> (js/fetch "/data/layers/layers.json")
      (.then (fn [resp] (when (.-ok resp) (.json resp))))
      (.then (fn [^js data]
               (when data
                 (let [layers (js->clj data :keywordize-keys true)]
                   (when (seq layers)
                     (swap! state/!state assoc :draw-layers layers))))))
      (.catch (fn [_] nil))))

(defn- wire-draw-save! []
  (map-ui/set-draw-on-save!
   (fn [fc]
     (let [layer-id (:draw-selected-layer-id @state/!state)]
       (when layer-id
         (-> (js/fetch "/api/backend/save-layer"
                       (clj->js {:method "POST"
                                 :headers {"Content-Type" "application/json"}
                                 :body (.stringify js/JSON (clj->js {:layer-id layer-id
                                                                      :geojson fc}))}))
             (.then (fn [resp]
                      (when-not (.-ok resp)
                        (js/console.error "Kunde inte spara lager" (.-status resp)))))
             (.catch (fn [err]
                       (js/console.error "Fel vid sparning av lager" err))))))))
  (map-ui/set-draw-on-map-ready!
   (fn []
     (when (= :draw (:page @state/!state))
       (when-let [layer-id (:draw-selected-layer-id @state/!state)]
         (map-ui/load-draw-layer! layer-id))))))

(defn init! []
  (wire-effects!)
  (wire-draw-save!)
  (when-let [v (read-app-version)]
    (swap! state/!state assoc :app-version v))
  (locale/init-locale!)
  (map-ui/set-draw-t! (locale/make-t @state/!state))
  (load-layers-config!)
  (pin-form/load-pin-icons!)
  (pin-form/load-pins-from-storage!)
  (render/render!)
  (map-panel-ui.layout/sync-layout!)
  (map-panel-ui.layout/observe-nav! map-sync/schedule-map-resize!)
  (app-load/init-load!)
  (.addEventListener js/document "keydown" keyboard/on-document-keydown!)
  (.addEventListener js/document "paste" clipboard/on-document-paste!)
  (.addEventListener js/document "click"
    (fn [e]
      (when-let [link (.closest (.-target e) ".map-popup-source-link")]
        (.preventDefault e)
        (when-let [href (.getAttribute link "href")]
          (when-let [[_ hash] (re-find #"(#.+)$" href)]
            (set! (.-hash js/location) hash)))
        (nav/navigate! :about))))
  (.addEventListener js/window "resize" #(map-sync/schedule-map-resize!))
  (try (nav/track-page! (:page @state/!state)) (catch :default _ nil))
  (backend/check-backend!)
  (js/setInterval backend/check-backend! 5000))
