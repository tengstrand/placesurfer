(ns placesurfer.html.sanitize
  (:require [clojure.string :as str]))

(def ^:private allowed-tags
  #{"a" "br" "p" "strong" "em" "b" "i" "ul" "ol" "li" "img"})

(def ^:private allowed-img-classes
  #{"description-maps-icon" "description-open-icon"})

(def ^:private blocked-with-content
  #{"script" "style" "iframe" "object" "embed" "svg" "form"})

(def ^:private br-placeholder "[[[BR]]]")

(defn- preprocess-br-tags [s]
  (str/replace s #"(?i)<br\s*/?>" br-placeholder))

(defn- postprocess-br-tags [s]
  (str/replace s br-placeholder "<br>"))

(defn- escape-text [s]
  (-> (str s)
      (str/replace #"&(?!amp;|lt;|gt;|quot;|#)" "&amp;")
      (str/replace "<" "&lt;")
      (str/replace ">" "&gt;")
      (str/replace "\"" "&quot;")))

(defn- text-with-breaks [s]
  (let [normalized (str/replace s "\r\n" "\n")
        parts (str/split normalized #"\n" -1)]
    (str/join "<br>" (map escape-text parts))))

(defn- plain-text? [s]
  (not (re-find #"<" s)))

(defn- safe-href? [href]
  (when-let [h (not-empty (str/trim (str href)))]
    (let [lower (str/lower-case h)]
      (or (str/starts-with? lower "http://")
          (str/starts-with? lower "https://")
          (str/starts-with? lower "mailto:")
          (and (str/starts-with? lower "/")
               (not (str/starts-with? lower "//")))))))

(defn- strip-dangerous-blocks [s]
  (reduce (fn [acc tag]
            (-> acc
                (str/replace (re-pattern (str "(?is)<" tag "\\b[^>]*>.*?</" tag ">")) "")
                (str/replace (re-pattern (str "(?is)<" tag "\\b[^>]*/>")) "")
                (str/replace (re-pattern (str "(?is)<" tag ">.*?</" tag ">")) "")))
          s
          blocked-with-content))

(defn- remove-comments [s]
  (str/replace s #"(?s)<!--.*?-->" ""))

(defn- strip-void-blocked-tags [s]
  (str/replace s #"(?i)<(input|link|meta|base|iframe|object|embed|svg|form)\b[^>]*/?>" ""))

(defn- extract-attr [attrs attr-name]
  (when-let [m (re-find (re-pattern (str "(?i)" attr-name "\\s*=\\s*(\"([^\"]*)\"|'([^']*)'|([^\\s>]+))"))
                         (str attrs))]
    (or (nth m 2) (nth m 3) (nth m 4))))

(defn- extract-href [attrs]
  (extract-attr attrs "href"))

(defn- safe-img-src? [src]
  (when-let [s (not-empty (str/trim (str src)))]
    (let [lower (str/lower-case s)]
      (and (str/starts-with? lower "/images/")
           (not (str/includes? lower "javascript:"))
           (not (str/includes? lower "data:"))))))

(defn- safe-img-class? [class-name]
  (contains? allowed-img-classes (str/trim (str class-name))))

(defn- strip-event-attrs [attrs]
  (str/replace (str attrs) #"(?i)\s+on\w+\s*=\s*(\"[^\"]*\"|'[^']*'|[^\s>]+)" ""))

(defn- strip-unsafe-url-attrs [attrs]
  (-> (str attrs)
      (str/replace #"(?i)\s+(href|src)\s*=\s*(\"|')?\s*javascript:[^\"'\s>]*(\"|')?" "")
      (str/replace #"(?i)\s+(href|src)\s*=\s*(\"|')?\s*data:[^\"'\s>]*(\"|')?" "")
      (str/replace #"(?i)\s+(href|src)\s*=\s*(\"|')?\s*vbscript:[^\"'\s>]*(\"|')?" "")))

(defn- parse-open-tag [s]
  (when-let [m (re-find #"^<(?!br\b)(\w+)([^>]*?)(/?)>" s)]
    (let [tag (str/lower-case (nth m 1))
          attrs (strip-unsafe-url-attrs (strip-event-attrs (nth m 2)))
          self-close (= "/" (nth m 3))]
      {:tag tag
       :void (or self-close (= "img" tag))
       :href (when (= "a" tag) (extract-href attrs))
       :src (when (= "img" tag) (extract-attr attrs "src"))
       :class (when (= "img" tag) (extract-attr attrs "class"))
       :len (count (nth m 0))})))

(defn- parse-close-tag [s]
  (when-let [m (re-find #"^</(\w+)\s*>" s)]
    {:tag (str/lower-case (nth m 1))
     :len (count (nth m 0))}))

(defn- parse-nodes
  ([s] (parse-nodes s nil))
  ([s parent-tag]
   (loop [remaining s nodes []]
     (cond
       (str/blank? remaining)
       {:nodes nodes :rest remaining}

       (= \< (nth remaining 0))
       (let [rest remaining]
         (cond
           (re-find #"^<!--" rest)
           (let [end (or (str/index-of rest "-->") (count rest))
                 after (+ end 3)]
             (recur (subs rest after) nodes))

           (and parent-tag
                (when-let [close (parse-close-tag rest)]
                  (= (:tag close) parent-tag)))
           {:nodes nodes :rest (subs rest (:len (parse-close-tag rest)))}

           :else
           (if-let [{:keys [tag void href src class len]} (parse-open-tag rest)]
             (cond
               (contains? blocked-with-content tag)
               (let [inner (subs rest len)
                     close-match (re-find (re-pattern (str "(?i)</" tag "\\s*>")) inner)]
                 (if close-match
                   (let [close-start (str/index-of inner (first close-match))
                         after (+ len close-start (count (first close-match)))]
                     (recur (subs rest after) nodes))
                   (recur "" nodes)))

               void
               (recur (subs rest len)
                      (conj nodes {:type :element :tag tag :href href :src src :class class :children []}))

               :else
               (let [inner (subs rest len)
                     parsed (parse-nodes inner tag)
                     child-nodes (:nodes parsed)
                     child-rest (:rest parsed)]
                 (recur child-rest
                        (conj nodes {:type :element :tag tag :href href :src src :class class :children child-nodes}))))
             (recur (subs rest 1) (conj nodes {:type :text :content "<"})))))

       :else
       (let [idx (str/index-of remaining "<")
             text (if idx (subs remaining 0 idx) remaining)
             after (if idx (subs remaining idx) "")]
         (recur after (conj nodes {:type :text :content text})))))))

(defn- render-node [{:keys [type tag href src class children content]}]
  (case type
    :text (postprocess-br-tags (text-with-breaks content))
    :element
    (let [inner (str/join "" (map render-node children))]
      (cond
        (and (= "a" tag) (safe-href? href))
        (str "<a href=\"" (escape-text href)
             "\" target=\"_blank\" rel=\"noopener noreferrer\">"
             inner
             "</a>")
        (and (= "img" tag) (safe-img-src? src) (safe-img-class? class))
        (str "<img class=\"" (escape-text class)
             "\" src=\"" (escape-text src)
             "\" alt=\"\" />")
        (= "a" tag)
        inner
        (= "img" tag)
        ""
        (contains? allowed-tags tag)
        (str "<" tag ">" inner "</" tag ">")
        :else inner))))

(defn- sanitize-html-content [s]
  (let [cleaned (-> s preprocess-br-tags remove-comments strip-dangerous-blocks strip-void-blocked-tags)
        {:keys [nodes]} (parse-nodes cleaned)]
    (str/join "" (map render-node nodes))))

(defn sanitize-description-html
  "Sanitize user-authored description HTML for safe popup rendering.

  Allows a small tag whitelist, strips scripts/event handlers/unsafe URLs,
  and converts plain-text newlines to <br>."
  [s]
  (let [text (str/trim (str (or s "")))]
    (if (empty? text)
      ""
      (postprocess-br-tags
       (if (plain-text? text)
         (text-with-breaks (preprocess-br-tags text))
         (sanitize-html-content text))))))
