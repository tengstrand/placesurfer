(ns hitteri.pin-ui.handlers.state
  "Shared pin-page state updates and render triggers."
  (:require [hitteri.app-ui.interface.effects :as effects]
            [hitteri.app-ui.interface.state :as app-state]
            [hitteri.pin-ui.handlers.map :as pin-map]))

(defn render! [] (effects/render!))

(defn swap-state! [f]
  (swap! app-state/!state f))

(defn swap-render! [f]
  (swap-state! f)
  (render!))

(defn update-form-field!
  [k v & {:keys [recenter?] :or {recenter? false}}]
  (swap-state! #(assoc-in % [:pin-form k] v))
  (render!)
  (when recenter?
    (pin-map/schedule-pin-map-sync! {:recenter? true})))

(defn clear-search-ui
  "Return state with search field and dropdown cleared."
  [s]
  (assoc s
         :pin-search-query ""
         :pin-search-results []
         :pin-search-highlight-index nil
         :pin-search-loading? false))
