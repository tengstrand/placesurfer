(ns hitteri.pin-ui.pure.editor-pane
  (:require [hitteri.pin-ui.pure.form-fields :as form-fields]
            [hitteri.pin-ui.pure.search-field :as search-field]
            [hitteri.map-panel-ui.interface.status :as map-panel-ui.status]))

(defn- form-content [props]
  (let [edit-mode? (= :edit (:pin-editor-mode props))
        new-mode? (= :new (:pin-editor-mode props))
        inline? (:pin-editor-inline? props false)
        show-search? (and (not inline?)
                          (or (:pin-show-search? props false)
                              (and new-mode? (not inline?))))
        show-form-fields? (or inline?
                              edit-mode?
                              (and new-mode? (not inline?)))]
    (into [:div.pin-editor-form]
          (concat (when show-form-fields? (form-fields/field-rows props))
                  (when show-search? [(search-field/search props)])))))

(defn editor-pane
  [{:keys [pin-message pin-editor-mode pin-editor-inline?
           cancel-pin-editor! confirm-pin-editor! pin-editor-ok-enabled? t]
    :or {t (fn [k] (name k))}
    :as props}]
  (let [confirm-label (if (= :new pin-editor-mode) (t :pin/add) (t :pin/update))
        show-actions? (not pin-editor-inline?)]
    [:div.pin-editor-pane
     (form-content props)
     (when-let [msg (map-panel-ui.status/display-status-text pin-message)]
       [:p.pin-editor-message msg])
     (when show-actions?
       [:div.pin-editor-actions
        [:button.pin-editor-ok
         {:type "button"
          :disabled (not pin-editor-ok-enabled?)
          :on {:click (fn [_] (confirm-pin-editor!))}}
         confirm-label]
        [:button.pin-editor-cancel
         {:type "button"
          :on {:click (fn [_] (cancel-pin-editor!))}}
         (t :common/cancel)]])]))
