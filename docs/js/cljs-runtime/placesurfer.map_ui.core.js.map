(ns placesurfer.map-ui.core
  "MapLibre integration.

  Public API is intentionally tiny:
    - mount-map!   create/attach map to an element (idempotent for same element)
    - destroy-map! tear down
    - resize-map!  resize visible map after layout changes
    - apply-state! replace markers and (optionally) fit bounds; safe to call
                   before mount, latest call always wins."
  (:require [placesurfer.map-ui.bounds :as bounds]
            [placesurfer.map-ui.markers :as markers]
            [placesurfer.map-ui.popup :as popup]))

(def ^:private style-url "https://tiles.openfreemap.org/styles/liberty")

(def ^:private default-view {:center [15.0 62.0] :zoom 4})
(def ^:private fit-padding 56)
(def ^:private fit-max-zoom 8)
(def ^:private fit-animate-duration-ms 700)
(def ^:private center-fly-duration-ms 700)
(def ^:private center-default-zoom 14)
(def ^:private hover-close-delay-ms 80)
(def ^:private marker-z-index-default "3")
(def ^:private marker-z-index-active "5")
(def ^:private popup-z-index "100")
(def ^:private marker-row-hover-class "placesurfer-marker--row-hover")
(def ^:private marker-map-hover-class "placesurfer-marker--map-hover")

;; --- state ---
;;
;; `!pending-state` holds the most recent desired marker+fit state. Whenever
;; the map becomes ready we apply it and clear it. New calls always overwrite
;; pending so the latest call wins, even if several arrive while the map style
;; is still loading.

(defonce !map (atom nil))
(defonce !map-container (atom nil))
(defonce !resize-observer (atom nil))
(defonce !markers (atom []))
(defonce !hover-popup (atom nil))
(defonce !marker-pick-handler (atom nil))
(defonce !country-pick-active? (atom false))
(defonce !country-pick-click-handler (atom nil))
(defonce !add-pin-mode-active? (atom false))
(defonce !add-pin-click-handler (atom nil))
(defonce !pending-state (atom nil))
(defonce !row-hover-match (atom nil))

(declare ensure-map-popup-guard! mock-map?)

;; --- map helpers ---

(defn- mock-map? [^js m]
  (true? (.-placesurferMockMap m)))

(defn- map-ready? [^js m]
  (cond
    (nil? m) false
    (mock-map? m) true
    :else
    (or (try (true? (.loaded m)) (catch :default _ false))
        (try (true? (.isStyleLoaded m)) (catch :default _ false)))))

(defn- safe-resize! [^js m]
  (when m
    (try (.resize m) (catch :default _ nil))))

(defn- map-attached? [^js m ^js el]
  (try
    (and m el (= el (.getContainer m)))
    (catch :default _ false)))

;; --- markers ---

(defn- marker-style-for [topic]
  (markers/style-for-topic topic))

(defn- marker-url-for [topic]
  (markers/url-for-topic topic))

(defn- draft-marker? [position]
  (true? (:draft? position)))

(defn- draft-url-pin? [position]
  (and (draft-marker? position)
       (= :url-pin (:marker-topic position))))

(defn- marker-pick-enabled? [position]
  (or (not (draft-marker? position))
      (draft-url-pin? position)))

(defn- img-marker? [topic]
  (markers/img-marker? topic))

(defn- marker-transform-origin [anchor]
  (if (= anchor "center") "center center" "center bottom"))

(defn- marker-visual-el [^js root-el]
  (when root-el
    (.querySelector root-el ".placesurfer-marker__visual")))

(defn- marker-visual-el-from-marker [^js marker]
  (some-> (try (.getElement marker) (catch :default _ nil))
          marker-visual-el))

(defn- marker-element
  ([topic] (marker-element topic nil nil))
  ([topic image-url-override] (marker-element topic image-url-override nil))
  ([topic image-url-override anchor-override]
   (let [el (.createElement js/document "div")
         visual (.createElement js/document "div")
         {:keys [width-px height-px background-position anchor]} (marker-style-for topic)
         anchor (or anchor-override anchor)
         image-url (or image-url-override (marker-url-for topic))
         img? (img-marker? topic)]
    (.add el.classList "maplibregl-marker" "placesurfer-marker")
    (.add visual.classList "placesurfer-marker__visual")
    (when (= topic :url-pin)
      (.add el.classList "placesurfer-marker--url-pin"))
    (when (= topic :location)
      (.add el.classList "placesurfer-marker--location"))
    (when (= topic :pin)
      (.add el.classList "placesurfer-marker--pin"))
    (when (= topic :removed)
      (.add el.classList "placesurfer-marker--removed"))
    (set! (.. el -style -width) (str width-px "px"))
    (set! (.. el -style -height) (str height-px "px"))
    (set! (.. el -style -lineHeight) "0")
    (set! (.. el -style -backgroundColor) "transparent")
    (set! (.. el -style -cursor) "pointer")
    (set! (.. el -style -overflow) "visible")
    (set! (.. visual -style -width) "100%")
    (set! (.. visual -style -height) "100%")
    (set! (.. visual -style -lineHeight) "0")
    (set! (.. visual -style -transformOrigin) (marker-transform-origin anchor))
    (set! (.. visual -style -transition) "transform 120ms ease-out")
    (when img?
      (set! (.. el -style -zIndex) marker-z-index-default)
      (let [img (.createElement js/document "img")]
        (set! (.-src img) image-url)
        (set! (.-alt img) "")
        (set! (.-draggable img) false)
        (set! (.. img -style -width) "100%")
        (set! (.. img -style -height) "100%")
        (set! (.. img -style -display) "block")
        (set! (.. img -style -pointerEvents) "none")
        (.appendChild visual img)))
    (when-not img?
      (set! (.. visual -style -backgroundImage) (str "url('" image-url "')"))
      (set! (.. visual -style -backgroundSize) "contain")
      (set! (.. visual -style -backgroundRepeat) "no-repeat")
      (set! (.. visual -style -backgroundPosition) background-position))
    (.appendChild el visual)
    el)))

(defn- clear-markers! []
  (doseq [marker @!markers]
    (try (.remove marker) (catch :default _)))
  (reset! !markers [])
  (reset! !hover-popup nil)
  (reset! !row-hover-match nil))

;; --- draw tool ---

(def ^:private draw-src  "placesurfer-draw")
(def ^:private draw-fill "placesurfer-draw-fill")
(def ^:private draw-line "placesurfer-draw-line")
(def ^:private draw-vtx  "placesurfer-draw-vertex")

(defonce !draw-active?      (atom false))
(defonce !draw-page-active? (atom false))
(defonce !draw-ring     (atom []))   ; in-progress polygon ring
(defonce !draw-polygons (atom []))   ; completed rings [[lng lat] ...]
(defonce !draw-drag     (atom nil))  ; {:type :polygon/:current :polygon-idx :vertex-idx}
(defonce !draw-hover-v  (atom nil))  ; vertex currently under cursor
(defonce !skip-click?   (atom false))
(defonce !draw-click-fn     (atom nil))
(defonce !draw-mm-fn        (atom nil))
(defonce !draw-md-fn        (atom nil))
(defonce !draw-mu-fn        (atom nil))
(defonce !draw-on-save      (atom nil)) ; (fn [fc]) called when user clicks Spara
(defonce !draw-on-map-ready (atom nil)) ; (fn []) called when map becomes ready, if on draw page
(defonce !draw-t            (atom (fn [k] (name k)))) ; translation fn

(defn- draw-fc []
  (let [done  (mapv (fn [ring]
                      {:type "Feature"
                       :geometry {:type "Polygon"
                                  :coordinates [(conj (vec ring) (first ring))]}
                       :properties {}})
                    @!draw-polygons)
        cur   (when (seq @!draw-ring)
                {:type "Feature"
                 :geometry {:type "LineString" :coordinates @!draw-ring}
                 :properties {:wip true}})
        verts (concat
               (mapcat (fn [ring]
                         (map (fn [[lng lat]]
                                {:type "Feature"
                                 :geometry {:type "Point" :coordinates [lng lat]}
                                 :properties {}})
                              ring))
                       @!draw-polygons)
               (map (fn [[lng lat]]
                      {:type "Feature"
                       :geometry {:type "Point" :coordinates [lng lat]}
                       :properties {:wip true}})
                    @!draw-ring))]
    {:type "FeatureCollection"
     :features (cond-> (vec verts) true (into done) cur (conj cur))}))

(defn- refresh-draw! [^js m]
  (when-let [^js src (try (.getSource m draw-src) (catch :default _ nil))]
    (.setData src (clj->js (draw-fc)))))

(defn- set-draw-layer-visibility! [^js m layer-id visible?]
  (try
    (when (try (.getLayer m layer-id) (catch :default _ nil))
      (.setLayoutProperty m layer-id "visibility" (if visible? "visible" "none")))
    (catch :default _ nil)))

(defn- set-draw-canvas-visibility! [^js m visible?]
  (set-draw-layer-visibility! m draw-fill visible?)
  (set-draw-layer-visibility! m draw-line visible?)
  ; vertices only shown when both canvas is visible AND draw mode is active
  (set-draw-layer-visibility! m draw-vtx (and visible? @!draw-active?)))

(defn- ensure-draw-layers! [^js m]
  (if (try (.getSource m draw-src) (catch :default _ nil))
    (when @!draw-active? (set-draw-layer-visibility! m draw-vtx true))
    (do
      (.addSource m draw-src (clj->js {:type "geojson" :data (draw-fc)}))
      (.addLayer m (clj->js {:id draw-fill :type "fill" :source draw-src
                              :filter ["==" ["geometry-type"] "Polygon"]
                              :paint {"fill-color" "#ff4500" "fill-opacity" 0.35}}))
      (.addLayer m (clj->js {:id draw-line :type "line" :source draw-src
                              :paint {"line-color" "#cc3300" "line-width" 2
                                      "line-dasharray" [2 1]}}))
      (.addLayer m (clj->js {:id draw-vtx :type "circle" :source draw-src
                              :filter ["==" ["geometry-type"] "Point"]
                              :paint {"circle-radius" 5 "circle-color" "#cc3300"
                                      "circle-stroke-width" 2
                                      "circle-stroke-color" "#fff"}}))
      ; all layers hidden by default — shown when on draw page
      (set-draw-canvas-visibility! m false))))

(defn- all-draw-vertices []
  (concat
   (mapcat (fn [pidx ring]
             (map-indexed (fn [vidx [lng lat]]
                            {:type :polygon :polygon-idx pidx :vertex-idx vidx
                             :lng lng :lat lat})
                          ring))
           (range) @!draw-polygons)
   (map-indexed (fn [vidx [lng lat]]
                  {:type :current :vertex-idx vidx :lng lng :lat lat})
                @!draw-ring)))

(defn- vertex-near-screen [^js m x y px]
  (some (fn [v]
          (let [^js pt (.project m #js {:lng (:lng v) :lat (:lat v)})
                d (js/Math.hypot (- x (.-x pt)) (- y (.-y pt)))]
            (when (< d px) v)))
        (all-draw-vertices)))

(defn- move-vertex! [v lng lat]
  (case (:type v)
    :polygon (swap! !draw-polygons
                    (fn [ps] (assoc-in ps [(:polygon-idx v) (:vertex-idx v)] [lng lat])))
    :current (swap! !draw-ring
                    (fn [r] (assoc (vec r) (:vertex-idx v) [lng lat])))))

(defn- polygons->fc [rings]
  {:type "FeatureCollection"
   :features (mapv (fn [ring]
                     {:type "Feature"
                      :geometry {:type "Polygon"
                                 :coordinates [(conj (vec ring) (first ring))]}
                      :properties {}})
                   rings)})

(defn- save-draw! []
  (let [fc (polygons->fc @!draw-polygons)]
    (if-let [f @!draw-on-save]
      (f fc)
      ; fallback: download if no save handler registered
      (let [json (.stringify js/JSON (clj->js fc))
            blob (js/Blob. #js [json] #js {:type "application/json"})
            url  (.createObjectURL js/URL blob)
            a    (.createElement js/document "a")]
        (set! (.-href a) url)
        (set! (.-download a) "flood.geojson")
        (.click a)
        (js/setTimeout #(.revokeObjectURL js/URL url) 1000)))))

(defn- close-polygon! [^js m]
  (when (>= (count @!draw-ring) 3)
    (swap! !draw-polygons conj @!draw-ring)
    (reset! !draw-ring [])
    (refresh-draw! m)
    (save-draw!)))

(defn- undo-point! [^js m]
  (if (seq @!draw-ring)
    (swap! !draw-ring #(vec (butlast %)))
    (when (seq @!draw-polygons)
      (reset! !draw-ring (last @!draw-polygons))
      (swap! !draw-polygons #(vec (butlast %)))))
  (refresh-draw! m))

(defn- clear-draw! [^js m]
  (reset! !draw-ring [])
  (reset! !draw-polygons [])
  (refresh-draw! m)
  (save-draw!))

(defn- detach-draw-handlers! [^js m]
  (doseq [[!a ev] [[!draw-click-fn "click"]
                   [!draw-mm-fn    "mousemove"]
                   [!draw-md-fn    "mousedown"]
                   [!draw-mu-fn    "mouseup"]]]
    (when-let [f @!a]
      (try (.off m ev f) (catch :default _))
      (reset! !a nil))))

(defn- attach-draw-handlers! [^js m]
  (let [click-fn (fn [^js e]
                   (when @!draw-active?
                     (when-not @!skip-click?
                       (let [^js ll (.-lngLat e)]
                         (swap! !draw-ring conj [(.-lng ll) (.-lat ll)])
                         (refresh-draw! m)))
                     (reset! !skip-click? false)))
        mm-fn    (fn [^js e]
                   (when @!draw-active?
                     (let [^js pt (.-point e)
                           x (.-x pt) y (.-y pt)]
                       (if-let [ds @!draw-drag]
                         (do (let [^js ll (.-lngLat e)]
                               (move-vertex! ds (.-lng ll) (.-lat ll)))
                             (refresh-draw! m))
                         (let [v (vertex-near-screen m x y 8)]
                           (reset! !draw-hover-v v)
                           (set-map-cursor! m (if v "pointer" "default")))))))
        md-fn    (fn [^js _e]
                   (when (and @!draw-active? @!draw-hover-v)
                     (reset! !draw-drag @!draw-hover-v)
                     (reset! !skip-click? true)
                     (try (.disable (.-dragPan m)) (catch :default _))
                     (set-map-cursor! m "grabbing")))
        mu-fn    (fn [^js _e]
                   (when @!draw-drag
                     (reset! !draw-drag nil)
                     (try (.enable (.-dragPan m)) (catch :default _))
                     (set-map-cursor! m (if @!draw-hover-v "pointer" "default"))))]
    (reset! !draw-click-fn click-fn)
    (reset! !draw-mm-fn mm-fn)
    (reset! !draw-md-fn md-fn)
    (reset! !draw-mu-fn mu-fn)
    (.on m "click"     click-fn)
    (.on m "mousemove" mm-fn)
    (.on m "mousedown" md-fn)
    (.on m "mouseup"   mu-fn)))

(defn- btn-style! [^js el text bg]
  (set! (.-textContent el) text)
  (doseq [[k v] [["padding" "4px 8px"] ["display" "block"] ["width" "100%"]
                 ["border" "none"] ["cursor" "pointer"] ["fontSize" "11px"]
                 ["fontWeight" "600"] ["color" "white"] ["marginBottom" "2px"]
                 ["borderRadius" "3px"] ["textAlign" "left"] ["background" bg]]]
    (aset (.-style el) k v)))

(defn- make-draw-ctrl [^js m]
  (let [t          @!draw-t
        el         (.createElement js/document "div")
        toggle-btn (.createElement js/document "button")
        close-btn  (.createElement js/document "button")
        undo-btn   (.createElement js/document "button")
        clear-btn  (.createElement js/document "button")
        save-btn   (.createElement js/document "button")
        update!    (fn [active?]
                     (btn-style! toggle-btn
                                 (if active? (t :draw/stop) (t :draw/start))
                                 (if active? "#9b2c2c" "#2b6cb0")))]
    (.add (.-classList el) "maplibregl-ctrl" "maplibregl-ctrl-group" "placesurfer-draw-ctrl")
    (set! (.. el -style -padding) "6px")
    (set! (.. el -style -minWidth) "128px")
    (set! (.. el -style -margin) "10px 0 0 10px")
    (btn-style! toggle-btn (t :draw/start)        "#2b6cb0")
    (btn-style! close-btn  (t :draw/close-polygon) "#276749")
    (btn-style! undo-btn   (t :draw/undo-point)   "#744210")
    (btn-style! clear-btn  (t :draw/clear-all)    "#822727")
    (btn-style! save-btn   (str "💾 " (t :common/save)) "#1a365d")
    (.addEventListener toggle-btn "click"
                       (fn []
                         (if @!draw-active?
                           (do (detach-draw-handlers! m)
                               (reset! !draw-active? false)
                               (reset! !draw-drag nil)
                               (reset! !draw-hover-v nil)
                               (reset! !skip-click? false)
                               (try (.enable (.-dragPan m)) (catch :default _))
                               (set-map-cursor! m "grab")
                               (set-draw-layer-visibility! m draw-vtx false)
                               (update! false))
                           (do (ensure-draw-layers! m)
                               (attach-draw-handlers! m)
                               (reset! !draw-active? true)
                               (set-map-cursor! m "default")
                               (set-draw-layer-visibility! m draw-vtx true)
                               (update! true)))))
    (.addEventListener close-btn "click" #(close-polygon! m))
    (.addEventListener undo-btn  "click" #(undo-point! m))
    (.addEventListener clear-btn "click" #(clear-draw! m))
    (.addEventListener save-btn  "click" save-draw!)
    (doseq [b [toggle-btn close-btn undo-btn clear-btn save-btn]]
      (.appendChild el b))
    #js {:onAdd (fn [_] el) :onRemove (fn [] nil)}))

(defn deactivate-draw-mode! []
  (reset! !draw-page-active? false)
  (when-let [^js m @!map]
    (when @!draw-active?
      (detach-draw-handlers! m)
      (reset! !draw-active? false)
      (reset! !draw-drag nil)
      (reset! !draw-hover-v nil)
      (reset! !skip-click? false)
      (try (.enable (.-dragPan m)) (catch :default _))
      (set-map-cursor! m "grab"))
    (set-draw-canvas-visibility! m false)))

(defn set-draw-on-save!
  "Register a callback (fn [geojson-clj-map]) called when user clicks Spara."
  [f]
  (reset! !draw-on-save f))

(defn set-draw-on-map-ready!
  "Register a (fn []) called once after the map finishes loading.
   Used to load the initial draw layer if the map wasn't ready on first navigation."
  [f]
  (reset! !draw-on-map-ready f))

(defn set-draw-t!
  "Set the translation function (fn [key]) used for draw toolbar labels."
  [f]
  (reset! !draw-t f))

(defn load-draw-layer!
  "Load a layer by fetching its GeoJSON and populating the draw canvas."
  [layer-id]
  (reset! !draw-page-active? true)
  (when-let [^js m @!map]
    (-> (js/fetch (str "/data/layers/" layer-id ".geojson"))
        (.then (fn [resp]
                 (when (.-ok resp) (.json resp))))
        (.then (fn [^js geojson]
                 (reset! !draw-ring [])
                 (if geojson
                   (let [features (js->clj (.-features geojson) :keywordize-keys true)
                         rings (keep (fn [f]
                                       (let [coords (get-in f [:geometry :coordinates 0])]
                                         (when (seq coords)
                                           (mapv (fn [[lng lat]] [lng lat]) (butlast coords)))))
                                     features)]
                     (reset! !draw-polygons (vec rings)))
                   (reset! !draw-polygons []))
                 (when (and (map-ready? m) @!draw-page-active?)
                   (ensure-draw-layers! m)
                   (refresh-draw! m)
                   (set-draw-canvas-visibility! m true))))
        (.catch (fn [_]
                  (reset! !draw-ring [])
                  (reset! !draw-polygons [])
                  (when (and (map-ready? m) @!draw-page-active?)
                    (ensure-draw-layers! m)
                    (refresh-draw! m)
                    (set-draw-canvas-visibility! m true)))))))

(defn- add-draw-toolbar! [^js m]
  (when-not (.-placesurferDrawAdded m)
    (set! (.-placesurferDrawAdded m) true)
    (.addControl m (make-draw-ctrl m) "top-left")))

;; --- flood overlay ---

(def ^:private flood-source-id "placesurfer-flood-zones")
(def ^:private flood-fill-layer-id "placesurfer-flood-fill")
(def ^:private flood-data-url "/data/layers/flood.geojson")

(defn- remove-flood-layers! [^js m]
  (try
    (when (.getLayer m flood-fill-layer-id) (.removeLayer m flood-fill-layer-id))
    (when (.getSource m flood-source-id) (.removeSource m flood-source-id))
    (catch :default _ nil)))

(defn- add-flood-layers! [^js m]
  (when-not (.getSource m flood-source-id)
    (.addSource m flood-source-id
                (clj->js {:type "geojson"
                           :data flood-data-url}))
    (.addLayer m (clj->js {:id flood-fill-layer-id
                             :type "fill"
                             :source flood-source-id
                             :paint {"fill-color" "#ff0000"
                                     "fill-opacity" 0.25}}))))

(defn- do-sync-overlay-layers! [^js m active-overlays]
  (try
    (if (contains? active-overlays :flood)
      (add-flood-layers! m)
      (remove-flood-layers! m))
    (catch :default _ nil)))

(defn sync-overlay-layers!
  "Show or hide map overlay layers based on the set of active overlay keywords."
  [active-overlays]
  (when-let [^js m @!map]
    (if (map-ready? m)
      (do-sync-overlay-layers! m active-overlays)
      (.once m "load" (fn [_]
                        (when-let [m2 @!map]
                          (do-sync-overlay-layers! m2 active-overlays)))))))

;; --- area circles ---

(def ^:private area-source-id "placesurfer-area-circles")
(def ^:private area-fill-layer-id "placesurfer-area-fill")
(def ^:private area-line-layer-id "placesurfer-area-line")

(defn- remove-area-layers! [^js m]
  (try
    (when (.getLayer m area-fill-layer-id) (.removeLayer m area-fill-layer-id))
    (when (.getLayer m area-line-layer-id) (.removeLayer m area-line-layer-id))
    (when (.getSource m area-source-id) (.removeSource m area-source-id))
    (catch :default _ nil)))

(defn- circle-coords [lng lat radius-km]
  (let [steps  64
        d      (/ radius-km 6371.0)
        lat-r  (* lat (/ js/Math.PI 180))
        lng-r  (* lng (/ js/Math.PI 180))
        pts    (mapv (fn [i]
                       (let [angle (/ (* i 2 js/Math.PI) steps)
                             lat2  (js/Math.asin
                                    (+ (* (js/Math.sin lat-r) (js/Math.cos d))
                                       (* (js/Math.cos lat-r) (js/Math.sin d) (js/Math.cos angle))))
                             lng2  (+ lng-r
                                      (js/Math.atan2
                                       (* (js/Math.sin angle) (js/Math.sin d) (js/Math.cos lat-r))
                                       (- (js/Math.cos d) (* (js/Math.sin lat-r) (js/Math.sin lat2)))))
                             lat2d (* lat2 (/ 180 js/Math.PI))
                             lng2d (* lng2 (/ 180 js/Math.PI))]
                         [lng2d lat2d]))
                     (range steps))]
    (conj pts (first pts))))

(defn- positions->circle-features [positions]
  (vec (mapcat (fn [{:keys [longitude latitude area-radii]}]
                 (when (and (seq area-radii) (number? longitude) (number? latitude))
                   (map (fn [r]
                          {:type "Feature"
                           :geometry {:type "Polygon"
                                      :coordinates [(circle-coords longitude latitude r)]}})
                        area-radii)))
               positions)))

(defn- apply-area-circles! [^js m positions]
  (try
    (remove-area-layers! m)
    (let [features (positions->circle-features positions)]
      (when (seq features)
        (.addSource m area-source-id
                    (clj->js {:type "geojson"
                               :data {:type "FeatureCollection" :features features}}))
        (.addLayer m (clj->js {:id area-fill-layer-id
                                :type "fill"
                                :source area-source-id
                                :paint {"fill-color" "#3b82f6"
                                        "fill-opacity" 0.08}}))
        (.addLayer m (clj->js {:id area-line-layer-id
                                :type "line"
                                :source area-source-id
                                :paint {"line-color" "#3b82f6"
                                        "line-width" 1.5
                                        "line-opacity" 0.5}}))))
    (catch :default _ nil)))

;; --- popup interactions (hover + click) ---

(defn- reset-marker-layering! []
  (doseq [^js marker @!markers]
    (when-let [^js el (try (.getElement marker) (catch :default _ nil))]
      (set! (.. el -style -zIndex) marker-z-index-default))))

(defn- elevate-active-marker! [^js marker]
  (reset-marker-layering!)
  (when-let [^js el (try (.getElement marker) (catch :default _ nil))]
    (set! (.. el -style -zIndex) marker-z-index-active)))

(defn- elevate-popup-layer! [^js popup]
  (when-let [^js el (try (.getElement popup) (catch :default _ nil))]
    (set! (.. el -style -zIndex) popup-z-index)))

(defn- popup-open-mode [^js popup]
  (.-placesurferOpenMode popup))

(defn- set-popup-open-mode! [^js popup mode]
  (set! (.-placesurferOpenMode popup) mode))

(defn- cancel-hover-close! [^js popup]
  (when-let [timer (.-placesurferCloseTimer popup)]
    (js/clearTimeout timer)
    (set! (.-placesurferCloseTimer popup) nil)))

(defn- popup-open? [^js popup]
  (true? (.isOpen ^js popup)))

(defn- marker-popup-open? [^js marker]
  (when-let [^js popup (try (.getPopup marker) (catch :default _ nil))]
    (popup-open? popup)))

(defn- any-marker-popup-open? []
  (boolean (some marker-popup-open? @!markers)))

(defn- position-map [position]
  (if (map? position)
    position
    (js->clj position :keywordize-keys true)))

(defn- marker-position-data [^js marker]
  (or (aget marker "placesurferPositionClj")
      (some-> (aget marker "placesurferPosition") position-map)))

(defn- augment-marker-click-position [^js root-el pos]
  (if (and pos root-el (.contains (.-classList root-el) "placesurfer-marker--pin"))
    (assoc pos :marker-topic :pin)
    pos))

(defn- position-match? [pos {:keys [id longitude latitude]}]
  (or (and id (= id (:id pos)))
      (and (number? longitude) (number? latitude)
           (= longitude (:longitude pos))
           (= latitude (:latitude pos)))))

(defn- find-marker-by-match [match]
  (some (fn [^js marker]
          (try
            (let [pos (marker-position-data marker)]
              (when (and pos (position-match? pos match))
                marker))
            (catch :default _ nil)))
        @!markers))

(defn- refresh-row-hover-emphasis! []
  (doseq [^js marker @!markers]
    (when-let [^js visual (marker-visual-el-from-marker marker)]
      (.remove visual.classList marker-row-hover-class)))
  (when-let [match @!row-hover-match]
    (when-let [^js marker (find-marker-by-match match)]
      (when-let [^js visual (marker-visual-el-from-marker marker)]
        (.add visual.classList marker-row-hover-class)))))

(defn set-marker-row-emphasis!
  "Scale the map marker matching `match` (:id or :longitude/:latitude) while a list row is hovered."
  [match]
  (when (or (:id match)
            (and (number? (:longitude match)) (number? (:latitude match))))
    (reset! !row-hover-match match)
    (refresh-row-hover-emphasis!)))

(defn clear-marker-row-emphasis!
  "Restore map marker size after list row hover ends."
  []
  (reset! !row-hover-match nil)
  (refresh-row-hover-emphasis!))

(defn close-all-popups! []
  (doseq [^js marker @!markers]
    (when-let [^js popup (try (.getPopup marker) (catch :default _ nil))]
      (cancel-hover-close! popup)
      (set-popup-open-mode! popup nil)
      (when (popup-open? popup)
        (try (.togglePopup marker) (catch :default _)))))
  (reset! !hover-popup nil)
  (reset-marker-layering!))

(defn- close-popup! [^js marker ^js popup]
  (cancel-hover-close! popup)
  (when (popup-open? popup)
    (try (.togglePopup marker) (catch :default _)))
  (set-popup-open-mode! popup nil)
  (when (= popup (:popup @!hover-popup))
    (reset! !hover-popup nil))
  (when-not (any-marker-popup-open?)
    (reset-marker-layering!)))

(defn- open-popup! [^js marker ^js popup mode root-el]
  (close-all-popups!)
  (try (.togglePopup marker) (catch :default _))
  (set-popup-open-mode! popup mode)
  (elevate-active-marker! marker)
  (elevate-popup-layer! popup)
  (reset! !hover-popup {:marker marker
                        :popup popup
                        :root-el root-el}))

(defn open-marker-popup!
  "Open the click popup on the marker matching `match` (:id or :longitude/:latitude)."
  [{:keys [id longitude latitude] :as match}]
  (when (or id (and (number? longitude) (number? latitude)))
    (some (fn [^js marker]
            (try
              (let [pos (marker-position-data marker)]
                (when (and pos (position-match? pos match))
                  (when-let [^js popup (.getPopup marker)]
                    (when-let [^js root-el (.getElement marker)]
                      (open-popup! marker popup "click" root-el)
                      true))))
              (catch :default _ nil)))
          @!markers)))

(defn- schedule-hover-close! [^js marker ^js popup]
  (when (= "hover" (popup-open-mode popup))
    (cancel-hover-close! popup)
    (set! (.-placesurferCloseTimer popup)
          (js/setTimeout
           (fn []
             (set! (.-placesurferCloseTimer popup) nil)
             (when (= "hover" (popup-open-mode popup))
               (close-popup! marker popup)))
           hover-close-delay-ms))))

(defn- el-contains-point? [^js el client-x client-y]
  (when (and el (number? client-x) (number? client-y))
    (let [^js rect (.getBoundingClientRect el)]
      (and (<= (.-left rect) client-x (.-right rect))
           (<= (.-top rect) client-y (.-bottom rect))))))

(defn- map-event-client-point [^js e]
  (let [^js dom (or (.-originalEvent e) e)]
    #js {:x (.-clientX dom) :y (.-clientY dom)}))

(defn- pointer-over-hover-zone? [client-x client-y]
  (if-let [{:keys [root-el marker popup]} @!hover-popup]
    (let [^js marker marker
          ^js popup popup]
      (or (el-contains-point? root-el client-x client-y)
          (when-let [^js popup-el (.getElement popup)]
            (el-contains-point? popup-el client-x client-y))
          (when-let [^js marker-el (.getElement marker)]
            (el-contains-point? marker-el client-x client-y))))
    false))

(defn- set-map-cursor! [^js m cursor]
  (when-let [^js canvas (try (.getCanvas m) (catch :default _ nil))]
    (set! (.. canvas -style -cursor) cursor)))

(defn- ensure-map-country-pick-click! [^js m]
  (when-not (.-placesurferCountryPickClick m)
    (set! (.-placesurferCountryPickClick m) true)
    (.on m "click"
         (fn [^js e]
           (when @!country-pick-active?
             (when-let [handler @!country-pick-click-handler]
               (let [^js ll (.-lngLat e)]
                 (when (and ll (number? (.-lng ll)) (number? (.-lat ll)))
                   (handler {:longitude (.-lng ll)
                             :latitude (.-lat ll)})))))))))

(defn- click-inside-popup-or-marker? [^js target]
  (boolean
   (when target
     (or (.closest target ".maplibregl-popup")
         (.closest target ".map-marker-popup")
         (.closest target ".placesurfer-marker")
         (.closest target ".maplibregl-marker")))))

(defn- ensure-map-add-pin-click! [^js m]
  (when-not (.-placesurferAddPinClick m)
    (set! (.-placesurferAddPinClick m) true)
    (.on m "click"
         (fn [^js e]
           (when @!add-pin-mode-active?
             (let [^js target (.-target (or (.-originalEvent e) e))]
               (when-not (click-inside-popup-or-marker? target)
                 (when-let [handler @!add-pin-click-handler]
                   (let [^js ll (.-lngLat e)]
                     (when (and ll (number? (.-lng ll)) (number? (.-lat ll)))
                       (handler {:longitude (.-lng ll)
                                 :latitude (.-lat ll)})))))))))))

(defn- ensure-map-popup-guard! [^js map]
  (when-not (.-placesurferPopupGuard map)
    (set! (.-placesurferPopupGuard map) true)
    (.on map "mousemove"
         (fn [^js e]
           (when-let [{:keys [marker popup]} @!hover-popup]
             (when (= "hover" (popup-open-mode popup))
               (let [^js pt (map-event-client-point e)
                     x (.-x pt)
                     y (.-y pt)]
                 (when-not (pointer-over-hover-zone? x y)
                   (close-popup! marker popup)))))))
    (.on map "click"
         (fn [^js e]
           (when-let [{:keys [marker popup]} @!hover-popup]
             (when (popup-open? popup)
               (let [^js target (.-target (or (.-originalEvent e) e))]
                 (when-not (click-inside-popup-or-marker? target)
                   (close-popup! marker popup)))))))))

(defn- marker-click-position [^js marker ^js root-el position]
  (when-let [pos (or (marker-position-data marker)
                      (when (map? position) position)
                      (when root-el (aget root-el "placesurferPositionClj")))]
    (augment-marker-click-position root-el pos)))

(defn- attach-marker-interactions! [^js marker ^js popup ^js root-el position]
  (.addEventListener root-el "mouseenter"
                     (fn [_]
                       (when-not @!add-pin-mode-active?
                         (when-let [^js visual (marker-visual-el root-el)]
                           (.add visual.classList marker-map-hover-class))
                         (when-not (= "click" (popup-open-mode popup))
                           (open-popup! marker popup "hover" root-el)))))
  (.addEventListener root-el "mouseleave"
                     (fn [_]
                       (when-let [^js visual (marker-visual-el root-el)]
                         (.remove visual.classList marker-map-hover-class))
                       (when (= "hover" (popup-open-mode popup))
                         (schedule-hover-close! marker popup))))
  (when-not (.-placesurferPopupBridge popup)
    (set! (.-placesurferPopupBridge popup) true)
    (.on popup "open"
         (fn [_]
           (elevate-popup-layer! popup)
           (when-let [^js popup-el (.getElement popup)]
             (.addEventListener popup-el "mouseenter"
                                #(cancel-hover-close! popup))
             (.addEventListener popup-el "mouseleave"
                                #(schedule-hover-close! marker popup))))))
  (.addEventListener root-el "click"
                     (fn [^js e]
                       (.stopPropagation e)
                       (when-not @!add-pin-mode-active?
                         (when (marker-pick-enabled? position)
                           (let [handled? (when-let [handler @!marker-pick-handler]
                                            (when-let [pos (marker-click-position marker root-el position)]
                                              (handler pos)))]
                             (when-not handled?
                               (if (= "click" (popup-open-mode popup))
                                 (close-popup! marker popup)
                                 (open-popup! marker popup "click" root-el)))))))))

(defn- add-markers! [^js m positions popup-opts]
  (doseq [position positions]
    (let [{:keys [longitude latitude topic marker-topic marker-anchor marker-offset]} position
          resolved-topic (or marker-topic topic :discgolf)
          {:keys [anchor]} (marker-style-for resolved-topic)
          effective-anchor (or marker-anchor anchor)
          root-el (marker-element resolved-topic (:marker-icon-url position) effective-anchor)
          marker-opts (cond-> {:element root-el :anchor effective-anchor}
                        (seq marker-offset) (assoc :offset (clj->js marker-offset)))
          marker (js/maplibregl.Marker. (clj->js marker-opts))
          popup (js/maplibregl.Popup.
                 (clj->js {:closeButton false
                           :closeOnClick false
                           :offset 20
                           :className "map-marker-popup"}))]
      (aset marker "placesurferPosition" (clj->js position))
      (aset marker "placesurferPositionClj" position)
      (.setHTML popup (popup/popup-html position popup-opts))
      (.setLngLat marker #js [longitude latitude])
      (.setPopup marker popup)
      (attach-marker-interactions! marker popup root-el position)
      (.addTo marker m)
      (swap! !markers conj marker))))

;; --- fit ---

(defn- fit-mock-map! [^js m {:keys [west east south north]}]
  (set! (.-fitBoundsCalled m) true)
  (let [^js c (.getCenter m)]
    (set! (.-lng c) (/ (+ west east) 2.0))
    (set! (.-lat c) (/ (+ south north) 2.0)))
  (.setZoom m fit-max-zoom))

(defn- fit-lng-lat-box! [^js m box {:keys [animate?]}]
  (when (bounds/valid-lng-lat-box? box)
    ;; Expand a single-point box so MapLibre fitBounds has a real area to fit.
    (let [{:keys [west east south north]} (bounds/pad-degenerate-box box)]
      (if (mock-map? m)
        (fit-mock-map! m box)
        (let [lng-bounds (js/maplibregl.LngLatBounds.
                          #js [west south]
                          #js [east north])]
          (safe-resize! m)
          (.fitBounds m lng-bounds
                      (clj->js {:padding fit-padding
                                :maxZoom fit-max-zoom
                                :duration (if animate? fit-animate-duration-ms 0)})))))))

(defn- fit-bounds! [^js m positions {:keys [animate?]}]
  (when-let [box (bounds/fit-lng-lat-bounds positions)]
    (fit-lng-lat-box! m box {:animate? animate?})))

;; --- apply-state! (the core operation) ---

(defn- normalize-state [{:keys [positions fit? fit-bounds animate? draft-marker open-popup-for popup-opts]}]
  {:positions (vec positions)
   :fit-bounds fit-bounds
   :draft-marker draft-marker
   :open-popup-for open-popup-for
   :popup-opts (or popup-opts {})
   :fit? (boolean fit?)
   :animate? (if (some? animate?) (boolean animate?) true)})

(defn- apply-now! [^js m {:keys [positions fit? fit-bounds animate? draft-marker open-popup-for popup-opts]}]
  (when (identical? m @!map)
    (clear-markers!)
    (when (seq positions)
      (add-markers! m positions popup-opts))
    (when draft-marker
      (add-markers! m [draft-marker] popup-opts))
    (try (apply-area-circles! m (cond-> (vec positions) draft-marker (conj draft-marker)))
         (catch :default _ nil))
    (cond
      (and fit? (seq positions))
      (fit-bounds! m positions {:animate? animate?})

      (and fit? fit-bounds)
      (fit-lng-lat-box! m fit-bounds {:animate? animate?}))
    (when open-popup-for
      (open-marker-popup! open-popup-for))
    (refresh-row-hover-emphasis!)))

(defn- consume-pending! [^js m]
  (when-let [state @!pending-state]
    (reset! !pending-state nil)
    (apply-now! m state)))

(defn- schedule-consume-when-ready! [^js m]
  (doseq [delay-ms [0 50 150 400 800 1500]]
    (js/setTimeout
     (fn []
       (when (and (identical? m @!map) @!pending-state (map-ready? m))
         (consume-pending! m)))
     delay-ms)))

(defn set-marker-pick-handler!
  "When set, marker clicks invoke `handler` with a keywordized position map
   instead of toggling the hover/click popup."
  [handler]
  (reset! !marker-pick-handler handler))

(defn sync-country-pick-state!
  "Toggle country-pick mode: arrow cursor and map clicks invoke `on-click` when active."
  [{:keys [active? on-click]}]
  (reset! !country-pick-active? (boolean active?))
  (reset! !country-pick-click-handler (when active? on-click))
  (when-let [^js m @!map]
    (set-map-cursor! m (cond
                         active? "default"
                         @!add-pin-mode-active? "default"
                         :else "grab"))))

(defn sync-add-pin-mode!
  "Toggle add-pin mode: arrow cursor, map canvas clicks invoke `on-click` once,
   and marker hover/click interactions are suppressed while active."
  [{:keys [active? on-click]}]
  (reset! !add-pin-mode-active? (boolean active?))
  (reset! !add-pin-click-handler (when active? on-click))
  (when-let [^js el @!map-container]
    (if active?
      (.add (.-classList el) "map-add-pin-active")
      (.remove (.-classList el) "map-add-pin-active")))
  (when-let [^js m @!map]
    (set-map-cursor! m (cond
                         active? "default"
                         @!country-pick-active? "default"
                         :else "grab"))))

(defn map-view-state
  "Return {:longitude :latitude :zoom} for the current map view, or nil."
  []
  (when-let [^js m @!map]
    (when (map-ready? m)
      (let [^js c (.getCenter m)
            zoom (try (.getZoom m) (catch :default _ nil))]
        (when (and c (number? (.-lng c)) (number? (.-lat c)) (number? zoom))
          {:longitude (.-lng c)
           :latitude (.-lat c)
           :zoom zoom})))))

(defn map-center-coords
  "Return {:longitude :latitude} for the current map center, or nil."
  []
  (when-let [view (map-view-state)]
    (select-keys view [:longitude :latitude])))

(defn fly-to-view!
  "Restore a previously captured {:longitude :latitude :zoom} view."
  [{:keys [longitude latitude zoom animate?]
    :or {animate? true}}]
  (when (and (number? longitude) (number? latitude) (number? zoom))
    (when-let [^js m @!map]
      (let [fly! (fn []
                   (try
                     (.flyTo m
                             (clj->js {:center #js [longitude latitude]
                                       :zoom zoom
                                       :duration (if animate? center-fly-duration-ms 0)}))
                     (catch :default _ nil)))]
        (if (map-ready? m)
          (fly!)
          (.once m "load" (fn [_] (fly!))))))))

(defn center-on-position!
  "Fly the map to `longitude` / `latitude`. No-op when the map is not mounted.
   With `:preserve-zoom? true`, only pans — current zoom is unchanged."
  [{:keys [longitude latitude zoom animate? preserve-zoom?]
    :or {zoom center-default-zoom animate? true}}]
  (when (and (number? longitude) (number? latitude))
    (when-let [^js m @!map]
      (let [fly! (fn []
                   (try
                     (.flyTo m
                             (clj->js (cond-> {:center #js [longitude latitude]
                                               :duration (if animate? center-fly-duration-ms 0)}
                                        (not preserve-zoom?) (assoc :zoom zoom))))
                     (catch :default _ nil)))]
        (if (map-ready? m)
          (fly!)
          (.once m "load" (fn [_] (fly!))))))))

(defn apply-state!
  "Replace markers and optionally fit bounds. Latest call always wins, even
   when several calls arrive before the map is ready. Safe to call before
   mount-map!."
  [state]
  (reset! !pending-state (normalize-state state))
  (when-let [^js m @!map]
    (if (map-ready? m)
      (consume-pending! m)
      (do
        (.once m "load" (fn [_] (consume-pending! m)))
        (schedule-consume-when-ready! m)))))

(defn- mount-ready! [^js m]
  (ensure-map-country-pick-click! m)
  (ensure-map-add-pin-click! m)
  (set-map-cursor! m (cond
                       @!add-pin-mode-active? "default"
                       @!country-pick-active? "default"
                       :else "grab"))
  (add-draw-toolbar! m)
  (safe-resize! m)
  (consume-pending! m)
  (schedule-consume-when-ready! m)
  (when-let [f @!draw-on-map-ready] (f)))

;; --- map lifecycle ---

(defn- disconnect-resize-observer! []
  (when-let [^js ro @!resize-observer]
    (.disconnect ro)
    (reset! !resize-observer nil)))

(defonce !resize-raf (atom nil))

(defn- observe-map-resize! [^js el ^js m]
  (disconnect-resize-observer!)
  (when (and el m (exists? js/ResizeObserver))
    (let [^js ro (js/ResizeObserver.
                  (fn [_]
                    (when-not @!resize-raf
                      (reset! !resize-raf
                              (js/requestAnimationFrame
                               (fn []
                                 (reset! !resize-raf nil)
                                 (safe-resize! m)))))))]
      (.observe ro el)
      (reset! !resize-observer ro))))

(defn destroy-map! []
  (disconnect-resize-observer!)
  (when-let [^js m @!map]
    (try (.remove m) (catch :default _)))
  (reset! !map nil)
  (reset! !map-container nil)
  (clear-markers!))

(defn destroy-map-if-attached! [^js el]
  (when (and el @!map (map-attached? @!map el))
    (destroy-map!)))

(defn resize-map! []
  (when-let [^js m @!map]
    (if (map-ready? m)
      (safe-resize! m)
      (.once m "load" #(safe-resize! m)))))

(defn mount-map!
  "Create a MapLibre map and attach it to `el`. Idempotent: if the map is
   already attached to the same element, returns the existing instance."
  [^js el]
  (when el
    (if (map-attached? @!map el)
      (let [^js m @!map]
        (mount-ready! m)
        m)
      (do
        (when @!map (destroy-map!))
        (let [m (js/maplibregl.Map.
                 (clj->js {:container el
                           :style style-url
                           :center (:center default-view)
                           :zoom (:zoom default-view)
                           :projection {:type "mercator"}
                           :renderWorldCopies false}))]
          (.addControl m (js/maplibregl.NavigationControl.) "top-right")
          (ensure-map-popup-guard! m)
          (reset! !map-container el)
          (reset! !map m)
          (observe-map-resize! el m)
          (.once m "load" (fn [_] (mount-ready! m)))
          m)))))

;; --- test helpers (not used at runtime) ---

(defn reset-state-for-tests! []
  (destroy-map!)
  (reset! !pending-state nil)
  (reset! !row-hover-match nil)
  (reset! !country-pick-active? false)
  (reset! !country-pick-click-handler nil)
  (reset! !add-pin-mode-active? false)
  (reset! !add-pin-click-handler nil))

(defn set-map-for-tests! [^js m]
  (reset! !map m))

(defn pending-state-for-tests []
  @!pending-state)

(defn marker-element-for-tests!
  [topic]
  (marker-element topic))

(defn marker-row-hover-class-for-tests []
  marker-row-hover-class)
