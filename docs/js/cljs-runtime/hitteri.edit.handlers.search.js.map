(ns hitteri.edit.handlers.search
  "Photon place search for the edit dataset list toolbar."
  (:require [clojure.string :as str]
            [hitteri.app-ui.interface.effects :as effects]
            [hitteri.app-ui.interface.state :as app-state]
            [hitteri.edit.handlers.form :as update-form]
            [hitteri.edit.handlers.map :as update-map]
            [hitteri.edit.handlers.rows :as update-rows]
            [hitteri.edit.interface.baseline :as edit-ui.baseline]
            [hitteri.edit.interface.forms :as edit-ui.forms]
            [hitteri.edit.interface.match :as edit-ui.match]
            [hitteri.edit.interface.rows :as edit-ui.rows]
            [hitteri.edit.pure.forms :as edit-forms]
            [hitteri.pin-ui.interface.photon :as photon]
            [hitteri.pin-ui.interface.search :as search-pure]))

(def ^:private search-debounce-ms 400)
(def ^:private outside-country-message "Location is outside current country")

(defonce !search-request-id (atom 0))
(defonce !search-timeout (atom nil))

(defn clear-update-search-ui
  "Return state with search field and dropdown cleared."
  [s]
  (assoc s
         :update-search-query ""
         :update-search-results []
         :update-search-highlight-index nil
         :update-search-loading? false))

(defn- render! [] (effects/render!))

(defn- swap-render! [f]
  (swap! app-state/!state f)
  (render!))

(defn- finish-search! [request-id results]
  (when (= request-id @!search-request-id)
    (swap-render!
     #(assoc %
             :update-search-results results
             :update-search-loading? false
             :update-search-highlight-index
             (search-pure/highlight-index-for-results results)))))

(defn- run-photon-search! [query]
  (let [request-id (swap! !search-request-id inc)
        trimmed (str/trim query)]
    (if (< (count trimmed) photon/min-search-chars)
      (finish-search! request-id [])
      (do
        (swap! app-state/!state assoc :update-search-loading? true)
        (render!)
        (let [{:keys [countries country-slug country-iso]} @app-state/!state
              url (photon/build-search-url trimmed 8
                                           {:countries countries
                                            :country-slug country-slug})]
          (-> (js/fetch url)
              (.then (fn [resp]
                       (when (= request-id @!search-request-id)
                         (if (.-ok resp)
                           (-> (.json resp)
                               (.then (fn [body]
                                        (when (= request-id @!search-request-id)
                                          (finish-search!
                                           request-id
                                           (photon/filter-results-for-country
                                            (photon/parse-response body)
                                            country-iso countries country-slug)))))
                               (.catch (fn [_] (finish-search! request-id []))))
                           (finish-search! request-id [])))))
              (.catch (fn [_] (finish-search! request-id [])))))))))

(defn set-update-search-query! [query]
  (swap! app-state/!state
         #(-> %
              (assoc :update-search-query query)
              (assoc :update-search-highlight-index nil)))
  (when-let [timeout @!search-timeout]
    (js/clearTimeout timeout))
  (reset! !search-timeout
          (js/setTimeout #(run-photon-search!
                           (:update-search-query @app-state/!state))
                         search-debounce-ms))
  (render!))

(defn- select-existing-row! [row form]
  (let [form* (merge form
                     {:name (edit-ui.baseline/coerce-form-text (:name row))
                      :locality (edit-ui.baseline/coerce-form-text (:locality row))
                      :homepage (edit-ui.baseline/coerce-form-text (:homepage row))
                      :description (edit-ui.baseline/coerce-form-text (:description row))})]
    (swap-render!
     (fn [s]
       (let [s (-> (update-rows/select-update-display-row s (:row-id row) row)
                   (assoc :update-form form*
                          :update-form-field-errors
                          (update-rows/compute-update-form-field-errors-for-state
                           (assoc s :update-form form*))
                          :update-row-baseline (edit-ui.baseline/row->form-baseline row))
                   clear-update-search-ui)]
         (-> s
             app-state/bump-description-sync-token
             (update :update-table-scroll-token (fnil inc 0))))))))

(defn- create-pending-row-from-search! [result form]
  (let [existing (update-rows/find-blank-manual-draft-pending-place @app-state/!state)
        place (if existing
                (edit-ui.rows/blank-empty-draft-pending-place existing)
                {:pending-id (update-rows/next-pending-row-id!)
                 :name ""
                 :locality ""
                 :description ""
                 :source :manual
                 :action :added})
        place (merge place
                     {:name (:name result)
                      :longitude (:longitude result)
                      :latitude (:latitude result)
                      :action :added})
        places (if existing
                 (mapv #(if (= (:pending-id place) (:pending-id %)) place %)
                       (update-rows/as-update-pending-places
                        (:update-pending-places @app-state/!state)))
                 (conj (vec (update-rows/as-update-pending-places
                             (:update-pending-places @app-state/!state)))
                       place))
        row (edit-ui.rows/pending-place->row place)
        errors (edit-ui.forms/compute-update-form-field-errors form true)]
    (swap-render!
     (fn [s]
       (-> s
           (assoc :update-url-form nil
                  :update-pending-places places
                  :update-form form
                  :update-form-field-errors errors
                  :update-sort {:field nil :dir :asc})
           (update-rows/select-update-display-row (:pending-id place) row)
           (assoc :update-row-baseline (edit-ui.baseline/row->form-baseline row))
           clear-update-search-ui
           app-state/bump-description-sync-token
           (update :update-table-scroll-token (fnil inc 0)))))))

(defn- apply-search-result! [result]
  (let [{:keys [country-iso countries country-slug update-form update-rows]} @app-state/!state]
    (if (photon/result-in-current-country? result country-iso countries country-slug)
      (let [lon (:longitude result)
            lat (:latitude result)
            form (edit-forms/form-from-search-result result update-form)
            existing (edit-ui.match/find-saved-row-by-exact-coords
                      (update-rows/as-update-rows update-rows) lon lat)]
        (app-state/clear-update-status!)
        (if existing
          (select-existing-row! existing form)
          (create-pending-row-from-search! result form))
        (update-form/resolve-update-location-from-coordinates! lon lat {})
        (update-map/sync-update-map!))
      (swap-render!
       #(assoc % :update-message outside-country-message)))))

(defn select-update-search-result! [result]
  (apply-search-result! result))

(defn set-update-search-highlight-index! [idx]
  (swap-render! #(assoc % :update-search-highlight-index idx)))

(defn update-search-enter! []
  (let [{:keys [update-search-results update-search-highlight-index]} @app-state/!state
        action (search-pure/enter-action update-search-results nil
                                         update-search-highlight-index)]
    (when (vector? action)
      (when-let [result (search-pure/highlighted-result update-search-results
                                                        (second action))]
        (select-update-search-result! result)))))

(defn update-search-keydown! [^js e]
  (let [{:keys [update-search-results update-search-highlight-index]} @app-state/!state
        n (count update-search-results)
        key (.-key e)]
    (cond
      (= "ArrowDown" key)
      (when (pos? n)
        (.preventDefault e)
        (set-update-search-highlight-index!
         (search-pure/step-highlight-index update-search-highlight-index n 1)))

      (= "ArrowUp" key)
      (when (pos? n)
        (.preventDefault e)
        (set-update-search-highlight-index!
         (search-pure/step-highlight-index update-search-highlight-index n -1)))

      (search-pure/enter-key? e)
      (do
        (.preventDefault e)
        (.stopPropagation e)
        (update-search-enter!))

      :else nil)))
