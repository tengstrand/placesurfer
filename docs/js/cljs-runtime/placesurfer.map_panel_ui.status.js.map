(ns placesurfer.map-panel-ui.status
  (:require [clojure.string :as str]))

(defn display-status-text
  [v]
  (when (some? v)
    (let [s (str/trim (str v))]
      (when (seq s) s))))

(defn map-status-text
  [{:keys [status count country-loading? t]
    :or {t (fn [k] (name k))}}]
  (str (or status "")
       (when (pos? (or count 0))
         (t :status/places-count {:count count}))
       (when country-loading?
         (t :status/loading-suffix))))
