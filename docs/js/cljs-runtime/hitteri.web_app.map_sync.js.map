(ns hitteri.web-app.map-sync
  (:require [hitteri.i18n.interface :as i18n]
            [hitteri.map-panel-ui.interface.resize :as map-panel-ui.resize]
            [hitteri.map-ui.interface :as map-ui]
            [hitteri.web-app.state :as state]
            [hitteri.edit.interface.handlers.map :as update-map]
            [hitteri.pin-ui.interface.handlers.map :as pin-map]))

(defn- popup-opts [s]
  {:source-label (i18n/t (:locale s :en) :popup/source-label)})

(defn sync-map!
  ([] (sync-map! {}))
  ([{:keys [fit? fit-bounds animate?] :or {fit? false animate? true}}]
   (cond
     (= :update (:page @state/!state))
     (do
       (update-map/refresh-update-pending-places!)
       (map-ui/apply-state! {:positions (update-map/update-map-positions @state/!state)
                             :fit? fit?
                             :animate? animate?
                             :popup-opts (popup-opts @state/!state)}))

     (= :pin (:page @state/!state))
     (pin-map/sync-pin-map! {:recenter? false})

     :else
     (let [s @state/!state
           pin-selected? (some? (:pin-selected-id s))
           effective-fit? (and fit? (not pin-selected?))]
       (map-ui/apply-state! {:positions (pin-map/main-map-positions s)
                             :fit? effective-fit?
                             :fit-bounds fit-bounds
                             :animate? animate?
                             :popup-opts (popup-opts s)})
       (when (and pin-selected? (pin-map/selected-pin-on-main-map? s))
         (pin-map/schedule-focus-selected-pin-on-main-map!))))))

(defn schedule-map-resize! []
  (map-panel-ui.resize/schedule-resize! map-ui/resize-map!))
