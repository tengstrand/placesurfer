(ns hitteri.map-panel-ui.mount)

(defn create-main-mount!
  [{:keys [map-ui-mount sync-map! schedule-resize!]}]
  (fn [node]
    (map-ui-mount node)
    (sync-map! {:fit? true :animate? false})
    (schedule-resize!)))

(defn create-update-mount!
  [{:keys [map-ui-mount refresh-pending-places! sync-update-map!
           schedule-pin-sync! schedule-resize!]}]
  (fn [node]
    (map-ui-mount node)
    (refresh-pending-places!)
    (sync-update-map!)
    (schedule-pin-sync!)
    (schedule-resize!)))

(defn create-pin-mount!
  [{:keys [map-ui-mount sync-pin-map! schedule-pin-sync! schedule-resize!]}]
  (fn [node]
    (map-ui-mount node)
    (sync-pin-map!)
    (schedule-pin-sync!)
    (schedule-resize!)))

(defn create-unmount!
  [destroy-map!]
  (fn []
    (destroy-map!)))

(defn handler-props
  [{:keys [mount-map! mount-update-map! mount-pin-map! unmount-map!]}]
  {:mount-map! mount-map!
   :mount-update-map! mount-update-map!
   :mount-pin-map! mount-pin-map!
   :unmount-map! unmount-map!})
