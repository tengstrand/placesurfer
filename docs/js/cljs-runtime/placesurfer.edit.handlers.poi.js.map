(ns placesurfer.edit.handlers.poi
  "Point-of-interest radius circles panel."
  (:require [clojure.string :as str]
            [placesurfer.app-ui.interface.effects :as effects]
            [placesurfer.app-ui.interface.state :as app-state]
            [placesurfer.map-ui.interface :as map-ui]))

(def ^:private unit-to-meters
  {:meter 1
   :kilometer 1000
   :yard 0.9144
   :mile 1609.344})

(defn- new-id [] (str (random-uuid)))

(defn- pin-items [s]
  (filterv #(not (contains? % :separator)) (:pin-items s [])))

(defn init-poi!
  "Set default POI state on first activation: kilometer unit, first pin, 20km circle."
  []
  (let [s @app-state/!state]
    (when-not (:poi-initialized? s)
      (let [first-pin-id (:id (first (pin-items s)))
            default-circle {:id (new-id) :radius "20"}]
        (swap! app-state/!state assoc
               :poi-initialized? true
               :poi-unit :kilometer
               :poi-pin-id first-pin-id
               :poi-circles [default-circle]
               :poi-selected-id (:id default-circle)))))
  (sync-poi-circles!))

(defn sync-poi-circles!
  "Redraws POI circles on the current map based on app state."
  []
  (let [{:keys [poi-pin-id poi-circles poi-unit pin-items]} @app-state/!state
        multiplier (get unit-to-meters (or poi-unit :meter) 1)
        pin (when poi-pin-id
              (some #(when (= (:id %) poi-pin-id) %) pin-items))
        lng (:longitude pin)
        lat (:latitude pin)]
    (if (and (number? lng) (number? lat) (seq poi-circles))
      (map-ui/apply-poi-circles!
       (keep (fn [{:keys [radius]}]
               (let [r (js/parseFloat (str radius))]
                 (when (and (number? r) (pos? r) (not (js/isNaN r)))
                   {:lng lng :lat lat :radius-meters (* r multiplier)})))
             poi-circles))
      (map-ui/clear-poi-circles!))))

(defn- swap-render-sync! [f]
  (swap! app-state/!state f)
  (effects/render!)
  (sync-poi-circles!))

(defn set-poi-unit! [unit]
  (swap-render-sync! #(assoc % :poi-unit unit)))

(defn set-poi-pin-id! [id]
  (swap-render-sync! #(assoc % :poi-pin-id id)))

(defn select-poi-circle! [id]
  (swap! app-state/!state assoc :poi-selected-id id)
  (effects/render!))

(defn set-poi-draft-radius! [s]
  (swap! app-state/!state assoc :poi-draft-radius s)
  (effects/render!))

(defn- valid-radius? [s]
  (when-not (str/blank? s)
    (let [n (js/parseFloat s)]
      (and (not (js/isNaN n)) (pos? n)))))

(defn add-poi-circle! []
  (let [{:keys [poi-draft-radius poi-editing-id]} @app-state/!state]
    (when (and (nil? poi-editing-id) (valid-radius? poi-draft-radius))
      (let [new-row {:id (new-id) :radius (str/trim poi-draft-radius)}]
        (swap-render-sync!
         #(-> %
              (update :poi-circles (fnil conj []) new-row)
              (assoc :poi-draft-radius ""
                     :poi-selected-id (:id new-row))))))))

(defn start-poi-circle-edit! [id]
  (let [circle (first (filter #(= id (:id %))
                               (:poi-circles @app-state/!state [])))]
    (when circle
      (swap! app-state/!state assoc
             :poi-selected-id id
             :poi-editing-id id
             :poi-draft-radius (:radius circle ""))
      (effects/render!))))

(defn confirm-poi-circle-edit! []
  (let [{:keys [poi-editing-id poi-draft-radius]} @app-state/!state]
    (when (and poi-editing-id (valid-radius? poi-draft-radius))
      (swap-render-sync!
       #(-> %
            (update :poi-circles
                    (fn [rows]
                      (mapv (fn [r]
                              (if (= poi-editing-id (:id r))
                                (assoc r :radius (str/trim poi-draft-radius))
                                r))
                            (or rows []))))
            (assoc :poi-draft-radius ""
                   :poi-editing-id nil))))))

(defn delete-poi-circle! [id]
  (swap-render-sync!
   #(-> %
        (update :poi-circles (fn [rows] (vec (remove (fn [r] (= id (:id r))) (or rows [])))))
        (cond-> (= id (:poi-selected-id %)) (assoc :poi-selected-id nil))
        (cond-> (= id (:poi-editing-id %)) (assoc :poi-editing-id nil :poi-draft-radius "")))))

(defn reorder-poi-circle! [drag-id to-index]
  (let [rows (vec (:poi-circles @app-state/!state []))
        from-index (first (keep-indexed (fn [i r] (when (= drag-id (:id r)) i)) rows))]
    (when (and (some? from-index) (some? to-index)
               (not= from-index to-index)
               (>= to-index 0) (< to-index (count rows)))
      (let [item (nth rows from-index)
            without (into (subvec rows 0 from-index) (subvec rows (inc from-index)))
            next-rows (into (subvec without 0 to-index)
                            (cons item (subvec without to-index)))]
        (swap-render-sync! #(assoc % :poi-circles next-rows))))))

(defn submit-poi-draft! []
  (if (:poi-editing-id @app-state/!state)
    (confirm-poi-circle-edit!)
    (add-poi-circle!)))

(defn poi-submit-enabled? [state]
  (valid-radius? (:poi-draft-radius state)))
