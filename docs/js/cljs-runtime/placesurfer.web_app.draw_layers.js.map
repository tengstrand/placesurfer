(ns placesurfer.web-app.draw-layers
  "Handlers for the layers page: drawn polygon layers and pasted reference images."
  (:require [placesurfer.app-ui.interface :as app-ui.interface]
            [placesurfer.app-ui.interface.effects :as effects]
            [placesurfer.map-ui.interface :as map-ui]
            [placesurfer.web-app.state :as state]))

(defn image-layer? [layer]
  (= "image" (:type layer)))

(defn save-config! []
  (let [layers (:draw-layers @state/!state)]
    (-> (js/fetch "/api/backend/save-layers-config"
                  (clj->js {:method "POST"
                            :headers {"Content-Type" "application/json"}
                            :body (.stringify js/JSON (clj->js {:layers layers}))}))
        (.catch (fn [err]
                  (js/console.error "Kunde inte spara lager-config" err))))))

(defn sync-reference-images!
  "Push image layers from state to the map and unlock the selected one."
  []
  (let [s      @state/!state
        images (filterv image-layer? (:draw-layers s))
        sel    (:draw-selected-layer-id s)]
    (map-ui/set-reference-images!
     (mapv (fn [{:keys [id image-url bounds opacity]}]
             {:id id :image-url image-url :bounds bounds :opacity opacity})
           images))
    (map-ui/set-reference-image-adjust!
     (when (some #(= (:id %) sel) images) sel))))

(defn enter-draw-page!
  "Load the selected layer when navigating to the layers page. For an image
   layer the draw canvas is just cleared/activated; the image itself is shown
   via sync-reference-images!."
  []
  (let [{:keys [draw-layers draw-selected-layer-id]} @state/!state
        selected (first (filter #(= (:id %) draw-selected-layer-id) draw-layers))]
    (if (and selected (not (image-layer? selected)))
      (do (map-ui/set-draw-canvas-color!
           (or (:color selected) app-ui.interface/default-layer-color))
          (map-ui/load-draw-layer! (:id selected)))
      (map-ui/load-draw-layer! ""))
    (sync-reference-images!)))

(defn select-layer! [layer-id]
  (swap! state/!state assoc :draw-selected-layer-id layer-id)
  (let [layer (first (filter #(= (:id %) layer-id)
                             (:draw-layers @state/!state)))]
    (when-not (image-layer? layer)
      (map-ui/set-draw-canvas-color!
       (or (:color layer) app-ui.interface/default-layer-color))
      (map-ui/load-draw-layer! layer-id))
    (sync-reference-images!)
    (effects/render!)))

(defn add-image-layer!
  "Add a pasted reference image as a layer, select it and persist the config."
  [{:keys [url bounds]}]
  (let [layers (:draw-layers @state/!state)
        n      (inc (count (filter image-layer? layers)))
        id     (str "bild-" (js/Date.now))
        layer  {:id id :type "image" :label (str "Bild " n)
                :image-url url :bounds bounds :opacity 50}]
    (swap! state/!state
           (fn [s]
             (-> s
                 (update :draw-layers (fnil conj []) layer)
                 (assoc :draw-selected-layer-id id))))
    (sync-reference-images!)
    (save-config!)
    (effects/render!)))

(defn image-bounds-changed!
  "Persist new bounds after the user moved or scaled a reference image."
  [id bounds]
  (swap! state/!state update :draw-layers
         (fn [layers]
           (mapv #(if (= (:id %) id) (assoc % :bounds bounds) %) layers)))
  (save-config!))

(defn set-image-opacity!
  "Live-update opacity for the selected image layer (persist via save-config!)."
  [opacity]
  (let [id (:draw-selected-layer-id @state/!state)]
    (swap! state/!state update :draw-layers
           (fn [layers]
             (mapv #(if (= (:id %) id) (assoc % :opacity opacity) %) layers)))
    (map-ui/set-reference-image-opacity! id opacity)
    (effects/render!)))

(defn delete-layer! [layer-id]
  (swap! state/!state
         (fn [s]
           (let [remaining (filterv #(not= (:id %) layer-id) (:draw-layers s))
                 new-sel   (when (seq remaining) (:id (first remaining)))]
             (-> s
                 (assoc :draw-layers remaining)
                 (assoc :draw-selected-layer-id new-sel)))))
  (let [{:keys [draw-layers draw-selected-layer-id]} @state/!state
        selected (first (filter #(= (:id %) draw-selected-layer-id) draw-layers))]
    (if (and selected (not (image-layer? selected)))
      (map-ui/load-draw-layer! (:id selected))
      (map-ui/load-draw-layer! ""))
    (sync-reference-images!)
    (save-config!)
    (effects/render!)))
