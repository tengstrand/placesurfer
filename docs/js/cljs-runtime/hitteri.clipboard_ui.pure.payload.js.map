(ns hitteri.clipboard-ui.pure.payload
  (:require [clojure.string :as str]
            [hitteri.clipboard-ui.google-maps.payload :as google-maps]
            [hitteri.clipboard-ui.google-maps.place :as place]
            [hitteri.clipboard-ui.hemnet.listing :as listing]
            [hitteri.clipboard-ui.hemnet.payload :as hemnet]))

(defn hemnet-bookmarklet-payload?
  [& args]
  (apply hemnet/hemnet-bookmarklet-payload? args))

(defn place-bookmarklet-payload?
  [& args]
  (apply google-maps/place-bookmarklet-payload? args))

(defn google-maps-bookmarklet-payload?
  [& args]
  (apply google-maps/google-maps-bookmarklet-payload? args))

(defn pin-list-payload?
  "True when `data` is a hitteri/pin-list payload."
  [data]
  (and (map? data)
       (= "hitteri/pin-list" (:type data))
       (sequential? (:pins data))))

(defn bookmarklet-payload?
  "True when `data` is a supported bookmarklet clipboard payload map."
  [data]
  (or (hemnet-bookmarklet-payload? data)
      (place-bookmarklet-payload? data)
      (pin-list-payload? data)))

(defn parse-bookmarklet-text
  "Parse clipboard text into a bookmarklet payload map, or nil."
  [text]
  (when-let [trimmed (not-empty (str/trim (str text)))]
    (try
      (let [raw (js/JSON.parse trimmed)
            data (js->clj raw :keywordize-keys true)]
        (when (bookmarklet-payload? data)
          data))
      (catch :default _ nil))))

(defn payload->listing
  [& args]
  (apply hemnet/payload->listing args))

(defn payload->place
  [& args]
  (apply google-maps/payload->place args))

(defn payload->coordinates
  "Extract decimal coordinates from any supported bookmarklet payload."
  [payload]
  (cond
    (hemnet-bookmarklet-payload? payload)
    (when-let [listing (payload->listing payload)]
      (when (listing/listing-has-coords? listing)
        {:longitude (:longitude listing) :latitude (:latitude listing)}))

    (place-bookmarklet-payload? payload)
    (when-let [place (payload->place payload)]
      (when (place/place-has-coords? place)
        {:longitude (:longitude place) :latitude (:latitude place)}))))

(defn clipboard-hint-valid?
  "True when clipboard text is a supported place bookmarklet payload."
  [text]
  (some? (parse-bookmarklet-text text)))
