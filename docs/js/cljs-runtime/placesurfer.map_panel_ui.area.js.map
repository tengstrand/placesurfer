(ns placesurfer.map-panel-ui.area
  (:require [placesurfer.map-panel-ui.container :as container]
            [placesurfer.map-panel-ui.home-search :as home-search]
            [placesurfer.map-panel-ui.status :as status]))

(defn area
  [{:keys [map-status mount-map! unmount-map!
           home-search-query home-search-results home-search-loading?
           home-search-highlight-index set-home-search-query!
           select-home-search-result! home-search-keydown! t]
    :or {map-status ""}}]
  [:div.map-area {:key "map-area"}
   (if set-home-search-query!
     (home-search/home-search {:query home-search-query
                                :results home-search-results
                                :loading? home-search-loading?
                                :highlight-index home-search-highlight-index
                                :set-query! set-home-search-query!
                                :select-result! select-home-search-result!
                                :keydown! home-search-keydown!
                                :t t})
     (when-let [text (status/display-status-text map-status)]
       [:div.map-status {:data-map-status "true"} text]))
   (container/container {:element-id "map"
                         :mount-map! mount-map!
                         :unmount-map! unmount-map!})])
