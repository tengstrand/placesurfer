(ns placesurfer.clipboard-ui.hemnet.form
  (:require [clojure.string :as str]
            [placesurfer.clipboard-ui.hemnet.listing :as listing]
            [placesurfer.clipboard-ui.hemnet.url :as url]))

(defn- non-blank [s]
  (when-let [t (not-empty (str/trim (str s)))]
    t))

(defn- coord-text [v]
  (some-> (listing/parse-number v) str))

(defn- labeled-part [v]
  (when-let [t (non-blank v)]
    t))

(defn- normalize-area [s]
  (when-let [t (non-blank s)]
    (let [converted (-> t
                        (str/replace #"(?i)\bkvm\b" "m²")
                        (str/replace "m2" "m²"))]
      (if (or (str/includes? converted "m²")
              (not (re-find #"\d" converted)))
        converted
        (str converted " m²")))))

(defn- plot-area-part [plot-area plot-label]
  (when-let [plot (labeled-part (normalize-area plot-area))]
    (str plot " " plot-label)))

(defn- address-includes-postal-city? [street postal-city]
  (and (non-blank street)
       (non-blank postal-city)
       (str/includes? (str/lower-case street) (str/lower-case postal-city))))

(defn- format-address-line [street-address postal-city]
  (cond
    (and (not (non-blank street-address)) (not (non-blank postal-city))) nil
    (not (non-blank street-address)) (non-blank postal-city)
    (not (non-blank postal-city)) (non-blank street-address)
    (address-includes-postal-city? street-address postal-city) (non-blank street-address)
    :else (str street-address ", " postal-city)))

(defn- resolve-listing-name [listing source-url]
  (or (non-blank (:listing-title listing))
      (non-blank (:street-address listing))
      (url/listing-title-from-url source-url)))

(defn- parse-amount [s]
  (when-let [t (non-blank s)]
    (let [cleaned (-> t
                      (str/replace " " "")      ; string match → replaces ALL spaces
                      (str/replace "," ".")
                      (str/replace #"[^\d.]" ""))]
      (when (seq cleaned)
        (let [n (js/parseFloat cleaned)]
          (when-not (js/isNaN n) n))))))

(defn- format-amount-se [n]
  (let [s (str (js/Math.round n))
        groups (map #(apply str (reverse %)) (partition-all 3 (reverse s)))]
    (str/join " " (reverse groups))))

(defn- calc-sqm-price [asking-price-str living-area-str]
  (when-let [price (parse-amount asking-price-str)]
    (when-let [area (parse-amount living-area-str)]
      (when (and (pos? price) (> area 1))
        (str (format-amount-se (/ price area)) " kr/m²")))))

(defn- kr-per-man? [s]
  (str/includes? (str/lower-case (str s)) "kr/mån"))

(defn- has-sqm-price? [extras]
  (some #(let [lc (str/lower-case (str %))]
           (and (str/includes? lc "kr/m")
                (not (str/includes? lc "mån"))))
        extras))

(defn build-description
  "Format listing fields into pin description text.

  Layout:
  1. Asking price (e.g. \"2 695 000 kr\")
  2. Housing form, rooms, living area, plot area, monthly fee
  3. Square meter price, tenure, build year (when present)"
  [{:keys [housing-form rooms living-area plot-area asking-price extra-values plot-label]
    :or {plot-label "tomt"}}]
  (let [details        (remove nil?
                               [(labeled-part housing-form)
                                (labeled-part rooms)
                                (labeled-part (normalize-area living-area))
                                (plot-area-part plot-area plot-label)])
        all-extras     (mapv non-blank (or extra-values []))
        line2-ext      (filterv kr-per-man? all-extras)
        other-ext      (filterv (complement kr-per-man?) all-extras)
        sqm-calc       (when-not (has-sqm-price? all-extras)
                         (calc-sqm-price asking-price living-area))
        line3-ext      (if sqm-calc (into [sqm-calc] other-ext) other-ext)
        line2          (when (seq (concat details line2-ext))
                         (str/join ", " (concat details line2-ext)))
        line3          (when (seq line3-ext) (str/join ", " line3-ext))
        lines          (remove nil? [(labeled-part asking-price) line2 line3])]
    (str/join "\n" lines)))

(defn address-line-for-geocoding
  "Build a geocoding query from listing address fields."
  [{:keys [street-address postal-city]}]
  (or (format-address-line street-address postal-city) ""))

(defn listing->pin-form
  "Map normalized listing + source url to pin editor form."
  ([listing source-url] (listing->pin-form listing source-url "tomt"))
  ([listing source-url plot-label]
  (let [{:keys [street-address postal-city longitude latitude image-url
                housing-form rooms living-area plot-area asking-price extra-values
                agent-url agent-name]} listing
        address (or (format-address-line street-address postal-city) "")
        description (build-description
                     {:housing-form housing-form
                      :rooms rooms
                      :living-area living-area
                      :plot-area plot-area
                      :asking-price asking-price
                      :extra-values extra-values
                      :plot-label plot-label})]
    {:name (or (resolve-listing-name listing source-url) "")
     :location address
     :icon (or (non-blank (:icon listing)) "house2.png")
     :longitude (or (coord-text longitude) "")
     :latitude (or (coord-text latitude) "")
     :url (or (non-blank source-url) "")
     :image (or (non-blank image-url) "")
     :description (or description "")
     :agent-url (or (non-blank agent-url) "")
     :agent-name (or (non-blank agent-name) "")})))
