(ns placesurfer.country-ui.search
  (:require [placesurfer.country.interface :as country]
            [placesurfer.country-ui.filter :as filter]))

(defn- sync-input!
  [^js node value]
  (when node
    (let [v (or value "")]
      (when (and (not= (.-value node) v)
                 (or (empty? v)
                     (not= node (.-activeElement js/document))))
        (set! (.-value node) v)))))

(defn- handle-keydown!
  [e country-highlight-index visible n select-country! set-country-highlight-index! navigate!]
  (let [key (.-key e)
        trimmed (.trim (.-value (.-target e)))]
    (case key
      "ArrowDown"
      (do (.preventDefault e)
          (set-country-highlight-index!
           (country/step-highlight-index country-highlight-index n 1)))

      "ArrowUp"
      (do (.preventDefault e)
          (set-country-highlight-index!
           (country/step-highlight-index country-highlight-index n -1)))

      "Enter"
      (do (.preventDefault e)
          (if (empty? trimmed)
            (navigate! :home)
            (when (pos? n)
              (let [idx (or country-highlight-index 0)
                    slug (get-in visible [idx :slug])]
                (when slug (select-country! slug))))))

      nil)))

(defn search-input
  [value country-slug countries country-highlight-index
   set-country-filter! set-country-highlight-index!
   select-country! navigate! t]
  (let [visible-for-query (fn [query]
                            (filter/visible-countries countries query country-slug))]
    [:input.country-search
     {:type "search"
      :placeholder (t :country/search-placeholder)
      :aria-label (t :country/search-aria)
      :replicant/on-render (fn [{:keys [replicant/node]}]
                             (sync-input! node value))
      :on {:input (fn [e]
                    (let [query (.-value (.-target e))
                          visible (visible-for-query query)]
                      (set-country-filter! query (count visible))))
           :keydown (fn [e]
                      (let [trimmed (.trim (.-value (.-target e)))
                            visible (visible-for-query trimmed)]
                        (handle-keydown!
                         e country-highlight-index visible (count visible)
                         select-country! set-country-highlight-index! navigate!)))}}]))
