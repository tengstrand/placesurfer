(ns placesurfer.settings-ui.pure.panel
  (:require [clojure.string :as str]
            [placesurfer.nav-ui.interface.flags :as flags]))

(def ^:private locales
  [{:locale :en :iso "GB" :label-key :settings/language-english}
   {:locale :sv :iso "SE" :label-key :settings/language-swedish}
   {:locale :no :iso "NO" :label-key :settings/language-norwegian}
   {:locale :da :iso "DK" :label-key :settings/language-danish}
   {:locale :fi :iso "FI" :label-key :settings/language-finnish}
   {:locale :de :iso "DE" :label-key :settings/language-german}
   {:locale :fr :iso "FR" :label-key :settings/language-french}
   {:locale :es :iso "ES" :label-key :settings/language-spanish}
   {:locale :pt :iso "PT" :label-key :settings/language-portuguese}
   {:locale :ja :iso "JP" :label-key :settings/language-japanese}])

(defn- row-class [selected?]
  (str/join " "
            (remove nil? [(when selected? "settings-language-row--selected")])))

(defn- language-row
  [{:keys [locale iso label-key active? set-locale! t]}]
  [:button.settings-language-row
   {:type "button"
    :class (row-class active?)
    :on {:click (fn [_] (set-locale! locale))}}
   [:span.settings-language-flag (flags/iso->flag iso)]
   [:span.settings-language-label (t label-key)]])

(defn- sorted-locales [t]
  (sort-by #(t (:label-key %)) compare locales))

(defn- transit-section
  [{:keys [transit-destination set-transit-destination! t]
    :or {transit-destination "" set-transit-destination! (fn [_] nil)}}]
  [:div.settings-section
   [:h2.settings-heading (t :settings/transit-heading)]
   [:div.settings-field-row
    [:label.settings-field-label {:for "settings-transit-destination"}
     (t :settings/transit-destination-label)]
    [:input.settings-text-input
     {:id "settings-transit-destination"
      :type "text"
      :placeholder ""
      :value (or transit-destination "")
      :on {:input (fn [e] (set-transit-destination! (.. e -target -value)))}}]]])

(defn- dropbox-section
  [{:keys [dropbox-configured? dropbox-connected? dropbox-account-email dropbox-sync-error
           connect-dropbox! disconnect-dropbox! t]}]
  [:div.settings-section
   [:h2.settings-heading (t :settings/dropbox-heading)]
   (cond
     (not dropbox-configured?)
     [:p.settings-dropbox-status (t :settings/dropbox-not-configured)]

     dropbox-connected?
     [:div.settings-dropbox-connected
      [:p.settings-dropbox-status
       (if dropbox-account-email
         (t :settings/dropbox-connected-as {:email dropbox-account-email})
         (t :settings/dropbox-connected))]
      [:button.settings-dropbox-disconnect
       {:type "button" :on {:click (fn [_] (disconnect-dropbox!))}}
       (t :settings/dropbox-disconnect)]]

     :else
     [:div.settings-dropbox-disconnected
      [:p.settings-dropbox-status (t :settings/dropbox-not-connected)]
      [:button.settings-dropbox-connect
       {:type "button" :on {:click (fn [_] (connect-dropbox!))}}
       (t :settings/dropbox-connect)]])
   (when dropbox-sync-error
     [:p.settings-dropbox-error (t :settings/dropbox-error)])])

(defn panel
  [{:keys [locale set-locale! t
           transit-destination set-transit-destination!
           dropbox-configured? dropbox-connected? dropbox-account-email dropbox-sync-error
           connect-dropbox! disconnect-dropbox!]
    :or {locale :en
         set-locale! (fn [_] nil)
         t (fn [k] (name k))
         transit-destination ""
         set-transit-destination! (fn [_] nil)
         connect-dropbox! (fn [] nil)
         disconnect-dropbox! (fn [] nil)}}]
  [:div.settings-sections
   [:div.settings-section
    [:h2.settings-heading (t :settings/language)]
    [:div.settings-language-list
     (for [{locale-code :locale :as spec} (sorted-locales t)]
       ^{:key (name locale-code)}
       (language-row (assoc spec
                            :locale locale-code
                            :active? (= locale-code locale)
                            :set-locale! set-locale!
                            :t t)))]]
   (transit-section {:transit-destination transit-destination
                     :set-transit-destination! set-transit-destination!
                     :t t})
   (dropbox-section {:dropbox-configured? dropbox-configured?
                     :dropbox-connected? dropbox-connected?
                     :dropbox-account-email dropbox-account-email
                     :dropbox-sync-error dropbox-sync-error
                     :connect-dropbox! connect-dropbox!
                     :disconnect-dropbox! disconnect-dropbox!
                     :t t})])
