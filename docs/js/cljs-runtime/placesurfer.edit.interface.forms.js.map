(ns placesurfer.edit.interface.forms
  (:require [placesurfer.edit.pure.forms :as forms]))

(defn update-form-field-error
  [k v & opts]
  (apply forms/update-form-field-error k v opts))

(defn compute-update-form-field-errors
  ([form] (forms/compute-update-form-field-errors form))
  ([form require-core?] (forms/compute-update-form-field-errors form require-core?))
  ([form require-core? t] (forms/compute-update-form-field-errors form require-core? t)))

(defn valid-update-name?
  [v]
  (forms/valid-update-name? v))

(defn valid-homepage?
  [v]
  (forms/valid-homepage? v))

(defn valid-update-form?
  [form]
  (forms/valid-update-form? form))
