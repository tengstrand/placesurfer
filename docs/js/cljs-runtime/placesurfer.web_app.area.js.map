(ns placesurfer.web-app.area
  (:require [placesurfer.app-ui.interface.effects :as effects]
            [placesurfer.i18n.interface :as i18n]
            [placesurfer.web-app.map-sync :as map-sync]
            [placesurfer.web-app.state :as state]))

(defn set-area-radius! [v]
  (let [n (js/parseFloat (str v))]
    (when-not (js/isNaN n)
      (swap! state/!state assoc :area-radius n)
      (i18n/save-area-settings! n (:area-unit @state/!state :km))
      (map-sync/sync-area-circles!)
      (effects/render!))))

(defn set-area-unit! [unit]
  (swap! state/!state assoc :area-unit unit)
  (i18n/save-area-settings! (:area-radius @state/!state 20) unit)
  (map-sync/sync-area-circles!)
  (effects/render!))
