(ns placesurfer.map-panel-ui.interface.mount
  (:require [placesurfer.map-panel-ui.mount :as mount]))

(defn create-main-mount!
  [deps]
  (mount/create-main-mount! deps))

(defn create-update-mount!
  [deps]
  (mount/create-update-mount! deps))

(defn create-pin-mount!
  [deps]
  (mount/create-pin-mount! deps))

(defn create-unmount!
  [destroy-map!]
  (mount/create-unmount! destroy-map!))

(defn handler-props
  [handlers]
  (mount/handler-props handlers))
