(ns hitteri.edit.pure.duplicates
  (:require [clojure.string :as str]
            [hitteri.edit.pure.coords :as coords]
            [hitteri.edit.pure.rows :as rows]
            [hitteri.edit.pure.sources :as sources]))

(defn- vec-rows [rows]
  (if (sequential? rows) (vec rows) []))

(defn- normalized-name [name]
  (some-> name str str/trim str/lower-case))

(defn- coord-key [row]
  (when-let [{:keys [longitude latitude]} (coords/row-lon-lat row)]
    [(double longitude) (double latitude)]))

(defn- active-rows [rows]
  (remove rows/row-save-as-tombstone? (vec-rows rows)))

(defn- duplicate-filter-rows [rows]
  "Rows considered for duplicate filter/sort; keep client tombstones visible in clusters."
  (remove rows/disk-tombstone-row? (vec-rows rows)))

(defn find-first-name-duplicate
  "First row (in list order) whose trimmed name was already seen."
  [rows]
  (loop [seen #{} xs (seq (active-rows rows))]
    (if-let [row (first xs)]
      (let [name (normalized-name (:name row))]
        (if (and (seq name) (contains? seen name))
          {:kind :name :row row}
          (recur (if (seq name) (conj seen name) seen) (rest xs))))
      nil)))

(defn find-first-coord-duplicate
  "First row (in list order) whose longitude/latitude was already seen."
  [rows]
  (loop [seen #{} xs (seq (active-rows rows))]
    (if-let [row (first xs)]
      (if-let [key (coord-key row)]
        (if (contains? seen key)
          {:kind :coords :row row}
          (recur (conj seen key) (rest xs)))
        (recur seen (rest xs)))
      nil)))

(defn first-duplicate
  [rows]
  (or (find-first-name-duplicate rows)
      (find-first-coord-duplicate rows)))

(defn- duplicate-group-row-ids
  [groups]
  (into #{}
        (mapcat (fn [[_k rows]]
                  (when (> (count rows) 1)
                    (map :row-id rows)))
                groups)))

(defn- normalized-source [row]
  (some-> (:source row) sources/normalize-update-source))

(defn fully-identical-rows?
  "Two rows carry the same longitude/latitude and source."
  [a b]
  (and (some? a) (some? b)
       (not= (:row-id a) (:row-id b))
       (let [ca (coord-key a)
             cb (coord-key b)]
         (and ca cb
              (= ca cb)
              (= (normalized-source a) (normalized-source b))))))

(defn has-identical-saved-sibling?
  [rows row]
  (and (rows/saved-update-row-id? (:row-id row))
       (some #(fully-identical-rows? row %)
             (remove rows/row-save-as-tombstone? (active-rows rows)))))

(defn duplicate-row-id-set
  "Row ids that share a trimmed name (case-insensitive) and/or coordinates with another row."
  [rows]
  (let [filter-rows (duplicate-filter-rows rows)
        by-name (group-by #(normalized-name (:name %)) filter-rows)
        name-dups (duplicate-group-row-ids
                   (filter (fn [[name _]] (seq name)) by-name))
        by-coord (group-by coord-key (filter #(coord-key %) filter-rows))
        coord-dups (duplicate-group-row-ids by-coord)]
    (into name-dups coord-dups)))

(defn- union-duplicate-groups!
  [parent find-root group-rows]
  (when (> (count group-rows) 1)
    (let [ids (mapv :row-id group-rows)]
      (doseq [id (rest ids)]
        (let [ra (find-root (first ids))
              rb (find-root id)]
          (when (not= ra rb)
            (swap! parent assoc ra rb)))))))

(defn sort-rows-by-duplicate-clusters
  "Group duplicate rows together (shared name and/or coordinates)."
  [rows]
  (let [filter-rows (vec (duplicate-filter-rows rows))
        parent (atom (into {} (map (fn [r] [(:row-id r) (:row-id r)]) filter-rows)))
        find-root (fn find-root [id]
                    (let [p (get @parent id id)]
                      (if (= p id)
                        id
                        (find-root p))))
        by-name (vals (group-by #(normalized-name (:name %)) filter-rows))
        by-coord (vals (group-by coord-key (filterv coord-key filter-rows)))]
    (doseq [group (concat by-name by-coord)]
      (union-duplicate-groups! parent find-root group))
    (let [cluster-root (fn [row-id] (find-root row-id))
          root-order (into {}
                           (map-indexed (fn [i root] [root i])
                                        (sort (distinct (map cluster-root (map :row-id filter-rows))))))
          sort-key (fn [row]
                     [(get root-order (cluster-root (:row-id row)) js/Infinity)
                      (or (normalized-name (:name row)) "")
                      (or (coord-key row) [])
                      (:row-id row)])]
      (vec (sort-by sort-key filter-rows)))))

(defn duplicate-error-message
  [{:keys [kind row]}]
  (case kind
    :name (str "Duplicate name: \"" (str/trim (str (:name row))) "\"")
    :coords (let [{:keys [longitude latitude]} (coords/row-lon-lat row)]
              (str "Duplicate coordinates: " longitude ", " latitude))
    "Dataset has duplicate names or coordinates"))

(defn dataset-has-duplicates?
  [rows]
  (boolean (first-duplicate rows)))
