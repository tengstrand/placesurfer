(defonce !resolve-location-request-id (atom 0))
(defonce !update-load-request-id (atom 0))
(defonce !update-pending-id-seq (atom 0))
(defonce !health-check-request-id (atom 0))
(defonce !backend-health-online? (atom false))

(defonce !load-id (atom 0))
(defonce !topic-load-ids (atom {}))
(defonce !countries-load-request-id (atom 0))
(defonce !countries-load-promise (atom nil))

(defn clear-update-status! []
  (swap! !state assoc :update-error nil :update-message nil))

(defn normalize-country-code [s]
  (some-> s str str/trim str/upper-case))

(defn non-empty-js-string? [v]
  (when (string? v)
    (let [s (str/trim v)]
      (when (seq s) s))))

(defn non-empty-text? [v]
  (when-let [s (cond
                  (string? v) (not-empty (str/trim v))
                  (some? v) (not-empty (str/trim (str v)))
                  :else nil)]
    s))

(defn update-error-text [v]
  (or (non-empty-js-string? v)
      (when (some? v)
        (let [s (str/trim (str v))]
          (when (seq s) s)))))

(defn valid-topic? [topic]
  (or (= topic :pins)
      (contains? (set (data/topic-keys)) topic)))

(defn visible-positions [s]
  (let [active (set (:active-topics s))]
    (vec (filter #(contains? active (:topic %)) (:positions s)))))

(defn bump-description-sync-token [s]
  (update s :description-sync-token (fnil inc 0)))

(defn reset-description-editor-state [s]
  (-> s
      (assoc :description-edit-mode :text)
      (bump-description-sync-token)))
