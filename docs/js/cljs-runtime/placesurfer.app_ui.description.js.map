(ns placesurfer.app-ui.description
  (:require [placesurfer.app-ui.interface.effects :as effects]
            [placesurfer.app-ui.interface.state :as state]))

(defn toggle-description-edit-mode! []
  (swap! state/!state
         (fn [s]
           (-> s
               (update :description-edit-mode #(if (= % :html) :text :html))
               (state/bump-description-sync-token))))
  (effects/render!))
