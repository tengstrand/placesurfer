(ns placesurfer.i18n.pure.storage
  (:require [cljs.reader :as reader]))

(def storage-key "settings")

(defn- parse-settings [raw]
  (when (seq (str raw))
    (try
      (reader/read-string raw)
      (catch :default _ nil))))

(defn read-settings!
  "Load settings map from localStorage; returns {} when missing/invalid."
  []
  (try
    (if-let [raw (.getItem js/localStorage storage-key)]
      (or (parse-settings raw) {})
      {})
    (catch :default _ {})))

(defn save-settings!
  "Persist settings map to localStorage."
  [settings]
  (try
    (.setItem js/localStorage storage-key (pr-str settings))
    (catch :default _ nil)))
