(ns placesurfer.app-ui.interface.effects
  "Stable public API for wired cross-module effect handlers."
  (:require [placesurfer.app-ui.effects :as core]))

(defn wire! [handlers] (core/wire! handlers))
(defn render! [] (core/render!))
(defn navigate! [& args] (apply core/navigate! args))
(defn navigate-to-pin! [] (core/navigate-to-pin!))
(defn navigate-to-update! [] (core/navigate-to-update!))
(defn select-country! [& args] (apply core/select-country! args))
(defn resolve-update-location-from-coordinates! [& args] (apply core/resolve-update-location-from-coordinates! args))
(defn sync-marker-pick-handler! [] (core/sync-marker-pick-handler!))
(defn reload-update-dataset! [& args] (apply core/reload-update-dataset! args))
(defn sync-update-map! [& args] (apply core/sync-update-map! args))
(defn load-topic-positions! [topic] (core/load-topic-positions! topic))
(defn schedule-update-map-pin-sync! [& args] (apply core/schedule-update-map-pin-sync! args))
(defn schedule-center-on-position! [& args] (apply core/schedule-center-on-position! args))
(defn schedule-map-resize! [] (core/schedule-map-resize!))
(defn sync-main-map! [& args] (apply core/sync-main-map! args))
(defn check-backend! [& args] (apply core/check-backend! args))
(defn track-page! [& args] (apply core/track-page! args))
(defn set-update-topic! [& args] (apply core/set-update-topic! args))
(defn run-in-update-pins-mode! [& args] (apply core/run-in-update-pins-mode! args))
