(ns placesurfer.country-ui.rows
  (:require [clojure.string :as str]
            [placesurfer.nav-ui.interface.flags :as nav-ui.flags]))

(defn row-class
  [selected? keyboard-highlight?]
  (str/join " "
            (remove nil? [(when selected? "country-row--selected")
                          (when keyboard-highlight? "country-row--keyboard-focus")])))

(defn row
  [{:keys [iso label slug]} selected? keyboard-highlight? select-country!]
  [:button.country-row
   {:type "button"
    :class (row-class selected? keyboard-highlight?)
    :replicant/on-render (fn [{:keys [replicant/node]}]
                           (when (and keyboard-highlight? node)
                             (.scrollIntoView node #js {:block "nearest"})))
    :on {:click (fn [_] (select-country! slug))}}
   [:span.country-flag (nav-ui.flags/iso->flag iso)]
   [:span.country-label label]])
