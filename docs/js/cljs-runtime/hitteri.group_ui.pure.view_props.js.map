(ns hitteri.group-ui.pure.view-props
  (:require [clojure.string :as str]))

(defn view-props
  [state handlers t]
  (let [draft (str (:pin-separator-overlay-draft-label state ""))]
    (merge
     {:group-rows (:pin-separator-overlay-rows state [])
      :group-selected-id (:pin-separator-overlay-selected-id state)
      :group-draft-label draft
      :group-editing? (some? (:pin-separator-overlay-editing-id state))
      :group-submit-enabled? (not (str/blank? (str/trim draft)))
      :t t}
     handlers)))
