(ns placesurfer.edit.interface.handlers.description-trace
  (:require [placesurfer.edit.handlers.description-trace :as core]))

(defn enabled? [] (core/enabled?))
(defn trace! [& args] (apply core/trace! args))
(defn trace-buffer [] (core/trace-buffer))
(defn clear-trace! [] (core/clear-trace!))
(defn diagnostics [& args] (apply core/diagnostics args))
