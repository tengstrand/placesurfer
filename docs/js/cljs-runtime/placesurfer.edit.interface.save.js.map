(ns placesurfer.edit.interface.save
  (:require [placesurfer.edit.pure.save :as save]))

(defn delete-row->tombstone
  [country-code row]
  (save/delete-row->tombstone country-code row))

(defn row->save-position
  [country-code row]
  (save/row->save-position country-code row))

(defn normalize-save-position-for-compare
  [position]
  (save/normalize-save-position-for-compare position))

(defn save-positions-identity-key
  [position]
  (save/save-positions-identity-key position))

(defn canonical-save-positions
  [positions]
  (save/canonical-save-positions positions))
