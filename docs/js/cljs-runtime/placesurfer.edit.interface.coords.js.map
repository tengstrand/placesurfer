(ns placesurfer.edit.interface.coords
  (:require [placesurfer.edit.pure.coords :as coords]))

(defn form-field-value-str
  [v]
  (coords/form-field-value-str v))

(defn normalize-decimal-input
  [v]
  (coords/normalize-decimal-input v))

(defn decimal-input-matches?
  [s]
  (coords/decimal-input-matches? s))

(defn parse-decimal
  [v]
  (coords/parse-decimal v))

(defn parse-dms-coordinates
  [text]
  (coords/parse-dms-coordinates text))

(defn parse-decimal-coordinate-pair
  [text]
  (coords/parse-decimal-coordinate-pair text))

(defn parse-pasted-coordinates
  [text]
  (coords/parse-pasted-coordinates text))

(defn valid-longitude?
  [v]
  (coords/valid-longitude? v))

(defn valid-latitude?
  [v]
  (coords/valid-latitude? v))

(defn form-has-coords?
  "True when update form longitude and latitude are both valid."
  [form]
  (coords/form-has-coords? form))

(defn haversine-distance-m
  [lon1 lat1 lon2 lat2]
  (coords/haversine-distance-m lon1 lat1 lon2 lat2))

(defn row-lon-lat
  [row]
  (coords/row-lon-lat row))

(defn row-has-coords?
  [row]
  (coords/row-has-coords? row))

(defn row-distance-m
  [reference-row row]
  (coords/row-distance-m reference-row row))
