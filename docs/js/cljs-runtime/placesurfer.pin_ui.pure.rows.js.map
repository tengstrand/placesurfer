(ns placesurfer.pin-ui.pure.rows
  (:require [clojure.string :as str]
            [placesurfer.country.interface :as country]
            [placesurfer.pin-ui.pure.forms :as forms]
            [placesurfer.pin-ui.pure.update-context :as update-context]))

(defn separator-item?
  [item]
  (= :separator (:kind item)))

(defn topic-position-item?
  [item]
  (= :topic-position (:kind item)))

(def ^:private synthetic-id-prefix "__pin-page-")

(defn synthetic-display-item?
  "True for pin-page separators and topic rows that are not persisted pins."
  [item]
  (or (topic-position-item? item)
      (and (separator-item? item)
           (str/starts-with? (str (:id item)) synthetic-id-prefix))))

(defn item-in-country?
  [item countries country-slug]
  (let [{:keys [longitude latitude]} item]
    (cond
      (separator-item? item) false
      (not (and (number? longitude) (number? latitude))) false
      (or (not country-slug) (not (seq countries))) true
      :else
      (if-let [{:keys [west east south north]} (country/country-bounds-for-slug country-slug countries)]
        (and (<= west longitude east)
             (<= south latitude north))
        true))))

(defn pins-for-country
  "Pins whose coordinates fall within `country-slug` bounds."
  [items countries country-slug]
  (vec (filter #(and (not (separator-item? %))
                     (item-in-country? % countries country-slug))
               items)))

(defn country-slug-for-view
  "Country slug used to filter pins in the list and on the edit map."
  [s]
  (if (and (= :update (:page s))
           (update-context/update-pins-mode? s))
    (or (country/slug-for-iso (:update-country-code s) (:countries s))
        (:country-slug s))
    (:country-slug s)))

(defn- pin-visible-in-country? [item countries country-slug]
  (and (not (separator-item? item))
       (item-in-country? item countries country-slug)))

(defn visible-list-items
  "Pins in `country-slug` plus separators adjacent to at least one such pin."
  [items countries country-slug]
  (let [items* (vec items)
        pin-visible? #(pin-visible-in-country? % countries country-slug)]
    (vec (keep-indexed
          (fn [idx item]
            (cond
              (separator-item? item)
              (when (or (some pin-visible? (subvec items* 0 idx))
                        (some pin-visible? (subvec items* (inc idx))))
                item)
              (pin-visible? item) item))
          items*))))

(defn all-list-items
  "All pins and separators in storage order (no country filter)."
  [items]
  (vec (or items [])))

(defn pin-page-list-items
  "Saved pins and groups for the browse pin page (no topic positions)."
  [items]
  (all-list-items items))

(defn- pin-sort-key [{:keys [name]}]
  [(if (str/blank? name) 1 0) (str/lower-case (or name ""))])

(defn sort-pins
  "Return pins sorted alphabetically by name (case-insensitive)."
  [items]
  (vec (sort-by pin-sort-key items)))

(defn selection-id-after-delete
  "After removing `deleted-id` from `table-rows`, return the id to select next.
  Prefers the row below; falls back to the row above for the last item.
  Returns nil only when there is no other row."
  [table-rows deleted-id]
  (when (seq table-rows)
    (let [idx (first (keep-indexed (fn [i {:keys [id]}]
                                      (when (= id deleted-id) i))
                                    table-rows))
          n (count table-rows)]
      (when (some? idx)
        (if (< idx (dec n))
          (:id (nth table-rows (inc idx)))
          (when (pos? idx)
            (:id (nth table-rows (dec idx)))))))))

(defn table-rows
  [items selected-id]
  (mapv (fn [item]
          {:id (:id item)
           :selected? (= selected-id (:id item))
           :kind (cond
                   (separator-item? item) :separator
                   (topic-position-item? item) :topic-position
                   :else :pin)
           :values item})
        (vec items)))

(defn make-separator [id label]
  {:id (str id)
   :kind :separator
   :label (str (or label ""))})

(defn- last-item-separator? [items]
  (when (seq items)
    (separator-item? (last items))))

(defn- synthetic-separator-id [suffix]
  (str synthetic-id-prefix "sep-" suffix))

(defn- topic-position-id [topic idx]
  (str synthetic-id-prefix "topic-" (name topic) "-" idx))

(defn- position-address [position]
  (str/trim (str (or (:location position) (:address position) ""))))

(defn- position->topic-item [position idx topic marker-icon-url]
  {:id (topic-position-id topic idx)
   :kind :topic-position
   :topic topic
   :name (str/trim (str (or (:name position) "")))
   :address (position-address position)
   :location (:location position)
   :longitude (:longitude position)
   :latitude (:latitude position)
   :url (:homepage position)
   :description (:description position)
   :source (:source position)
   :marker-icon-url marker-icon-url})

(defn- positions-for-topic [positions topic]
  (vec (filter #(= topic (:topic %)) positions)))

(defn- sorted-active-topics [active-topics topic-label-fn]
  (->> active-topics
       seq
       (map (fn [topic] {:topic topic :label (topic-label-fn topic)}))
       (sort-by :label #(compare (str/lower-case (str %1)) (str/lower-case (str %2))))
       (mapv :topic)))

(defn pin-page-display-items
  "Pin list items for the dedicated pin page: saved pins, optional Pins separator,
  then each active topic's positions followed by a topic-name separator."
  [{:keys [pin-items active-topics positions pins-section-label topic-label-fn
           topic-marker-url-fn]
    :or {active-topics #{} positions []}}]
  (let [base (all-list-items pin-items)
        with-pins-separator (if (or (empty? base) (last-item-separator? base))
                              base
                              (conj base
                                    (make-separator (synthetic-separator-id "pins")
                                                    pins-section-label)))
        active (sorted-active-topics active-topics topic-label-fn)]
    (reduce
     (fn [acc topic]
       (let [topic-positions (positions-for-topic positions topic)
             label (topic-label-fn topic)
             marker-url (topic-marker-url-fn topic)
             topic-items (mapv (fn [[idx pos]]
                                 (position->topic-item pos idx topic marker-url))
                               (map-indexed vector topic-positions))]
         (if (seq topic-items)
           (-> acc
               (into topic-items)
               (conj (make-separator (synthetic-separator-id (name topic)) label)))
           acc)))
     with-pins-separator
     active)))

(defn- visible-id-set [items]
  (set (map :id items)))

(defn merge-visible-order
  "Rebuild `all-items` keeping non-visible items in place while
   replacing visible items with `reordered-visible` in list order."
  [all-items reordered-visible]
  (let [visible-ids (visible-id-set reordered-visible)
        reordered (vec reordered-visible)]
    (loop [remaining (seq all-items)
           result []
           visible-queue reordered]
      (if (empty? remaining)
        (vec result)
        (let [item (first remaining)]
          (if (visible-ids (:id item))
            (recur (rest remaining)
                   (conj result (first visible-queue))
                   (rest visible-queue))
            (recur (rest remaining) (conj result item) visible-queue)))))))

(defn- index-of-id [items id]
  (first (keep-indexed (fn [idx item]
                          (when (= (str id) (str (:id item))) idx))
                        items)))

(defn move-item-to-index
  "Move the item at `from-index` to `to-index` in `items`."
  [items from-index to-index]
  (when (and (<= 0 from-index (dec (count items)))
             (<= 0 to-index (count items))
             (not= from-index to-index))
    (let [item (nth items from-index)
          without (vec (concat (subvec items 0 from-index)
                               (subvec items (inc from-index))))
          to-index* (min to-index (count without))]
      (vec (concat (subvec without 0 to-index*)
                   [item]
                   (subvec without to-index*))))))

(defn reorder-list-items
  "Reorder `list-items` by moving `drag-id` to just before whichever item has
   `target-id`, merged back into `all-items`. Falls back to the raw `to-index`
   position when `target-id` is nil or isn't found in `list-items`.
   Resolving by id (rather than trusting `to-index` as-is) matters because
   the caller (pure.drag) computes `to-index` by counting the RENDERED rows,
   which don't always line up 1:1 with `list-items`'s own order - pin-ui's
   pin-table sorts/groups rows for display and renders separators as headers
   rather than rows (see pin-ui.pure.list-panel/pin-sorted-table's pin-only filter), so a drop at
   rendered-row-index N can land on a different item, or even a different
   absolute index, than `list-items`'s own position N.
   `move-item-to-index`'s `to-index` is a position counted AFTER `drag-id` has
   already been removed - so when the target sits AFTER `drag-id` in
   `list-items`, removing `drag-id` first shifts the target one slot earlier,
   and that shift has to be subtracted here, or the dragged item ends up one
   slot past (i.e. just after, not just before) the row it was dropped on.
   EXCEPT when the target is `drag-id`'s own immediate next neighbor: 'just
   before the neighbor' is where the dragged item already sits, so the
   subtracted index is a no-op there - dropping anywhere on that one
   adjacent row (not just its lower half) is treated as swapping places with
   it instead, since a drag the user visibly performed should never
   silently do nothing."
  ([all-items list-items drag-id to-index] (reorder-list-items all-items list-items drag-id to-index nil))
  ([all-items list-items drag-id to-index target-id]
   (let [from-index (index-of-id list-items drag-id)
         target-index (when target-id (index-of-id list-items target-id))
         resolved-to-index (cond
                              (nil? target-index) to-index
                              (and from-index (> target-index from-index))
                              (if (= target-index (inc from-index))
                                target-index
                                (dec target-index))
                              :else target-index)]
     (when (and (some? from-index) (some? resolved-to-index))
       (when-let [reordered (move-item-to-index list-items from-index resolved-to-index)]
         (merge-visible-order all-items reordered))))))

(defn reorder-visible-pin
  "Reorder visible list items by moving `drag-id` to just before `target-id`
   (or `to-index` when that can't be resolved) in the visible list."
  ([all-items countries country-slug drag-id to-index]
   (reorder-visible-pin all-items countries country-slug drag-id to-index nil))
  ([all-items countries country-slug drag-id to-index target-id]
   (reorder-list-items all-items
                       (visible-list-items all-items countries country-slug)
                       drag-id
                       to-index
                       target-id)))

(defn reorder-pin-page-items
  "Reorder saved pins and groups on the browse pin page."
  ([all-items drag-id to-index] (reorder-pin-page-items all-items drag-id to-index nil))
  ([all-items drag-id to-index target-id]
   (reorder-list-items all-items (pin-page-list-items all-items) drag-id to-index target-id)))

(defn insert-item-after-id
  "Insert `new-item` after the item with `id`, or append when `id` is missing."
  [items id new-item]
  (if-let [idx (first (keep-indexed (fn [i v] (when (= id (:id v)) i)) items))]
    (vec (concat (subvec (vec items) 0 (inc idx))
                 [new-item]
                 (subvec (vec items) (inc idx))))
    (conj (vec items) new-item)))

(defn upsert-item [items item]
  (if-let [idx (first (keep-indexed (fn [i v] (when (= (:id item) (:id v)) i)) items))]
    (assoc-in (vec items) [idx] item)
    (conj (vec items) item)))

(defn remove-item [items id]
  (vec (remove #(= id (:id %)) items)))

(defn find-by-id [items id]
  (first (filter #(= (str id) (str (:id %))) items)))

(defn- coord-key [{:keys [longitude latitude]}]
  (when (and (number? longitude) (number? latitude))
    [(double longitude) (double latitude)]))

(defn find-by-coords
  "Return the first pin with the same longitude/latitude."
  [items longitude latitude]
  (when-let [key (coord-key {:longitude longitude :latitude latitude})]
    (first (filter #(= key (coord-key %)) items))))

