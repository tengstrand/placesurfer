(ns placesurfer.pin-ui.handlers.form
  "Form field edits for the pin editor (name, coords, url, description)."
  (:require [clojure.string :as str]
            [placesurfer.pin-ui.handlers.editor :as editor]
            [placesurfer.pin-ui.handlers.map :as pin-map]
            [placesurfer.pin-ui.handlers.rows :as pin-rows]
            [placesurfer.pin-ui.handlers.state :as pin-state]
            [placesurfer.pin-ui.pure.forms :as forms]))

(defn- notify-inline-edit! []
  (editor/schedule-inline-auto-save!))

(defn set-pin-name! [v]
  (pin-state/update-form-field! :name v)
  (pin-rows/update-draft-pin-field! :name v)
  (notify-inline-edit!))

(defn set-pin-address! [v]
  (pin-state/update-form-field! :location v)
  (notify-inline-edit!))

(defn set-pin-icon! [v]
  (pin-state/update-form-field! :icon (forms/normalize-icon v))
  (pin-map/schedule-pin-map-sync! {:recenter? false})
  (notify-inline-edit!))

(defn set-pin-stars! [v]
  (pin-state/update-form-field! :ranking (forms/normalize-stars v))
  (notify-inline-edit!))

(defn set-pin-radii! [v]
  (pin-state/update-form-field! :radii v)
  (pin-map/schedule-pin-map-sync! {:recenter? false})
  (notify-inline-edit!))

(defn set-pin-url! [v]
  (pin-state/update-form-field! :url v)
  (notify-inline-edit!))

(defn set-pin-image! [v]
  (pin-state/update-form-field! :image v)
  (notify-inline-edit!))

(defn set-pin-agent-url! [v]
  (pin-state/update-form-field! :agent-url v)
  (notify-inline-edit!))

(defn set-pin-agent-name! [v]
  (pin-state/update-form-field! :agent-name v)
  (notify-inline-edit!))

(defn set-pin-description! [v]
  (pin-state/update-form-field! :description v)
  (notify-inline-edit!))

(defn set-pin-longitude! [v]
  (pin-state/update-form-field! :longitude v)
  (notify-inline-edit!))

(defn commit-pin-longitude! [v]
  (when (seq (str/trim (str v)))
    (pin-state/update-form-field! :longitude (str/trim (str v))
                                  {:recenter? true})
    (notify-inline-edit!)))

(defn set-pin-latitude! [v]
  (pin-state/update-form-field! :latitude v)
  (notify-inline-edit!))

(defn commit-pin-latitude! [v]
  (when (seq (str/trim (str v)))
    (pin-state/update-form-field! :latitude (str/trim (str v))
                                  {:recenter? true})
    (notify-inline-edit!)))
