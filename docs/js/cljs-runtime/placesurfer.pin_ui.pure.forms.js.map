(ns placesurfer.pin-ui.pure.forms
  (:require [clojure.string :as str]
            [placesurfer.html.interface.sanitize :as html-sanitize]
            [placesurfer.pin-ui.pure.coords :as coords]))

(def default-icon "pin-orange.png")
(def hemnet-icon "house2.png")
(def icon-dir "/images/pins/")

(def stars-dir "/images/stars/")
(def default-stars "3-stars.png")
(def stars-options ["5-stars.png" "4-stars.png" "3-stars.png" "2-stars.png" "1-star.png" "0-stars.png"])

(defn stars-url [stars]
  (str stars-dir (if (some #{stars} stars-options) stars default-stars)))

(defn normalize-stars [stars]
  (if (some #{stars} stars-options) stars "0-stars.png"))

(def ^:private legacy-icon-map
  {"pin2.png" default-icon
   "home.png" hemnet-icon
   "house.png" "house12.png"})

(def ^:private fallback-icon-options
  ["house1.png" "house10.png" "house11.png" "house12.png" "house13.png" "house14.png"
   "house15.png" "house16.png" "house17.png" "house18.png" "house19.png"
   "house2.png" "house20.png" "house21.png" "house22.png" "house23.png"
   "house24.png" "house25.png" "house27.png" "house28.png"
   "house29.png" "house30.png" "house31.png" "house32.png" "house33.png" "house34.png"
   "house3.png" "house4.png" "house5.png" "house6.png" "house7.png" "house8.png" "house9.png"
   default-icon "pin-white.png"])

(defonce ^:private icon-options* (atom fallback-icon-options))

(defn icon-options []
  @icon-options*)

(defn set-icon-options! [filenames]
  (when (seq filenames)
    (reset! icon-options* (vec filenames))))

(defn- remap-legacy-icon [v]
  (get legacy-icon-map v v))

(defn normalize-icon
  ([icon] (normalize-icon icon (icon-options)))
  ([icon options]
   (let [v (str/trim (str icon))
         v (if (empty? v) default-icon (remap-legacy-icon v))]
     (cond
       (some #{v} options) v
       (some #{default-icon} options) default-icon
       (seq options) (first options)
       :else default-icon))))

(defn icon-url [icon]
  (str icon-dir (normalize-icon icon)))

(defn default-form []
  {:name ""
   :location ""
   :icon default-icon
   :ranking default-stars
   :radii ""
   :longitude ""
   :latitude ""
   :url ""
   :image ""
   :description ""
   :agent-url ""
   :agent-name ""})

(defn coerce-text [v]
  (cond
    (string? v) v
    (nil? v) ""
    :else (str v)))

(defn- sanitize-description [v]
  (html-sanitize/sanitize-description-html (coerce-text v)))

(defn form->item
  "Build a pin item map from form + id."
  [form id]
  (when-let [lon (coords/parse-decimal (:longitude form))]
    (when-let [lat (coords/parse-decimal (:latitude form))]
       (cond-> {:id id
                :name (str/trim (coerce-text (:name form)))
                :address (str/trim (coerce-text (:location form)))
                :icon (normalize-icon (:icon form))
                :ranking (normalize-stars (:ranking form))
                :longitude lon
                :latitude lat
                :url (str/trim (coerce-text (:url form)))
                :image (str/trim (coerce-text (:image form)))
                :description (str/trim (sanitize-description (:description form)))
                :agent-url (str/trim (coerce-text (:agent-url form)))
                :agent-name (str/trim (coerce-text (:agent-name form)))}
         (seq (str/trim (coerce-text (:radii form))))
         (assoc :radii (str/trim (coerce-text (:radii form))))))))

(defn item->form [item]
  (if item
    {:name (coerce-text (:name item))
     :location (coerce-text (:address item))
     :icon (normalize-icon (or (:icon item) default-icon))
     :ranking (normalize-stars (or (:ranking item) (:stars item) "0-stars.png"))
     :radii (coerce-text (:radii item))
     :longitude (if (number? (:longitude item))
                   (str (:longitude item))
                   (coerce-text (:longitude item)))
     :latitude (if (number? (:latitude item))
                  (str (:latitude item))
                  (coerce-text (:latitude item)))
     :url (coerce-text (:url item))
     :image (coerce-text (:image item))
     :description (coerce-text (:description item))
     :agent-url (coerce-text (:agent-url item))
     :agent-name (coerce-text (:agent-name item))}
    (default-form)))

(defn parse-radii
  "Parse a comma-separated radii string into a vector of positive km numbers.
   Returns nil if the string is empty or contains any invalid/out-of-range value."
  [s]
  (let [trimmed (str/trim (str s))]
    (when (seq trimmed)
      (let [parts (str/split trimmed #"\s*,\s*")
            nums  (mapv #(js/parseFloat %) parts)]
        (when (every? #(and (number? %) (not (js/isNaN %)) (pos? %) (<= % 20000)) nums)
          nums)))))

(defn radii-valid?
  "True when the radii field is empty (no circles) or contains valid positive km values."
  [s]
  (let [trimmed (str/trim (str s))]
    (or (empty? trimmed)
        (some? (parse-radii trimmed)))))

(defn form-valid? [form]
  (and (seq (str/trim (coerce-text (:name form))))
       (coords/valid-longitude? (:longitude form))
       (coords/valid-latitude? (:latitude form))
       (radii-valid? (:radii form))))

(defn form-from-search-result
  "Build edit form values from a Photon result, keeping url/description."
  [result pin-form]
  {:name (:name result)
   :location (or (:location pin-form) "")
   :icon (normalize-icon (or (:icon pin-form) default-icon))
   :ranking (normalize-stars (or (:ranking pin-form) default-stars))
   :radii (or (:radii pin-form) "")
   :longitude (str (:longitude result))
   :latitude (str (:latitude result))
   :url (or (:url pin-form) "")
   :image (or (:image pin-form) "")
   :description (or (:description pin-form) "")
   :agent-url (or (:agent-url pin-form) "")
   :agent-name (or (:agent-name pin-form) "")})

(defn form-field-values
  [form]
  {:name (str/trim (coerce-text (:name form)))
   :location (str/trim (coerce-text (:location form)))
   :icon (normalize-icon (:icon form))
   :ranking (normalize-stars (:ranking form))
   :radii (str/trim (coerce-text (:radii form)))
   :longitude (str/trim (coerce-text (:longitude form)))
   :latitude (str/trim (coerce-text (:latitude form)))
   :url (str/trim (coerce-text (:url form)))
   :image (str/trim (coerce-text (:image form)))
   :description (str/trim (coerce-text (:description form)))
   :agent-url (str/trim (coerce-text (:agent-url form)))
   :agent-name (str/trim (coerce-text (:agent-name form)))})

(defn form-edited-from-baseline?
  [form baseline]
  (and (some? baseline)
       (not= (form-field-values form) (form-field-values baseline))))

(defn pin-icon-anchor
  "MapLibre anchor point: 'bottom' for pin-shaped icons, 'center' for others."
  [icon]
  (if (str/starts-with? icon "pin-") "bottom" "center"))

(defn pin-icon-marker-offset
  "Pixel offset [x y] to compensate for whitespace below the visual tip in pin images."
  [icon]
  (case icon
    "pin-orange.png" [0 2]
    "pin-white.png"  [0 4]
    (if (str/starts-with? icon "pin-") [0 4] [0 0])))
