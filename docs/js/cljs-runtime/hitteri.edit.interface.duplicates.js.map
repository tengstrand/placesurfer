(ns hitteri.edit.interface.duplicates
  (:require [hitteri.edit.pure.duplicates :as duplicates]))

(defn find-first-name-duplicate
  [rows]
  (duplicates/find-first-name-duplicate rows))

(defn find-first-coord-duplicate
  [rows]
  (duplicates/find-first-coord-duplicate rows))

(defn first-duplicate
  [rows]
  (duplicates/first-duplicate rows))

(defn fully-identical-rows?
  [a b]
  (duplicates/fully-identical-rows? a b))

(defn has-identical-saved-sibling?
  [rows row]
  (duplicates/has-identical-saved-sibling? rows row))

(defn duplicate-row-id-set
  [rows]
  (duplicates/duplicate-row-id-set rows))

(defn sort-rows-by-duplicate-clusters
  [rows]
  (duplicates/sort-rows-by-duplicate-clusters rows))

(defn duplicate-error-message
  [info]
  (duplicates/duplicate-error-message info))

(defn dataset-has-duplicates?
  [rows]
  (duplicates/dataset-has-duplicates? rows))
