(ns placesurfer.country.core)

(defn locale->iso []
  (try
    (let [lang (or (.-language js/navigator)
                   (aget (.-languages js/navigator) 0)
                   "en-US")
          parts (.split lang "-")]
      (if (> (.-length parts) 1)
        (.toUpperCase (aget parts 1))
        "SE"))
    (catch :default _ "SE")))

(defn slug-for-iso [iso countries]
  (some #(when (= iso (:iso %)) (:slug %)) countries))

(defn iso-for-slug [slug countries]
  (some #(when (= slug (:slug %)) (:iso %)) countries))

(defn country-label [slug countries]
  (:label (first (filter #(= slug (:slug %)) countries))))

(defn country-bounds-for-slug
  "Bounding box for `slug` from enriched :countries, or nil."
  [slug countries]
  (when-let [{:keys [west east south north]} (first (filter #(= slug (:slug %)) countries))]
    (when (and (number? west) (number? east) (number? south) (number? north))
      {:west west :east east :south south :north north})))

(defn- bounds-for-pick
  "Map-click bounds; use metropolitan :pick-* boxes when present."
  [{:keys [pick-west pick-east pick-south pick-north west east south north]}]
  {:west (or pick-west west)
   :east (or pick-east east)
   :south (or pick-south south)
   :north (or pick-north north)})

(defn- point-in-bounds? [country lon lat]
  (let [{:keys [west east south north]} (bounds-for-pick country)]
    (and (number? west) (number? east) (number? south) (number? north)
         (<= west lon east)
         (<= south lat north))))

(defn- bounds-area [country]
  (let [{:keys [west east south north]} (bounds-for-pick country)]
    (* (- east west) (- north south))))

(defn slug-for-point
  "Country slug whose pick bounding box contains `lon`/`lat`, preferring the smallest match."
  [lon lat countries]
  (some->> countries
           (filter #(point-in-bounds? % lon lat))
           (sort-by bounds-area)
           first
           :slug))

(defn navigate-country-plan [target-page]
  {:focus-search? (= target-page :country)})

(defn set-country-filter-plan [query]
  {:country-filter (or query "")})

(defn highlight-index-after-filter
  "Index to highlight after the filter changes, or nil when the list is empty."
  [visible-count]
  (when (pos? visible-count) 0))

(defn step-highlight-index
  "Move keyboard highlight by `delta` (+1 down, -1 up) with wrap. Returns nil when
   `visible-count` is zero. First arrow from `nil` lands on index 0 (down) or last (up)."
  [current-index visible-count delta]
  (when (pos? visible-count)
    (let [idx (if (some? current-index)
                current-index
                (if (pos? delta) -1 visible-count))]
      (mod (+ idx delta) visible-count))))

(defn select-country-plan
  "Pure plan for selecting a country in the UI."
  [{:keys [current-slug page mobile?]} slug]
  (let [same-country? (= slug current-slug)
        on-country-page? (= page :country)]
    {:same-country? same-country?
     :clear-filter? true
     :switch-to-country-page? (and (not same-country?) (not on-country-page?))
     :focus-search? (and (not same-country?) (not on-country-page?))
     :load-country? (not same-country?)
     :navigate-home? (and (not same-country?) on-country-page? mobile?)
     :load-options {:fit? true :animate? true}}))
