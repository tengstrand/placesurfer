(ns placesurfer.app-ui.ui.pages
  (:require [placesurfer.topic-ui.interface :as topic-ui]))

(defn map-page?
  [page]
  (contains? #{:home :topic :country} page))

(defn about-page?
  [page]
  (= page :about))

(defn settings-page?
  [page]
  (= page :settings))

(defn topic-page?
  [page]
  (topic-ui/topic-page? page))

(defn country-page?
  [page]
  (= page :country))

(defn update-page?
  [page]
  (= page :update))

(defn pin-page?
  [page]
  (= page :pin))

(defn groups-page?
  [page]
  (= page :groups))

(defn show-main-map-area?
  [{:keys [page mobile?]}]
  (and (map-page? page)
       (not (and mobile? (or (topic-page? page) (country-page? page))))))
