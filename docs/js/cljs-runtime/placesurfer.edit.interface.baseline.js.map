(ns placesurfer.edit.interface.baseline
  (:require [placesurfer.edit.pure.baseline :as baseline]
            [placesurfer.edit.pure.sources :as sources]))

(defn normalize-update-source
  [source]
  (sources/normalize-update-source source))

(defn coerce-form-text
  [v]
  (sources/coerce-form-text v))

(defn form-field-values
  [form]
  (baseline/form-field-values form))

(defn row->form-baseline
  [row]
  (baseline/row->form-baseline row))

(defn form-edited-from-baseline?
  [form baseline]
  (baseline/form-edited-from-baseline? form baseline))
