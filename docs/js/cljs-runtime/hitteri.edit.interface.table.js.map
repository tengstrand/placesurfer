(ns hitteri.edit.interface.table
  (:require [hitteri.edit.pure.columns :as columns]
            [hitteri.edit.pure.sort :as sort]
            [hitteri.edit.pure.table :as table]))

(defn column-label
  "Display label for an update-table column key."
  ([k] (columns/column-label k))
  ([k t] (columns/column-label k t)))

(defn table-sort-data-field
  "Maps UI sort keys to row data keys."
  [sort-key]
  (sort/table-sort-data-field sort-key))

(defn compare-field-values
  "Sort helper: numbers asc, nils last, strings case-insensitive."
  [a b]
  (sort/compare-field-values a b))

(defn as-update-columns
  [cols]
  (table/as-update-columns cols))

(defn distance-sort-active?
  [selected-row]
  (table/distance-sort-active? selected-row))

(defn preferred-column-keys
  [update-columns]
  (table/preferred-column-keys update-columns))

(defn table-columns
  ([update-columns] (table/table-columns update-columns))
  ([update-columns t] (table/table-columns update-columns t)))

(defn resolve-table-sort
  [update-sort distance-sort?]
  (table/resolve-table-sort update-sort distance-sort?))

(defn update-columns-for-rows
  [rows]
  (table/update-columns-for-rows rows))

(defn sort-update-table-rows
  [rows sort-params pin-row?]
  (table/sort-update-table-rows rows sort-params pin-row?))
