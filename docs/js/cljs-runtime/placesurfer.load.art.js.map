(ns placesurfer.load.art
  (:require [placesurfer.load.gis :as gis]))

(def ^:private counts-url "data/art/place-counts.edn")

(defn- gis-url [slug]
  (str "data/art/" slug ".edn"))

(defn load-counts! []
  (gis/load-counts! counts-url))

(defn load-countries! []
  (gis/load-countries! counts-url))

(defn load-country! [slug]
  (gis/load-country! gis-url slug))
