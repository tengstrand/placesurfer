(ns placesurfer.about-ui.sources
  (:require [clojure.string :as str]))

(def source-ids
  [:manual :openstreetmap :discgolfmetrix :discgolfapi :biodlarkartan])

(def ^:private source-id-set (set source-ids))

(defn normalize-source-id
  [source]
  (when source
    (let [k (cond
              (keyword? source) source
              (symbol? source) (keyword (name source))
              (string? source) (keyword (str/lower-case (str/trim source)))
              :else nil)]
      (when (contains? source-id-set k) k))))

(defn anchor-id
  [source-id]
  (str "source-" (name source-id)))

(defn icon-src
  [source-id]
  (str "/images/source/" (name source-id) ".png"))

(defn about-href
  [source-id]
  (str "/?page=about#" (anchor-id source-id)))

(defn name-key [source-id]
  (keyword (str "source-" (name source-id) "-name")))

(defn description-key [source-id]
  (keyword (str "source-" (name source-id) "-description")))

(def ^:private metrix-api-url "https://discgolfmetrix.com/api.php")

(defn- scroll-to-location-hash! []
  (try
    (let [hash (.-hash js/location)]
      (when (and (seq hash) (.startsWith hash "#source-"))
        (js/setTimeout
         #(when-let [el (.querySelector js/document hash)]
            (.scrollIntoView el #js {:behavior "auto" :block "start"}))
         0)))
    (catch :default _ nil)))

(defn- attribution-link [href text]
  [:a.about-link
   {:href href
    :target "_blank"
    :rel "noopener noreferrer"}
   text])

(defn- description-content [t source-id]
  (case source-id
    :manual
    [:p.about-source-description (t (description-key source-id))]

    :openstreetmap
    [:p.about-source-description
     (t :source-openstreetmap-description)
     " "
     (t :source-openstreetmap-attribution-prefix)
     (attribution-link "https://www.openstreetmap.org/copyright"
                       (t :source-openstreetmap-attribution-link))
     "."]

    :discgolfmetrix
    [:p.about-source-description
     (t :source-discgolfmetrix-description-prefix)
     (attribution-link metrix-api-url
                       (t :source-discgolfmetrix-description-link))
     "."]

    :discgolfapi
    [:p.about-source-description
     (t :source-discgolfapi-description-prefix)
     (attribution-link "https://discgolfapi.com/"
                       (t :source-discgolfapi-description-link))
     "."]

    :biodlarkartan
    [:p.about-source-description
     (attribution-link (t :source-biodlarkartan-url) "Biodlarkartan")
     " "
     (t :source-biodlarkartan-description)]

    [:p.about-source-description (t (description-key source-id))]))

(defn section
  [t]
  [:motion.about-section#about-sources
   {:replicant/on-render (fn [_] (scroll-to-location-hash!))}
   [:h2.about-heading (t :about/sources-heading)]
   [:table.about-sources-table
    [:thead
     [:tr
      [:th.about-sources-icon-col {:scope "col" :aria-hidden "true"} ""]
      [:th.about-sources-name-col {:scope "col"} (t :about/sources-column-source)]
      [:th.about-sources-desc-col {:scope "col"} (t :about/sources-column-description)]]]
    [:tbody
     (for [source-id source-ids]
       ^{:key (name source-id)}
       [:tr.about-sources-row {:id (anchor-id source-id)}
        [:td.about-sources-icon-cell
         [:img.about-source-icon {:src (icon-src source-id) :alt ""}]]
        [:td.about-source-name (t (name-key source-id))]
        [:td.about-sources-desc-cell
         (description-content t source-id)]])]]])
