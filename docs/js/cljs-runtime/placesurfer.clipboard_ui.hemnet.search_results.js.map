(ns placesurfer.clipboard-ui.hemnet.search-results
  "Normalize a placesurfer/hemnet-search-results payload's :items - each shaped
   exactly like a single-listing placesurfer/hemnet-listing payload - into
   pin-form-shaped maps, reusing the same normalization used for single
   Hemnet-listing imports. Despite the ns name (kept for the payload :type's
   sake, see hemnet.payload), this also handles Booli and Notar search
   results - the payload shape is source-agnostic."
  (:require [placesurfer.clipboard-ui.booli.url :as booli-url]
            [placesurfer.clipboard-ui.hemnet.form :as hemnet-form]
            [placesurfer.clipboard-ui.hemnet.listing :as hemnet-listing]
            [placesurfer.clipboard-ui.hemnet.payload :as hemnet-payload]
            [placesurfer.clipboard-ui.hemnet.url :as hemnet-url]
            [placesurfer.clipboard-ui.notar.url :as notar-url]
            [placesurfer.i18n.interface :as i18n]))

(defn- listing-id-from-url
  "Try each known site's URL id pattern in turn - Hemnet's bare numeric id is
   kept unprefixed for backward compatibility with already-stored results;
   Booli's and Notar's are namespaced (see booli.url/notar.url) so none of
   them can ever collide."
  [url]
  (or (hemnet-url/listing-id-from-url url)
      (booli-url/listing-id-from-url url)
      (notar-url/listing-id-from-url url)))

(defn- item->result [item locale]
  (when-let [listing (hemnet-payload/payload->listing item)]
    (when (hemnet-listing/listing-has-coords? listing)
      (let [source-url (:url item)
            id (listing-id-from-url source-url)]
        (when id
          (assoc (hemnet-form/listing->pin-form listing source-url (i18n/t locale :common/plot))
                 :id id))))))

(defn payload->results
  "Normalize a hemnet-search-results payload's :items into a vector of
   pin-form-shaped maps (each tagged with :id), skipping items without a
   resolvable listing id or coordinates."
  [payload locale]
  (vec (keep #(item->result % locale) (:items payload []))))
