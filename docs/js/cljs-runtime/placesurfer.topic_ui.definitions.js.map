(ns placesurfer.topic-ui.definitions
  "Build topic definition maps from keys and lookup functions.")

(defn from-keys
  "One {:topic :label :marker-url} map per topic key, in key order."
  [topic-keys label-fn marker-url-fn]
  (mapv (fn [topic]
          {:topic topic
           :label (label-fn topic)
           :marker-url (marker-url-fn topic)})
        topic-keys))
