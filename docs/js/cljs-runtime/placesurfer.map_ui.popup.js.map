(ns placesurfer.map-ui.popup
  (:require [clojure.string :as str]
            [placesurfer.about-ui.interface.sources :as sources]
            [placesurfer.googlestreetmap.interface :as google-maps]
            [placesurfer.html.interface.sanitize :as html-sanitize]))

(defn- non-blank? [s]
  (some? (when s (seq (str/trim (str s))))))

(defn- escape-html [s]
  (-> (str s)
      (str/replace "&" "&amp;")
      (str/replace "<" "&lt;")
      (str/replace ">" "&gt;")
      (str/replace "\"" "&quot;")))

(defn- popup-page-url [{:keys [homepage url]}]
  (cond
    (non-blank? homepage) homepage
    (non-blank? url) url
    :else nil))

(defn- popup-image-html [position]
  (when-let [image (some-> (:image position) str str/trim not-empty)]
    (let [img (str "<img src=\""
                   (escape-html image)
                   "\" alt=\"\" loading=\"lazy\">")
          page-url (popup-page-url position)]
      (if page-url
        (str "<a class=\"map-popup-image-link\" href=\""
             (escape-html page-url)
             "\" target=\"_blank\" rel=\"noopener noreferrer\">"
             img
             "</a>")
        img))))

(defn- popup-address-row-html [position]
  (when-let [address (not-empty (str/trim (str (:address position))))]
    (str "<div class=\"map-popup-address-row\">"
         "<span class=\"map-popup-address\">" (escape-html address) "</span>"
         "</div>")))

(defn- popup-source-html [source source-label]
  (when-let [source-id (sources/normalize-source-id source)]
    (str "<div class=\"map-popup-source\">"
         "<span class=\"map-popup-source-label\">"
         (escape-html source-label)
         "</span>"
         "<a class=\"map-popup-source-link\" href=\""
         (escape-html (sources/about-href source-id))
         "\">"
         "<img class=\"map-popup-link-icon\" src=\""
         (escape-html (sources/icon-src source-id))
         "\" alt=\""
         (escape-html (name source-id))
         "\" />"
         "</a>"
         "</div>")))

(defn popup-html
  "HTML for a place popup (map marker or pin list preview)."
  ([position]
   (popup-html position {}))
  ([position {:keys [source-label] :or {source-label "Source: "}}]
   (let [{:keys [name description locality source agent-url]} position
         {:keys [google-maps-url hemnet-url]} (or (google-maps/place-external-links position) {})
         source-html (popup-source-html source source-label)
         address-row-html (popup-address-row-html position)
         hemnet-link-html (when hemnet-url
                            (google-maps/build-external-icon-link-html
                             {:url hemnet-url
                              :icon-src "/images/hemnet.png"
                              :icon-class "place-external-link-icon"
                              :link-class "place-external-link--hemnet"
                              :aria-label "Hemnet"}))
         agent-link-html (when (non-blank? agent-url)
                           (google-maps/build-external-icon-link-html
                            {:url agent-url
                             :icon-src "/images/agent.png"
                             :icon-class "place-external-link-icon"
                             :link-class "place-external-link--agent"
                             :aria-label "Mäklare"}))
         google-maps-link-html (when google-maps-url
                                 (google-maps/build-maps-icon-link-html
                                  {:url google-maps-url}))
         title-links (remove nil? [hemnet-link-html agent-link-html google-maps-link-html])
         name-html (if (seq title-links)
                     (str "<div class=\"map-popup-name-row\">"
                          "<div class=\"map-popup-name\">" (escape-html (or name "Place")) "</div>"
                          (str/join "" title-links)
                          "</div>")
                     (str "<div class=\"map-popup-name\">" (escape-html (or name "Place")) "</div>"))
         parts (cond-> [name-html]
                  (non-blank? (:image position))
                  (conj (str "<div class=\"map-popup-image\">"
                             (popup-image-html position)
                             "</div>"))

                  address-row-html
                  (conj address-row-html)

                  (non-blank? description)
                  (conj (str "<div class=\"map-popup-description\">"
                             (html-sanitize/sanitize-description-html description)
                             "</div>"))

                  (non-blank? locality)
                  (conj (str "<div class=\"map-popup-locality\">"
                             (escape-html locality)
                             "</div>"))

                  source-html
                  (conj source-html))]
     (str "<div class=\"map-popup\">" (str/join "" parts) "</div>"))))
