(ns placesurfer.map-ui.popup
  (:require [clojure.string :as str]
            [placesurfer.about-ui.interface.sources :as sources]
            [placesurfer.googlestreetmap.interface :as google-maps]
            [placesurfer.html.interface.sanitize :as html-sanitize]))

(defn- non-blank? [s]
  (some? (when s (seq (str/trim (str s))))))

(defn- escape-html [s]
  (-> (str s)
      (str/replace "&" "&amp;")
      (str/replace "<" "&lt;")
      (str/replace ">" "&gt;")
      (str/replace "\"" "&quot;")))

(defn- popup-page-url [{:keys [homepage url]}]
  (cond
    (non-blank? homepage) homepage
    (non-blank? url) url
    :else nil))

(defn- popup-image-html [position]
  (when-let [image (some-> (:image position) str str/trim not-empty)]
    (let [img (str "<img src=\""
                   (escape-html image)
                   "\" alt=\"\" loading=\"lazy\">")
          page-url (popup-page-url position)]
      (if page-url
        (str "<a class=\"map-popup-image-link\" href=\""
             (escape-html page-url)
             "\" target=\"_blank\" rel=\"noopener noreferrer\">"
             img
             "</a>")
        img))))

(defn- popup-address-row-html [position]
  (when-let [address (not-empty (str/trim (str (:address position))))]
    (str "<div class=\"map-popup-address-row\">"
         "<span class=\"map-popup-address\">" (escape-html address) "</span>"
         "</div>")))

(def ^:private deletable-marker-topics #{:pin :hemnet-result :booli-result :notar-result})
(def ^:private editable-marker-topics #{:pin})

(defn- popup-edit-btn-html
  "Jump-to-edit-page button, shown only for a saved pin marker (not Hemnet/
   Booli search results, which have no entry on the edit page) and only when
   the caller says editing is actually reachable right now (`:editable?` -
   the backend has to be online, see pin_ui.handlers.map/popup-opts). Click
   handling is wired up in map-ui.core via `set-on-marker-edit-handler!`."
  [position editable? edit-label]
  (when (and editable?
             (contains? editable-marker-topics (:marker-topic position))
             (:id position))
    (str "<button type=\"button\" class=\"map-popup-edit-btn\" title=\""
         (escape-html edit-label) "\" aria-label=\"" (escape-html edit-label) "\">"
         "<img src=\"/images/edit.png\" alt=\"\" />"
         "</button>")))

(defn- popup-delete-btn-html
  "Trash-icon button, shown only for a saved pin or Hemnet search-result
   marker (identified by :marker-topic - absent on the plain position maps
   used for list-preview cards, so this never renders there). The actual
   click handling (soft-delete for Hemnet, remove for pins, same as the
   list's own trash icon) is wired up in map-ui.core via
   `set-on-marker-delete-handler!` - this is just the markup."
  [position delete-label]
  (when (and (contains? deletable-marker-topics (:marker-topic position))
             (:id position))
    (str "<button type=\"button\" class=\"map-popup-delete-btn\" title=\""
         (escape-html delete-label) "\" aria-label=\"" (escape-html delete-label) "\">"
         "<img src=\"/images/trash.png\" alt=\"\" />"
         "</button>")))

(defn- popup-viewing-html
  "Open-house viewing date/time, already formatted ready-to-display text by
   whichever bookmarklet scraped it (e.g. \"Visning: 18 okt. 11:00\") - shown
   at the very bottom of the popup, below the source row."
  [position]
  (when-let [viewing (not-empty (str/trim (str (:viewing position))))]
    (str "<div class=\"map-popup-viewing\">" (escape-html viewing) "</div>")))

(defn departures-url-with-destination
  "Appends the user's configured transit destination (see settings-ui's
   \"Avgångar\" section) as a &Z=<name> param onto the precomputed Samtrafiken
   deep link - confirmed empirically that this HAFAS skin accepts
   &Z=<urlencoded name> as the destination param. Public: clicking a
   train-station/bus-stop marker opens this URL directly (see
   map-ui.core/attach-marker-interactions!) rather than going through a
   popup link, so this is called from outside this namespace."
  [transit-departures-url transit-destination]
  (if (non-blank? transit-destination)
    (str transit-departures-url "&Z=" (js/encodeURIComponent (str/trim transit-destination)))
    transit-departures-url))

(defn- popup-transit-html
  "Transit lines (from Trafiklab, e.g. \"4 mot Uppsala C, 805 mot Enköping\"),
   when present - needs a Trafiklab API key at data-generation time, so is
   absent for many stops and for all non-transit markers (pins, other
   topics). The \"Show departures\" journey-planner link that used to live
   here was removed: clicking a train-station/bus-stop marker now opens it
   directly instead of requiring the popup (see map-ui.core)."
  [{:keys [transit-lines]} transit-label]
  (when (seq transit-lines)
    (str "<div class=\"map-popup-transit\">"
         "<div class=\"map-popup-transit-lines\">"
         (escape-html transit-label)
         (escape-html (str/join ", " transit-lines))
         "</div>"
         "</div>")))

(defn- popup-source-html [source source-label]
  (when-let [source-id (sources/normalize-source-id source)]
    (str "<div class=\"map-popup-source\">"
         "<span class=\"map-popup-source-label\">"
         (escape-html source-label)
         "</span>"
         "<a class=\"map-popup-source-link\" href=\""
         (escape-html (sources/about-href source-id))
         "\">"
         "<img class=\"map-popup-link-icon\" src=\""
         (escape-html (sources/icon-src source-id))
         "\" alt=\""
         (escape-html (name source-id))
         "\" />"
         "</a>"
         "</div>")))

(defn popup-html
  "HTML for a place popup (map marker or pin list preview)."
  ([position]
   (popup-html position {}))
  ([position {:keys [source-label delete-label edit-label editable? transit-label]
              :or {source-label "Source: " delete-label "Delete" edit-label "Edit"
                   transit-label "Lines: "}}]
   (let [{:keys [name description location source agent-url agent-name]} position
         {:keys [listing-site listing-url google-maps-url]} (or (google-maps/place-external-links position) {})
         edit-btn-html (popup-edit-btn-html position editable? edit-label)
         delete-btn-html (popup-delete-btn-html position delete-label)
         source-html (popup-source-html source source-label)
         viewing-html (popup-viewing-html position)
         address-row-html (popup-address-row-html position)
         transit-html (popup-transit-html position transit-label)
         listing-link-html (when (and listing-site listing-url)
                             (google-maps/build-external-icon-link-html
                              {:url listing-url
                               :icon-src (:icon-src listing-site)
                               :icon-class "place-external-link-icon"
                               :link-class (:link-class listing-site)
                               :aria-label (:aria listing-site)}))
         agent-link-html (when (non-blank? agent-url)
                           (google-maps/build-external-icon-link-html
                            {:url agent-url
                             :icon-src "/images/agent.png"
                             :icon-class "place-external-link-icon"
                             :link-class "place-external-link--agent"
                             :aria-label (or (not-empty agent-name) "Mäklare")}))
         google-maps-link-html (when google-maps-url
                                 (google-maps/build-maps-icon-link-html
                                  {:url google-maps-url}))
         title-links (remove nil? [listing-link-html agent-link-html google-maps-link-html
                                    edit-btn-html delete-btn-html])
         name-html (if (seq title-links)
                     (str "<div class=\"map-popup-name-row\">"
                          "<div class=\"map-popup-name\">" (escape-html (or name "Place")) "</div>"
                          (str/join "" title-links)
                          "</div>")
                     (str "<div class=\"map-popup-name\">" (escape-html (or name "Place")) "</div>"))
         parts (cond-> [name-html]
                  (non-blank? (:image position))
                  (conj (str "<div class=\"map-popup-image\">"
                             (popup-image-html position)
                             "</div>"))

                  address-row-html
                  (conj address-row-html)

                  (non-blank? description)
                  (conj (str "<div class=\"map-popup-description\">"
                             (html-sanitize/sanitize-description-html description)
                             "</div>"))

                  (non-blank? location)
                  (conj (str "<div class=\"map-popup-location\">"
                             (escape-html location)
                             "</div>"))

                  transit-html
                  (conj transit-html)

                  source-html
                  (conj source-html)

                  viewing-html
                  (conj viewing-html))]
     (str "<div class=\"map-popup\">" (str/join "" parts) "</div>"))))
