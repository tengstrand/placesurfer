(ns hitteri.pin-ui.handlers.editor
  "Pin editor open/close/confirm."
  (:require [hitteri.app-ui.interface.state :as app-state]
            [hitteri.map-ui.interface :as map-ui]
            [hitteri.pin-ui.handlers.map :as pin-map]
            [hitteri.pin-ui.handlers.rows :as rows]
            [hitteri.pin-ui.handlers.state :as pin-state]
            [hitteri.pin-ui.pure.forms :as forms]
            [hitteri.pin-ui.pure.rows :as pure-rows]
            [hitteri.pin-ui.pure.update-context :as update-context]))

(def ^:private inline-auto-save-ms 400)

(defonce !inline-auto-save-timeout (atom nil))

(defn- update-pins-mode? [s]
  (update-context/update-pins-mode? s))

(defn- inline-edit-active? [s]
  (and (update-pins-mode? s)
       (:pin-editor-inline? s)
       (= :edit (:pin-editor-mode s))))

(defn- editor-snapshot [s]
  {:form (:pin-form s (forms/default-form))
   :baseline (:pin-form-baseline s (forms/default-form))
   :search-query (:pin-search-query s "")
   :search-results (:pin-search-results s [])
   :search-highlight-index (:pin-search-highlight-index s)
   :search-loading? (:pin-search-loading? s false)
   :message (:pin-message s)})

(defn- restore-snapshot! [s snapshot]
  (-> s
      (assoc :pin-form (:form snapshot)
             :pin-form-baseline (:baseline snapshot)
             :pin-search-query (:search-query snapshot)
             :pin-search-results (:search-results snapshot)
             :pin-search-highlight-index (:search-highlight-index snapshot)
             :pin-search-loading? (:search-loading? snapshot)
             :pin-message (:message snapshot))
      pin-state/clear-search-ui
      (assoc :pin-search-query (:search-query snapshot)
             :pin-search-results (:search-results snapshot)
             :pin-search-highlight-index (:search-highlight-index snapshot)
             :pin-search-loading? (:search-loading? snapshot))))

(defn- close-editor! [s]
  (assoc s
         :pin-editor-open? false
         :pin-editor-inline? false
         :pin-editor-mode nil
         :pin-show-search? false
         :pin-editor-snapshot nil))

(defn- focus-pin-field! [element-id]
  (when (js* "typeof document !== 'undefined' && document.getElementById")
    (doseq [delay-ms [0 60 140 260]]
      (js/setTimeout
       #(when-let [el (.getElementById js/document element-id)]
          (.focus el))
       delay-ms))))

(defn focus-pin-toolbar-search! []
  (focus-pin-field! "pin-toolbar-search"))

(defn- focus-pin-search! []
  (focus-pin-field! "pin-search"))

(defn- focus-pin-name! []
  (focus-pin-field! "pin-name"))

(defn- close-separator-overlay [s]
  (assoc s
         :pin-separator-overlay-open? false
         :pin-separator-overlay-rows []
         :pin-separator-overlay-selected-id nil
         :pin-separator-overlay-snapshot nil))

(defn reset-inline-idle! []
  (pin-state/swap-render!
   #(-> %
       (assoc :pin-editor-mode nil
              :pin-show-search? false
              :pin-form (forms/default-form)
              :pin-form-baseline (forms/default-form)
              :pin-message nil)
       pin-state/clear-search-ui))
  (pin-map/schedule-pin-map-sync! {:recenter? false}))

(defn maybe-save-inline-pin! []
  (when (inline-edit-active? @app-state/!state)
    (when (rows/save-enabled? @app-state/!state)
      (rows/save-pin!))))

(defn schedule-inline-auto-save! []
  (when (inline-edit-active? @app-state/!state)
    (when-let [timeout @!inline-auto-save-timeout]
      (js/clearTimeout timeout))
    (reset! !inline-auto-save-timeout
            (js/setTimeout
             (fn []
               (reset! !inline-auto-save-timeout nil)
               (maybe-save-inline-pin!))
             inline-auto-save-ms))))

(defn maybe-save-inline-pin-before-switch! []
  (when-let [timeout @!inline-auto-save-timeout]
    (js/clearTimeout timeout)
    (reset! !inline-auto-save-timeout nil))
  (maybe-save-inline-pin!))

(defn- open-editor! [mode form & {:keys [show-search? focus-search? focus-name?]
                                  :or {show-search? false focus-search? false focus-name? true}}]
  (let [inline? (update-pins-mode? @app-state/!state)]
    (pin-state/swap-render!
     (fn [s]
       (-> s
           close-separator-overlay
           (assoc :pin-editor-snapshot (editor-snapshot s)
                  :pin-editor-mode mode
                  :pin-editor-open? (not inline?)
                  :pin-editor-inline? inline?
                  :pin-show-search? (boolean (and inline? show-search?))
                  :pin-form form
                  :pin-form-baseline form
                  :pin-message nil)
           app-state/reset-description-editor-state
           pin-state/clear-search-ui)))
    (pin-map/schedule-pin-map-sync! {:recenter? (not inline?)})
    (cond
      focus-search? (focus-pin-search!)
      (and (= mode :edit) focus-name?) (focus-pin-name!)
      :else nil)))

(defn start-pin-search! []
  (if (update-pins-mode? @app-state/!state)
    (do (open-editor! :new (forms/default-form) {:show-search? false :focus-name? false})
        (focus-pin-toolbar-search!))
    (open-editor! :new (forms/default-form) {:show-search? true :focus-search? true})))

(defn open-pin-editor-new! []
  (if (update-pins-mode? @app-state/!state)
    (start-pin-search!)
    (open-editor! :new (forms/default-form) {:focus-search? true})))

(defn open-pin-editor-edit! []
  (when-let [id (:pin-selected-id @app-state/!state)]
    (when-let [item (pure-rows/find-by-id (:pin-items @app-state/!state) id)]
      (when-not (pure-rows/separator-item? item)
        (open-editor! :edit (forms/item->form item))))))

(defn load-pin-into-inline-editor! [id]
  (when (update-pins-mode? @app-state/!state)
    (maybe-save-inline-pin-before-switch!)
    (when-let [item (pure-rows/find-by-id (:pin-items @app-state/!state) id)]
      (when-not (pure-rows/separator-item? item)
        (open-editor! :edit (forms/item->form item) {:focus-name? false})))))

(defn cancel-pin-editor! []
  (pin-state/swap-render!
   (fn [s]
     (-> s
         (restore-snapshot! (:pin-editor-snapshot s (editor-snapshot s)))
         close-editor!)))
  (pin-map/schedule-pin-map-sync! {:recenter? false})
  (when (= :pin (:page @app-state/!state))
    (map-ui/close-all-popups!)))

(defn confirm-pin-editor! []
  (let [mode (:pin-editor-mode @app-state/!state)]
    (case mode
      :new (rows/add-pin!)
      :edit (rows/save-pin!)
      nil)
    (when-not (update-pins-mode? @app-state/!state)
      (pin-state/swap-render! close-editor!))))

(defn edit-enabled? [state]
  (boolean
   (when-let [id (:pin-selected-id state)]
     (when-let [item (pure-rows/find-by-id (:pin-items state []) id)]
       (and (not (pure-rows/separator-item? item))
            (some #(= id (:id %)) (:pin-items state [])))))))

(defn ok-enabled? [state]
  (case (:pin-editor-mode state)
    :new (forms/form-valid? (:pin-form state (forms/default-form)))
    :edit (rows/save-enabled? state)
    false))

(defn pin-form-dirty? [state]
  (let [form (:pin-form state (forms/default-form))
        baseline (:pin-form-baseline state (forms/default-form))]
    (forms/form-edited-from-baseline? form baseline)))
