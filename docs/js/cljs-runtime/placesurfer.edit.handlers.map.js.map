(ns placesurfer.edit.handlers.map
  (:require [clojure.string :as str]
            [placesurfer.edit.interface.baseline :as edit-ui.baseline]
            [placesurfer.edit.interface.coords :as edit-ui.coords]
            [placesurfer.edit.interface.match :as edit-ui.match]
            [placesurfer.edit.interface.rows :as edit-ui.rows]
            [placesurfer.edit.pure.topics :as edit-topics]
            [placesurfer.map-ui.interface :as map-ui]
            [placesurfer.pin-ui.interface.handlers.interaction :as pin-interaction]
            [placesurfer.pin-ui.interface.handlers.map :as pin-map-handlers]
            [placesurfer.topic.interface :as data]
            [placesurfer.app-ui.interface.effects :as effects]
            [placesurfer.app-ui.interface.state :as state]
            [placesurfer.edit.handlers.rows :as update-rows]
            [placesurfer.i18n.interface :as i18n]))

(defn- popup-opts [s]
  {:source-label (i18n/t (:locale s :en) :popup/source-label)})

(def ^:private update-map-center-zoom 9)

(defn- map-page? [page]
  (contains? #{:home :topic :country} page))

(declare sync-marker-pick-handler!)

(defn- valid-topic? [topic]
  (contains? (set (data/topic-keys)) topic))

(defn coords-from-update-form [s]
  (let [form (:update-form s)
        lon (edit-ui.coords/parse-decimal (:longitude form))
        lat (edit-ui.coords/parse-decimal (:latitude form))]
    (when (and (number? lon) (number? lat))
      {:longitude lon :latitude lat})))

(defn coords-from-update-url-form [s]
  (when-let [form (:update-url-form s)]
    (let [lon (edit-ui.coords/parse-decimal (:longitude form))
          lat (edit-ui.coords/parse-decimal (:latitude form))]
      (when (and (number? lon) (number? lat))
        {:longitude lon :latitude lat}))))

(defn- coords-for-pending-pin [s]
  (when (:update-url-form s)
    (or (coords-from-update-url-form s)
        (coords-from-update-form s))))

(defn- next-pending-row-id! []
  (swap! state/!update-pending-id-seq dec))

(defn- pending-place->map-position [place update-topic]
  {:longitude (:longitude place)
   :latitude (:latitude place)
   :name (:name place)
   :locality (:locality place)
   :source (:source place)
   :topic update-topic
   :marker-topic :url-pin
   :pending-id (:pending-id place)})

(defn- deleted-row->map-position [row update-topic]
  (when-let [{:keys [longitude latitude]} (edit-ui.coords/row-lon-lat row)]
    (cond-> {:longitude longitude
             :latitude latitude
             :name (:name row)
             :locality (:locality row)
             :source (:source row)
             :topic update-topic
             :marker-topic :removed}
      (:row-id row) (assoc :row-id (:row-id row))
      (:pending-id row) (assoc :pending-id (:pending-id row)))))

(defn- client-deleted-at-coords? [s longitude latitude]
  (edit-ui.match/coords-match-deleted-row-at? (:update-rows s)
                                              (:update-pending-places s)
                                              longitude latitude
                                              edit-ui.rows/row-marked-deleted?))

(defn- disk-tombstone-at-coords? [s longitude latitude]
  (edit-ui.match/coords-match-deleted-row-at? (:update-rows s)
                                              (:update-pending-places s)
                                              longitude latitude
                                              edit-ui.rows/saved-delete-row?))

(defn- position-hidden-on-update-map? [s position]
  (let [{:keys [longitude latitude]} position]
    (and (number? longitude) (number? latitude)
         (or (disk-tombstone-at-coords? s longitude latitude)
             (client-deleted-at-coords? s longitude latitude)))))

(defn- client-deleted-map-positions [s]
  (let [topic (:update-topic s)]
    (when topic
      (reduce (fn [acc row]
                (if (and (edit-ui.rows/row-marked-deleted? row)
                         (some? (edit-ui.coords/row-lon-lat row)))
                  (let [pos (deleted-row->map-position row topic)
                        dup? (some (fn [existing]
                                     (edit-ui.match/coords-exact-match? (:longitude pos) (:latitude pos)
                                                                        (:longitude existing)
                                                                        (:latitude existing)))
                                   acc)]
                    (if dup? acc (conj acc pos)))
                  acc))
              []
              (concat (update-rows/as-update-rows (:update-rows s))
                      (update-rows/as-update-pending-places (:update-pending-places s)))))))

(defn- pending-map-positions [s]
  (let [topic (:update-topic s)]
    (when topic
      (mapv #(pending-place->map-position % topic)
            (filter (fn [place]
                      (and (some? (edit-ui.coords/row-lon-lat place))
                           (not (edit-ui.rows/row-marked-deleted? place))))
                    (update-rows/as-update-pending-places (:update-pending-places s)))))))

(defn- saved-row->map-position [row update-topic]
  (when-let [{:keys [longitude latitude]} (edit-ui.coords/row-lon-lat row)]
    (when (and (not (edit-ui.rows/row-marked-deleted? row))
               (not (edit-ui.rows/saved-delete-row? row)))
      (cond-> {:longitude longitude
               :latitude latitude
               :name (:name row)
               :locality (:locality row)
               :source (:source row)
               :topic update-topic}
        (:row-id row) (assoc :row-id (:row-id row))
        (:pending-id row) (assoc :pending-id (:pending-id row))))))

(defn- update-topic-positions [s]
  (when-let [topic (:update-topic s)]
    (when-not (edit-topics/pins-topic? topic)
      (let [rows (update-rows/as-update-rows (:update-rows s))]
        (if (seq rows)
          (vec (keep #(saved-row->map-position % topic) rows))
          (vec (filter #(= topic (:topic %)) (:positions s))))))))

(defn update-map-positions [s]
  (if (edit-topics/pins-topic? (:update-topic s))
    (pin-map-handlers/pins-only-map-positions s)
    (into (into (vec (remove #(position-hidden-on-update-map? s %)
                              (or (update-topic-positions s) [])))
                (or (pending-map-positions s) []))
          (or (client-deleted-map-positions s) []))))

(defn register-current-url-pending-place [s]
  (if-not (:update-url-form s)
    s
    (if-let [{:keys [longitude latitude]} (coords-for-pending-pin s)]
      (if (edit-ui.match/coords-exist-in-update-rows? longitude latitude (:update-rows s))
        (assoc s :update-pending-places [])
        (let [url-form (:update-url-form s)
              place {:name (:name url-form)
                     :locality (:locality url-form)
                     :homepage (:homepage url-form)
                     :description (or (:description url-form) "")
                     :longitude longitude
                     :latitude latitude
                     :source :manual
                     :url-form url-form}
              places (update-rows/as-update-pending-places (:update-pending-places s))
              idx (edit-ui.match/find-pending-place-index places longitude latitude)
              pending-id (if (some? idx)
                           (:pending-id (nth places idx))
                           (update-rows/next-pending-row-id!))]
          (assoc s :update-pending-places
                 [(-> place
                      (assoc :pending-id pending-id)
                      (assoc :action :added))])))
      s)))

(defn- prune-pending-places-matching-rows [s]
  (update s :update-pending-places
          (fn [places]
            (vec (remove (fn [place]
                           (edit-ui.match/coords-exist-in-update-rows? (:longitude place)
                                                                      (:latitude place)
                                                                      (:update-rows s)))
                         (update-rows/as-update-pending-places places))))))

(defn- clear-orphaned-pending-selection [s]
  (-> s
      (assoc :update-selected-row-id nil
             :update-selected-row nil
             :update-row-baseline nil
             :update-form (state/default-update-form)
             :update-form-field-errors {}
             :update-url-form nil)
      (update :update-form-reset-token (fnil inc 0))))

(defn- reconcile-orphaned-pending-selection [s]
  (let [selected-id (:update-selected-row-id s)]
    (if (and (some? selected-id) (neg? selected-id)
             (nil? (update-rows/find-update-display-row s selected-id)))
      (if-let [coords (coords-from-update-form s)]
        (if (edit-ui.match/coords-exist-in-update-rows? (:longitude coords)
                                                        (:latitude coords)
                                                        (:update-rows s))
          (update-rows/select-saved-row-for-exact-url-coords s (:longitude coords) (:latitude coords))
          (clear-orphaned-pending-selection s))
        (clear-orphaned-pending-selection s))
      s)))

(defn- refresh-update-pending-places* [reselect-row? {:keys [recenter?] :or {recenter? true}}]
  (swap! state/!state
         (fn [s]
           (let [selected-id (:update-selected-row-id s)
                 s (-> s
                       register-current-url-pending-place
                       prune-pending-places-matching-rows
                       reconcile-orphaned-pending-selection)]
             (if-let [{:keys [longitude latitude]} (coords-for-pending-pin s)]
               (if (and (not reselect-row?)
                        (and selected-id (edit-ui.rows/saved-update-row-id? selected-id)))
                 s
                 (update-rows/select-row-for-url-coords s longitude latitude))
               s))))
  (when (= :update (:page @state/!state))
    (effects/sync-update-map! {:recenter? recenter?})
    (effects/render!)))

(defn refresh-update-pending-places!
  ([] (refresh-update-pending-places! false nil))
  ([reselect-row?]
   (if (map? reselect-row?)
     (refresh-update-pending-places* false reselect-row?)
     (refresh-update-pending-places! reselect-row? nil)))
  ([reselect-row? opts]
   (let [{:keys [recenter?] :or {recenter? true}} (or opts {})]
     (refresh-update-pending-places* reselect-row? {:recenter? recenter?}))))

(defn- run-update-map-pin-sync! [{:keys [recenter?] :or {recenter? true}}]
  (when (= :update (:page @state/!state))
    (if (edit-topics/pins-topic? (:update-topic @state/!state))
      (effects/sync-update-map! {:recenter? recenter?})
      (do
        (refresh-update-pending-places* false {:recenter? recenter?})
        (doseq [delay-ms [0 80 200 500]]
          (js/setTimeout
           #(when (= :update (:page @state/!state))
              (when-not (edit-topics/pins-topic? (:update-topic @state/!state))
                (refresh-update-pending-places* false {:recenter? recenter?})))
           delay-ms))))))

(defn schedule-update-map-pin-sync!
  "Optional opts: {:recenter? true|false}. Called with no args from legacy call sites."
  [& [opts]]
  (let [{:keys [recenter?] :or {recenter? true}} (or opts {})]
    (run-update-map-pin-sync! {:recenter? recenter?})))

(defn- center-on-update-map! [coords]
  (map-ui/center-on-position!
   (assoc coords :zoom update-map-center-zoom :animate? true)))

(defn sync-update-map!
  ([] (sync-update-map! {}))
  ([{:keys [recenter?] :or {recenter? true}}]
   (let [s @state/!state
         positions (update-map-positions s)
         pins-topic? (edit-topics/pins-topic? (:update-topic s))
         pin-form-coords (when pins-topic?
                           (when-let [form (:pin-form s)]
                             (when-let [lon (edit-ui.coords/parse-decimal (:longitude form))]
                               (when-let [lat (edit-ui.coords/parse-decimal (:latitude form))]
                                 {:longitude lon :latitude lat}))))
         fit-pins? (and pins-topic? (not pin-form-coords) (seq positions))]
     (map-ui/apply-state! {:positions positions
                           :fit? fit-pins?
                           :animate? fit-pins?
                           :popup-opts (popup-opts s)})
     (when recenter?
       (cond
         (and pins-topic? pin-form-coords)
         (center-on-update-map! pin-form-coords)

         (and (not pins-topic?) (some? (coords-from-update-form s)))
         (center-on-update-map! (coords-from-update-form s)))))))

(defn schedule-center-on-position!
  ([position] (schedule-center-on-position! position {}))
  ([position {:keys [delay-ms preserve-zoom?] :or {delay-ms 80}}]
   (when (and (map? position)
              (number? (:longitude position))
              (number? (:latitude position)))
     (js/setTimeout
      #(if preserve-zoom?
         (map-ui/center-on-position!
          {:longitude (:longitude position)
           :latitude (:latitude position)
           :preserve-zoom? true
           :animate? true})
         (center-on-update-map!
          {:longitude (:longitude position)
           :latitude (:latitude position)}))
      delay-ms))))

(defn- retry-update-row-popup! [match & [{:keys [attempt delay-ms]
                                         :or {attempt 0 delay-ms 150}}]]
  (when (<= attempt 8)
    (if (map-ui/open-marker-popup! match)
      nil
      (js/setTimeout #(retry-update-row-popup! match {:attempt (inc attempt)
                                                      :delay-ms delay-ms})
                     delay-ms))))

(defn schedule-update-row-popup!
  "Open the popup for an update table row, retrying until the marker is mounted."
  [row]
  (when (and row (number? (:longitude row)) (number? (:latitude row)))
    (retry-update-row-popup!
     {:longitude (:longitude row)
      :latitude (:latitude row)})))

(defn normalize-map-position [raw]
  (let [p (if (map? raw) raw (js->clj raw :keywordize-keys true))
        topic-raw (:topic p)
        topic (cond
                (keyword? topic-raw) topic-raw
                (some? topic-raw) (keyword (str topic-raw))
                :else nil)
        source-raw (:source p)
        source (cond
                 (keyword? source-raw) source-raw
                 (some? source-raw) (keyword (str source-raw))
                 :else nil)
        lon (:longitude p)
        lat (:latitude p)]
    (cond-> p
      (valid-topic? topic) (assoc :topic topic)
      (not (valid-topic? topic)) (dissoc :topic)
      source (assoc :source source)
      (string? lon) (assoc :longitude (edit-ui.coords/parse-decimal lon))
      (string? lat) (assoc :latitude (edit-ui.coords/parse-decimal lat)))))

(defn position->update-form [position]
  (let [{:keys [name locality homepage longitude latitude source]} position]
    {:google-url ""
     :name (or name "")
     :locality (or locality "")
     :homepage (or homepage "")
     :longitude (if (number? longitude) (str longitude) (or longitude ""))
     :latitude (if (number? latitude) (str latitude) (or latitude ""))
     :source (edit-ui.baseline/normalize-update-source source)}))

(defn apply-update-from-map-position!
  ([position]
   (apply-update-from-map-position! position
                                    {:url-draft? true
                                     :select-existing-row? true}))
  ([position {:keys [url-draft? select-existing-row?]
              :or {url-draft? true select-existing-row? true}}]
   (state/clear-update-status!)
   (let [topic (:topic position)
         form (position->update-form position)
         url-form (dissoc form :google-url)
         lon (if (number? (:longitude position))
               (:longitude position)
               (edit-ui.coords/parse-decimal (:longitude position)))
         lat (if (number? (:latitude position))
               (:latitude position)
               (edit-ui.coords/parse-decimal (:latitude position)))]
     (swap! state/!state
            (fn [s]
              (let [country (state/normalize-country-code
                             (or (:country-code position)
                                 (when (and (= :update (:page s))
                                            (some? (:update-country-code s)))
                                   (:update-country-code s))
                                 (:country-iso s)
                                 "SE"))
                    s (cond-> (-> s
                                  (assoc :update-topic topic)
                                  (assoc :update-country-code country)
                                  (assoc :update-form form)
                                  (update :update-form-reset-token inc))
                        url-draft? (assoc :update-url-form url-form)
                        (not url-draft?) (assoc :update-url-form nil))]
                (if (and select-existing-row?
                         (number? lon) (number? lat))
                  (if-let [row (update-rows/find-display-row-in-state s lon lat)]
                    (update-rows/select-update-display-row s (:row-id row) row)
                    s)
                  s))))
     (when (and (number? lon) (number? lat)
                (str/blank? (str (:locality position))))
       (effects/resolve-update-location-from-coordinates! lon lat))
     position)))

(defn pick-update-position-from-map! [raw-position]
  (when (:backend-online? @state/!state)
    (let [normalized (normalize-map-position raw-position)
          position (assoc normalized :topic (or (:topic normalized)
                                                (:update-topic @state/!state)))
          lon (if (number? (:longitude position))
                (:longitude position)
                (edit-ui.coords/parse-decimal (:longitude position)))
          lat (if (number? (:latitude position))
                (:latitude position)
                (edit-ui.coords/parse-decimal (:latitude position)))]
      (when (:topic position)
        (map-ui/close-all-popups!)
        (if-let [row (when (and (number? lon) (number? lat))
                       (update-rows/find-display-row-in-state @state/!state lon lat false))]
          (update-rows/toggle-update-row! (:row-id row))
          (do
            (apply-update-from-map-position! position
                                             {:url-draft? false
                                              :select-existing-row? false})
            (effects/render!)
            (schedule-center-on-position!
             position {:delay-ms 0 :preserve-zoom? true})))))))

(defn open-update-from-map-position! [raw-position]
  (when (and (:backend-online? @state/!state)
             (map-page? (:page @state/!state))
             (not (pin-interaction/pin-map-position? raw-position)))
    (let [position (normalize-map-position raw-position)]
      (when (:topic position)
        (map-ui/close-all-popups!)
        (let [was-update? (= :update (:page @state/!state))]
          (apply-update-from-map-position! position
                                           {:url-draft? false
                                            :select-existing-row? false})
          (swap! state/!state assoc :page :update)
          (sync-marker-pick-handler!)
          (effects/render!)
          (when-not was-update? (effects/track-page! :update))
          (effects/reload-update-dataset!)
          (if was-update?
            (schedule-center-on-position! position {:delay-ms 0})
            (schedule-center-on-position! position {:delay-ms 120})))))))

(defn pick-map-position-from-map! [raw-position]
  (if (pin-interaction/pin-map-position? raw-position)
    (pin-interaction/pick-pin-from-map! raw-position)
    (let [page (:page @state/!state)]
      (cond
        (and (:backend-online? @state/!state)
             (= :update page))
        (pick-update-position-from-map! raw-position)

        (and (:backend-online? @state/!state)
             (map-page? page)
             (not= :home page))
        (open-update-from-map-position! raw-position)

        :else nil))))

(defn sync-marker-pick-handler! []
  (map-ui/set-marker-pick-handler! pick-map-position-from-map!))
