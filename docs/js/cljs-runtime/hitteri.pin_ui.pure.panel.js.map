(ns hitteri.pin-ui.pure.panel
  (:require [hitteri.pin-ui.handlers.editor :as editor]
            [hitteri.pin-ui.pure.forms :as forms]
            [hitteri.pin-ui.pure.list-panel :as list-panel]
            [hitteri.pin-ui.pure.rows :as pure-rows]
            [hitteri.pin-ui.pure.update-context :as update-context]
            [hitteri.map-panel-ui.interface.container :as map-panel-ui.container]))

(def browse-table-columns
  (fn [_t]
    [{:key :icon :label ""}
     {:key :name :label ""}]))

(def table-columns
  (fn [t]
    (into (browse-table-columns t)
          [{:key :address :label ""}])))

(defn- pin-browse-table-rows [state]
  (pure-rows/table-rows
   (pure-rows/pin-page-list-items (:pin-items state))
   (:pin-selected-id state)))

(defn view-props
  [state handlers map-handler-props t]
  (let [selected-id (:pin-selected-id state)
        pin-items (:pin-items state [])
        inline? (:pin-editor-inline? state false)
        update-pins? (update-context/update-pins-mode? state)]
    (merge
     {:pin-items pin-items
      :pin-form (:pin-form state (forms/default-form))
      :pin-table-rows (if (= :pin (:page state))
                        (pin-browse-table-rows state)
                        (:pin-table-rows state []))
      :pin-table-columns (if (= :pin (:page state))
                           (browse-table-columns t)
                           (table-columns t))
      :t t
      :pin-selected-id selected-id
      :pin-search-query (:pin-search-query state "")
      :pin-search-results (:pin-search-results state [])
      :pin-search-loading? (:pin-search-loading? state false)
      :pin-search-highlight-index (:pin-search-highlight-index state)
      :pin-message (:pin-message state)
      :pin-editor-open? (:pin-editor-open? state false)
      :pin-editor-inline? inline?
      :pin-show-search? (:pin-show-search? state false)
      :pin-editor-mode (:pin-editor-mode state)
      :pin-table-keyboard-focus? (:pin-table-keyboard-focus? state false)
      :pin-show-preview? (:pin-show-preview? state false)
      :pin-show-topics-on-map? (:pin-show-topics-on-map? state true)
      :pin-separator-overlay-rows (:pin-separator-overlay-rows state [])
      :pin-separator-overlay-selected-id (:pin-separator-overlay-selected-id state)
      :show-pin-group-field? (and inline? update-pins? selected-id)
      :pin-group-id (when selected-id (pure-rows/group-id-for-item pin-items selected-id))
      :pin-group-options (pure-rows/group-options pin-items)
      :pin-export-copied? (:pin-export-copied? state false)
      :description-edit-mode (:description-edit-mode state :text)
      :description-sync-token (:description-sync-token state 0)
      :pin-edit-enabled? (editor/edit-enabled? state)
      :pin-editor-ok-enabled? (editor/ok-enabled? state)
      :pin-delete-enabled? (boolean
                           (when selected-id
                             (some #(= selected-id (:id %)) pin-items)))
      :mount-pin-map! (:mount-pin-map! map-handler-props)
      :unmount-map! (:unmount-map! map-handler-props)}
     handlers)))

(defn panel
  [{:keys [page pin-items pin-selected-id unmount-map! pin-table-rows]
    :as props}]
  (let [mount-pin-map-fn (:mount-pin-map! props)
        rows (if (= :pin page)
               (pin-browse-table-rows {:pin-items pin-items
                                       :pin-selected-id pin-selected-id})
               pin-table-rows)
        props* (assoc props :pin-table-rows rows)]
    [:section.update-section
     [:div.pin-layout
      [:aside.pin-list-panel
       (list-panel/list-panel
        (assoc props*
               :show-toolbar? false
               :show-toolbar-search? true
               :toolbar-search-end? false
               :show-topics-toggle? true
               :show-preview-toggle? true
               :show-editor-overlay? false
               :show-drag-handle? false
               :drag-from-whole-row? true))]
      [:div.pin-map-panel
       (map-panel-ui.container/container {:element-id "pin-map"
                                          :mount-map! mount-pin-map-fn
                                          :unmount-map! unmount-map!})]]]))
