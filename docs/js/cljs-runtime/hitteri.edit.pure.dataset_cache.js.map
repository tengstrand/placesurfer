(ns hitteri.edit.pure.dataset-cache
  (:require [clojure.string :as str]))

(defn cache-key
  "Stable cache key for a loaded update dataset."
  [topic country-code]
  [(keyword topic) (some-> country-code str str/upper-case)])

(defn entry-from-state
  "Snapshot update dataset fields worth restoring later."
  [s]
  {:rows (:update-rows s)
   :columns (:update-columns s)
   :disk-baseline (:update-disk-baseline s)
   :disk-save-snapshot (:update-disk-save-snapshot s)})

(defn cached-entry
  [cache topic country-code]
  (get cache (cache-key topic country-code)))

(defn has-cached-entry?
  [cache topic country-code]
  (some? (cached-entry cache topic country-code)))
