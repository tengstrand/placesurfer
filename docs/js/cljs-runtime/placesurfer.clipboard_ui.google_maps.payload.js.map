(ns placesurfer.clipboard-ui.google-maps.payload
  (:require [placesurfer.clipboard-ui.google-maps.place :as place]))

(def payload-type "placesurfer/place")
(def source "google-maps")

(defn google-maps-bookmarklet-payload?
  "True when `data` is a Google Maps place bookmarklet clipboard payload map."
  [data]
  (and (map? data)
       (= payload-type (:type data))
       (map? (:place data))))

(defn place-bookmarklet-payload?
  "Alias for google-maps-bookmarklet-payload?."
  [data]
  (google-maps-bookmarklet-payload? data))

(defn payload->place
  "Extract normalized place map from a Google Maps bookmarklet payload."
  [payload]
  (when (google-maps-bookmarklet-payload? payload)
    (place/normalize-place-payload (:place payload))))
