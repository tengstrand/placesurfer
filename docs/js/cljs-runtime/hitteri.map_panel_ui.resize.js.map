(ns hitteri.map-panel-ui.resize
  (:require [hitteri.map-panel-ui.layout :as layout]))

(defonce !resize-timeout (atom nil))

(defn schedule-resize!
  [resize-map!]
  (layout/sync-layout!)
  (when-let [tid @!resize-timeout]
    (js/clearTimeout tid))
  (reset! !resize-timeout
          (js/setTimeout
           (fn []
             (reset! !resize-timeout nil)
             (resize-map!))
           200)))
