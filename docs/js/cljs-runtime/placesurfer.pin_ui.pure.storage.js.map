(ns placesurfer.pin-ui.pure.storage
  (:require [placesurfer.pin-ui.pure.forms :as forms]))

(def storage-key "placesurfer_pins")

(defn- separator-kind? [item]
  (let [kind (:kind item)]
    (or (= kind :separator)
        (= kind "separator"))))

(defn- normalize-separator [item]
  (when (map? item)
    (let [id (or (:id item) (str (random-uuid)))]
      {:id (str id)
       :kind :separator
       :label (str (or (:label item) ""))})))

(defn- normalize-pin [item]
  (when (map? item)
    (let [id (or (:id item) (str (random-uuid)))]
      (cond-> {:id (str id)
               :name (str (or (:name item) ""))
               :address (str (or (:address item) ""))
               :icon (forms/normalize-icon (or (:icon item) forms/default-icon))
               :longitude (:longitude item)
               :latitude (:latitude item)
               :url (str (or (:url item) ""))
               :image (str (or (:image item) ""))
               :description (str (or (:description item) ""))
               :agent-url (str (or (:agent-url item) ""))}
        (string? (:longitude item)) (update :longitude #(js/parseFloat %))
        (string? (:latitude item)) (update :latitude #(js/parseFloat %))))))

(defn- normalize-item [item]
  (when (map? item)
    (if (separator-kind? item)
      (normalize-separator item)
      (normalize-pin item))))

(defn- parse-items [raw]
  (try
    (let [parsed (js/JSON.parse raw)]
      (->> (js->clj parsed :keywordize-keys true)
           (keep normalize-item)
           vec))
    (catch :default _ [])))

(defn read-pins!
  "Load pins from localStorage; returns empty vector on missing/invalid data."
  []
  (try
    (if-let [raw (.getItem js/localStorage storage-key)]
      (parse-items raw)
      [])
    (catch :default _ [])))

(defn save-pins!
  "Persist pins vector to localStorage."
  [items]
  (try
    (.setItem js/localStorage storage-key
              (.stringify js/JSON (clj->js (mapv normalize-item items))))
    (catch :default _ nil)))

(defn new-pin-id []
  (str (random-uuid)))
