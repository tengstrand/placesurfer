(ns placesurfer.app-ui.ui.draw-layers-panel
  (:require [clojure.string :as str]))

;; --- helpers ---

(defn- enter-key? [e] (= "Enter" (.-key e)))

(defn- submit! [label add!]
  (when (and add! (seq (str/trim (or label "")))) (add!)))

(defn- clamp [n lo hi] (max lo (min hi (or n 0))))

(defn- to-hex [n]
  (let [s (.toString (js/Math.round (clamp n 0 255)) 16)]
    (if (= 1 (count s)) (str "0" s) s)))

(defn- rgb->hex [{:keys [r g b]}]
  (str "#" (to-hex r) (to-hex g) (to-hex b)))

;; --- HSV ↔ RGB ---

(defn- rgb->hsv [{:keys [r g b]}]
  (let [r' (/ r 255.0) g' (/ g 255.0) b' (/ b 255.0)
        cmax  (max r' g' b')
        cmin  (min r' g' b')
        delta (- cmax cmin)
        h (if (zero? delta)
            0
            (mod (+ 360 (cond
                          (= cmax r') (* 60 (/ (- g' b') delta))
                          (= cmax g') (* 60 (+ 2 (/ (- b' r') delta)))
                          :else        (* 60 (+ 4 (/ (- r' g') delta)))))
                 360))
        s (if (zero? cmax) 0 (/ delta cmax))]
    {:h h :s s}))

(defn- hsv->rgb [h s]
  (let [c s
        x (* c (- 1 (js/Math.abs (- (mod (/ h 60) 2) 1))))
        m (- 1 c)
        [r' g' b'] (cond
                     (< h 60)  [c x 0]
                     (< h 120) [x c 0]
                     (< h 180) [0 c x]
                     (< h 240) [0 x c]
                     (< h 300) [x 0 c]
                     :else      [c 0 x])]
    {:r (js/Math.round (* (+ r' m) 255))
     :g (js/Math.round (* (+ g' m) 255))
     :b (js/Math.round (* (+ b' m) 255))}))

;; --- color preview CSS ---

(defn- color->preview-css [{:keys [r g b lightness opacity]}]
  (let [l  (/ (or lightness 0) 100)
        rf (js/Math.round (+ r (* (- 255 r) l)))
        gf (js/Math.round (+ g (* (- 255 g) l)))
        bf (js/Math.round (+ b (* (- 255 b) l)))
        a  (/ (or opacity 35) 100)]
    (str "rgba(" rf "," gf "," bf "," a ")")))

;; --- canvas color wheel ---

(defn- draw-wheel! [^js canvas]
  (let [ctx  (.getContext canvas "2d")
        size (.-width canvas)
        cx   (/ size 2.0)
        cy   (/ size 2.0)
        r    (dec cx)]
    (doseq [deg (range 360)]
      (let [start (* (- deg 1) (/ js/Math.PI 180))
            end   (* (+ deg 1) (/ js/Math.PI 180))
            grad  (.createRadialGradient ctx cx cy 0 cx cy r)]
        (.addColorStop grad 0 "#ffffff")
        (.addColorStop grad 1 (str "hsl(" deg ",100%,50%)"))
        (.beginPath ctx)
        (.moveTo ctx cx cy)
        (.arc ctx cx cy r start end)
        (.closePath ctx)
        (set! (.-fillStyle ctx) grad)
        (.fill ctx)))))

(defn- canvas-pos->color [^js canvas client-x client-y]
  (let [rect (.getBoundingClientRect canvas)
        x    (- client-x (.-left rect))
        y    (- client-y (.-top rect))
        size (.-width canvas)
        cx   (/ size 2.0)
        cy   (/ size 2.0)
        r    (dec cx)
        dx   (- x cx)
        dy   (- y cy)
        dist (js/Math.sqrt (+ (* dx dx) (* dy dy)))]
    (when (<= dist r)
      (let [h (mod (+ 360 (* 180 (/ (js/Math.atan2 dy dx) js/Math.PI))) 360)
            s (min 1.0 (/ dist r))]
        (hsv->rgb h s)))))

(defn- current-color [^js canvas]
  (js->clj (.-placesurferWheelColor canvas) :keywordize-keys true))

(defn- setup-drag! [^js canvas set-color! save!]
  (let [!down   (atom false)
        on-move (fn [e]
                  (when @!down
                    (when-let [rgb (canvas-pos->color canvas (.-clientX e) (.-clientY e))]
                      (set-color! (merge (current-color canvas) rgb)))))
        on-up   (fn [_]
                  (when @!down
                    (reset! !down false)
                    (when save! (save!))))]
    (.addEventListener canvas "mousedown"
      (fn [e]
        (reset! !down true)
        (when-let [rgb (canvas-pos->color canvas (.-clientX e) (.-clientY e))]
          (set-color! (merge (current-color canvas) rgb)))))
    (.addEventListener canvas "mousemove" on-move)
    (.addEventListener js/window "mouseup" on-up)
    (fn [] (.removeEventListener js/window "mouseup" on-up))))

(defn- indicator-style [color wheel-size]
  (let [{:keys [h s]} (rgb->hsv color)
        cx    (/ wheel-size 2.0)
        cy    (/ wheel-size 2.0)
        dist  (* s (- cx 8))
        angle (* h (/ js/Math.PI 180))
        x     (+ cx (* dist (js/Math.cos angle)))
        y     (+ cy (* dist (js/Math.sin angle)))]
    {:position       "absolute"
     :left           (str (js/Math.round (- x 6)) "px")
     :top            (str (js/Math.round (- y 6)) "px")
     :width          "12px"
     :height         "12px"
     :border-radius  "50%"
     :border         "2px solid white"
     :box-shadow     "0 0 0 1.5px rgba(0,0,0,0.4)"
     :pointer-events "none"
     :background     (rgb->hex color)}))

;; --- slider ---

(defn- color-slider [{:keys [label key min-val max-val color set-draw-layer-color! save-draw-layers-config!]}]
  (let [val (get color key 0)]
    [:div.draw-color-row
     [:span.draw-color-label label]
     [:input.draw-color-slider
      {:type "range" :min min-val :max max-val :value val
       :on {:input  (fn [e]
                      (when set-draw-layer-color!
                        (set-draw-layer-color!
                         (assoc color key (js/parseInt (.. e -target -value) 10)))))
            :change (fn [_] (when save-draw-layers-config! (save-draw-layers-config!)))}}]
     [:span.draw-color-value val]]))

;; --- panel ---

(defn panel
  [{:keys [draw-layers draw-selected-layer-id draw-layer-draft-label
           navigate-to-update-tab!
           select-draw-layer! add-draw-layer!
           delete-draw-layer! set-draw-layer-draft-label!
           set-draw-layer-color! save-draw-layers-config!
           backend-online? update-topic-options t]
    :or {t (fn [k] (name k))}}]
  (let [topic-opt      (first (filter #(not= "pins" (:value %)) (or update-topic-options [])))
        selected-layer (first (filter #(= (:id %) draw-selected-layer-id) draw-layers))
        color          (or (:color selected-layer) {:r 255 :g 69 :b 0 :lightness 0 :opacity 35})
        slider-props   {:color                    color
                        :set-draw-layer-color!    set-draw-layer-color!
                        :save-draw-layers-config! save-draw-layers-config!}
        wheel-size     160]
    [:aside.draw-layers-panel
     [:div.update-panel-tab-bar
      [:button.update-panel-tab.update-panel-tab--active
       {:type "button" :title "Lager"}
       [:img.update-panel-tab-icon.update-panel-tab-icon--small
        {:src "/images/layers.png" :alt "Lager"}]]
      [:button.update-panel-tab
       {:type "button" :title (t :topic/pins)
        :on {:click (fn [_] (when navigate-to-update-tab! (navigate-to-update-tab! :pins)))}}
       [:img.update-panel-tab-icon {:src "/images/pin.png" :alt ""}]]
      [:button.update-panel-tab
       {:type "button" :title (t :nav/groups-alt)
        :on {:click (fn [_] (when navigate-to-update-tab! (navigate-to-update-tab! :groups)))}}
       [:img.update-panel-tab-icon.update-panel-tab-icon--small
        {:src "/images/groups.png" :alt ""}]]
      (when (and backend-online? topic-opt)
        [:button.update-panel-tab
         {:type "button" :title (:label topic-opt "")
          :on {:click (fn [_] (when navigate-to-update-tab! (navigate-to-update-tab! :topic)))}}
         [:img.update-panel-tab-icon.update-panel-tab-icon--small
          {:src (:marker-url topic-opt) :alt (:label topic-opt "")}]])]
     [:div.update-table-wrap
      [:div.draw-layer-list
       (if (seq draw-layers)
         (for [{:keys [id label]} draw-layers]
           ^{:key id}
           [:div.draw-layer-row.update-row
            {:class (when (= id draw-selected-layer-id) "update-row--selected")
             :on {:click (fn [_] (when select-draw-layer! (select-draw-layer! id)))}}
            [:span.draw-layer-label label]
            (when (= id draw-selected-layer-id)
              [:button.draw-layer-delete-btn
               {:type "button" :title "Ta bort"
                :on {:click (fn [e]
                              (.stopPropagation e)
                              (when delete-draw-layer! (delete-draw-layer! id)))}}
               [:img {:src "/images/trash.png" :alt "Ta bort"}]])])
         [:p.draw-layer-empty "Inga lager"])]
      [:div.draw-layer-draft-row
       [:input.group-draft-input
        {:type "text" :placeholder ""
         :value (or draw-layer-draft-label "")
         :on {:input   (fn [e]
                         (when set-draw-layer-draft-label!
                           (set-draw-layer-draft-label! (.. e -target -value))))
              :keydown (fn [e]
                         (when (enter-key? e)
                           (.preventDefault e)
                           (submit! draw-layer-draft-label add-draw-layer!)))}}]
       [:button.group-draft-submit-btn
        {:type "button"
         :disabled (not (seq (str/trim (or draw-layer-draft-label ""))))
         :on {:click (fn [_] (submit! draw-layer-draft-label add-draw-layer!))}}
        (t :pin/new)]]
      (when selected-layer
        [:div.draw-color-picker
         [:div.draw-wheel-outer
          {:style {:position "relative"
                   :width    (str wheel-size "px")
                   :height   (str wheel-size "px")}}
          [:canvas.draw-color-wheel-canvas
           {:width  wheel-size
            :height wheel-size
            :replicant/on-mount
            (fn [{:keys [replicant/node]}]
              (let [^js node node]
                (draw-wheel! node)
                (set! (.-placesurferWheelColor node) (clj->js color))
                (let [cleanup (setup-drag! node set-draw-layer-color! save-draw-layers-config!)]
                  (set! (.-placesurferWheelCleanup node) cleanup))))
            :replicant/on-render
            (fn [{:keys [replicant/node]}]
              (let [^js node node]
                (set! (.-placesurferWheelColor node) (clj->js color))))
            :replicant/on-unmount
            (fn [{:keys [replicant/node]}]
              (let [^js node node]
                (when-let [cleanup (.-placesurferWheelCleanup node)]
                  (cleanup))))}]
          [:div.draw-wheel-indicator
           {:style (indicator-style color wheel-size)}]]
         [:div.draw-color-preview-circle
          {:style {:background (color->preview-css color)}}]
         [:div.draw-color-sliders
          (color-slider (merge slider-props {:label "Ljushet" :key :lightness :min-val 0 :max-val 100}))
          (color-slider (merge slider-props {:label "Genomskinlighet" :key :opacity :min-val 0 :max-val 100}))]])]]))
