(ns placesurfer.app-ui.ui.draw-layers-panel
  (:require [clojure.string :as str]))

(defn- enter-key? [e]
  (= "Enter" (.-key e)))

(defn- submit! [draw-layer-draft-label add-draw-layer!]
  (when (and add-draw-layer!
             (seq (str/trim (or draw-layer-draft-label ""))))
    (add-draw-layer!)))

(defn panel
  [{:keys [draw-layers draw-selected-layer-id draw-layer-draft-label
           navigate-to-update-tab!
           select-draw-layer! add-draw-layer!
           delete-draw-layer! set-draw-layer-draft-label!
           backend-online? update-topic-options
           t]
    :or {t (fn [k] (name k))}}]
  (let [topic-opt (first (filter #(not= "pins" (:value %))
                                 (or update-topic-options [])))]
    [:aside.draw-layers-panel
     [:div.update-panel-tab-bar
      [:button.update-panel-tab.update-panel-tab--active
       {:type "button" :title "Lager"}
       [:img.update-panel-tab-icon.update-panel-tab-icon--small
        {:src "/images/layers.png" :alt "Lager"}]]
      [:button.update-panel-tab
       {:type "button" :title (t :topic/pins)
        :on {:click (fn [_] (when navigate-to-update-tab!
                              (navigate-to-update-tab! :pins)))}}
       [:img.update-panel-tab-icon {:src "/images/pin.png" :alt ""}]]
      [:button.update-panel-tab
       {:type "button" :title (t :nav/groups-alt)
        :on {:click (fn [_] (when navigate-to-update-tab!
                              (navigate-to-update-tab! :groups)))}}
       [:img.update-panel-tab-icon.update-panel-tab-icon--small
        {:src "/images/groups.png" :alt ""}]]
      (when (and backend-online? topic-opt)
        [:button.update-panel-tab
         {:type "button" :title (:label topic-opt "")
          :on {:click (fn [_] (when navigate-to-update-tab!
                                (navigate-to-update-tab! :topic)))}}
         [:img.update-panel-tab-icon.update-panel-tab-icon--small
          {:src (:marker-url topic-opt) :alt (:label topic-opt "")}]])]
     [:div.update-table-wrap
      [:div.draw-layer-list
       (if (seq draw-layers)
         (for [{:keys [id label]} draw-layers]
           ^{:key id}
           [:div.draw-layer-row.update-row
            {:class (when (= id draw-selected-layer-id) "update-row--selected")
             :on {:click (fn [_] (when select-draw-layer! (select-draw-layer! id)))}}
            [:span.draw-layer-label label]
            (when (= id draw-selected-layer-id)
              [:button.draw-layer-delete-btn
               {:type "button"
                :title "Ta bort"
                :on {:click (fn [e]
                              (.stopPropagation e)
                              (when delete-draw-layer! (delete-draw-layer! id)))}}
               [:img {:src "/images/trash.png" :alt "Ta bort"}]])])
         [:p.draw-layer-empty "Inga lager"])]
      [:div.draw-layer-draft-row
       [:input.group-draft-input
        {:type "text"
         :placeholder "Namn på nytt lager"
         :value (or draw-layer-draft-label "")
         :on {:input   (fn [e]
                         (when set-draw-layer-draft-label!
                           (set-draw-layer-draft-label! (.. e -target -value))))
              :keydown (fn [e]
                         (when (enter-key? e)
                           (.preventDefault e)
                           (submit! draw-layer-draft-label add-draw-layer!)))}}]
       [:button.group-draft-submit-btn
        {:type "button"
         :disabled (not (seq (str/trim (or draw-layer-draft-label ""))))
         :on {:click (fn [_] (submit! draw-layer-draft-label add-draw-layer!))}}
        (t :pin/new)]]]]))
