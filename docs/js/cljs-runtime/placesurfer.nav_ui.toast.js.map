(ns placesurfer.nav-ui.toast)

(defonce ^:private !toast-el (atom nil))
(defonce ^:private !hide-timer (atom nil))

(defn- toast-element! []
  (or @!toast-el
      (let [^js el (.createElement js/document "div")]
        (.setAttribute el "class" "nav-toast")
        (.setAttribute el "role" "status")
        (.setAttribute el "aria-live" "polite")
        (set! (.-display (.-style el)) "none")
        (.appendChild js/document.body el)
        (reset! !toast-el el)
        el)))

(defn- edit-tab-anchor []
  (or (.querySelector js/document "sl-tab.nav-update-tab")
      (.querySelector js/document ".nav-update-icon")
      (.querySelector js/document ".nav-update-tab")))

(defn- position-under-edit-tab! [^js toast-node]
  (when toast-node
    (if-let [^js anchor (edit-tab-anchor)]
      (let [rect (.getBoundingClientRect anchor)
            style (.-style toast-node)]
        (set! (.-position style) "fixed")
        (set! (.-top style) (str (+ (.-bottom rect) 4) "px"))
        (set! (.-left style) (str (+ (.-left rect) (/ (.-width rect) 2)) "px"))
        (set! (.-transform style) "translateX(-50%)")
        (set! (.-display style) "block"))
      (set! (.-display (.-style toast-node)) "none"))))

(defn show!
  "Shows a one-off status message under the edit-tab icon. `:kind :success`
   (e.g. confirming an import) renders green instead of the default red/
   error look used for warnings like 'pick exactly one topic' or a failed
   Dropbox sync."
  ([message] (show! message {}))
  ([message {:keys [duration-ms kind] :or {duration-ms 3200 kind :error}}]
   (let [^js el (toast-element!)]
     (set! (.-textContent el) (str message))
     (set! (.-className el) (str "nav-toast" (when (= kind :success) " nav-toast--success")))
     (when-let [timer @!hide-timer]
       (js/clearTimeout timer))
     (position-under-edit-tab! el)
     (js/requestAnimationFrame #(position-under-edit-tab! el))
     (reset! !hide-timer
             (js/setTimeout
              #(set! (.-display (.-style el)) "none")
              duration-ms)))))

(defn hide! []
  (when-let [^js el @!toast-el]
    (when-let [timer @!hide-timer]
      (js/clearTimeout timer))
    (set! (.-display (.-style el)) "none")))

;; Declarative helper kept for tests / optional embedding.
(defn toast
  [message]
  (when-let [text (some-> message str not-empty)]
    [:div.nav-toast {:role "status" :aria-live "polite"} text]))
