(ns hitteri.topic.interface
  (:require [hitteri.topic.core :as core]))

(defn topics []
  (core/topics))

(defn topic-keys []
  (core/topic-keys))

(defn topic-label [topic]
  (core/topic-label topic))

(defn topic-marker-url [topic]
  (core/topic-marker-url topic))

(defn default-active-topics []
  (core/default-active-topics))

(defn load-countries! [active-topics]
  (core/load-countries! active-topics))

(defn enrich-countries-with-counts! [active-topics countries]
  (core/enrich-countries-with-counts! active-topics countries))

(defn browse-map-positions [positions]
  (core/browse-map-positions positions))

(defn load-topic-country! [topic slug]
  (core/load-topic-country! topic slug))

(defn load-country-topics! [slug active-topics]
  (core/load-country-topics! slug active-topics))

(defn load-country-topics-with-progress! [slug active-topics progress-handlers]
  (core/load-country-topics-with-progress! slug active-topics progress-handlers))
