(ns hitteri.pin-ui.handlers.search
  "Photon place search for the pin editor."
  (:require [clojure.string :as str]
            [hitteri.app-ui.interface.effects :as effects]
            [hitteri.app-ui.interface.state :as app-state]
            [hitteri.pin-ui.handlers.editor :as editor]
            [hitteri.pin-ui.handlers.map :as pin-map]
            [hitteri.pin-ui.handlers.rows :as pin-rows]
            [hitteri.pin-ui.handlers.state :as pin-state]
            [hitteri.pin-ui.pure.forms :as forms]
            [hitteri.pin-ui.pure.photon :as photon]
            [hitteri.pin-ui.pure.search :as search]
            [hitteri.pin-ui.pure.update-context :as update-context]))

(def ^:private search-debounce-ms 400)
(def ^:private outside-country-message "Location is outside current country")

(defonce !search-request-id (atom 0))
(defonce !search-timeout (atom nil))

(defn- update-pins-mode? [s]
  (update-context/update-pins-mode? s))

(defn- finish-search!
  [request-id results & [on-success]]
  (when (= request-id @!search-request-id)
    (pin-state/swap-render!
     #(assoc %
             :pin-search-results results
             :pin-search-loading? false
             :pin-search-highlight-index
             (search/highlight-index-for-results results)))
    (when on-success (on-success results))))

(defn- run-photon-search!
  ([query] (run-photon-search! query nil))
  ([query on-success]
   (let [request-id (swap! !search-request-id inc)
         trimmed (str/trim query)]
     (if (< (count trimmed) photon/min-search-chars)
       (finish-search! request-id [] on-success)
       (do
         (pin-state/swap-state!
          #(assoc % :pin-search-loading? true))
         (pin-state/render!)
         (let [{:keys [countries country-slug country-iso]} @app-state/!state
               url (photon/build-search-url trimmed 8
                                            {:countries countries
                                             :country-slug country-slug})]
           (-> (js/fetch url)
               (.then (fn [resp]
                        (when (= request-id @!search-request-id)
                          (if (.-ok resp)
                            (-> (.json resp)
                                (.then (fn [body]
                                         (when (= request-id @!search-request-id)
                                           (finish-search!
                                            request-id
                                            (photon/filter-results-for-country
                                             (photon/parse-response body)
                                             country-iso countries country-slug)
                                            on-success))))
                                (.catch (fn [_] (finish-search! request-id [] on-success))))
                            (finish-search! request-id [] on-success)))))
               (.catch (fn [_] (finish-search! request-id [] on-success))))))))))

(defn set-pin-search-query! [query]
  (pin-state/swap-state!
   #(-> %
        (assoc :pin-search-query query)
        (assoc :pin-search-highlight-index nil)))
  (when-let [timeout @!search-timeout]
    (js/clearTimeout timeout))
  (reset! !search-timeout
          (js/setTimeout #(run-photon-search!
                           (:pin-search-query @app-state/!state))
                         search-debounce-ms))
  (pin-state/render!))

(defn- apply-search-result-on-update-pins! [form]
  (pin-rows/add-pin!)
  (when-let [id (:pin-selected-id @app-state/!state)]
    (editor/load-pin-into-inline-editor! id)))

(defn- apply-search-result! [result]
  (let [{:keys [country-iso countries country-slug pin-form page]} @app-state/!state]
    (if (photon/result-in-current-country? result country-iso countries country-slug)
      (let [form (forms/form-from-search-result result pin-form)]
        (pin-state/swap-render!
         (fn [s]
           (pin-rows/refresh-table-rows
            (-> s
                (assoc :pin-form form
                       :pin-form-baseline form
                       :pin-selected-id nil
                       :pin-message nil)
                (pin-state/clear-search-ui)))))
        (cond
          (update-pins-mode? @app-state/!state)
          (apply-search-result-on-update-pins! form)

          (= :update page)
          (effects/run-in-update-pins-mode!
           (fn [] (apply-search-result-on-update-pins! form)))

          :else
          (pin-map/schedule-pin-map-sync! {:recenter? true})))
      (pin-state/swap-render!
       #(assoc % :pin-message outside-country-message)))))

(defn select-pin-search-result! [result]
  (apply-search-result! result))

(defn set-pin-search-highlight-index! [idx]
  (pin-state/swap-render!
   #(assoc % :pin-search-highlight-index idx)))

(defn pin-search-enter! []
  (let [{:keys [pin-search-results pin-search-highlight-index]} @app-state/!state
        action (search/enter-action pin-search-results nil pin-search-highlight-index)]
    (when (vector? action)
      (when-let [result (search/highlighted-result pin-search-results
                                                   (second action))]
        (select-pin-search-result! result)))))

(defn pin-search-keydown! [^js e]
  (let [{:keys [pin-search-results
                pin-search-highlight-index]} @app-state/!state
        n (count pin-search-results)
        key (.-key e)]
    (cond
      (= "ArrowDown" key)
      (when (pos? n)
        (.preventDefault e)
        (set-pin-search-highlight-index!
         (search/step-highlight-index pin-search-highlight-index n 1)))

      (= "ArrowUp" key)
      (when (pos? n)
        (.preventDefault e)
        (set-pin-search-highlight-index!
         (search/step-highlight-index pin-search-highlight-index n -1)))

      (search/enter-key? e)
      (do
        (.preventDefault e)
        (.stopPropagation e)
        (pin-search-enter!))

      :else nil)))
