(ns placesurfer.load.honey
  (:require [placesurfer.load.gis :as gis]))

(def ^:private counts-url "data/honey/place-counts.edn")

(defn- gis-url [slug]
  (str "data/honey/" slug ".edn"))

(defn load-counts! []
  (gis/load-counts! counts-url))

(defn load-countries! []
  (gis/load-countries! counts-url))

(defn load-country! [slug]
  (gis/load-country! gis-url slug))
