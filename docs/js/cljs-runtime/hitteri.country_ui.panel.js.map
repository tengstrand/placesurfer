(ns hitteri.country-ui.panel
  (:require [clojure.string :as str]
            [hitteri.country-ui.filter :as filter]
            [hitteri.country-ui.rows :as rows]
            [hitteri.country-ui.search :as search]))

(defn panel
  [{:keys [countries country-slug country-filter country-highlight-index
           status countries-loading?
           select-country! set-country-filter! set-country-highlight-index!
           navigate! ensure-countries-loaded! t]
    :or {t (fn [k] (name k))}}]
  (let [countries (or countries [])
        filter-q (or country-filter "")
        status-str (str (or status ""))
        load-error? (str/starts-with? status-str "Error")
        visible (filter/visible-countries countries filter-q country-slug)]
    [:div.country-section
     {:replicant/on-mount (fn [_]
                            (when ensure-countries-loaded!
                              (ensure-countries-loaded!)))}
     (search/search-input filter-q country-slug countries country-highlight-index
                          set-country-filter! set-country-highlight-index!
                          select-country! navigate! t)
     [:div.country-list {:key (str "country-list-" (count countries))}
      (cond
        load-error?
        [:p.country-list-message.country-list-message--error status-str]

        (empty? countries)
        [:p.country-list-message (t :country/loading)]

        (empty? visible)
        [:p.country-list-message (t :country/no-matches)]

        :else
        (map-indexed
         (fn [idx {:keys [slug] :as country}]
           ^{:key slug}
           (rows/row country
                     (= slug country-slug)
                     (= idx country-highlight-index)
                     select-country!))
         visible))]]))
