(ns placesurfer.edit.pure.topic-dropdown)

(defn- close-dropdown! [e]
  (when-let [details (.closest (.-target e) "details")]
    (.removeAttribute details "open")))

(defn- selected-option [options update-topic]
  (or (some #(when (= update-topic (:topic %)) %) options)
      (first options)))

(defn- icon-class [topic]
  (when topic
    (str "update-topic-dropdown-icon update-topic-dropdown-icon--" (name topic))))

(defn- topic-option
  [{:keys [topic label marker-url selected? request-update-topic-change!]}]
  [:button {:type "button"
            :class (if selected?
                     "update-topic-dropdown-option update-topic-dropdown-option--selected"
                     "update-topic-dropdown-option")
            :on {:click (fn [e]
                          (.preventDefault e)
                          (request-update-topic-change! topic)
                          (close-dropdown! e))}}
   (when marker-url
     [:img {:class (icon-class topic)
            :src marker-url
            :alt ""}])
   [:span.update-topic-dropdown-label label]])

(defn dropdown
  [{:keys [update-topic update-topic-options request-update-topic-change!]}]
  (when (seq update-topic-options)
    (let [{:keys [topic label marker-url]}
          (selected-option update-topic-options update-topic)
          current-topic (or update-topic topic)]
      [:details.update-topic-dropdown
       [:summary.update-topic-dropdown-trigger
        (cond-> {}
          label (assoc :aria-label label :title label))
        (when marker-url
          [:img {:class (icon-class current-topic)
                 :src marker-url
                 :alt ""}])]
       [:div.update-topic-dropdown-menu
        (for [option update-topic-options]
          ^{:key (name (:topic option))}
          (topic-option (assoc option
                               :selected? (= current-topic (:topic option))
                               :request-update-topic-change! request-update-topic-change!)))]])))
