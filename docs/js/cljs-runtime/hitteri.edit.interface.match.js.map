(ns hitteri.edit.interface.match
  (:require [hitteri.edit.pure.match :as match]))

(defn coords-exact-match?
  [lon-a lat-a lon-b lat-b]
  (match/coords-exact-match? lon-a lat-a lon-b lat-b))

(defn coords-match?
  ([lon-a lat-a lon-b lat-b]
   (match/coords-match? lon-a lat-a lon-b lat-b))
  ([lon-a lat-a lon-b lat-b threshold-m]
   (match/coords-match? lon-a lat-a lon-b lat-b threshold-m)))

(defn coords-exist-in-update-rows?
  [longitude latitude rows]
  (match/coords-exist-in-update-rows? longitude latitude rows))

(defn find-saved-row-by-exact-coords
  [rows longitude latitude]
  (match/find-saved-row-by-exact-coords rows longitude latitude))

(defn find-saved-row-by-name-without-coords
  [rows place-name]
  (match/find-saved-row-by-name-without-coords rows place-name))

(defn row-coord-distance-m
  [row longitude latitude]
  (match/row-coord-distance-m row longitude latitude))

(defn find-pending-place-index
  [places longitude latitude]
  (match/find-pending-place-index places longitude latitude))

(defn closest-row-within-coord-threshold
  ([rows longitude latitude]
   (match/closest-row-within-coord-threshold rows longitude latitude))
  ([rows longitude latitude threshold-m]
   (match/closest-row-within-coord-threshold rows longitude latitude threshold-m)))

(defn coords-match-deleted-row-at?
  [rows places longitude latitude row-pred?]
  (match/coords-match-deleted-row-at? rows places longitude latitude row-pred?))

(defn find-display-row-by-coords
  ([saved-rows pending-places longitude latitude]
   (match/find-display-row-by-coords saved-rows pending-places longitude latitude))
  ([saved-rows pending-places longitude latitude use-url-name?]
   (match/find-display-row-by-coords saved-rows pending-places
                                     longitude latitude use-url-name?)))
