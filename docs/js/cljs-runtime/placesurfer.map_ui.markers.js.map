(ns placesurfer.map-ui.markers)

(def ^:private pin-marker-px 25)

(def marker-urls
  {:discgolf "/images/marker/discgolf.png"
   :art "/images/marker/art.png"
   :table-tennis "/images/marker/table-tennis.png"
   :honey "/images/marker/honey.png"
   :train-station "/images/marker/train-station.png"
   :bus-stop "/images/marker/bus-stop.png"
   :url-pin "/images/marker.png"
   :location "/images/pin.png"
   :pin "/images/pins/pin-orange.png"
   :removed "/images/removed.png"
   :hemnet-result "/images/marker/hemnet.png"
   :booli-result "/images/marker/booli.png"
   :notar-result "/images/marker/notar.png"})

(def marker-styles
  {:discgolf {:width-px 12
              :height-px 23
              :anchor "bottom"
              :background-position "center bottom"}
   :art {:width-px 15
         :height-px 15
         :anchor "center"
         :background-position "center center"}
   :table-tennis {:width-px 16
                  :height-px 16
                  :anchor "center"
                  :background-position "center center"}
   :honey {:width-px 16
           :height-px 16
           :anchor "center"
           :background-position "center center"}
   :train-station {:width-px 16
                   :height-px 16
                   :anchor "center"
                   :background-position "center center"}
   :bus-stop {:width-px 16
              :height-px 16
              :anchor "center"
              :background-position "center center"}
   :url-pin {:width-px 21
             :height-px 27
             :anchor "bottom"
             :background-position "center bottom"}
   :location {:width-px 28
              :height-px 28
              :anchor "bottom"
              :background-position "center bottom"}
   :pin {:width-px pin-marker-px
         :height-px pin-marker-px
         :anchor "bottom"
         :background-position "center bottom"}
   :removed {:width-px 16
             :height-px 16
             :anchor "bottom"
             :background-position "center bottom"}
   :hemnet-result {:width-px 18
                   :height-px 18
                   :anchor "center"
                   :background-position "center center"}
   :booli-result {:width-px 18
                  :height-px 18
                  :anchor "center"
                  :background-position "center center"}
   :notar-result {:width-px 18
                  :height-px 18
                  :anchor "center"
                  :background-position "center center"}})

(defn style-for-topic [topic]
  (get marker-styles topic))

(defn url-for-topic [topic]
  (get marker-urls topic))

(defn img-marker? [topic]
  (contains? #{:url-pin :location :pin :removed} topic))
