(ns hitteri.pin-ui.pure.toolbar-search
  (:require [clojure.string :as str]))

(defn- coerce-text [v]
  (cond
    (string? v) v
    (nil? v) ""
    :else (str v)))

(defn- search-field
  [{:keys [input-id results-list-id query results loading? highlight-index
           set-query! select-result! keydown! toolbar-search-end? t]
    :or {t (fn [k] (name k))}}]
  [:div.update-toolbar-search
   {:class (when toolbar-search-end? "update-toolbar-search--end")}
   [:img.update-toolbar-search-icon
    {:src "/images/search.png" :alt ""}]
   [:input.update-toolbar-search-input
    (cond-> {:type "text"
             :aria-label (t :pin/search-place)
             :aria-autocomplete "list"
             :aria-expanded (boolean (seq results))
             :value (coerce-text query)
             :on {:input (fn [e] (set-query! (.. e -target -value)))
                  :keydown (fn [e] (keydown! e))}}
      input-id (assoc :id input-id))]
   (when loading?
     [:p.update-toolbar-search-loading (t :pin/searching)])
   (when (seq results)
     [:ul.update-toolbar-search-results
      (cond-> {:role "listbox"}
        results-list-id (assoc :id results-list-id))
      (map-indexed
       (fn [idx {:keys [label] :as result}]
         ^{:key (str label "-" (:longitude result) "-" (:latitude result))}
         [:li.update-toolbar-search-result
          {:id (when results-list-id (str results-list-id "-result-" idx))
           :role "option"
           :aria-selected (= idx highlight-index)
           :class (when (= idx highlight-index)
                    "update-toolbar-search-result--highlighted")
           :on {:click (fn [_] (select-result! result))}}
          label])
       results)])])

(defn pin-search [props]
  (search-field
   {:input-id "pin-toolbar-search"
    :results-list-id "pin-toolbar-search-results"
    :query (:pin-search-query props)
    :results (:pin-search-results props)
    :loading? (:pin-search-loading? props)
    :highlight-index (:pin-search-highlight-index props)
    :set-query! (:set-pin-search-query! props)
    :select-result! (:select-pin-search-result! props)
    :keydown! (:pin-search-keydown! props)
    :toolbar-search-end? (:toolbar-search-end? props true)
    :t (:t props)}))
