(ns placesurfer.clipboard-ui.hemnet.url
  (:require [clojure.string :as str]))

(def ^:private hemnet-listing-pattern
  #"^https?://(?:www\.)?hemnet\.se/bostad/.+-(\d+)/?$")

(defn valid-hemnet-listing-url?
  "True when `url` looks like a Hemnet property listing page."
  [url]
  (boolean
   (when-let [s (not-empty (str/trim (str url)))]
     (re-matches hemnet-listing-pattern s))))

(defn listing-id-from-url
  "Extract numeric listing id from a Hemnet listing URL."
  [url]
  (when-let [s (not-empty (str/trim (str url)))]
    (some-> (re-matches hemnet-listing-pattern s) second)))

(defn- slug-segment->title-words [segment]
  (->> (str/split segment #"-")
       (remove str/blank?)
       (map str/capitalize)
       (str/join " ")))

(defn listing-title-from-url
  "Derive estate/listing title from the Hemnet URL slug (fallback when h1 is unavailable)."
  [url]
  (when-let [s (not-empty (str/trim (str url)))]
    (when-let [[_ slug _id] (re-matches #"(?i)https?://(?:www\.)?hemnet\.se/bostad/(.+)-(\d+)/?$" s)]
      (when-let [[_ title-slug] (re-find #"-kommun-(.+)$" slug)]
        (not-empty (slug-segment->title-words title-slug))))))
